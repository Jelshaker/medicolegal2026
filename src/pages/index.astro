---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import {
  SITE_TITLE,
  SITE_TAGLINE,
  SITE_DESCRIPTION,
  PAGE_HERO_IMAGES,
  BLOG_CATEGORIES,
} from "../consts";
import Callout from "../components/Callout.astro";
import { getCollection } from "astro:content";

const radiologyFundamentalsTitle = "Radiology fundamentals";
const medicolegalFundamentalsTitle = "Medicolegal fundamentals";
const radiologyLegislationTitle = "Radiology Legislation";
const radiologyCaseLawTitle = "Radiology Legal Cases";
const importantNewCasesTitle = "Recent Developments";

const allPosts = (await getCollection("recent-developments")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const categoryLabel = (id: string) =>
  BLOG_CATEGORIES.find((c) => c.id === id)?.label ?? id;
---

<BaseLayout
  title={`${SITE_TITLE} — ${SITE_TAGLINE}`}
  description={SITE_DESCRIPTION}
>
  <!-- Masthead -->
  <PageHero
    eyebrow="Radiology · Law · Reference resource"
    title="A radiologist's guide to medicolegal law."
    description="A free, independent reference for those working at the interface of radiology and the law. It covers how common radiological investigations are performed, interpreted and reported, the standards governing reporting, relevant statutory duties, and the consequences when things go wrong. Written primarily for radiologists and healthcare professionals."
    heroImage={PAGE_HERO_IMAGES["/"] || undefined}
  >
    <div class="hero-link-row">
      <a href="/radiology-fundamentals" class="link-hero"
        >Radiology fundamentals</a
      >
      <a href="/medicolegal-fundamentals" class="link-hero"
        >Medicolegal law library</a
      >
      <a href="/free-dicom-viewer" class="link-hero">DICOM viewer</a>
    </div>
  </PageHero>

  <!-- Why this exists -->
  <section class="section-white">
    <div class="container-page doc">
      <div class="sec">
        <p class="meta-label">A brief explainer why this website exists</p>
        <h1 class="sec-title-lg">Why does Radiology Law exist?</h1>
        <p class="para">
          I am a practising radiologist with a master's degree in Healthcare
          Ethics and Law, a combination which has given me a deep interest in
          medical ethics and healthcare law, especially in relation to clinical
          radiology. In recent years it has become increasingly difficult to
          distinguish genuine case law from
          <b>AI-generated slop</b>. This is particularly frustrating as, in my
          free time, I like to follow recent and interesting medicolegal
          developments.
        </p>
        <p class="para">
          This is intellectually stimulating and not simply academic. I
          frequently come across cases with direct relevance to my clinical
          practice and to the NHS more generally. This site was therefore
          created to provide a
          <em>human-reviewed</em> and <em>trustworthy</em> resource for radiologists,
          lawyers and patients navigating medicolegal case law, with a clear focus
          on radiology. All material is checked against primary sources (a shocking
          proposal in this day and age I know...).
        </p>
      </div>
    </div>
  </section>

  <!-- Breaking news — most recent recent-development -->
  <section class="section-dark">
    <div class="container-page doc">
      <div>
        <p class="meta-label text-slate-200">Most Recent Case Update</p>
        <h2 class="heading-hero-text">
          {allPosts[0].data.title}
        </h2>
        <p class="para text-slate-200 mt-3">
          {allPosts[0].data.description}
        </p>
        <p class="text-muted mt-2">
          {
            (allPosts[0].data.pubDate as Date).toLocaleDateString("en-GB", {
              day: "numeric",
              month: "long",
              year: "numeric",
            })
          }
          · {categoryLabel(allPosts[0].data.category)}
        </p>
        <div class="mt-6 flex flex-wrap gap-x-8 gap-y-2">
          <a
            href={`/recent-developments/${allPosts[0].slug}`}
            class="btn btn-primary">Read the analysis</a
          >
          <a href="/recent-developments" class="btn-outline">See more →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- How this resource is laid out -->
  <section class="section-white">
    <div class="container-page doc">
      <div class="sec">
        <p class="meta-label">Website Structure</p>
        <h2 class="sec-title-lg">From Fundamentals to Recent Events</h2>
        <p class="para">
          The site is structured so that everyone, from first-time visitors to
          experienced medicolegal practitioners, are on an equal footing both
          <em>clinically</em> and <em>legally</em>. These following sections aim
          to provide a concise and comprehensive overview of clinical radiology
          as a specialty, important legislation and regulations, foundational
          medicolegal principles, and significant recent judgments.
        </p>
      </div>
      <div class="mt-10 grid-2-col">
        <article class="tile pad-box">
          <span class="sec-no">Section 01</span>
          <h3 class="heading-lg">
            {radiologyFundamentalsTitle}
          </h3>
          <p class="para-sm-mt-2">
            An overview of common radiological examinations, their indications,
            limitations and associated risks. Covers risk mitigation, image
            handling and storage, quality assurance, and the applicable
            legislative framework.
          </p>
          <a href="/radiology-fundamentals" class="link-sm-block"
            >Open {radiologyFundamentalsTitle}</a
          >
        </article>
        <article class="tile pad-box">
          <span class="sec-no">Section 02</span>
          <h3 class="heading-lg">
            {medicolegalFundamentalsTitle}
          </h3>
          <p class="para-sm-mt-2">
            Foundational principles including Bolam, Bolitho and Montgomery, and
            key legislation governing radiology practice such as IRR17 and
            IR(ME)R, statutory duties and the duty of candour.
          </p>
          <a href="/medicolegal-fundamentals" class="link-sm-block"
            >Open {medicolegalFundamentalsTitle}</a
          >
        </article>
        <article class="tile pad-box">
          <span class="sec-no">Section 05</span>
          <h3 class="heading-lg">
            {radiologyLegislationTitle}
          </h3>
          <p class="para-sm-mt-2">
            The statutory framework underpinning radiological practice: who each
            duty binds, what it requires, what must be recorded, and what
            follows from a failure. Summary only — the primary text governs.
          </p>
          <a href="/radiology-legislation" class="link-sm-block"
            >Browse the legislation</a
          >
        </article>

        <article class="tile pad-box">
          <span class="sec-no">Section 03</span>
          <h3 class="heading-lg">
            {radiologyCaseLawTitle}
          </h3>
          <p class="para-sm-mt-2">
            Analysis of landmark and instructive cases relevant to radiological
            practice.
          </p>
          <a href="/radiology-legal-cases" class="link-sm-block"
            >Open {radiologyCaseLawTitle}</a
          >
        </article>
        <article class="tile pad-box">
          <span class="sec-no">Section 04</span>
          <h3 class="heading-lg">
            {importantNewCasesTitle}
          </h3>
          <p class="para-sm-mt-2">
            Regularly updated analysis of new judgments raising important
            radiological or legal points.
          </p>
          <a href="/recent-developments" class="link-sm-block"
            >Open {importantNewCasesTitle}</a
          >
        </article>
      </div>
    </div>
  </section>

  <!-- Free DICOM viewer — advertise the page; viewer stays on its own page -->
  <section class="section-paper">
    <div class="container-page doc text-center">
      <div class="sec">
        <p class="meta-label">A Super Useful Free Tool</p>
        <h2 class="sec-title-lg">Free DICOM Image Viewer</h2>
        <p class="para-max-w">
          A free, browser-based DICOM viewer for reviewing imaging in complete
          privacy. No upload to any server — all processing occurs locally in
          the browser. Tested with plain radiographs, CT and MRI. A practical
          tool for radiologists, legal professionals and patients reviewing
          anonymised images securely.
        </p>
        <a href="/free-dicom-viewer" class="btn-primary-lg"
          >Open the DICOM viewer</a
        >
      </div>
    </div>
  </section>
</BaseLayout>
