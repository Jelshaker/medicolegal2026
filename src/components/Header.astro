---
import { NAVIGATION_LINKS, SITE_TITLE } from "../consts";
---

<header>
	<nav>
		<a href="/" class="site-title">{SITE_TITLE}</a>
		<ul>
			{
				NAVIGATION_LINKS.map((link) => (
					<li>
						<a href={link.href}>{link.label}</a>
					</li>
				))
			}
		</ul>
	</nav>
</header>

<style>
	header {
		padding: 2em 0;
	}
	nav {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.75rem;
	}
	ul {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		padding: 0;
		margin: 0;
	}
	a {
		color: var(--black);
	}
	.site-title {
		font-weight: 700;
		font-size: 1.25rem;
		text-decoration: none;
	}
</style>