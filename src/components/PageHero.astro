---
// Reusable page masthead — full-width hero image pinned to the viewport
// (background-attachment: fixed) so it stays visible as the user scrolls,
// then a soft gradient overlay, then the page eyebrow / title / description.
//
// The hero is a CSS background rather than an <img>, so it cannot use
// `srcset`; instead the three derivatives generated by
// `scripts/optimise-images.mjs` are passed as custom properties and swapped at
// the breakpoints below. The originals are 1–4 MB camera files, so this is the
// single largest weight saving on the site (the home hero drops from ~2.4 MB to
// ~110 kB). An SVG or not-yet-processed path falls through to the original.
//
// Props
//   heroImage   — URL path to a hero image (optional)
//   darkOverlay — strength of the dark gradient; default 0.65 (0–1)
import { imageAtWidth } from "../lib/images";

interface Props {
	eyebrow?: string;
	title: string;
	description?: string;
	heroImage?: string;
	darkOverlay?: number;
}

const {
	eyebrow = "Radiology & medicolegal law",
	title,
	description = "",
	heroImage,
	darkOverlay = 0.65,
} = Astro.props as Props;

// Dark gradient — strong at the top where the text sits (0.75),
// then fades to clear near the bottom so the image bleeds into the section below.
const gradient = heroImage
	? `linear-gradient(to bottom, rgba(2 6 23 / 0.75) 0%, rgba(2 6 23 / 0.70) 25%, rgba(2 6 23 / 0.40) 55%, rgba(2 6 23 / 0) 100%)`
	: "transparent";

// Mobile and small tablets, desk/laptop, then large desktop — chosen to match
// the three breakpoints in the <style> block below.
const background = heroImage
	? [
			`--hero-sm: url("${imageAtWidth(heroImage, 1024)}")`,
			`--hero-md: url("${imageAtWidth(heroImage, 1440)}")`,
			`--hero-lg: url("${imageAtWidth(heroImage, 1920)}")`,
		].join("; ")
	: undefined;
---

<section
	class:list={[
		"relative overflow-hidden border-b border-slate-300",
		heroImage ? "hero-plate min-h-[36rem] sm:min-h-[42rem]" : "py-14 sm:py-16",
	]}
	style={background}
>
	<!-- Dark gradient overlay — scrolls normally, so it "clears away" as the user scrolls down -->
	{heroImage && (
		<div
			class="absolute inset-0"
			style={`background: ${gradient};`}
			aria-hidden="true"
		/>
	)}

	<!-- Content — centred vertically, pushed lower for breathing room -->
	<div class="container-page relative z-10 py-32 sm:py-40">
		<div class="doc text-center mx-auto">
			{eyebrow && <p class="meta-label text-slate-300">{eyebrow}</p>}
			<h1 class="mt-5 font-serif text-4xl font-bold leading-tight text-white sm:text-5xl md:text-6xl text-balance break-words" style="text-shadow: 0 2px 8px rgba(0 0 0 / 0.5);">
				{title}
			</h1>
			{description && <p class="standfirst mx-auto mt-4 text-slate-200/90" style="text-shadow: 0 1px 4px rgba(0 0 0 / 0.4);">{description}</p>}
			<slot />
		</div>
	</div>
</section>

<style>
	/* Hero plate: a parallax background served from the responsive ladder.
	   Slate-950 sits underneath so there is no flash of white while the WebP
	   downloads. The custom properties come from the component's inline style
	   (see `background` above) — media queries cannot read them, but they can
	   swap which variable is used. */
	.hero-plate {
		background-color: #020617;
		background-image: var(--hero-sm);
		background-position: center;
		background-size: cover;
		background-attachment: fixed;
	}

	@media (min-width: 768px) {
		.hero-plate {
			background-image: var(--hero-md);
		}
	}

	@media (min-width: 1440px) {
		.hero-plate {
			background-image: var(--hero-lg);
		}
	}
</style>
