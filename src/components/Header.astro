---
import { NAVIGATION_LINKS, PRACTITIONER, SITE_TITLE } from "../consts";

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
	href === "/" ? pathname === "/" : pathname.startsWith(href);
---

<header class="sticky top-0 z-50 border-b border-slate-300 bg-white">
	<div class="container-page flex h-16 items-center justify-between gap-6 md:h-[4.75rem]">
		<a href="/" class="group" aria-label={`${SITE_TITLE} — home`}>
			<span class="block font-serif text-[1.05rem] font-bold leading-tight text-slate-900">
				{PRACTITIONER.shortName}
			</span>
			<span class="meta-label mt-0.5 block !text-[0.62rem]">Radiology &amp; medicolegal law</span>
		</a>

		<nav class="hidden items-center gap-x-6 xl:flex" aria-label="Primary">
			{
				NAVIGATION_LINKS.map((link) => (
					<a
						href={link.href}
						class:list={[
							"font-sans text-[0.8rem] font-medium tracking-wide transition-colors",
							isActive(link.href)
								? "border-b-2 border-slate-900 pb-0.5 text-slate-900"
								: "border-b-2 border-transparent pb-0.5 text-slate-600 hover:text-slate-900",
						]}
					>
						{link.label}
					</a>
				))
			}
			<a href="/login" class="btn btn-ghost !px-4 !py-2 !text-xs">Secure Login</a>
		</nav>

		<div class="flex items-center gap-2.5">
			<a href="/login" class="btn btn-ghost hidden !px-4 !py-2 !text-xs sm:inline-flex xl:hidden">
				Secure Login
			</a>

			<button
				id="menu-toggle"
				type="button"
				class="flex h-10 w-10 items-center justify-center border border-slate-300 text-slate-700 hover:border-slate-900 hover:text-slate-900 xl:hidden"
				aria-label="Open menu"
				aria-expanded="false"
				aria-controls="mobile-menu"
			>
				<svg id="icon-burger" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
					<path d="M4 7h16M4 12h16M4 17h16" />
				</svg>
				<svg id="icon-close" class="hidden h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
					<path d="M6 6l12 12M18 6 6 18" />
				</svg>
			</button>
		</div>
	</div>

	<nav
		id="mobile-menu"
		class="hidden border-t border-slate-200 bg-white px-4 pb-4 pt-2 xl:hidden"
		aria-label="Mobile"
	>
		<ul class="flex flex-col">
			{
				NAVIGATION_LINKS.map((link) => (
					<li class="border-b border-slate-100 last:border-b-0">
						<a
							href={link.href}
							class:list={[
								"block py-3 font-sans text-[0.9rem]",
								isActive(link.href) ? "font-semibold text-slate-900" : "text-slate-600 hover:text-slate-900",
							]}
						>
							{link.label}
						</a>
					</li>
				))
			}
			<li class="mt-3 border-t border-slate-200 pt-4">
				<a href="/login" class="btn btn-ghost w-full">Secure Client Login</a>
			</li>
		</ul>
	</nav>
<script>
	const menuToggle = document.getElementById("menu-toggle");
	const mobileMenu = document.getElementById("mobile-menu");
	const iconBurger = document.getElementById("icon-burger");
	const iconClose = document.getElementById("icon-close");

	menuToggle?.addEventListener("click", () => {
		const open = mobileMenu?.classList.toggle("hidden") !== true;
		menuToggle.setAttribute("aria-expanded", String(open));
		iconBurger?.classList.toggle("hidden", open);
		iconClose?.classList.toggle("hidden", !open);
	});

	if (mobileMenu) {
		mobileMenu.querySelectorAll("a").forEach((a) =>
			a.addEventListener("click", () => {
				mobileMenu.classList.add("hidden");
				iconBurger?.classList.remove("hidden");
				iconClose?.classList.add("hidden");
			}),
		);
	}
</script>
</header>