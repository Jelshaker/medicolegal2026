---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import PageIntro from "../components/PageIntro.astro";
import Section from "../components/Section.astro";
import LocalDicomViewer from "../components/LocalDicomViewer.astro";
import Figure from "../components/Figure.astro";
import Diagram from "../components/Diagram.astro";
import { SITE_TITLE } from "../consts";
---

<BaseLayout
	title={`DICOM Viewer | ${SITE_TITLE}`}
	description="A free, privacy-first, local-only DICOM viewer for solicitors, barristers, insurers and clinicians. Review CT, MRI and plain-film series in your browser — no upload, no server, no transfer of patient data."
>
	<PageHero
		eyebrow="Local DICOM viewer"
		title="Local DICOM Viewer"
		description="Drop a DICOM study and review it in your own browser — window/level, pan, zoom, slice navigation and anonymised tag inspection. Every pixel stays on your device."
	/>

	<PageIntro
		eyebrow="Local viewer"
		paragraphs={[
			'A free viewer that opens a DICOM study in your own browser. Nothing is uploaded, nothing is stored, and no copy of patient data is created — which is why it can be used to get a first look at a study without creating a data protection problem.',
			'It is a triage and orientation tool. It is not a calibrated diagnostic workstation, and no opinion should be based on it.',
		]}
		contents={[
			{ href: '#privacy-by-design', label: 'Privacy by design' },
			{ href: '#open-a-study', label: 'Open a study' },
			{ href: '#legal-workflow', label: 'Legal workflow' },
			{ href: '#limits', label: 'Limits' },
		]}
		audience="Written for solicitors, barristers, insurers, expert witnesses and clinicians."
		reviewed="September 2026"
	/>

	<!-- Privacy by design -->
	<section id="privacy-by-design" class="scroll-mt-24 bg-paper py-14">
		<div class="container-page">
			<div class="doc">
				<Figure
					label="Figure 01"
					caption="How a local-only viewer works"
					subtitle="The file is parsed and rendered inside the browser session. No upload, no server and no retained copy is created, so the data-minimisation duty is met by design."
				>
					<Diagram name="local-only" />
				</Figure>
			</div>
			<div class="divide-y divide-slate-200">
				<div class="py-5">
					<h2 class="text-base font-bold text-navy-900">No upload, no server</h2>
					<p class="mt-3 text-sm leading-relaxed text-slate-600">
						Files are parsed and rendered entirely by JavaScript running in your own browser. Nothing is
						transmitted, stored or logged, so no further copy of personal data is created. The
						data-minimisation and security principles of the UK GDPR and the Data Protection Act 2018
						are satisfied by design rather than by contract.
					</p>
				</div>
				<div class="py-5">
					<h2 class="text-base font-bold text-navy-900">Works with a full series</h2>
					<p class="mt-3 text-sm leading-relaxed text-slate-600">
						Drop multiple <code class="rounded bg-slate-100 px-1.5 py-0.5 text-xs">.dcm</code>
						files to load a series as a slice stack and scroll through it with the slider, the on-screen
						controls or Ctrl+scroll. Single images and whole stacks are both supported.
					</p>
				</div>
				<div class="py-5">
					<h2 class="text-base font-bold text-navy-900">Triage only — not for reporting</h2>
					<p class="mt-3 text-sm leading-relaxed text-slate-600">
						This is an uncalibrated consumer display. It must never be used to make or exclude a
						diagnosis, and it cannot substitute for official interpretation on a compliant diagnostic
						workstation (see the limits below).
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- The viewer -->
	<section id="open-a-study" class="scroll-mt-24 bg-white py-14">
		<div class="container-page space-y-8">
			<div>
				<h2 class="text-2xl font-bold tracking-tight text-navy-900">Open a study</h2>
				<p class="mt-3 max-w-3xl leading-relaxed text-slate-600">
					No account, no installation and no network connection is required once the page has loaded.
					Anonymise source imaging before review wherever the study still carries patient-identifying tags.
				</p>
			</div>
			<LocalDicomViewer />
		</div>
	</section>

	<!-- Legal framing -->
	<section id="legal-workflow" class="scroll-mt-24 bg-slate-50 py-16">
		<div class="container-page space-y-12">
			<Section
				eyebrow="How it fits the legal workflow"
				title="A proportionate first look — not a substitute for instructed evidence"
			>
				<div class="divide-y divide-slate-200">
					<div class="py-5">
						<h3 class="text-base font-bold text-navy-900">Preliminary triage</h3>
						<p class="mt-3 text-sm leading-relaxed text-slate-600">
							Before incurring the cost of a full expert instruction, a solicitor can establish whether
							a study is broadly normal or contains something worth investigating — and therefore
							whether the claim has a radiological foundation at all.
						</p>
					</div>
					<div class="py-5">
						<h3 class="text-base font-bold text-navy-900">Proportionality and costs</h3>
						<p class="mt-3 text-sm leading-relaxed text-slate-600">
							The overriding objective in CPR Part 1 requires cases to be dealt with justly and at
							proportionate cost. A free local review helps frame the radiological issue before an
							expert is instructed, so that the questions put to the expert are properly targeted.
						</p>
					</div>
					<div class="py-5">
						<h3 class="text-base font-bold text-navy-900">Handling and custody</h3>
						<p class="mt-3 text-sm leading-relaxed text-slate-600">
							Because nothing is copied, this tool does not disturb the integrity of the original media.
							Where an expert opinion is required, the images must still be provided to the expert as
							the full study — never as screenshots.
						</p>
					</div>
				</div>
			</Section>

			<Section id="limits" eyebrow="Medicolegal limits" title="What this free viewer can and cannot do">
				<div class="divide-y divide-slate-200">
					<div class="py-5">
						<h3 class="text-base font-bold text-navy-900">Appropriate uses</h3>
						<ul class="mt-4 space-y-2.5 text-sm text-slate-600">
							<li>Orientation — getting to know the series before instructing an expert.</li>
							<li>Confirming that a study has been produced and transferred in full.</li>
							<li>Reviewing anonymised teaching or conference material locally.</li>
							<li>Preparing questions for a CPR Part 35 letter of instruction.</li>
						</ul>
					</div>
					<div class="py-5">
						<h3 class="text-base font-bold text-navy-900">Not appropriate for</h3>
						<ul class="mt-4 space-y-2.5 text-sm text-slate-600">
							<li>Official interpretation or any diagnostic conclusion about a patient.</li>
							<li>Measuring lesions for staging, quantum or causation purposes.</li>
							<li>Substituting for a report that complies with CPR Part 35.</li>
							<li>Reviewing identifiable patient data without a lawful basis.</li>
						</ul>
					</div>
				</div>

				<div class="mt-8 rounded-xl border border-amber-300 bg-amber-50/60 p-6">
					<h3 class="text-base font-bold text-amber-900">Why the technical limits matter legally</h3>
					<p class="mt-2 text-sm leading-relaxed text-slate-700">
						Published standards for teleradiology require that an official interpretation is made on a
						display system with controlled luminance and ambient lighting, accurate association of
						patient demographics with study images, and reliable window/level, pan, zoom and measurement
						tools. A browser canvas provides none of that calibration. The RCR's 2025 <em>Standards for
						interpretation and reporting of imaging investigations</em> likewise require remote reporting
						arrangements to comply with the same technical specifications and governance as
						provider-based reporting. A preliminary look here must therefore always be followed by
						proper re-derivation on a diagnostic workstation before any formal opinion is expressed.
					</p>
				</div>
			</Section>

			<div class="text-center">
				<a href="/expert-witness" class="btn btn-primary">Instruct a formal expert review</a>
			</div>
		</div>
	</section>
</BaseLayout>
