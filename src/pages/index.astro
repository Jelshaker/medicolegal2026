---
import BaseLayout from '../layouts/BaseLayout.astro';
import MedicalImageViewer from '../components/MedicalImageViewer.astro';
import Callout from '../components/Callout.astro';
import { getCollection } from 'astro:content';
import { PRACTITIONER, SITE_TITLE, SITE_DESCRIPTION, SITE_TAGLINE, BLOG_CATEGORIES, RESOURCE_LIBRARIES } from '../consts';

const allPosts = (await getCollection('recent-developments')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const featured = allPosts.find((p) => p.data.featured) ?? allPosts[0];
const recent = allPosts.slice(0, 3);
const categoryLabel = (id: string) => BLOG_CATEGORIES.find((c) => c.id === id)?.label ?? id;
const stats = [
	{ value: '1957', label: 'Bolam — the standard of care' },
	{ value: '~37%', label: 'Abdominal claims turning on incidental findings' },
	{ value: '2025', label: 'RCR interpretation and reporting standards' },
	{ value: '100%', label: 'DICOM viewing that never leaves your device' },
];
---

<BaseLayout title={`${SITE_TITLE} — ${SITE_TAGLINE}`} description={SITE_DESCRIPTION}>
	<!-- Masthead -->
	<section class="border-b border-slate-300 bg-white">
		<div class="container-page py-16 sm:py-20">
			<div class="doc text-center">
				<p class="meta-label">Radiology · Law · Reference resource</p>
				<h1 class="mt-5 font-serif text-4xl font-bold leading-tight text-slate-900 sm:text-5xl">
					A working resource for radiology and medicolegal law.
				</h1>
				<p class="mx-auto mt-6 max-w-2xl font-serif text-[1.1rem] leading-relaxed text-slate-600">
					Reference material for anyone who has to reason about imaging and the law: how investigations
					are performed, interpreted and reported, the standards and statutory duties that govern them,
					and how a court, a regulator or an insurer will test the result. Written for radiologists,
					referrers, solicitors, barristers, insurers and expert witnesses.
				</p>
				<div class="mt-8 flex flex-wrap justify-center gap-x-8 gap-y-2 border-t border-slate-200 pt-5">
					<a href="/radiology-resources" class="font-sans text-[0.8rem] font-medium text-slate-600 underline decoration-slate-300 underline-offset-4 hover:text-slate-900 hover:decoration-slate-600">Radiology reference</a>
					<a href="/medicolegal-fundamentals" class="font-sans text-[0.8rem] font-medium text-slate-600 underline decoration-slate-300 underline-offset-4 hover:text-slate-900 hover:decoration-slate-600">Medicolegal law library</a>
					<a href="/dicom-viewer" class="font-sans text-[0.8rem] font-medium text-slate-600 underline decoration-slate-300 underline-offset-4 hover:text-slate-900 hover:decoration-slate-600">DICOM viewer</a>
				</div>

	<!-- What this resource is — and what it is not -->
	<section class="border-b border-slate-200 bg-paper">
		<div class="container-page py-14">
			<div class="doc divide-y divide-slate-200">
				<div class="pb-8">
					<div class="flex items-baseline gap-3">
						<span class="font-sans text-[0.7rem] font-semibold tabular-nums tracking-[0.14em] text-slate-400">§ 01</span>
						<span class="eyebrow">Scope</span>
					</div>
					<h2 class="mt-2 font-serif text-xl font-bold text-slate-900">Small, and kept current</h2>
					<p class="mt-3 font-serif leading-relaxed text-slate-600">
						This is a deliberately small resource. It holds a selective set of entries on radiology and
						medicolegal law, each one sourced to the statute, standard or decision behind it, rather than
						attempting to be a complete text.
					</p>
				</div>
				<div class="py-8">
					<div class="flex items-baseline gap-3">
						<span class="font-sans text-[0.7rem] font-semibold tabular-nums tracking-[0.14em] text-slate-400">§ 02</span>
						<span class="eyebrow">Commentary</span>
					</div>
					<h2 class="mt-2 font-serif text-xl font-bold text-slate-900">Recent case commentary</h2>
					<p class="mt-3 font-serif leading-relaxed text-slate-600">
						Its distinguishing feature is short, anonymised commentary on recent cases that raise an
						interesting radiological or legal point. Every piece says what the imaging showed, what the
						court was asked to decide, and what a radiologist should take from it.
					</p>
				</div>
				<div class="pt-2">
					<Callout tone="caution" title="What it is not">
						<p>
							It is not a substitute for the primary sources, not a comprehensive case database, and not
							legal or clinical advice. Where a matter needs a radiological opinion, instruction is handled
							through the practice behind the resource.
						</p>
					</Callout>
				</div>
			</div>
		</div>
	</section>

	<!-- The two libraries -->
	<section class="border-b border-slate-200 bg-white">
		<div class="container-page py-16">
			<div class="doc">
				<div class="border-t border-slate-300 pt-8">
					<p class="meta-label">Two reference libraries</p>
					<h2 class="mt-3 font-serif text-2xl font-bold text-slate-900 sm:text-3xl">Radiology, and the law that governs it</h2>
					<p class="mt-4 font-serif leading-relaxed text-slate-600">
						The material is organised in two halves that read across to one another: what imaging can and
						cannot do, and how the law treats it when it goes wrong.
					</p>
				</div>
				<div class="mt-10 divide-y divide-slate-200 border-t border-slate-200">
					{
						RESOURCE_LIBRARIES.map((lib, i) => (
							<article class="py-8">
								<div class="flex items-baseline gap-3">
									<span class="font-sans text-[0.7rem] font-semibold tabular-nums tracking-[0.14em] text-slate-400">
										§ {String(i + 1).padStart(2, "0")}
									</span>
									<span class="eyebrow">{lib.eyebrow}</span>
								</div>
								<h3 class="mt-2 font-serif text-xl font-bold text-slate-900">{lib.title}</h3>
								<p class="mt-3 font-serif leading-relaxed text-slate-600">{lib.description}</p>
								<p class="mt-4 font-sans text-xs uppercase tracking-[0.1em] text-slate-500">
									{lib.topics.join(" · ")}
								</p>
								<a href={lib.href} class="mt-4 inline-block font-sans text-[0.8rem] font-medium text-slate-700 underline decoration-slate-300 underline-offset-4 hover:text-slate-900 hover:decoration-slate-600">
									{lib.cta}
								</a>
							</article>
						))
					}
				</div>
			</div>
		</div>
	</section>

			</div>
		</div>
	</section>

	<!-- Legal framework -->
	<section class="border-b border-slate-200 bg-white">
		<div class="container-page py-16">
			<div class="doc">
				<div class="border-t border-slate-300 pt-8">
					<p class="meta-label">Medicolegal law library</p>
					<h2 class="mt-3 font-serif text-2xl font-bold text-slate-900 sm:text-3xl">The framework, in four questions</h2>
					<p class="mt-4 font-serif leading-relaxed text-slate-600">
						Every radiological claim resolves into a small number of legal questions. Each is examined in
						the law library, with the authorities and the professional standards that govern the answer.
					</p>
				</div>
				<div class="mt-10 divide-y divide-slate-200 border-t border-slate-200">
					{[
						{ t: 'What standard of care applies?', d: 'Bolam, Bolitho and the line between a defensible difference of opinion and a breach.', href: '/medicolegal-fundamentals', tag: 'Bolam · Bolitho' },
						{ t: 'Was the finding demonstrable?', d: 'The "pure diagnosis" argument, incidentalomas, and what the images actually showed on the day.', href: '/medicolegal-radiology', tag: 'Breach & causation' },
						{ t: 'What did the patient know?', d: 'Consent, the materiality of risk, and the duty of candour where a complication occurs.', href: '/medicolegal-fundamentals', tag: 'Montgomery · Candour' },
						{ t: 'Who else is liable?', d: 'Remote reporting, provider-level duties, escalation failure and dual liability in teleradiology.', href: '/recent-developments', tag: 'Teleradiology' },
					].map((p, i) => (
						<article class="py-7">
							<div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
								<span class="font-sans text-[0.7rem] font-semibold tabular-nums tracking-[0.14em] text-slate-400">
									§ {String(i + 1).padStart(2, "0")}
								</span>
								<h3 class="font-serif text-lg font-bold text-slate-900">
									<a href={p.href} class="hover:underline hover:underline-offset-4 hover:decoration-slate-400">{p.t}</a>
								</h3>
							</div>
							<p class="mt-2 font-serif text-[0.95rem] leading-relaxed text-slate-600">{p.d}</p>
							<p class="mt-2 font-sans text-xs uppercase tracking-[0.1em] text-slate-500">{p.tag}</p>
						</article>
					))}
				</div>
				<div class="mt-8 flex flex-wrap gap-x-8 gap-y-2">
					<a href="/dicom-viewer" class="font-sans text-[0.8rem] font-medium text-slate-600 underline decoration-slate-300 underline-offset-4 hover:text-slate-900 hover:decoration-slate-600">Free local DICOM viewer</a>
					<a href="/patient-advice" class="font-sans text-[0.8rem] font-medium text-slate-600 underline decoration-slate-300 underline-offset-4 hover:text-slate-900 hover:decoration-slate-600">Patient advice</a>
					<a href="/about" class="font-sans text-[0.8rem] font-medium text-slate-600 underline decoration-slate-300 underline-offset-4 hover:text-slate-900 hover:decoration-slate-600">About the curator</a>
				</div>
			</div>
		</div>
	</section>

	<!-- Key figures, set as a reference table -->
	<section class="border-b border-slate-200 bg-paper">
		<div class="container-page py-14">
			<div class="doc">
				<p class="meta-label">Reference figures</p>
				<table class="mt-4 w-full border-collapse text-left">
					<thead>
						<tr>
							<th scope="col" class="border-b border-slate-400 bg-white px-3 py-2 font-sans text-[0.7rem] font-semibold uppercase tracking-[0.14em] text-slate-500">Figure</th>
							<th scope="col" class="border-b border-slate-400 bg-white px-3 py-2 font-sans text-[0.7rem] font-semibold uppercase tracking-[0.14em] text-slate-500">Bears upon</th>
						</tr>
					</thead>
					<tbody>
						{stats.map((s) => (
							<tr class="bg-white">
								<td class="border-b border-slate-200 px-3 py-3 align-top font-serif text-[0.95rem] font-bold text-slate-900">{s.value}</td>
								<td class="border-b border-slate-200 px-3 py-3 align-top font-serif text-sm text-slate-600">{s.label}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</div>
	</section>


	<!-- Featured case -->
	<section class="border-b border-slate-200 bg-white">
		<div class="container-page py-16">
			<div class="doc">
				<div class="border-t border-slate-300 pt-8">
					<p class="meta-label">Featured case discussion</p>
					<h2 class="mt-3 font-serif text-2xl font-bold leading-snug text-slate-900">{featured.data.title}</h2>
					<p class="mt-4 font-serif leading-relaxed text-slate-600">{featured.data.description}</p>
					<p class="mt-4 font-sans text-xs uppercase tracking-[0.1em] text-slate-500">
						{featured.data.tags.slice(0, 3).join(" · ")}
					</p>
					<a href={`/recent-developments/${featured.slug}`} class="btn btn-ghost mt-6">Read the analysis</a>
				</div>
				<div class="mx-auto mt-10 max-w-2xl">
					{
						featured.data.figures?.[0]
							? (
								<MedicalImageViewer
									src={featured.data.figures[0]}
									alt="Anonymised case image"
									caption="Anonymised source series referenced in the featured case"
									modality="MRI / CT"
								/>
								)
							: (
								<MedicalImageViewer
									src="/images/placeholders/anonymised-mri-knee-sagittal.svg"
									alt="Anonymised imaging placeholder"
									caption="Anonymised reference image"
									modality="MRI"
								/>
								)
					}
				</div>
			</div>
		</div>
	</section>

	<!-- Recent posts — flat text index -->
	<section class="border-b border-slate-200 bg-paper">
		<div class="container-page py-16">
			<div class="doc">
				<div class="border-t border-slate-300 pt-8">
					<p class="meta-label">Recent developments</p>
					<h2 class="mt-3 font-serif text-2xl font-bold text-slate-900 sm:text-3xl">Latest case discussions</h2>
				</div>
				<div class="mt-8 divide-y divide-slate-200 border-t border-slate-200">
					{recent.map((post, i) => (
						<article class="py-7">
							<div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
								<span class="font-sans text-[0.7rem] font-semibold tabular-nums tracking-[0.14em] text-slate-400">
									§ {String(i + 1).padStart(2, "0")}
								</span>
								<span class="font-sans text-xs uppercase tracking-[0.1em] text-slate-500">
									{categoryLabel(post.data.category)}
								</span>
							</div>
							<h3 class="mt-2 font-serif text-lg font-bold leading-snug text-slate-900">
								<a href={`/recent-developments/${post.slug}`} class="hover:underline hover:decoration-slate-400 hover:underline-offset-4">{post.data.title}</a>
							</h3>
							<p class="mt-2 font-serif text-[0.95rem] leading-relaxed text-slate-600">{post.data.description}</p>
						</article>
					))}
				</div>
				<a href="/recent-developments" class="mt-8 inline-block font-sans text-[0.8rem] font-medium text-slate-700 underline decoration-slate-300 underline-offset-4 hover:text-slate-900 hover:decoration-slate-600">
					All discussions
				</a>
			</div>
		</div>
	</section>

	<!-- Who maintains the resource -->
	<section class="bg-white">
		<div class="container-page py-16">
			<div class="doc text-center">
				<div class="border-t border-slate-300 pt-8">
					<p class="meta-label">Who maintains this resource</p>
					<p class="mx-auto mt-4 max-w-2xl font-serif text-[1.05rem] leading-relaxed text-slate-600">
						The material is curated by {PRACTITIONER.name}, a consultant radiologist in NHS practice with an
						independent medicolegal workload, and is reviewed against the primary sources cited throughout.
						Where a matter needs a radiological opinion rather than background, terms of instruction and
						imaging transfer guidance are set out on the expert witness page.
					</p>
					<div class="mt-7 flex flex-wrap justify-center gap-x-8 gap-y-2">
						<a href="/expert-witness" class="font-sans text-[0.8rem] font-medium text-slate-700 underline decoration-slate-300 underline-offset-4 hover:text-slate-900 hover:decoration-slate-600">Expert witness services</a>
						<a href="/about" class="font-sans text-[0.8rem] font-medium text-slate-700 underline decoration-slate-300 underline-offset-4 hover:text-slate-900 hover:decoration-slate-600">About the curator</a>
						<a href="/sitemap" class="font-sans text-[0.8rem] font-medium text-slate-700 underline decoration-slate-300 underline-offset-4 hover:text-slate-900 hover:decoration-slate-600">Site map</a>
						<a href="/contact" class="font-sans text-[0.8rem] font-medium text-slate-700 underline decoration-slate-300 underline-offset-4 hover:text-slate-900 hover:decoration-slate-600">Contact the secretariat</a>
					</div>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>
