---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_TITLE } from "../consts";
---

<BaseLayout
  title={`About | ${SITE_TITLE}`}
  description="Brief background of the curator."
>
  <main class="mx-auto max-w-3xl px-4 py-12">
    <header class="mb-8">
      <p class="text-sm uppercase tracking-wide opacity-60 mb-2">
        About this resource
      </p>
      <h1 class="text-3xl font-bold mb-3">Joseph El-Sheikha</h1>
      <p class="text-lg leading-relaxed">
        Consultant Radiologist at Hampshire Hospitals NHS Foundation Trust
        (Basingstoke, Winchester) (HHFT)
      </p>
    </header>

    <section class="mb-8">
      <h2 class="text-xl font-semibold mb-3">Degrees & Qualifications</h2>
      <ul class="list-disc pl-6 space-y-1 leading-relaxed mb-4">
        <li>
          <strong>MBChB</strong> — Bachelor of Medicine, Bachelor of Surgery, University
          of Manchester (2008)
        </li>
        <li>
          <strong>MD</strong> — Medical Doctorate, Hull York Medical School (2017)
        </li>
        <li>
          <strong>LLM</strong> — Healthcare Ethics and Law, University of Manchester
          (2017)
        </li>
        <li>
          <strong>Postgraduate Diploma</strong> in Research Training, Hull York Medical
          School (2014)
        </li>
        <li>
          <strong>Postgraduate Diploma</strong> in Clinical Education, RCPS Glasgow
          / ABP (2013)
        </li>
        <li>
          <strong>Postgraduate Certificate</strong> in Diagnostic Imaging, University
          of Leeds (2013)
        </li>
      </ul>

      <h3 class="text-lg font-semibold mb-2 opacity-90">
        Membership Examinations
      </h3>
      <ul class="list-disc pl-6 space-y-1 leading-relaxed">
        <li>
          <strong>FRCR</strong> — Fellow of the Royal College of Radiologists (2019)
        </li>
        <li>
          <strong>MRCS</strong> — Member of the Royal College of Surgeons of England
          (2011)
        </li>
        <li>
          <strong>USMLE</strong> — United States Medical Licensing Examination, ECFMG
          (2014)
        </li>
      </ul>
    </section>

    <section class="mb-8">
      <h2 class="text-xl font-semibold mb-3">Professional memberships</h2>
      <ul class="list-disc pl-6 space-y-1 leading-relaxed">
        <li>General Medical Council (GMC 7017101)</li>
        <li>Fellow, Royal College of Radiologists (FRCR)</li>
        <li>
          Member, British Society for Gastrointestinal and Abdominal Radiology
          (BSGAR)
        </li>
        <li>Member, European Society of Radiology (ESR)</li>
      </ul>
    </section>

    <section class="mb-8">
      <h2 class="text-xl font-semibold mb-3">Employment</h2>
      <ul class="list-disc pl-6 space-y-1 leading-relaxed">
        <li>
          <strong>Radiology Consultant</strong>, HHFT (Sept 2022–present)
        </li>
        <li>
          <strong>Peritoneal Malignancy Radiology Fellowship</strong>, PMI
          Basingstoke Hospital (2021–2022)
        </li>
        <li>
          <strong>Clinical Radiology Specialist Resident</strong>, John
          Radcliffe Hospital Oxford (2016–2021)
        </li>
        <li>
          <strong>Vascular Surgery Research Fellow</strong>, Hull Royal
          Infirmary (2012–2014)
        </li>
      </ul>
    </section>

    <section class="mb-8">
      <h2 class="text-xl font-semibold mb-3">Selected publications</h2>
      <ul class="list-disc pl-6 space-y-1 leading-relaxed">
        <li>
          The appendix “mucocoele” misnomer: radiological terminology of “likely
          appendix mucinous neoplasm” better reflects pathology finding — <em
            >Clinical Radiology</em
          >(2023)
        </li>
        <li>
          Rectal Venous Malformation Treated by Superior Rectal Artery
          Embolization — <em>Cardiovasc Intervent Radiol</em> (2019)
        </li>
        <li>
          Long-term outcomes of endovenous laser ablation and conventional
          surgery for great saphenous varicose veins — <em
            >British Journal of Surgery</em
          > (2018)
        </li>
        <li>
          A systematic review of the compression regimes used in randomised
          clinical trials following endovenous ablation — <em>Phlebology</em> (2016)
        </li>
      </ul>
    </section>
    <section class="mb-8">
      <h2 class="text-xl font-semibold mb-3">Current Roles</h2>
      <ul class="list-disc pl-6 space-y-1 leading-relaxed">
        <li>College Tutor - Wessex Deanery</li>
        Hepatobiliary Pancreas (HPB) Radiology Tutor<em>
          - NHS England South East Imaging Academy (SEIA)
        </em>
        <li>
          Gastrointestinal (GI) Radiology Tutor<em>
            - NHS England South East Imaging Academy (SEIA)
          </em>
        </li>
      </ul>
    </section>
  </main>
</BaseLayout>
