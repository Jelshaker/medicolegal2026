---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MedicalImageViewer from '../../components/MedicalImageViewer.astro';
import { getCollection } from 'astro:content';
import { SITE_TITLE, BLOG_CATEGORIES } from '../../consts';
import { formatDate, readingTime } from '../../lib/utils';
import { isoDate } from '../../lib/seo';

export const prerender = true;

export async function getStaticPaths() {
	const posts = await getCollection('recent-developments');
	return posts.map((post) => ({
		params: { slug: post.slug },
		props: { post },
	}));
}

const { post } = Astro.props as { post: Awaited<ReturnType<typeof getCollection<'recent-developments'>>>[number] };
const { Content } = await post.render();
const readMin = readingTime(post.body);
const categoryLabel = (id: string) => BLOG_CATEGORIES.find((c) => c.id === id)?.label ?? id;
---

<BaseLayout
	title={`${post.data.title} | ${SITE_TITLE}`}
	description={post.data.description}
	article={{
		headline: post.data.title,
		datePublished: isoDate(post.data.pubDate),
		dateModified: post.data.updatedDate ? isoDate(post.data.updatedDate) : undefined,
		section: categoryLabel(post.data.category),
	}}
>
	<!-- Article header -->
	<section class="border-b border-slate-300 bg-white py-14">
		<div class="container-page">
			<div class="doc text-center">
				<nav class="font-sans text-xs text-slate-500" aria-label="Breadcrumb">
					<ol class="flex items-center justify-center gap-2">
						<li><a href="/recent-developments" class="hover:text-slate-900 hover:underline hover:underline-offset-4">Recent Developments</a></li>
						<li aria-hidden="true">/</li>
						<li>{categoryLabel(post.data.category)}</li>
					</ol>
				</nav>
				<p class="meta-label mt-6">{categoryLabel(post.data.category)}</p>
				<h1 class="mt-3 font-serif text-3xl font-bold leading-tight text-slate-900 sm:text-4xl">{post.data.title}</h1>
				<p class="mx-auto mt-5 max-w-2xl font-serif text-[1.05rem] leading-relaxed text-slate-600">{post.data.description}</p>
				<div class="mt-6 flex flex-wrap items-baseline justify-center gap-x-5 gap-y-2 font-sans text-xs text-slate-500">
					<span>Published {formatDate(post.data.pubDate)}</span>
					<span>{readMin} min read</span>
					{post.data.anonymised && (
						<span class="border border-slate-300 px-2 py-0.5 text-[0.65rem] font-semibold uppercase tracking-[0.12em] text-slate-500">Anonymised</span>
					)}
				</div>
				<p class="mt-4 font-sans text-xs uppercase tracking-[0.1em] text-slate-400">
					{post.data.tags.join(" · ")}
				</p>
			</div>
		</div>
	</section>

	<!-- Body -->
	<article class="bg-white py-12">
		<div class="container-page">
			<div class="doc">
				{post.data.keyTakeaways && (
					<aside class="border-t border-slate-300 pt-3">
						<p class="meta-label mb-2">Key takeaways for the court / tribunal</p>
						<ol class="space-y-2 font-serif text-[0.925rem] leading-relaxed text-slate-600">
							{post.data.keyTakeaways.map((t, i) => (
								<li class="flex gap-3">
									<span class="shrink-0 font-sans text-[0.7rem] font-semibold tabular-nums tracking-[0.1em] text-slate-400">{i + 1}.</span>
									<span>{t}</span>
								</li>
							))}
						</ol>
					</aside>
				)}

				<div class="prose article-body mt-10 max-w-none">
					<Content />
				</div>

				{post.data.figures && post.data.figures.length > 0 && (
					<div class="mt-10 space-y-6">
						{post.data.figures.map((src, i) => (
							<MedicalImageViewer
								src={src}
								alt={`Anonymised figure ${i + 1}`}
								caption={`Anonymised reference figure ${i + 1} for this analysis`}
								modality="MRI / CT / X-ray"
							/>
						))}
					</div>
				)}

				<div class="mt-12 border-t border-slate-200 pt-4">
					<p class="font-serif text-sm italic leading-snug text-slate-600">
						{post.data.author}, Consultant Radiologist &amp; Medicolegal Expert Witness
					</p>
				</div>

				<div class="mt-8">
					<a href="/recent-developments" class="font-sans text-[0.8rem] font-medium text-slate-600 underline decoration-slate-300 underline-offset-4 hover:text-slate-900 hover:decoration-slate-600">&larr; All recent developments</a>
				</div>
			</div>
		</div>
	</article>

	<!-- Comments -->
	<section class="border-t border-slate-200 bg-paper py-14">
		<div class="container-page">
			<div class="doc">
				<p class="meta-label">Comments</p>
				<h2 class="mt-3 font-serif text-2xl font-bold text-slate-900">Join the discussion</h2>
				<form id="comment-form" class="mt-6 grid gap-4 border border-slate-300 bg-white p-5">
					<label class="block font-sans text-xs font-semibold uppercase tracking-[0.1em] text-slate-600">
						Name *
						<input name="author" type="text" required class="input-field mt-1.5" placeholder="Your name" />
					</label>
					<label class="block font-sans text-xs font-semibold uppercase tracking-[0.1em] text-slate-600">
						Comment *
						<textarea name="text" rows="3" required class="input-field mt-1.5" placeholder="Your comment (moderated)"></textarea>
					</label>
					<div class="flex items-center gap-3">
						<button type="submit" class="btn btn-primary" data-submit>Post comment</button>
						<span class="font-sans text-xs text-slate-500">Comments are stored via Cloudflare KV and moderated.</span>
					</div>
				</form>
				<div id="comment-list" class="mt-8 space-y-4" data-postid={post.slug}>
					<!-- populated client-side -->
				</div>
			</div>
		</div>
	</section>
</BaseLayout>

<script define:vars={{ postId: post.slug }}>
	const list = document.getElementById("comment-list") as HTMLElement | null;
	const form = document.getElementById("comment-form") as HTMLFormElement | null;

	function escapeHtml(s: string) {
		return s.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c] as string));
	}

	async function load() {
		if (!list) return;
		const res = await fetch(`/api/comments?postId=${encodeURIComponent(postId)}`);
		if (!res.ok) return;
		const comments = await res.json();
		list.innerHTML = comments.length
			? comments.map((c) => `
				<div class="rounded-2xl border border-slate-200 bg-white p-5">
					<div class="flex items-center justify-between text-sm">
						<span class="font-semibold text-navy-900">${escapeHtml(c.author)}</span>
						<span class="text-xs text-slate-500">${new Date(c.date).toLocaleDateString("en-GB")}</span>
					</div>
					<p class="mt-2 text-slate-600">${escapeHtml(c.text)}</p>
				</div>`).join("")
			: `<p class="text-sm text-slate-500">No comments yet. Be the first to join the discussion.</p>`;
	}

	form?.addEventListener("submit", async (e) => {
		e.preventDefault();
		const data = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
		const btn = form.querySelector("[data-submit]") as HTMLButtonElement | null;
		if (btn) { btn.disabled = true; btn.textContent = "Posting…"; }
		try {
			const res = await fetch("/api/comments", {
				method: "POST",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify({ postId, author: data.author, text: data.text }),
			});
			const json = await res.json();
			if (!res.ok) throw new Error(json.error || "Failed");
			form.reset();
			await load();
		} catch (err) {
			alert("There was a problem posting your comment.");
		} finally {
			if (btn) { btn.disabled = false; btn.textContent = "Post comment"; }
		}
	});

	load();
</script>
