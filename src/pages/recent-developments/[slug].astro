---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MedicalImageViewer from '../../components/MedicalImageViewer.astro';
import PageHero from '../../components/PageHero.astro';
import { getCollection } from 'astro:content';
import { SITE_TITLE, BLOG_CATEGORIES, PAGE_HERO_IMAGES } from '../../consts';
import { formatDate, readingTime } from '../../lib/utils';
import { isoDate } from '../../lib/seo';

export const prerender = true;

export async function getStaticPaths() {
	const posts = await getCollection('recent-developments');
	return posts.map((post) => ({
		params: { slug: post.slug },
		props: { post },
	}));
}

const { post } = Astro.props as { post: Awaited<ReturnType<typeof getCollection<'recent-developments'>>>[number] };
const { Content } = await post.render();
const readMin = readingTime(post.body);
const categoryLabel = (id: string) => BLOG_CATEGORIES.find((c) => c.id === id)?.label ?? id;
---

<BaseLayout
	title={`${post.data.title} | ${SITE_TITLE}`}
	description={post.data.description}
	article={{
		headline: post.data.title,
		datePublished: isoDate(post.data.pubDate),
		dateModified: post.data.updatedDate ? isoDate(post.data.updatedDate) : undefined,
		section: categoryLabel(post.data.category),
	}}
>
<!-- Article header with hero image -->
	<PageHero
		heroImage={PAGE_HERO_IMAGES["/recent-developments"]}
		title={post.data.title}
		description={post.data.description}
	>
		<nav class="mt-4" aria-label="Breadcrumb">
			<ol class="flex items-center justify-center gap-2 font-sans text-xs uppercase tracking-[0.14em] text-slate-400">
				<li><a href="/recent-developments" class="hover:text-slate-200 hover:underline">Recent Developments</a></li>
				<li aria-hidden="true">/</li>
				<li>{categoryLabel(post.data.category)}</li>
			</ol>
		</nav>
		<div class="mt-4 flex flex-wrap items-baseline justify-center gap-x-5 gap-y-2 text-slate-300/80">
			<span>Published {formatDate(post.data.pubDate)}</span>
			<span>{readMin} min read</span>
			{post.data.anonymised && (
				<span class="border border-slate-500/50 px-2 py-0.5 text-[0.65rem] font-semibold uppercase tracking-[0.12em] text-slate-400">Anonymised</span>
			)}
		</div>
		<p class="mt-3 font-sans text-xs uppercase tracking-[0.1em] text-slate-400">
			{post.data.tags.join(" · ")}
		</p>
	</PageHero>

	<!-- Body -->
	<article class="bg-white py-12">
		<div class="container-page">
			<div class="doc">
				{post.data.keyTakeaways && (
					<aside class="divider-strong pt-3">
						<p class="meta-label mb-2">Key takeaways for the court / tribunal</p>
						<ol class="list mt-0">
							{post.data.keyTakeaways.map((t, i) => (
								<li class="flex gap-3">
									<span class="shrink-0 font-sans text-[0.7rem] font-semibold tabular-nums tracking-[0.1em] text-slate-400">{i + 1}.</span>
									<span>{t}</span>
								</li>
							))}
						</ol>
					</aside>
				)}

				<div class="article-body mt-10">
					<Content />
				</div>

				{post.data.figures && post.data.figures.length > 0 && (
					<div class="mt-10 space-y-6">
						{post.data.figures.map((src, i) => (
							<MedicalImageViewer
								src={src}
								alt={`Anonymised figure ${i + 1}`}
								caption={`Anonymised reference figure ${i + 1} for this analysis`}
								modality="MRI / CT / X-ray"
							/>
						))}
					</div>
				)}

				<div class="mt-12 divider pt-4">
					<p class="font-serif text-sm italic leading-snug text-slate-600">
						{post.data.author}, Consultant Radiologist &amp; Medicolegal Expert Witness
					</p>
				</div>

				<div class="mt-8">
					<a href="/recent-developments" class="link-sm">&larr; All recent developments</a>
				</div>
			</div>
		</div>
	</article>

	<!-- Comments -->
	<section class="divider-below bg-paper py-14">
		<div class="container-page">
			<div class="doc">
				<p class="meta-label">Comments</p>
				<h2 class="sec-title">Join the discussion</h2>
				<form id="comment-form" class="mt-6 grid gap-4 border border-slate-300 bg-white p-5">
					<label class="form-label">
						Name *
						<input name="author" type="text" required class="input-field" placeholder="Your name" />
					</label>
					<label class="form-label">
						Comment *
						<textarea name="text" rows="3" required class="input-field" placeholder="Your comment (moderated)"></textarea>
					</label>
					<div class="flex items-center gap-3">
						<button type="submit" class="btn btn-primary" data-submit>Post comment</button>
						<span class="text-muted">Comments are stored via Cloudflare KV and moderated.</span>
					</div>
				</form>
				<div id="comment-list" class="mt-8 space-y-4" data-postid={post.slug}>
					<!-- populated client-side -->
				</div>
			</div>
		</div>
	</section>
</BaseLayout>

<script define:vars={{ postId: post.slug }}>
	const list = document.getElementById("comment-list") as HTMLElement | null;
	const form = document.getElementById("comment-form") as HTMLFormElement | null;

	function escapeHtml(s: string) {
		return s.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c] as string));
	}

	async function load() {
		if (!list) return;
		const res = await fetch(`/api/comments?postId=${encodeURIComponent(postId)}`);
		if (!res.ok) return;
		const comments = await res.json();
		list.innerHTML = comments.length
			? comments.map((c) => `
				<div class="border border-slate-200 bg-white p-5">
					<div class="flex items-center justify-between text-sm">
						<span class="font-semibold text-slate-800">${escapeHtml(c.author)}</span>
						<span class="text-xs text-slate-500">${new Date(c.date).toLocaleDateString("en-GB")}</span>
					</div>
					<p class="mt-2 text-slate-600">${escapeHtml(c.text)}</p>
				</div>`).join("")
			: `<p class="text-sm text-slate-500">No comments yet. Be the first to join the discussion.</p>`;
	}

	form?.addEventListener("submit", async (e) => {
		e.preventDefault();
		const data = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
		const btn = form.querySelector("[data-submit]") as HTMLButtonElement | null;
		if (btn) { btn.disabled = true; btn.textContent = "Posting…"; }
		try {
			const res = await fetch("/api/comments", {
				method: "POST",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify({ postId, author: data.author, text: data.text }),
			});
			const json = await res.json();
			if (!res.ok) throw new Error(json.error || "Failed");
			form.reset();
			await load();
		} catch (err) {
			alert("There was a problem posting your comment.");
		} finally {
			if (btn) { btn.disabled = false; btn.textContent = "Post comment"; }
		}
	});

	load();
</script>
