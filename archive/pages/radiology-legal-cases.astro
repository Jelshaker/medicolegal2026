---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import PageIntro from "../components/PageIntro.astro";
import Section from "../components/Section.astro";
import Callout from "../components/Callout.astro";
import Figure from "../components/Figure.astro";
import { PAGE_HERO_IMAGES } from "../consts";
---

<BaseLayout
  description="A concise digest of foundational pre-2010 medical negligence decisions establishing the legal principles governing clinical practice and diagnostic interpretation."
>
  <PageHero
    eyebrow="Foundational legal cases"
    description="Landmark pre-2010 judicial decisions establishing the legal standards of care, clinical judgment, and diagnostic interpretation."
    heroImage={PAGE_HERO_IMAGES["/radiology-legal-cases"] || undefined}
  />

  <PageIntro
    eyebrow="Case law"
    paragraphs={[
      "A selective digest of foundational pre-2010 judicial authorities that govern medical negligence and inform the legal assessment of radiological practice.",
      "These landmark appellate and House of Lords decisions establish the enduring legal tests for professional standard of care, logical peer review, and diagnostic evaluation.",
    ]}
    contents={[
      { href: "#bolam", label: "Bolam (1957)" },
      { href: "#whitehouse", label: "Whitehouse (1981)" },
      { href: "#bolitho", label: "Bolitho (1997)" },
      { href: "#penney", label: "Penney (2000)" },
      { href: "#themes", label: "Principles" },
    ]}
    audience="Written for radiologists, solicitors, barristers and expert witnesses."
    reviewed="October 2026"
  />

  <section class="band-paper">
    <div class="container-page min-w-0">
      <div class="doc min-w-0">
        <Figure
          src="/images/spine_CT.jpg"
          alt="Cross-sectional CT image of the spine"
          label="Plate 01"
          caption="The image is evidence, not the legal conclusion"
          subtitle="The court must determine what the original study showed before evaluating whether the report met the required legal standard."
          ratio="wide"
        />
      </div>
    </div>
  </section>

  <section class="band-white">
    <div class="container-page min-w-0 space-y-12">
      <Section
        id="bolam"
        index="01"
        eyebrow="Standard of care"
        title="Bolam v Friern Hospital Management Committee"
        citation="[1957] 1 WLR 582"
      >
        <p class="para">
          <strong>Issue:</strong> The legal test for determining the standard of care
          required of a professional exercising a skilled calling.
        </p>

        <p class="para">
          <strong>Facts:</strong> A patient suffered severe fractures during electroconvulsive
          therapy when relaxant drugs were not administered and no physical restraint
          was used, though a responsible body of medical opinion supported this practice
          at the time.
        </p>

        <div class="rule-quote">
          <p class="text-caption">
            <strong>Principle:</strong> a doctor is not negligent if they act in accordance
            with a practice accepted as proper by a responsible body of medical men
            skilled in that particular art.
          </p>
        </div>

        <div class="note-box">
          <p>
            <strong class="text-slate-800">Relevance:</strong>
            The foundational cornerstone for evaluating whether a radiologist's interpretation
            or failure to detect an abnormality falls below the accepted professional
            standard.
          </p>
        </div>
      </Section>

      <Section
        id="whitehouse"
        index="02"
        eyebrow="Clinical judgment"
        title="Whitehouse v Jordan"
        citation="[1981] 1 All ER 267 (HL)"
      >
        <p class="para">
          <strong>Issue:</strong> The legal distinction between a negligent act or
          omission and an error of clinical judgment.
        </p>

        <p class="para">
          <strong>Facts:</strong> Difficult forceps delivery resulted in severe neonatal
          asphyxia and brain damage. Allegations focused on the duration and force
          applied during traction.
        </p>

        <div class="rule-quote">
          <p class="text-caption">
            <strong>Principle:</strong> an error of judgment is not necessarily negligence.
            A distinction must be drawn between a professional exercising reasonable
            care who makes an incorrect evaluation, and a failure to exercise the
            required standard of care.
          </p>
        </div>

        <div class="note-box">
          <p>
            <strong class="text-slate-800">Relevance:</strong>
            Highly pertinent to radiological reporting, where visual interpretation
            often involves nuanced perception and grey-scale differentiation rather
            than absolute binary answers.
          </p>
        </div>
      </Section>

      <Section
        id="bolitho"
        index="03"
        eyebrow="Logical scrutiny"
        title="Bolitho v City and Hackney Health Authority"
        citation="[1998] AC 232 (HL)"
      >
        <p class="para">
          <strong>Issue:</strong> Whether the court can reject expert medical opinion
          advanced under the <em>Bolam</em> test if that opinion is shown to be illogical.
        </p>

        <p class="para">
          <strong>Facts:</strong> A two-year-old boy suffering from croup experienced
          respiratory arrests and suffered catastrophic brain damage after a doctor
          failed to attend to intubate.
        </p>

        <div class="rule-quote">
          <p class="text-caption">
            <strong>Principle:</strong> the court must be satisfied that the expert
            opinion relied upon has a logical basis. If professional opinion cannot
            withstand logical analysis, the judge is entitled to hold that it is not
            responsible or responsible in law.
          </p>
        </div>

        <div class="note-box">
          <p>
            <strong class="text-slate-800">Relevance:</strong>
            Ensures that retrospective expert assertions in radiology negligence claims
            (e.g., claiming a subtle nodule was "obviously visible") must be logically
            defensible rather than mere hindsight assertion.
          </p>
        </div>
      </Section>

      <Section
        id="penney"
        index="04"
        eyebrow="Diagnostic interpretation"
        title="Penney v East Kent Health Authority"
        citation="[2000] Lloyd's Rep Med 41 (CA)"
      >
        <p class="para">
          <strong>Issue:</strong> The standard applicable to false-negative screening
          and diagnostic reporting.
        </p>

        <p class="para">
          <strong>Facts:</strong> Cervical cytology slides were reported as negative
          when subsequent review revealed abnormalities that should have prompted
          referral for treatment.
        </p>

        <div class="rule-quote">
          <p class="text-caption">
            <strong>Principle:</strong> the court must determine what the material
            actually showed. Evidence that other practitioners might also have issued
            a negative report is not conclusive where the material demonstrates abnormalities
            requiring action.
          </p>
        </div>

        <div class="note-box">
          <p>
            <strong class="text-slate-800">Relevance:</strong>
            Directly analogous to radiological image review, establishing that a missed
            finding cannot be excused purely by citing inter-observer variability
            if the feature is demonstrably present on the study.
          </p>
        </div>
      </Section>

      <Section
        id="themes"
        index="05"
        eyebrow="Synthesis"
        title="Principles Emerging from Foundational Case Law"
      >
        <div class="entry-list mt-0">
          <div class="entry">
            <h3 class="entry-title">Objective baseline of image content</h3>
            <p class="para">
              The court first establishes what was objectively visible on the
              contemporaneous imaging before evaluating whether the reporting
              standard was met.
            </p>
          </div>

          <div class="entry">
            <h3 class="entry-title">Logical defence of opinion</h3>
            <p class="para">
              Under <em>Bolitho</em>, professional opinion supporting a missed
              or deferred finding must withstand logical scrutiny rather than
              relying on unexamined custom.
            </p>
          </div>

          <div class="entry">
            <h3 class="entry-title">Judgment versus breach</h3>
            <p class="para">
              As established in <em>Whitehouse</em>, difficult diagnostic grey
              areas involve legitimate clinical judgment which does not equate
              to professional negligence.
            </p>
          </div>

          <div class="entry">
            <h3 class="entry-title">Guard against hindsight bias</h3>
            <p class="para">
              Assessments must be made based on knowledge and circumstances
              contemporaneous with the examination, avoiding contamination by
              subsequent clinical outcomes.
            </p>
          </div>
        </div>
      </Section>
    </div>
  </section>
</BaseLayout>
