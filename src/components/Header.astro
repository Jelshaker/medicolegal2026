---
import { NAVIGATION_LINKS, PRACTITIONER } from "../consts";

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
	href === "/" ? pathname === "/" : pathname.startsWith(href);
---

<header class="sticky top-0 z-50 border-b border-slate-200/70 bg-white/85 backdrop-blur-md dark:border-navy-800 dark:bg-navy-950/85">
	<div class="container-page flex h-16 items-center justify-between gap-4 md:h-[4.5rem]">
		<a href="/" class="group flex items-center gap-2.5" aria-label={`${PRACTITIONER.shortName} — home`}>
			<span class="flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-br from-navy-800 to-navy-950 text-white shadow-sm ring-1 ring-white/10">
				<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
					<path d="M2.5 12h3.2l2.2-5.5 3.6 11 2.6-6.5h1.9" />
					<path d="M17.5 12h2.6v3.1" opacity=".6" />
				</svg>
			</span>
			<span class="leading-tight">
				<span class="block text-[0.95rem] font-bold tracking-tight text-navy-900 dark:text-white">
					{PRACTITIONER.shortName}
				</span>
				<span class="block text-[0.66rem] font-semibold uppercase tracking-[0.16em] text-teal-600 dark:text-teal-400">
					Consultant Radiologist · Medico-legal
				</span>
			</span>
		</a>

		<nav class="hidden items-center gap-1 lg:flex" aria-label="Primary">
			{
				NAVIGATION_LINKS.map((link) => (
					<a
						href={link.href}
						class:list={[
							"rounded-lg px-3.5 py-2 text-sm font-semibold transition-colors",
							isActive(link.href)
								? "bg-teal-50 text-teal-700 dark:bg-navy-800 dark:text-teal-300"
								: "text-slate-600 hover:bg-slate-100 hover:text-navy-900 dark:text-slate-300 dark:hover:bg-navy-800 dark:hover:text-white",
						]}
					>
						{link.label}
					</a>
				))
			}
		</nav>

		<div class="flex items-center gap-2.5">
			<button
				id="theme-toggle"
				type="button"
				class="flex h-10 w-10 items-center justify-center rounded-xl border border-slate-200 text-slate-600 transition-colors hover:border-teal-500 hover:text-teal-600 dark:border-navy-700 dark:text-slate-300"
				aria-label="Toggle dark mode"
			>
				<svg id="icon-moon" class="hidden h-4.5 w-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
					<path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z" />
				</svg>
				<svg id="icon-sun" class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<circle cx="12" cy="12" r="4" />
					<path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4" />
				</svg>
			</button>

			<a href="/login" class="btn btn-navy hidden !px-4 !py-2.5 text-sm sm:inline-flex">
				<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<rect x="3" y="11" width="18" height="11" rx="2" />
					<path d="M7 11V7a5 5 0 0 1 10 0v4" />
				</svg>
				Secure Login
			</a>

			<button
				id="menu-toggle"
				type="button"
				class="flex h-10 w-10 items-center justify-center rounded-xl border border-slate-200 text-slate-700 lg:hidden dark:border-navy-700 dark:text-slate-200"
				aria-label="Open menu"
				aria-expanded="false"
				aria-controls="mobile-menu"
			>
				<svg id="icon-burger" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
					<path d="M4 7h16M4 12h16M4 17h16" />
				</svg>
				<svg id="icon-close" class="hidden h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
					<path d="M6 6l12 12M18 6 6 18" />
				</svg>
			</button>
		</div>
	</div>

	<nav
		id="mobile-menu"
		class="hidden border-t border-slate-200 bg-white px-4 pb-4 pt-2 lg:hidden dark:border-navy-800 dark:bg-navy-950"
		aria-label="Mobile"
	>
		<ul class="flex flex-col">
			{
				NAVIGATION_LINKS.map((link) => (
					<li>
						<a
							href={link.href}
							class:list={[
								"block rounded-lg px-3 py-3 text-[0.95rem] font-semibold",
								isActive(link.href)
									? "bg-teal-50 text-teal-700 dark:bg-navy-800 dark:text-teal-300"
									: "text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-navy-800",
							]}
						>
							{link.label}
						</a>
					</li>
				))
			}
			<li class="mt-2 border-t border-slate-100 pt-3 dark:border-navy-800">
				<a href="/login" class="btn btn-navy w-full">
					<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<rect x="3" y="11" width="18" height="11" rx="2" />
						<path d="M7 11V7a5 5 0 0 1 10 0v4" />
					</svg>
					Secure Client Login
				</a>
			</li>
		</ul>
	</nav>
<script>
	const menuToggle = document.getElementById("menu-toggle");
	const mobileMenu = document.getElementById("mobile-menu");
	const iconBurger = document.getElementById("icon-burger");
	const iconClose = document.getElementById("icon-close");

	menuToggle?.addEventListener("click", () => {
		const open = mobileMenu?.classList.toggle("hidden") !== true;
		menuToggle.setAttribute("aria-expanded", String(open));
		iconBurger?.classList.toggle("hidden", open);
		iconClose?.classList.toggle("hidden", !open);
	});

	if (mobileMenu) {
		mobileMenu.querySelectorAll("a").forEach((a) =>
			a.addEventListener("click", () => {
				mobileMenu.classList.add("hidden");
				iconBurger?.classList.remove("hidden");
				iconClose?.classList.add("hidden");
			}),
		);
	}

	const toggleBtn = document.getElementById("theme-toggle");
	const iconMoon = document.getElementById("icon-moon");
	const iconSun = document.getElementById("icon-sun");
	const syncIcons = () => {
		const dark = document.documentElement.classList.contains("dark");
		iconMoon?.classList.toggle("hidden", !dark);
		iconSun?.classList.toggle("hidden", dark);
	};
	syncIcons();
	toggleBtn?.addEventListener("click", () => {
		const dark = document.documentElement.classList.toggle("dark");
		try {
			localStorage.setItem("ml-theme", dark ? "dark" : "light");
		} catch {
			/* private mode */
		}
		syncIcons();
	});
</script>
</header>