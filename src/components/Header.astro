---
import { LOGIN_BUTTON_TEXT, NAVIGATION_LINKS, PRACTITIONER, SITE_BRAND_SUBTITLE, SITE_TITLE } from "../consts";

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
    href === "/" ? pathname === "/" : pathname.startsWith(href);

const navLinkClass = (href: string) =>
    isActive(href)
        ? "nav-link nav-link-active"
        : "nav-link nav-link-inactive";
---

<header>
    <!-- Full-width background bar: sticky, white, bottom border, z-index 50.
         The inner container keeps content centred; the right group breaks out to
         the viewport edge so login and burger sit flush far right. -->
    <div class="sticky-bar">
        <div class="header-bar flex items-center">
            <!-- Centre: logo + nav links — kept inside the content container -->
            <div class="container-page row-lg flex items-center flex-1">
                <div class="flex items-center gap-x-6">
                    <!-- Logo -->
                    <a href="/" class="group flex shrink-0 items-center gap-3" aria-label={`${SITE_TITLE} — home`}>
                        <img
                            src="/logo.png"
                            alt={`${SITE_TITLE} logo`}
                            width="512"
                            height="512"
                            class="header-logo"
                            loading="eager"
                            decoding="async"
                        />
                        <span>
                            <span class="brand-name">
                                {PRACTITIONER.shortName}
                            </span>
                            <span class="meta-label mt-0.5 block !text-[0.62rem]">{SITE_BRAND_SUBTITLE}</span>
                        </span>
                    </a>

                    <!-- Desktop nav — hidden on mobile, sits next to logo on desktop -->
                    <nav class="header-nav hidden lg:flex" aria-label="Primary">
                        <div class="flex items-center gap-x-6">
                            {
                                NAVIGATION_LINKS.map((link) => (
                                    <a
                                        href={link.href}
                                        class:list={[navLinkClass(link.href)]}
                                    >
                                        {link.label}
                                    </a>
                                ))
                            }
                        </div>
                    </nav>
                </div>
            </div>

            <!-- Right group: login (desktop only) + mobile toggle — sits outside container, fixed to viewport right -->
            <div class="shrink-0 flex items-center gap-x-4 pr-6">
                <!-- Secure Login — desktop only; moved into mobile drawer below to avoid overlap -->
                <a href="/login" class="btn btn-ghost shrink-0 header-login hidden lg:inline-flex">{LOGIN_BUTTON_TEXT}</a>

                <!-- Desktop divider — hidden on mobile -->
                <div class="vrule hidden sm:block" aria-hidden="true"></div>

                <!-- Mobile menu toggle — visible on mobile, hidden on desktop -->
                <button
                    id="menu-toggle"
                    type="button"
                    class="header-toggle block lg:hidden"
                    aria-label="Open menu"
                    aria-expanded="false"
                    aria-controls="mobile-menu"
                >
                    <svg id="icon-burger" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <path d="M4 7h16M4 12h16M4 17h16" />
                    </svg>
                    <svg id="icon-close" class="hidden h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <path d="M6 6l12 12M18 6 6 18" />
                    </svg>
                </button>
            </div>
        </div>
    </div>

    <!-- Mobile Navigation Drawer -->
    <div
        id="mobile-menu"
        class="hidden menu-mobile mobile-menu-drawer"
        aria-label="Mobile"
    >
        <ul class="flex flex-col text-right">
            {
                NAVIGATION_LINKS.map((link) => (
                    <li class="border-b border-slate-100 last:border-b-0">
                        <a
                            href={link.href}
                            class:list={[
                                isActive(link.href) ? "nav-mobile-active" : "nav-mobile",
                            ]}
                        >
                            {link.label}
                        </a>
                    </li>
                ))
            }
            <!-- Mobile login — inside drawer so it never overlaps the hamburger -->
            <div class="border-t border-slate-100 p-3">
                <a href="/login" class="btn btn-ghost header-login-mobile flex w-full">{LOGIN_BUTTON_TEXT}</a>
            </div>
        </ul>
    </div>

<style>
    .header-bar {
        height: 4rem;
    }
    @media (min-width: 768px) {
        .header-bar {
            height: 4.75rem;
        }
    }
    .header-logo {
        height: 2.75rem;
        width: 2.75rem;
    }
    @media (min-width: 768px) {
        .header-logo {
            height: 3rem;
            width: 3rem;
        }
    }
    .header-nav {
        display: none;
    }
    @media (min-width: 1024px) {
        .header-nav {
            display: flex;
        }
    }
    .header-toggle {
        display: flex;
        height: 2.5rem;
        width: 2.5rem;
        align-items: center;
        justify-content: center;
        border: 1px solid #cbd5e1;
        color: #334155;
        transition: border-color 0.15s ease, color 0.15s ease;
    }
    .header-toggle:hover {
        border-color: #0f172a;
        color: #0f172a;
    }
    @media (min-width: 1024px) {
        .header-toggle {
            display: none !important;
        }
    }
    .header-login,
    .header-login-mobile {
        font-size: 0.75rem;
        padding: 0.5rem 1rem !important;
    }
    .header-login-mobile {
        display: inline-flex;
    }
    @media (min-width: 1024px) {
        .header-login-mobile {
            display: none;
        }
    }

    /* Narrow dropdown menu — positioned under the hamburger button on the right.
       Uses min() so it caps at 20rem on wide screens but shrinks to fit narrow viewports. */
    .mobile-menu-drawer {
        position: absolute;
        top: 100%;
        right: 0;
        width: min(20rem, calc(100vw - 1.5rem));
        z-index: 60;
    }
</style>
</header>

<script>
    function openMenu() {
        const mobileMenu = document.getElementById("mobile-menu");
        const iconBurger = document.getElementById("icon-burger");
        const iconClose = document.getElementById("icon-close");
        const toggle = document.getElementById("menu-toggle");
        if (!mobileMenu) return;
        mobileMenu.classList.remove("hidden");
        toggle?.setAttribute("aria-expanded", "true");
        iconBurger?.classList.add("hidden");
        iconClose?.classList.remove("hidden");
    }

    function closeMenu() {
        const mobileMenu = document.getElementById("mobile-menu");
        const iconBurger = document.getElementById("icon-burger");
        const iconClose = document.getElementById("icon-close");
        const toggle = document.getElementById("menu-toggle");
        if (!mobileMenu) return;
        mobileMenu.classList.add("hidden");
        toggle?.setAttribute("aria-expanded", "false");
        iconBurger?.classList.remove("hidden");
        iconClose?.classList.add("hidden");
    }

    function toggleMenu() {
        const mobileMenu = document.getElementById("mobile-menu");
        if (!mobileMenu) return;
        if (mobileMenu.classList.contains("hidden")) {
            openMenu();
        } else {
            closeMenu();
        }
    }

    // Toggle open/close when clicking the mobile menu button
    document.addEventListener("click", (e) => {
        const toggle = e.target.closest("#menu-toggle");
        if (!toggle) return;
        e.preventDefault();
        toggleMenu();
    });

    // Close mobile menu when a nav link inside it is clicked.
    document.addEventListener("click", (e) => {
        const link = e.target.closest("#mobile-menu a");
        if (!link) return;
        closeMenu();
    });

    // Close mobile menu when clicking anywhere outside the menu area
    document.addEventListener("click", (e) => {
        const mobileMenu = document.getElementById("mobile-menu");
        const toggle = document.getElementById("menu-toggle");
        if (!mobileMenu || !toggle) return;
        if (mobileMenu.classList.contains("hidden")) return;
        if (!mobileMenu.contains(e.target) && !toggle.contains(e.target)) {
            closeMenu();
        }
    });
</script>
