---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE, DEMO_PORTAL_ACCOUNT } from '../consts';
---

<BaseLayout
	title={`Secure Login | ${SITE_TITLE}`}
	description="Professional portal login for solicitors, barristers and referrers to access secure correspondence and case imaging correspondence."
	noindex
>
	<section class="bg-paper py-20">
		<div class="container-page max-w-md">
			<div class="border border-slate-300 bg-white p-8">
				<div>
					<h1 class="font-serif text-xl font-bold text-slate-900">Secure Login</h1>
					<p class="mt-1 font-sans text-xs uppercase tracking-[0.12em] text-slate-500">Case correspondence &amp; imaging portal</p>
				</div>

				<p class="mt-5 font-serif text-sm leading-relaxed text-slate-600">
					Professional referrers and instructing parties can sign in to access secure
					correspondence and case updates. Access is issued by the secretariat.
				</p>

				<form id="login-form" class="mt-6 grid gap-4">
					<label class="form-label">
						Email
						<input name="email" type="email" required autocomplete="username" class="input-field" placeholder="you@firm.co.uk" />
					</label>
					<label class="form-label">
						Password
						<input name="password" type="password" required autocomplete="current-password" class="input-field" placeholder="••••••••" />
					</label>
					<button type="submit" class="btn btn-primary w-full" data-submit>Sign in</button>
				</form>

				<div class="mt-6 border-t border-slate-200 pt-4 font-sans text-xs leading-relaxed text-slate-500">
					<p class="font-semibold text-slate-600">Demo access (replace with a real provider in production)</p>
					<p class="mt-1">Email: <code>{DEMO_PORTAL_ACCOUNT.email}</code><br />Password: <code>{DEMO_PORTAL_ACCOUNT.password}</code></p>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>

<script>
	const form = document.getElementById("login-form") as HTMLFormElement | null;
	if (form) {
		form.addEventListener("submit", async (e) => {
			e.preventDefault();
			const data = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
			const btn = form.querySelector("[data-submit]") as HTMLButtonElement | null;
			if (btn) { btn.disabled = true; btn.textContent = "Signing in…"; }
			try {
				const res = await fetch("/api/login", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify(data),
				});
				const json = await res.json();
				if (!res.ok) throw new Error(json.error || "Login failed");
				alert("Signed in successfully.");
			} catch (err) {
				alert("Invalid credentials. Please try again or contact the secretariat.");
			} finally {
				if (btn) { btn.disabled = false; btn.textContent = "Sign in"; }
			}
		});
	}
</script>