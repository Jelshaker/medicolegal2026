---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import PageIntro from '../../components/PageIntro.astro';
import { getCollection } from 'astro:content';
import { formatDateShort } from '../../lib/utils';
import { PAGE_HERO_IMAGES } from '../../consts';

export const prerender = true;

const categories = {
    all: {
        label: 'All',
        color: '#94a3b8',
    },
    'clinical-negligence': {
        label: 'Clinical Negligence',
        color: '#8d7a9a',
    },
    'diagnostic-error': {
        label: 'Diagnostic Error',
        color: '#b8935a',
    },
    'radiology-imaging': {
        label: 'Radiology & Imaging',
        color: '#7a9a8d',
    },
    'primary-care': {
        label: 'Primary Care',
        color: '#a07a8d',
    },
    causation: {
        label: 'Causation',
        color: '#a86b6b',
    },
    'standard-of-care': {
        label: 'Standard of Care',
        color: '#7c9a6e',
    },
    'expert-evidence': {
        label: 'Expert Evidence',
        color: '#7a8da0',
    },
    obstetrics: {
        label: 'Obstetrics',
        color: '#8d9a7a',
    },
    mri: {
        label: 'MRI',
        color: '#7a9a8d',
    },
    'emergency-imaging': {
        label: 'Emergency Imaging',
        color: '#a07a8d',
    },
    'incidental-findings': {
        label: 'Incidental Findings',
        color: '#b8935a',
    },
    screening: {
        label: 'Screening',
        color: '#8d7a9a',
    },
    'radiology-requests': {
        label: 'Radiology Requests',
        color: '#7c9a6e',
    },
    'judicial-review': {
        label: 'Judicial Review',
        color: '#9a8d7a',
    },
    'surgical-negligence': {
        label: 'Surgical Negligence',
        color: '#a86b6b',
    },
    'non-medical': {
        label: 'Non Medical',
        color: '#9a7a8d',
    },
    xr: {
        label: 'XR',
        color: '#b8935a',
    },
    ct: {
        label: 'CT',
        color: '#7a9a8d',
    },
    ultrasound: {
        label: 'Ultrasound',
        color: '#a07a8d',
    },
    mammography: {
        label: 'Mammography',
        color: '#7c9a6e',
    },
} as const;

type Category = keyof typeof categories;

function categoryLabel(category: string): string {
    return categories[category as Category]?.label ?? category;
}

function categoryColor(category: string): string {
    return categories[category as Category]?.color ?? '#94a3b8';
}

function slugifyTag(tag: string): string {
    return tag.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
}

function normalizeCategory(category: string): string {
    return category.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
}

const allPosts = (await getCollection('recent-developments')).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const usedCategories = Object.entries(categories);
---

<BaseLayout
    title="Recent Developments | Radiology & Medicolegal Law"
    description="Concise commentary on recent developments in radiology, clinical negligence, case law, regulation and expert practice."
>
    <PageHero
        eyebrow="Commentary"
        title="Recent Developments"
        description="Concise analysis of recent developments in radiology and medicolegal practice."
        heroImage={PAGE_HERO_IMAGES['/recent-developments'] || undefined}
        compact
    />

    <PageIntro
        eyebrow="Recent developments"
        paragraphs={[
            'Short commentary on cases, professional standards and clinical issues with direct relevance to radiologists and legal practitioners.',
            'Each article identifies the radiological issue, the applicable legal or professional principle and its practical significance.'
        ]}
        contents={[
            { href: '#latest-commentary', label: 'Latest commentary' },
            { href: '#browse-by-subject', label: 'Browse by subject' },
        ]}
        audience="For radiologists, solicitors, barristers, insurers and expert witnesses."
        reviewed="October 2026"
    />

    <section class="band">
        <div class="container-page">
            <div
                id="browse-by-subject"
                class="doc scroll-mt-24"
            >
                <div class="sec">
                    <p class="meta-label">Filter</p>
                    <h2 class="sec-title">Browse by Subject</h2>

                    <p
                        id="blog-count"
                        class="mt-3 text-muted-alt"
                        aria-live="polite"
                    >
                        Showing all {allPosts.length} articles
                    </p>
                </div>

                <div
                    id="blog-filters"
                    class="mt-4 flex flex-wrap gap-2"
                    aria-label="Filter articles by subject"
                >
                    {usedCategories.map(([id, category]) => (
                        <button
                            type="button"
                            class="chip cursor-pointer transition-colors hover:border-slate-600"
                            data-category={id}
                            style={`--marker-color: ${category.color}`}
                            aria-pressed="false"
                        >
                            {category.label}
                        </button>
                    ))}
                </div>
            </div>

            <div
                id="latest-commentary"
                class="doc mt-8 scroll-mt-24"
            >
                <div class="sec">
                    <p class="meta-label">Latest</p>
                    <h2 class="sec-title">Latest Commentary</h2>

                    <p class="standfirst">
                        Newest first. Each article is a concise analysis rather than
                        a substitute for the judgment, guidance or primary source.
                    </p>
                </div>

                <div
                    id="blog-grid"
                    class="entry-list-ruled mt-8"
                >
                    <figure class="figure mt-0">
                        <div class="figure-frame">
                            <div class="relative aspect-[5/1] overflow-hidden">
                                <img
                                    src="/images/pexels-shvetsa-4226205.jpg"
                                    alt="Radiology image"
                                    class="h-full w-full object-cover"
                                />
                            </div>
                        </div>
                    </figure>
                    {allPosts.map((post) => {
                        const postTags = post.data.tags;
                        const firstTagSlug = slugifyTag(postTags[0]);
                        const categorySlug = post.data.category as string;
                        return (
                            <article
                                class="blog-card py-5"
                                data-tags={postTags.map(t => slugifyTag(t)).join(' ')}
                                style={`--marker-color: ${categoryColor(firstTagSlug)}`}
                            >
                                <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
                                    <div class="flex items-center gap-2">
                                        <span
                                            class="sec-marker"
                                            aria-hidden="true"
                                        ></span>

                                        <span class="text-muted-alt">
                                            {categoryLabel(categorySlug)}
                                        </span>
                                    </div>

                                    <span class="ml-2">
                                        <a
                                            href={`/recent-developments/?category=${firstTagSlug}`}
                                            class="text-sm font-sans text-muted-alt hover:text-slate-700 underline underline-offset-2"
                                        >
                                            {categoryLabel(firstTagSlug)}
                                        </a>
                                    </span>

                                    <time
                                        class="text-muted-light ml-auto"
                                        datetime={post.data.pubDate.toISOString()}
                                    >
                                        {formatDateShort(post.data.pubDate)}
                                    </time>
                                </div>

                                <h3 class="mt-2 font-serif text-lg font-bold leading-snug text-slate-900">
                                    <a href={`/recent-developments/${post.slug}`}>{post.data.title}</a>
                                </h3>

                                <p class="para-sm">
                                    {post.data.description}
                                </p>

                                <p class="mt-3 text-sm">
                                    <a href={`/recent-developments/${post.slug}`}>Read analysis →</a>
                                </p>
                            </article>
                        );
                    })}
                </div>

                <p
                    id="blog-empty"
                    class="mt-8 hidden text-sm text-slate-500"
                >
                    No articles are currently available in this category.
                </p>
            </div>
        </div>
    </section>
</BaseLayout>

<script>
    function slugifyTag(tag) {
        return tag.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
    }

    function normalizeCategory(category) {
        return category.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
    }

    const filters = document.getElementById('blog-filters');
    const grid = document.getElementById('blog-grid');
    const count = document.getElementById('blog-count');
    const emptyMessage = document.getElementById('blog-empty');

    const cards = Array.from(
        grid?.querySelectorAll<HTMLElement>('.blog-card') ?? []
    );

    function applyFilter(category: string): void {
        filters
            ?.querySelectorAll<HTMLButtonElement>('[data-category]')
            .forEach((button) => {
                const active = button.dataset.category === category;

                button.classList.toggle('is-active', active);
                button.setAttribute(
                    'aria-pressed',
                    active ? 'true' : 'false'
                );
            });

        let visible = 0;

        const normalizedCategory = normalizeCategory(category);

        cards.forEach((card) => {
            const cardTags = card.dataset.tags
                ? card.dataset.tags.split(' ').map(slugifyTag)
                : [];

            const matches =
                category === 'all' ||
                cardTags.includes(normalizedCategory);

            card.hidden = !matches;

            if (matches) {
                visible += 1;
            }
        });

        if (count) {
            count.textContent =
                category === 'all'
                    ? `Showing all ${cards.length} articles`
                    : `Showing ${visible} of ${cards.length} articles`;
        }

        emptyMessage?.classList.toggle('hidden', visible > 0);
    }

    filters?.addEventListener('click', (event) => {
        const target = event.target as HTMLElement;

        const button = target.closest<HTMLButtonElement>(
            '[data-category]'
        );

        if (!button) return;

        applyFilter(button.dataset.category ?? 'all');
    });

    applyFilter('all');

    // Activate filter from URL ?category= param (e.g. when clicking a tag link)
    const params = new URLSearchParams(window.location.search);
    const category = params.get('category');
    if (category) {
        applyFilter(category);
        // Clean the URL so it doesn't persist on subsequent navigation
        const url = new URL(window.location.href);
        url.searchParams.delete('category');
        window.history.replaceState({}, '', url.toString());
    }
</script>