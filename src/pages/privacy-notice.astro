---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import PageIntro from "../components/PageIntro.astro";
import Section from "../components/Section.astro";
import Callout from "../components/Callout.astro";

export const prerender = true;

const contactEmail = "enquiries@medicolegal.org";
---

<BaseLayout
    title="Privacy notice | Radiology & Medicolegal Law"
    description="How this website collects, uses and protects personal information."
>
    <PageHero
        eyebrow="Your information"
        title="Privacy Notice"
        description="How personal information is collected, used and protected when you use this website."
    />

    <br><br>

    <PageIntro
        eyebrow="Privacy"
        paragraphs={[
            "No account is required to read this resource. Limited technical information is processed when the site is accessed, and further information is collected only if you contact the site or accept optional analytics.",
            "This notice explains how that information is handled under the UK GDPR and the Data Protection Act 2018."
        ]}
        contents={[
            { href: "#controller", label: "Controller" },
            { href: "#information", label: "Information collected" },
            { href: "#use", label: "How it is used" },
            { href: "#sharing", label: "Sharing and transfers" },
            { href: "#retention", label: "Retention" },
            { href: "#rights", label: "Your rights" },
        ]}
        reviewed="October 2026"
    />

    <br><br>

    <section class="band">
        <div class="container-page">
            <div class="doc space-y-14">

                <Section
                    id="controller"
                    index="01"
                    eyebrow="Controller"
                    title="Who is responsible"
                >
                    <p class="para">
                        The controller for information processed through this website is
                        <strong> Dr Joseph El-Sheikha, Consultant Radiologist</strong>.
                    </p>

                    <p class="para-sm">
                        Privacy enquiries may be sent to
                        {" "}
                        <a href={`mailto:${contactEmail}`} class="link">
                            {contactEmail}
                        </a>.
                    </p>
                </Section>

                <Section
                    id="information"
                    index="02"
                    eyebrow="Information collected"
                    title="What information is collected"
                >
                    <div class="entry-list-ruled">
                        <div class="entry">
                            <h3 class="entry-title">Website use</h3>
                            <p class="para-sm">
                                The hosting and security services may process limited technical
                                information, including IP address, browser information, requested
                                pages and security events.
                            </p>
                        </div>

                        <div class="entry">
                            <h3 class="entry-title">Enquiries</h3>
                            <p class="para-sm">
                                If you contact the site, your name, contact details and the
                                contents of your message will be processed.
                            </p>
                        </div>

                        <div class="entry">
                            <h3 class="entry-title">Optional analytics</h3>
                            <p class="para-sm">
                                If you accept analytics cookies, information about site use is
                                collected to help improve the resource. Analytics remains
                                disabled if you decline or make no choice.
                            </p>
                        </div>
                    </div>

                    <Callout tone="limit" title="Do not send patient information">
                        <p>
                            Please do not submit patient names, dates of birth, NHS numbers,
                            medical records, diagnostic images or other identifiable clinical
                            information through the public enquiry form or ordinary email.
                            Initial case enquiries should be anonymised.
                        </p>
                    </Callout>
                </Section>

                <Section
                    id="use"
                    index="03"
                    eyebrow="Purpose"
                    title="How information is used"
                >
                    <ul class="list">
                        <li>To operate, secure and maintain the website.</li>
                        <li>To respond to enquiries.</li>
                        <li>To consider a prospective professional instruction.</li>
                        <li>To understand site use where analytics consent has been given.</li>
                        <li>To meet applicable legal and professional obligations.</li>
                    </ul>

                    <p class="para-sm">
                        Website security and general correspondence are processed on the basis
                        of legitimate interests. Information needed to consider or perform an
                        instruction may be processed for contractual, legal or legitimate-interest
                        purposes. Optional analytics relies on consent.
                    </p>

                    <p class="para-sm">
                        Where health information is necessary for a legal claim, it may be
                        processed under the legal-claims condition in Article 9(2)(f) of the UK
                        GDPR. An appropriate secure transfer method will be provided before
                        identifiable case material is accepted.
                    </p>
                </Section>

                <Section
                    id="sharing"
                    index="04"
                    eyebrow="Recipients"
                    title="Sharing and international transfers"
                >
                    <p class="para">
                        Information may be processed by providers supporting hosting, security,
                        email and consented analytics. It may also be disclosed where necessary
                        to professional advisers, insurers, regulators, courts or public
                        authorities.
                    </p>

                    <p class="para-sm">
                        Personal information is not sold or used for third-party advertising.
                        Where a supplier processes information outside the United Kingdom,
                        an applicable adequacy decision or other lawful safeguard is used.
                    </p>
                </Section>

                       id="retention"
                    index="05"
                    eyebrow="Retention"
                    title="How long information is kept"
                >
                    <ul class="list">
                        <li>
                            <strong>General enquiries:</strong> normally for no more than
                            12 months after the last substantive contact.
                        </li>
                        <li>
                            <strong>Professional instructions:</strong> for the period required
                            by the engagement, professional obligations and applicable law.
                        </li>
                        <li>
                            <strong>Technical and security records:</strong> only for as long
                            as reasonably required for operation and security.
                        </li>
                        <li>
                            <strong>Analytics:</strong> for the period stated in the
                            /cookie-policy cookie policy</a>.
                        </li>
                    </ul>

                    <p class="para-sm">
                        Information may be retained for longer where required for a complaint,
                        investigation, legal claim or other legal obligation.
                    </p>
                </Section>

                <Section
                    id="rights"
                    index="06"
                    eyebrow="Your rights"
                    title="Your data-protection rights"
                >
                    <p class="para">
                        Depending on the circumstances, you may ask to access, correct, delete,
                        restrict or receive a copy of your personal information. You may object
                        to processing based on legitimate interests and withdraw analytics
                        consent at any time through “Cookie settings”.
                    </p>

                    <p class="para-sm">
                        Rights are subject to legal exceptions. Identity may be checked before
                        information is released. Requests are normally answered within one
                        month.
                    </p>

                    <p class="para-sm">
                        To exercise a right or raise a concern, email
                        {" "}
                        {`mailto:${contactEmail}`}
                            {contactEmail}
                        </a>.
                        You may also complain to the
                        {" "}
                        https://ico.org.uk/make-a-complaint/
                            Information Commissioner’s Office
                        </a>.
                    </p>
                </Section>

                <Callout tone="caution" title="Scope">
                    <p>
                        This notice applies to the website. A separate privacy notice or terms
                        of engagement may apply if an enquiry becomes a professional instruction.
                    </p>
                </Callout>

            </div>
        </div>
    </section>
</BaseLayout>