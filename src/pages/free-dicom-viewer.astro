---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Callout from '../components/Callout.astro';
import LocalDicomViewer from '../components/LocalDicomViewer.astro';
import { PAGE_HERO_IMAGES } from '../consts';
---

<BaseLayout
    title="Free DICOM Viewer | Radiology & Medicolegal Law"
    description="Open DICOM images locally in your browser using this free viewer. No account required."
>
    <PageHero
        eyebrow="Free browser tool"
        title="Free DICOM Viewer"
        description="Open and review DICOM images directly in your browser. No account or installation is required."
        heroImage={PAGE_HERO_IMAGES["/free-dicom-viewer"] || undefined}
    >
        <p class="mt-4 font-sans text-xs uppercase tracking-[0.14em] text-slate-400">
            Basic viewing · Local processing · No sign-up
        </p>
    </PageHero>

    <section id="open-a-study" class="scroll-mt-24 bg-white py-14">
        <div class="container-page">
            <div class="mx-auto max-w-2xl">
                <LocalDicomViewer />

                <Callout tone="limit" title="Not for clinical diagnosis">
                    <p>
                        This is a basic reference viewer and is not a certified diagnostic
                        medical device. It should not be used for primary interpretation,
                        clinical decision-making or formal medicolegal opinion. Diagnostic
                        review requires the complete examination on an appropriate clinical
                        workstation by a suitably qualified professional.
                    </p>
                </Callout>

                <div class="mt-8 rounded-xl border border-slate-200 bg-slate-50 p-6">
                    <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-500">
                        Quick guide
                    </h2>

                    <ul class="mt-4 list space-y-2 text-sm text-slate-600">
                        <li>
                            <strong>Open a study:</strong> choose the DICOM files or folder,
                            or drag them into the viewer.
                        </li>
                        <li>
                            <strong>Move through images:</strong> use the mouse wheel,
                            arrows or slice control.
                        </li>
                        <li>
                            <strong>Adjust the display:</strong> use Window Width,
                            Window Level or Invert.
                        </li>
                        <li>
                            <strong>Zoom and pan:</strong> enlarge the image and move
                            around the displayed field.
                        </li>
                        <li>
                            <strong>Restore the display:</strong> select Reset all.
                        </li>
                    </ul>

                    <p class="mt-5 text-sm text-slate-500">
                        Need more help?
                        {' '}
                        <a
                            href="/how-to-use-the-dicom-viewer"
                            class="link-strong"
                        >
                            Read the step-by-step guide
                        </a>.
                    </p>
                </div>

                <Callout tone="key" title="Privacy
                        viewer is designed to process selected files locally in the
                        browser. Use it only on a secure device and only where you are
                        authorised to access the images.
                    </p>
                </Callout>
            </div>
        </div>
    </section>
</BaseLayout>