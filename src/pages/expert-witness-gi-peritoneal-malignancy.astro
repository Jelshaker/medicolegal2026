---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import PageIntro from '../components/PageIntro.astro';
import Section from '../components/Section.astro';
import Callout from '../components/Callout.astro';
import Figure from '../components/Figure.astro';
import Diagram from '../components/Diagram.astro';
import { PAGE_HERO_IMAGES } from '../consts';

const contactEmail = 'enquiries@medicolegal.org';
---

<BaseLayout
    title="Expert Witness | GI and Peritoneal Malignancy"
    description="Independent radiological expert evidence in gastrointestinal and peritoneal malignancy, including diagnostic interpretation, staging and delayed-diagnosis claims."
>
    <PageHero
        eyebrow="GI and peritoneal malignancy"
        title="Radiology Expert Witness"
        description="Independent radiological opinion on gastrointestinal malignancy, peritoneal disease, staging and delayed diagnosis."
        heroImage={PAGE_HERO_IMAGES["/expert-witness-gi-peritoneal-malignancy"] || undefined}
    />

    <PageIntro
        eyebrow="Expert evidence"
        paragraphs={[
            'Independent radiological opinion is available in civil claims involving gastrointestinal and peritoneal malignancy. Instructions may be accepted from claimants, defendants or as a single joint expert, subject to competence, capacity and conflict checks.',
            'Expert evidence is prepared in accordance with CPR Part 35 and Practice Direction 35. The overriding duty is to the court, irrespective of the party giving instructions.'
        ]}
        contents={[
            { href: '#scope', label: 'Scope of practice' },
            { href: '#services', label: 'Types of opinion' },
            { href: '#method', label: 'Method' },
            { href: '#instruction', label: 'Instructions' },
        ]}
        audience="For solicitors, barristers, insurers and NHS legal teams."
        reviewed="October 2026"
    />

    <section class="band-paper">
        <div class="container-page">
            <div class="doc">
                <Figure
                    label="Figure 01"
                    caption="From instruction to opinion"
                    subtitle="Conflict and competence checks precede review of the records, source imaging and questions in issue."
                >
                    <Diagram name="instruction-cycle" />
                </Figure>
            </div>
        </div>
    </section>

    <section class="band-white">
        <div class="content-section">
            <Section
                id="scope"
                index="01"
                eyebrow="Scope of practice"
                title="GI and Peritoneal Imaging"
                lead="Opinion is confined to matters within current radiological expertise."
            >
                <div class="entry-list">
                    <div class="entry">
                        <h3 class="entry-title">Peritoneal malignancy</h3>
                        <p class="para-sm">
                            Review of CT and MRI for peritoneal deposits, omental disease,
                            ascites, disease distribution and radiological staging.
                        </p>
                    </div>

                    <div class="entry">
                        <h3 class="entry-title">Gastrointestinal malignancy</h3>
                        <p class="para-sm">
                            Diagnostic and staging imaging in colorectal, oesophageal,
                            gastric, pancreatic and related gastrointestinal malignancies.
                        </p>
                    </div>

                    <div class="entry">
                        <h3 class="entry-title">Metastatic disease</h3>
                        <p class="para-sm">
                            Review of hepatic, nodal and peritoneal metastatic disease,
                            including comparison with prior and subsequent examinations.
                        </p>
                    </div>

                    <div class="entry">
                        <h3 class="entry-title">Delayed diagnosis</h3>
                        <p class="para-sm">
                            Assessment of whether an abnormality should reasonably have
                            been detected, characterised, reported or investigated earlier.
                        </p>
                    </div>

                    <div class="entry">
                        <h3 class="entry-title">Protocol and technical adequacy</h3>
                        <p class="para-sm">
                            Consideration of examination protocol, contrast phase,
                            anatomical coverage, image quality and relevant limitations.
                        </p>
                    </div>

                    <div class="entry">
                        <h3 class="entry-title">Treatment response</h3>
                        <p class="para-sm">
                            Radiological assessment of interval change and treatment
                            response where this falls within the questions instructed.
                        </p>
                    </div>
                </div>
            </Section>
        </div>
    </section>

    <section class="bg-paper py-16">
        <div class="content-section-sm">
            <Section
                id="services"
                index="02"
                eyebrow="Services"
                title="Types of Opinion"
            >
                <div class="grid-2-col-lg">
                    <div class="entry">
                        <h3 class="entry-title">Preliminary screening opinion</h3>
                        <p class="para-sm">
                            Focused review to identify the principal radiological issues,
                            the apparent merits and limitations, and any further material
                            required before a full opinion can be given.
                        </p>
                    </div>

                    <div class="entry">
                        <h3 class="entry-title">Part 35 report</h3>
                        <p class="para-sm">
                            A reasoned report addressing the letter of instruction and
                            complying with CPR Part 35, Practice Direction 35 and the
                            applicable statement of truth.
                        </p>
                    </div>

                    <div class="entry">
                        <h3 class="entry-title">Breach of duty</h3>
                        <p class="para-sm">
                            Opinion on whether the examination and report met the standard
                            reasonably expected of a competent radiologist undertaking
                            that work at the relevant time.
                        </p>
                    </div>

                    <div class="entry">
                        <h3 class="entry-title">Radiological causation</h3>
                        <p class="para-sm">
                            Opinion on what competent reporting would probably have shown
                            and the likely next radiological step. Questions of treatment,
                            prognosis or survival may require evidence from another
                            specialty.
                        </p>
                    </div>

                    <div class="entry">
                        <h3 class="entry-title">Supplementary opinion</h3>
                        <p class="para-sm">
                            Responses to Part 35 questions, review of additional evidence
                            and revision where new material affects the opinion.
                        </p>
                    </div>

                    <div class="entry">
                        <h3 class="entry-title">Expert discussion and evidence</h3>
                        <p class="para-sm">
                            Participation in expert meetings, joint statements, conferences
                            and oral evidence where appropriate and directed.
                        </p>
                    </div>
                </div>
            </Section>
        </div>
    </section>

    <section class="band-white">
        <div class="content-section-sm">
            <Section
                id="method"
                index="03"
                eyebrow="Method"
                title="How the Opinion Is Prepared"
            >
                <div class="entry-list">
                    <div class="entry">
                        <h3 class="entry-title">1. Conflict and competence</h3>
                        <p class="para-sm">
                            The parties, issues and requested field of opinion are reviewed
                            before an instruction is accepted.
                        </p>
                    </div>

                    <div class="entry">
                        <h3 class="entry-title">2. Source material</h3>
                        <p class="para-sm">
                            The original DICOM examinations are reviewed where available,
                            together with the reports, referral information, relevant
                            records and imaging chronology.
                        </p>
                    </div>

                    <div class="entry">
                        <h3 class="entry-title">3. Independent interpretation</h3>
                        <p class="para-sm">
                            The imaging findings are derived independently before comparison
                            with the contemporaneous report and later examinations.
                        </p>
                    </div>

                    <div class="entry">
                        <h3 class="entry-title">4. Contemporaneous standard</h3>
                        <p class="para-sm">
                            The opinion considers the protocol, image quality, available
                            clinical information and professional practice at the relevant
                            date, while allowing for hindsight bias.
                        </p>
                    </div>

                    <div class="entry">
                        <h3 class="entry-title">5. Reasoned conclusions</h3>
                        <p class="para-sm">
                            Fact, assumption and opinion are distinguished. Any reasonable
                            range of professional opinion, evidential limitation or matter
                            outside radiological expertise is stated.
                        </p>
                    </div>
                </div>

                <Callout tone="key" title="Duty to the court">
                    <p>
                        The opinion is independent and may not support the case of the
                        instructing party. Material evidence that detracts from the
                        conclusion is considered, and any subsequent material change of
                        opinion is communicated promptly.
                    </p>
                </Callout>
            </Section>
        </div>
    </section>

    <section id="instruction" class="band-paper">
        <div class="container-page">
            <div class="doc">
                <Section
                    index="04"
                    eyebrow="Instructions"
                    title="Making an Enquiry"
                >
                    <p class="para">
                        Initial enquiries should identify the parties, the proposed field
                        of opinion, the principal radiological issues and the relevant
                        deadline. This permits conflict, competence and capacity checks
                        before confidential records are transferred.
                    </p>

                    <div class="entry-list">
                        <div class="entry">
                            <h3 class="entry-title">Initial information</h3>
                            <ul class="list">
                                <li>Names of the parties and instructing organisations.</li>
                                <li>A brief anonymised case summary.</li>
                                <li>The imaging modalities and dates in issue.</li>
                                <li>The questions on which opinion is sought.</li>
                                <li>Any conference, limitation or court deadline.</li>
                            </ul>
                        </div>

                        <div class="entry">
                            <h3 class="entry-title">Material usually required</h3>
                            <ul class="list">
                                <li>The formal letter of instruction.</li>
                                <li>Original DICOM imaging and reports.</li>
                                <li>Relevant referral and clinical records.</li>
                                <li>Earlier and later comparative imaging.</li>
                                <li>Pleadings and other expert evidence where relevant.</li>
                            </ul>
                        </div>
                    </div>

                    <Callout tone="caution" title="Confidential material">
                        <p>
                            Do not send patient-identifiable records through a public
                            website form or ordinary email. A secure transfer route will
                            be provided after preliminary checks and acceptance of the
                            instruction.
                        </p>
                    </Callout>

                    <div class="mt-8">
                        {`mailto:${contactEmail}?subject=GI%20radiology%20expert%20witness%20enquiry`}
                            Make an initial enquiry
                        </a>
                    </div>
                </Section>
            </div>
        </div>
    </section>
</BaseLayout>