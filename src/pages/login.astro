---
import BaseLayout from '../layouts/BaseLayout.astro';
import { DEMO_PORTAL_ACCOUNT, LOGIN_BUTTON_TEXT, LOGIN_PAGE_TITLE, SITE_TITLE } from '../consts';
import { toast, type ToastKind } from '../lib/toast';
---

<BaseLayout
	title={`${LOGIN_PAGE_TITLE} | ${SITE_TITLE}`}
	description="Professional portal login for solicitors, barristers and referrers to access secure correspondence and case imaging correspondence."
	noindex
>
	<section class="bg-paper py-20">
		<div class="container-page max-w-md">
			<div class="border border-slate-300 bg-white p-8">
				<div>
					<h1 class="font-serif text-xl font-bold text-slate-900">{LOGIN_PAGE_TITLE}</h1>
					<p class="mt-1 font-sans text-xs uppercase tracking-[0.12em] text-slate-500">Members Only</p>
				</div>

				<p class="para-sm mt-5">
Secure portal for academic paper review and privileged legal commentary. Verify credentials to access the review proceedings. By invitation only.				</p>

				<form id="login-form" class="mt-6 grid gap-4">
					<label class="form-label">
						Email
						<input name="email" type="email" required autocomplete="username" class="input-field" placeholder="you@radiologylaw.com" />
					</label>
					<label class="form-label">
						Password
						<input name="password" type="password" required autocomplete="current-password" class="input-field" placeholder="••••••••" />
					</label>
					<!-- CSRF protection -->
					<input type="hidden" name="csrfToken" id="csrf-token" />
					<!-- Spam honeypot -->
					<input type="text" name="_honey" class="sr-only" tabindex="-1" autocomplete="off" aria-hidden="true" />
					<button type="submit" class="btn btn-primary w-full" data-submit>Sign in</button>
				</form>
			</div>
		</div>
	</section>
</BaseLayout>

<script>
	// Fetch CSRF token on page load
	(async () => {
		try {
			const res = await fetch("/api/login");
			if (res.ok) {
				const json = await res.json();
				const input = document.getElementById("csrf-token") as HTMLInputElement | null;
				if (input && json.csrfToken) input.value = json.csrfToken;
			}
		} catch { /* token fetch failed — form will still work but without CSRF */ }
	})();

	const form = document.getElementById("login-form") as HTMLFormElement | null;
	if (form) {
		form.addEventListener("submit", async (e) => {
			e.preventDefault();
			const data = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
			const btn = form.querySelector("[data-submit]") as HTMLButtonElement | null;
			if (btn) { btn.disabled = true; btn.textContent = "Signing in…"; }
			try {
				const res = await fetch("/api/login", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify(data),
				});
				const json = await res.json();
				if (!res.ok) throw new Error(json.error || "Login failed");
				toast("Signed in successfully.", "success", 3000);
			} catch (err: unknown) {
				const msg = err instanceof Error ? err.message : "Invalid credentials. Please try again or contact the secretariat.";
				toast(msg, "error", 5000);
			} finally {
				if (btn) { btn.disabled = false; btn.textContent = "Sign in"; }
			}
		});
	}
</script>
