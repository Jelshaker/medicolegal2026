---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import PageIntro from '../components/PageIntro.astro';
import { SITE_TITLE } from '../consts';
---

<BaseLayout title={`Referrals & Terms | ${SITE_TITLE}`} description="Secure referrals, terms of instruction and imaging transfer guidance (DICOM / PACS) for instructing Dr Joseph El-Sheikha as a medico-legal radiology expert.">
	<PageHero
		eyebrow="Instructing the expert"
		title="Referrals & Terms"
		description="A secure referral form for GP and solicitor referrers, alongside terms of instruction and imaging transfer guidance."
	/>

	<PageIntro
		eyebrow="Instructing the expert"
		paragraphs={[
			'A secure route to ask for an opinion, the terms on which instructions are accepted, and guidance for transferring imaging safely.',
			'The resource itself needs no instruction and no payment. This page is only for matters that require a formal radiological opinion, which is prepared independently and in the form the court requires.',
		]}
		contents={[
			{ href: '#referral-form', label: 'Referral form' },
			{ href: '#terms', label: 'Terms of engagement' },
			{ href: '#imaging-transfer', label: 'Imaging transfer' },
		]}
		reviewed="September 2026"
	/>

	<section class="bg-white py-16">
		<div class="container-page">
			<div class="doc space-y-14">
				<!-- Form -->
				<div id="referral-form" class="scroll-mt-24 border-t border-slate-300 pt-8">
					<span class="eyebrow">Secure referral</span>
					<h2 class="mt-3 font-serif text-2xl font-bold text-slate-900">Submit a medico-legal referral</h2>
					<p class="mt-3 font-serif leading-relaxed text-slate-600">Complete the form below and it will be stored securely for the secretariat to action. Fields marked * are required.</p>

					<form id="referral-form" class="mt-8 grid gap-5">
						<label class="block font-sans text-xs font-semibold uppercase tracking-[0.1em] text-slate-600">
							Referrer type *
							<select name="referrerType" required class="input-field mt-1.5">
								<option value="">Select…</option>
								<option>GP / General Practice</option>
								<option>Solicitor / Barrister</option>
								<option>Insurer</option>
								<option>Hospital / NHS Trust</option>
								<option>Patient / member of the public</option>
							</select>
						</label>
						<label class="block font-sans text-xs font-semibold uppercase tracking-[0.1em] text-slate-600">
							Referrer name *
							<input name="referrerName" type="text" required class="input-field mt-1.5" placeholder="Full name" />
						</label>
						<label class="block font-sans text-xs font-semibold uppercase tracking-[0.1em] text-slate-600">
							Firm / organisation
							<input name="organisation" type="text" class="input-field mt-1.5" placeholder="Firm or trust" />
						</label>
						<label class="block font-sans text-xs font-semibold uppercase tracking-[0.1em] text-slate-600">
							Email *
							<input name="referrerEmail" type="email" required class="input-field mt-1.5" placeholder="you@firm.co.uk" />
						</label>
						<label class="block font-sans text-xs font-semibold uppercase tracking-[0.1em] text-slate-600">
							Phone
							<input name="referrerPhone" type="tel" class="input-field mt-1.5" placeholder="Optional" />
						</label>
						<label class="block font-sans text-xs font-semibold uppercase tracking-[0.1em] text-slate-600">
							Patient / case reference *
							<input name="patientRef" type="text" required class="input-field mt-1.5" placeholder="Reference or pseudonym" />
						</label>
						<label class="block font-sans text-xs font-semibold uppercase tracking-[0.1em] text-slate-600">
							Clinical / issue summary *
							<textarea name="summary" rows="4" required class="input-field mt-1.5" placeholder="Brief, anonymised summary of the issue and the imaging question"></textarea>
						</label>
						<label class="block font-sans text-xs font-semibold uppercase tracking-[0.1em] text-slate-600">
							Urgency
							<select name="urgency" class="input-field mt-1.5">
								<option value="standard">Standard</option>
								<option value="urgent">Urgent</option>
							</select>
						</label>
						<div class="flex items-center gap-3">
							<button type="submit" class="btn btn-primary" data-submit>Submit referral</button>
							<span class="font-sans text-xs text-slate-500">Stored securely; never including patient-identifying case details on this page.</span>
						</div>
					</form>
				</div>

				<!-- Terms -->
				<div id="terms" class="scroll-mt-24 border-t border-slate-300 pt-8">
					<span class="eyebrow">Terms of engagement</span>
					<ul class="mt-4 space-y-2.5 border-t border-slate-200 pt-4 font-serif text-[0.95rem] leading-relaxed text-slate-600">
						<li>Reports prepared in accordance with <strong>CPR Part 35</strong> and the <strong>Expert Witness Institute / EMA</strong> Code of Practice.</li>
						<li>Re-derivation from source DICOM where required; reports are anonymised and reproducible.</li>
						<li>Conflicts of interest, indemnity and availability checked before acceptance.</li>
					</ul>
				</div>

				<!-- Imaging transfer -->
				<div id="imaging-transfer" class="scroll-mt-24 border-t border-slate-300 pt-8">
					<span class="eyebrow">Imaging transfer (DICOM / PACS)</span>
					<p class="mt-4 border-t border-slate-200 pt-4 font-serif text-[0.95rem] leading-relaxed text-slate-600">Imaging is accepted via encrypted transfer or secure DICOM link. Please include the full study (not screenshots) and any prior comparative studies.</p>
					<a href="#imaging-transfer" class="mt-3 inline-block font-sans text-[0.8rem] font-medium text-slate-700 underline decoration-slate-300 underline-offset-4 hover:text-slate-900 hover:decoration-slate-600">View transfer checklist</a>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>

<script>
	const form = document.getElementById("referral-form") as HTMLFormElement | null;
	if (form) {
		form.addEventListener("submit", async (e) => {
			e.preventDefault();
			const data = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
			const btn = form.querySelector("[data-submit]") as HTMLButtonElement | null;
			if (btn) { btn.disabled = true; btn.textContent = "Submitting…"; }
			try {
				const res = await fetch("/api/referrals", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify(data),
				});
				const json = await res.json();
				if (!res.ok) throw new Error(json.error || "Submission failed");
				form.reset();
				alert("Thank you. Your referral has been received (reference " + json.reference.slice(0, 8).toUpperCase() + ").");
			} catch (err) {
				alert("There was a problem submitting the referral. Please email the secretariat directly.");
			} finally {
				if (btn) { btn.disabled = false; btn.textContent = "Submit referral"; }
			}
		});
	}
</script>