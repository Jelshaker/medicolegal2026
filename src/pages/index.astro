---
import BaseLayout from '../layouts/BaseLayout.astro';
import MedicalImageViewer from '../components/MedicalImageViewer.astro';
import { getCollection } from 'astro:content';
import { KEY_STATS, PRACTITIONER, SITE_TITLE, SITE_DESCRIPTION, BLOG_CATEGORIES } from '../consts';

const allPosts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const featured = allPosts.find((p) => p.data.featured) ?? allPosts[0];
const recent = allPosts.slice(0, 3);
const categoryLabel = (id: string) => BLOG_CATEGORIES.find((c) => c.id === id)?.label ?? id;
const stats = [
	{ value: `${KEY_STATS.reportsDelivered}+`, label: 'Expert reports delivered' },
	{ value: `${KEY_STATS.standardTurnaroundDays} days`, label: 'Standard turnaround' },
	{ value: `${KEY_STATS.urgentTurnaroundHours}h`, label: 'Urgent turnaround' },
	{ value: `${KEY_STATS.clientSatisfaction}%`, label: 'Client satisfaction' },
];
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<!-- Hero -->
	<section class="relative overflow-hidden bg-navy-950 text-white">
		<div class="container-page grid items-center gap-12 py-20 lg:grid-cols-2 lg:gap-16 lg:py-28">
			<div>
				<span class="eyebrow mb-4 text-teal-400">Consultant Radiologist · Medicolegal Expert Witness</span>
				<h1 class="text-4xl font-extrabold leading-tight tracking-tight text-white sm:text-5xl">
					Independent imaging opinions, prepared for the courtroom.
				</h1>
				<p class="mt-5 max-w-xl text-lg leading-relaxed text-slate-300">
					{PRACTITIONER.shortName} provides CPR Part 35 / EMA compliant radiological
					expert opinions across MSK, gastrointestinal and interventional radiology — including
					re-derivation from source DICOM, anonymised case analysis and plain-language insight
					for solicitors, barristers and insurers.
				</p>
				<div class="mt-7 flex flex-wrap gap-3">
					<a href="/referrals" class="btn btn-primary">
						<svg class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h13M12 5v13"/></svg>
						Make a referral
					</a>
					<a href="/contact" class="btn btn-ghost">Contact the secretariat</a>
					<a href="/patient-advice" class="btn btn-ghost">Patient advice</a>
				</div>
				<div class="mt-9 grid grid-cols-2 gap-x-6 gap-y-5 sm:grid-cols-4">
					{stats.map((s) => (
						<div>
							<div class="text-2xl font-extrabold text-teal-400">{s.value}</div>
							<div class="mt-1 text-xs text-slate-400">{s.label}</div>
						</div>
					))}
				</div>
			</div>
			<div class="relative">
				<div class="overflow-hidden rounded-2xl border border-navy-700 shadow-2xl">
					<img src={PRACTITIONER.photo} alt="Dr Joseph El-Sheikha" class="aspect-[4/5] w-full object-cover" loading="lazy" />
				</div>
				<div class="absolute -bottom-5 -left-6 hidden rounded-2xl border border-teal-500/40 bg-navy-900 p-4 shadow-xl lg:block">
					<div class="flex items-center gap-3">
						<div class="flex h-11 w-11 items-center justify-center rounded-full bg-teal-600 text-sm font-bold text-white">FRCR</div>
						<div class="text-xs leading-snug text-slate-200">
							<span class="block font-semibold text-slate-100">Royal College of Radiologists</span>
							<span>Fellow · Specialist register</span>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Practice areas -->
	<section class="bg-white py-16 dark:bg-navy-900">
		<div class="container-page">
			<div class="max-w-2xl">
				<span class="eyebrow block">Practice areas</span>
				<h2 class="mt-3 text-3xl font-bold tracking-tight text-navy-900 dark:text-slate-100">Where I can assist the court</h2>
			</div>
			<div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
				{[
					{ t: 'Musculoskeletal', d: 'Orthopaedic injury, delayed fracture diagnosis and measurement-based quantum disputes.', img: '/images/knee_xray_pen_pointing.jpg' },
					{ t: 'Gastrointestinal', d: 'CT abdomen, missed GI pathology and ischaemic bowel claims.', img: '/images/ct_scanner.jpg' },
					{ t: 'Neuroradiology', d: 'Cauda equina, spine and brain imaging where timing decides liability.', img: '/images/spine_CT.jpg' },
					{ t: 'Interventional', d: 'Consent, dose documentation and complication disclosure.', img: '/images/xr_spine_radiograph_2.jpg' },
				].map((p) => (
					<a href="/legal-blog" class="group overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-soft transition-all hover:border-teal-500/40 hover:shadow-lift dark:border-navy-700 dark:bg-navy-900">
						<div class="h-40 overflow-hidden">
							<img src={p.img} alt="" loading="lazy" class="w-full object-cover transition-transform duration-500 group-hover:scale-105" />
						</div>
						<div class="p-4">
							<h3 class="font-bold text-navy-900 dark:text-slate-100">{p.t}</h3>
							<p class="mt-2 text-sm leading-snug text-slate-600 dark:text-slate-300">{p.d}</p>
						</div>
					</a>
				))}
			</div>
		</div>
	</section>

	<!-- Featured case -->
	<section class="bg-slate-50 py-16 dark:bg-navy-950">
		<div class="container-page grid items-center gap-12 lg:grid-cols-2">
			<div>
				<span class="eyebrow block text-teal-600 dark:text-teal-400">Featured case discussion</span>
				<h2 class="mt-3 text-3xl font-bold tracking-tight text-navy-900 dark:text-slate-100">{featured.data.title}</h2>
				<p class="mt-4 leading-relaxed text-slate-600 dark:text-slate-300">{featured.data.description}</p>
				<div class="mt-6 flex flex-wrap gap-2">
					{featured.data.tags.slice(0, 3).map((t) => <span class="chip">{t}</span>)}
				</div>
				<a href={`/legal-blog/${featured.slug}`} class="btn btn-primary mt-7">Read the analysis</a>
			</div>
			<div class="lg:ml-auto">
				{
					featured.data.figures?.[0]
						? (
							<MedicalImageViewer
								src={featured.data.figures[0]}
								alt="Anonymised case image"
								caption="Anonymised source series referenced in the featured case"
								modality="MRI / CT"
							/>
						)
						: (
							<MedicalImageViewer
								src="/images/placeholders/anonymised-mri-knee-sagittal.svg"
								alt="Anonymised imaging placeholder"
								caption="Anonymised reference image"
								modality="MRI"
							/>
						)
				}
			</div>
		</div>
	</section>

	<!-- Recent posts -->
	<section class="bg-white py-16 dark:bg-navy-900">
		<div class="container-page">
			<div class="flex items-end justify-between gap-4">
				<div>
					<span class="eyebrow block">Legal radiology</span>
					<h2 class="mt-3 text-3xl font-bold tracking-tight text-navy-900 dark:text-slate-100">Latest case discussions</h2>
				</div>
				<a href="/legal-blog" class="btn btn-ghost">All discussions</a>
			</div>
			<div class="mt-10 grid gap-6 md:grid-cols-3">
				{recent.map((post) => (
					<a href={`/legal-blog/${post.slug}`} class="group flex flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-soft transition-all hover:shadow-lift dark:border-navy-700 dark:bg-navy-900">
						<div class="px-5 pt-5">
							<span class="chip">{categoryLabel(post.data.category)}</span>
						</div>
						<div class="p-5">
							<h3 class="font-bold leading-snug text-navy-900 dark:text-slate-100">{post.data.title}</h3>
							<p class="mt-2 line-clamp-3 text-sm leading-snug text-slate-600 dark:text-slate-300">{post.data.description}</p>
						</div>
					</a>
				))}
			</div>
		</div>
	</section>

	<!-- CTA -->
	<section class="bg-gradient-to-br from-navy-900 to-navy-800 py-14 text-center dark:bg-navy-950">
		<div class="container-page max-w-3xl">
			<h2 class="text-3xl font-extrabold tracking-tight text-white">Ready to instruct?</h2>
			<p class="mt-3 text-lg text-slate-300">Terms of instruction, imaging transfer guidance and fee structure are all in one place.</p>
			<div class="mt-6 flex flex-wrap justify-center gap-3">
				<a href="/referrals" class="btn btn-primary">Referrals & terms</a>
				<a href="/contact" class="btn btn-white">Contact</a>
			</div>
		</div>
	</section>
</BaseLayout>