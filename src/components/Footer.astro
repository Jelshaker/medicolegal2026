---
import {
  COOKIE_SETTINGS_LABEL,
  MEMBERSHIPS,
  NAVIGATION_LINKS,
  PRACTITIONER,
  SITE_BRAND_SUBTITLE,
  SITE_TITLE,
} from "../consts";
---

<footer
  class="push-bottom footer-top bg-gradient-to-b from-slate-50 to-slate-200"
>
  <div class="container-page footer-grid">
    <div>
      <a href="/" class="row">
        <img
          src="/logo-256.png"
          alt={`${SITE_TITLE} logo`}
          width="256"
          height="256"
          class="footer-logo"
          loading="lazy"
          decoding="async"
        />
        <span>
          <span class="brand-name">{PRACTITIONER.shortName}</span>
          <span class="meta-label mt-0.5 block !text-[0.62rem]"
            >{SITE_BRAND_SUBTITLE}</span
          >
        </span>
      </a>
      <p class="footer-desc">A reference resource for radiology and the law.</p>
      <ul class="footer-members mt-3">
        {MEMBERSHIPS.slice(0, 4).map((m) => <li>{m}</li>)}
      </ul>
    </div>

    <div>
      <h2 class="meta-label">Main pages</h2>
      <ul class="mt-3 space-y-2 text-sm">
        {
          NAVIGATION_LINKS.map((link) => (
            <li>
              <a href={link.href} class="foot-link">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="meta-label">Support</h2>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a href="/about" class="foot-link">About</a></li>
        <li>
          <a href="/disclaimer-and-terms-of-use" class="foot-link"
            >Disclaimer &amp; terms of use</a
          >
        </li>
        <li><a href="/privacy-notice" class="foot-link">Privacy notice</a></li>
        <li><a href="/cookie-policy" class="foot-link">Cookie policy</a></li>
        <li>
          <button type="button" data-cookie-settings class="foot-link"
            >{COOKIE_SETTINGS_LABEL}</button
          >
        </li>
        <li><a href="/sitemap" class="foot-link">Site map</a></li>
      </ul>
    </div>

    <div>
      <h2 class="meta-label">Secretariat</h2>
      <dl class="mt-3 space-y-2 text-sm text-slate-600">
        <div>
          <dt class="meta-label !text-[0.62rem]">Email</dt>
          <dd class="mt-1 font-sans">
            <a
              href={`mailto:${PRACTITIONER.email}`}
              class="foot-link footer-email">{PRACTITIONER.email}</a
            >
          </dd>
        </div>
        <div>
          <dt class="meta-label !text-[0.62rem]">Phone</dt>
          <dd class="mt-1 font-sans">{PRACTITIONER.phone}</dd>
        </div>
        <div>
          <dt class="meta-label !text-[0.62rem]">GMC</dt>
          <dd class="mt-1 font-sans">{PRACTITIONER.gmcNumber}</dd>
        </div>
        <div>
          <dt class="meta-label !text-[0.62rem]">Address</dt>
          <dd class="mt-1 font-sans leading-snug max-w-[16rem]">
            {PRACTITIONER.address}
          </dd>
        </div>
      </dl>
    </div>
  </div>

  <div class="divider-strong pt-5 pb-4">
    <div class="container-page footer-bottom">
      <p class="font-sans">
        © {new Date().getFullYear()}
        {SITE_TITLE}. Maintained by {PRACTITIONER.name}.
      </p>
      <p class="max-w-xl italic leading-relaxed text-slate-500 md:text-right">
        Nothing on this site constitutes legal advice.
      </p>
    </div>
  </div>
</footer>

<script>
  document.querySelectorAll("[data-cookie-settings]").forEach((b) => {
    b.addEventListener("click", () =>
      window.dispatchEvent(new CustomEvent("ml:open-cookie-settings")),
    );
  });
</script>
