---
// Drawn schematics for the reference pages. Every graphic is monochrome line
// work on a white ground so it sits inside the document design rather than
// competing with it: hairline strokes, sans-serif labels, no colour, no radius.
//
// Each diagram is drawn on a 960 × 540 (16:9) canvas, which matches the
// default `ratio="video"` of Figure.astro.
interface Props {
	name:
		| "legal-questions"
		| "reporting-chain"
		| "duty-holders"
		| "case-timeline"
		| "incidental-regions"
		| "dose-scale"
		| "local-only"
		| "instruction-cycle"
		| "resource-map";
}

const { name } = Astro.props as Props;

const labels: Record<Props["name"], string> = {
	"legal-questions": "Diagram: the four questions that decide a radiological claim",
	"reporting-chain": "Diagram: the reporting chain from referrer to communication",
	"duty-holders": "Diagram: the four duty holders under IR(ME)R 2017",
	"case-timeline": "Diagram: timeline of the principal decisions and standards",
	"incidental-regions": "Diagram: regions in which incidental findings arise",
	"dose-scale": "Diagram: relative effective dose across imaging modalities",
	"local-only": "Diagram: a browser-only workflow in which no data leaves the device",
	"instruction-cycle": "Diagram: the stages of an expert instruction",
	"resource-map": "Diagram: how the pages of the resource are organised",
};
---

<svg
	class="diagram"
	viewBox="0 0 960 540"
	role="img"
	aria-label={labels[name]}
	preserveAspectRatio="xMidYMid meet"
>
	{
		name === "legal-questions" && (
			<g>
				<text class="d-cap" x="40" y="46">
					Framework
				</text>
				<text class="d-title" x="40" y="80">
					Four questions decide a radiological claim
				</text>
				<line class="d-rule" x1="40" y1="104" x2="920" y2="104" />

				<rect class="d-box" x="40" y="170" width="190" height="180" />
				<text class="d-num" x="58" y="204">
					01
				</text>
				<text class="d-label" x="58" y="240">
					Standard of care
				</text>
				<text class="d-sub" x="58" y="270">
					Bolam v Friern [1957]
				</text>
				<text class="d-sub" x="58" y="292">
					Bolitho [1997]
				</text>

				<line class="d-arrow" x1="232" y1="260" x2="264" y2="260" />
				<path class="d-head" d="M270 260 L262 256 L262 264 Z" />

				<rect class="d-box" x="270" y="170" width="190" height="180" />
				<text class="d-num" x="288" y="204">
					02
				</text>
				<text class="d-label" x="288" y="240">
					Breach
				</text>
				<text class="d-sub" x="288" y="270">
					Visible vs demonstrable
				</text>
				<text class="d-sub" x="288" y="292">
					Muller [2017] · FB [2017]
				</text>

				<line class="d-arrow" x1="462" y1="260" x2="494" y2="260" />
				<path class="d-head" d="M500 260 L492 256 L492 264 Z" />

				<rect class="d-box" x="500" y="170" width="190" height="180" />
				<text class="d-num" x="518" y="204">
					03
				</text>
				<text class="d-label" x="518" y="240">
					Causation
				</text>
				<text class="d-sub" x="518" y="270">
					Gregg v Scott [2005]
				</text>
				<text class="d-sub" x="518" y="292">
					Wilsher · Little
				</text>

				<line class="d-arrow" x1="692" y1="260" x2="724" y2="260" />
				<path class="d-head" d="M730 260 L722 256 L722 264 Z" />

				<rect class="d-box" x="730" y="170" width="190" height="180" />
				<text class="d-num" x="748" y="204">
					04
				</text>
				<text class="d-label" x="748" y="240">
					Consent
				</text>
				<text class="d-sub" x="748" y="270">
					Montgomery [2015]
				</text>
				<text class="d-sub" x="748" y="292">
					Material risk to the patient
				</text>

				<line class="d-rule" x1="40" y1="420" x2="920" y2="420" />
				<text class="d-note" x="40" y="452">
					Each question is set out in the law library with the authority and the professional standard behind it.
				</text>
				<text class="d-note" x="40" y="478">
					Breach asks what was demonstrable; causation asks what would have changed.
				</text>
			</g>
		)
	}
	{
		name === "reporting-chain" && (
			<g>
				<text class="d-cap" x="40" y="46">
					The chain
				</text>
				<text class="d-title" x="40" y="80">
					A report is one link in a chain of duties
				</text>
				<line class="d-rule" x1="40" y1="104" x2="920" y2="104" />

				<rect class="d-box" x="40" y="180" width="144" height="112" />
				<text class="d-num" x="54" y="210">
					01
				</text>
				<text class="d-label" x="54" y="242">
					Referrer
				</text>
				<text class="d-sub" x="54" y="266">
					Clinical question
				</text>
				<text class="d-sub" x="54" y="284">
					Sufficient information
				</text>

				<line class="d-arrow" x1="188" y1="236" x2="212" y2="236" />
				<path class="d-head" d="M218 236 L210 232 L210 240 Z" />

				<rect class="d-box" x="224" y="180" width="144" height="112" />
				<text class="d-num" x="238" y="210">
					02
				</text>
				<text class="d-label" x="238" y="242">
					Acquisition
				</text>
				<text class="d-sub" x="238" y="266">
					Protocol and technique
				</text>
				<text class="d-sub" x="238" y="284">
					Justification recorded
				</text>

				<line class="d-arrow" x1="372" y1="236" x2="396" y2="236" />
				<path class="d-head" d="M402 236 L394 232 L394 240 Z" />

				<rect class="d-box" x="408" y="180" width="144" height="112" />
				<text class="d-num" x="422" y="210">
					03
				</text>
				<text class="d-label" x="422" y="242">
					Reporting
				</text>
				<text class="d-sub" x="422" y="266">
					Demonstrable findings
				</text>
				<text class="d-sub" x="422" y="284">
					Named author
				</text>

				<line class="d-arrow" x1="556" y1="236" x2="580" y2="236" />
				<path class="d-head" d="M586 236 L578 232 L578 240 Z" />

				<rect class="d-box" x="592" y="180" width="144" height="112" />
				<text class="d-num" x="606" y="210">
					04
				</text>
				<text class="d-label" x="606" y="242">
					Report
				</text>
				<text class="d-sub" x="606" y="266">
					Conclusion and limits
				</text>
				<text class="d-sub" x="606" y="284">
					Structured format
				</text>

				<line class="d-arrow" x1="740" y1="236" x2="764" y2="236" />
				<path class="d-head" d="M770 236 L762 232 L762 240 Z" />

				<rect class="d-box" x="776" y="180" width="144" height="112" />
				<text class="d-num" x="790" y="210">
					05
				</text>
				<text class="d-label" x="790" y="242">
					Communication
				</text>
				<text class="d-sub" x="790" y="266">
					Critical results
				</text>
				<text class="d-sub" x="790" y="284">
					Fail-safe escalation
				</text>

				<path class="d-arrow" d="M664 292 L664 340 L848 340 L848 292" />
				<line class="d-arrow" x1="756" y1="340" x2="756" y2="374" />
				<path class="d-head" d="M756 380 L752 372 L760 372 Z" />

				<rect class="d-box" x="576" y="384" width="344" height="96" />
				<text class="d-label" x="596" y="418">
					Communication is part of the standard
				</text>
				<text class="d-sub" x="596" y="444">
					The duty does not end with the report. Where a finding
				</text>
				<text class="d-sub" x="596" y="462">
					needs action, it must reach someone who will act on it.
				</text>

				<text class="d-note" x="40" y="418">
					A claim can attach at any link:
				</text>
				<text class="d-note" x="40" y="444">
					the protocol that could not answer
				</text>
				<text class="d-note" x="40" y="462">
					the question, the finding that was
				</text>
				<text class="d-note" x="40" y="480">
					demonstrable, or the result that
				</text>
				<text class="d-note" x="40" y="498">
					never reached the clinician.
				</text>
			</g>
		)
	}
{
		name === "duty-holders" && (
			<g>
				<text class="d-cap" x="40" y="46">
					Duty holders
				</text>
				<text class="d-title" x="40" y="80">
					Four roles, one exposure
				</text>
				<line class="d-rule" x1="40" y1="104" x2="920" y2="104" />

				<rect class="d-box" x="60" y="150" width="380" height="160" />
				<text class="d-num" x="80" y="182">
					EMPLOYER
				</text>
				<text class="d-label" x="80" y="216">
					Provides the framework
				</text>
				<text class="d-sub" x="80" y="246">
					Written procedures, training and
				</text>
				<text class="d-sub" x="80" y="264">
					the incident reporting system.
				</text>

				<rect class="d-box" x="520" y="150" width="380" height="160" />
				<text class="d-num" x="540" y="182">
					REFERRER
				</text>
				<text class="d-label" x="540" y="216">
					Supplies the clinical question
				</text>
				<text class="d-sub" x="540" y="246">
					Sufficient clinical information, and
				</text>
				<text class="d-sub" x="540" y="264">
					entitlement to refer the patient.
				</text>

				<rect class="d-box" x="60" y="330" width="380" height="160" />
				<text class="d-num" x="80" y="362">
					PRACTITIONER
				</text>
				<text class="d-label" x="80" y="396">
					Justifies each exposure
				</text>
				<text class="d-sub" x="80" y="426">
					Takes clinical responsibility for the
				</text>
				<text class="d-sub" x="80" y="444">
					justification and its basis.
				</text>

				<rect class="d-box" x="520" y="330" width="380" height="160" />
				<text class="d-num" x="540" y="362">
					OPERATOR
				</text>
				<text class="d-label" x="540" y="396">
					Performs the practical aspects
				</text>
				<text class="d-sub" x="540" y="426">
					Must be entitled and trained for
				</text>
				<text class="d-sub" x="540" y="444">
					the task actually carried out.
				</text>

				<rect class="d-fill" x="450" y="288" width="60" height="64" />
				<text class="d-cap" x="480" y="306" text-anchor="middle">
					IR(ME)R
				</text>
				<text class="d-cap" x="480" y="324" text-anchor="middle">
					2017
				</text>
				</g>
		)
	}
	{
		name === "case-timeline" && (
			<g>
				<text class="d-cap" x="40" y="46">
					Chronology
				</text>
				<text class="d-title" x="40" y="80">
					The authorities, in the order they arrived
				</text>
				<line class="d-rule" x1="40" y1="104" x2="920" y2="104" />

				<line class="d-axis" x1="60" y1="290" x2="900" y2="290" />
				<path class="d-head" d="M912 290 L900 285 L900 295 Z" />

				<line class="d-axis" x1="90" y1="278" x2="90" y2="302" />
				<text class="d-label" x="90" y="252" text-anchor="middle">
					1957
				</text>
				<text class="d-sub" x="90" y="230" text-anchor="middle">
					Bolam v Friern
				</text>
				<text class="d-sub" x="90" y="212" text-anchor="middle">
					the standard of care
				</text>

				<line class="d-axis" x1="228" y1="278" x2="228" y2="302" />
				<text class="d-label" x="228" y="328" text-anchor="middle">
					1993
				</text>
				<text class="d-sub" x="228" y="352" text-anchor="middle">
					Ikarian Reefer
				</text>
				<text class="d-sub" x="228" y="370" text-anchor="middle">
					duties of the expert
				</text>

				<line class="d-axis" x1="366" y1="278" x2="366" y2="302" />
				<text class="d-label" x="366" y="252" text-anchor="middle">
					1997
				</text>
				<text class="d-sub" x="366" y="230" text-anchor="middle">
					Bolitho
				</text>
				<text class="d-sub" x="366" y="212" text-anchor="middle">
					opinion needs a logical basis
				</text>

				<line class="d-axis" x1="504" y1="278" x2="504" y2="302" />
				<text class="d-label" x="504" y="328" text-anchor="middle">
					2000
				</text>
				<text class="d-sub" x="504" y="352" text-anchor="middle">
					Penney, Palmer &amp; Canon
				</text>
				<text class="d-sub" x="504" y="370" text-anchor="middle">
					screening and perception
				</text>

				<line class="d-axis" x1="642" y1="278" x2="642" y2="302" />
				<text class="d-label" x="642" y="252" text-anchor="middle">
					2015
				</text>
				<text class="d-sub" x="642" y="230" text-anchor="middle">
					Montgomery
				</text>
				<text class="d-sub" x="642" y="212" text-anchor="middle">
					materiality of risk
				</text>

				<line class="d-axis" x1="780" y1="278" x2="780" y2="302" />
				<text class="d-label" x="780" y="328" text-anchor="middle">
					2017
				</text>
				<text class="d-sub" x="780" y="352" text-anchor="middle">
					Muller · FB
				</text>
				<text class="d-sub" x="780" y="370" text-anchor="middle">
					perception and task standard
				</text>

				<line class="d-axis" x1="900" y1="278" x2="900" y2="302" />
				<text class="d-label" x="900" y="252" text-anchor="middle">
					2025
				</text>
				<text class="d-sub" x="900" y="230" text-anchor="middle">
					RCR Standards
				</text>
				<text class="d-sub" x="900" y="212" text-anchor="middle">
					third edition
				</text>

				<line class="d-rule" x1="40" y1="410" x2="920" y2="410" />
				<text class="d-note" x="40" y="442">
					The trend is consistent: the standard of care remains a professional one, but the court now expects
				</text>
				<text class="d-note" x="40" y="464">
					the expert to reconstruct what was demonstrable on the images as acquired, rather than what is
				</text>
				<text class="d-note" x="40" y="486">
					visible with hindsight.
				</text>
			</g>
		)
	}
{
		name === "incidental-regions" && (
			<g>
				<text class="d-cap" x="40" y="46">
					Incidental findings
				</text>
				<text class="d-title" x="40" y="80">
					Pathology found outside the question that was asked
				</text>
				<line class="d-rule" x1="40" y1="104" x2="920" y2="104" />

				<ellipse class="d-outline" cx="330" cy="300" rx="180" ry="130" />
				<ellipse class="d-fill" cx="330" cy="300" rx="150" ry="104" />

				<rect class="d-box" x="312" y="382" width="36" height="26" />
				<ellipse class="d-box" cx="278" cy="346" rx="26" ry="18" />
				<ellipse class="d-box" cx="382" cy="346" rx="26" ry="18" />
				<ellipse class="d-box" cx="238" cy="252" rx="42" ry="30" />
				<circle class="d-box" cx="392" cy="250" r="17" />
				<circle class="d-box" cx="348" cy="286" r="13" />
				<circle class="d-box" cx="424" cy="300" r="11" />

				<line class="d-dash" x1="404" y1="346" x2="640" y2="196" />
				<line class="d-dash" x1="238" y1="252" x2="640" y2="286" />
				<line class="d-dash" x1="424" y1="300" x2="640" y2="376" />

				<text class="d-label" x="652" y="186">
					Renal
				</text>
				<text class="d-sub" x="652" y="208">
					A small renal mass seen on a study
				</text>
				<text class="d-sub" x="652" y="226">
					performed for a different indication.
				</text>

				<text class="d-label" x="652" y="276">
					Colonic
				</text>
				<text class="d-sub" x="652" y="298">
					Wall thickening without a dedicated
				</text>
				<text class="d-sub" x="652" y="316">
					colonic protocol or preparation.
				</text>

				<text class="d-label" x="652" y="366">
					Hepatic
				</text>
				<text class="d-sub" x="652" y="388">
					A deposit on a single-phase study
				</text>
				<text class="d-sub" x="652" y="406">
					not timed for the liver.
				</text>

				<line class="d-rule" x1="40" y1="448" x2="920" y2="448" />
				<text class="d-note" x="40" y="480">
					Around 37% of abdominal radiology claims cite incidental pathology. The question for the expert is
				</text>
				<text class="d-note" x="40" y="502">
					whether the finding fell within the responsibility created by the study that was actually performed.
				</text>
			</g>
		)
	}
{
		name === "dose-scale" && (
			<g>
				<text class="d-cap" x="40" y="46">
					Dose
				</text>
				<text class="d-title" x="40" y="80">
					Effective dose, on a logarithmic scale
				</text>
				<line class="d-rule" x1="40" y1="104" x2="920" y2="104" />

				<line class="d-axis" x1="60" y1="340" x2="900" y2="340" />
				<line class="d-axis" x1="60" y1="332" x2="60" y2="348" />
				<line class="d-axis" x1="270" y1="332" x2="270" y2="348" />
				<line class="d-axis" x1="480" y1="332" x2="480" y2="348" />
				<line class="d-axis" x1="690" y1="332" x2="690" y2="348" />
				<line class="d-axis" x1="900" y1="332" x2="900" y2="348" />

				<text class="d-sub" x="60" y="370" text-anchor="middle">
					0.001
				</text>
				<text class="d-sub" x="270" y="370" text-anchor="middle">
					0.01
				</text>
				<text class="d-sub" x="480" y="370" text-anchor="middle">
					0.1
				</text>
				<text class="d-sub" x="690" y="370" text-anchor="middle">
					1
				</text>
				<text class="d-sub" x="900" y="370" text-anchor="middle">
					10
				</text>
				<text class="d-note" x="60" y="400">
					Effective dose in millisieverts — indicative order of magnitude only.
				</text>

				<line class="d-axis" x1="333" y1="340" x2="333" y2="230" />
				<line class="d-axis" x1="657" y1="340" x2="657" y2="290" />
				<line class="d-axis" x1="753" y1="340" x2="753" y2="230" />
				<line class="d-axis" x1="880" y1="340" x2="880" y2="290" />

				<text class="d-label" x="333" y="222" text-anchor="middle">
					Chest radiograph
				</text>
				<text class="d-sub" x="333" y="202" text-anchor="middle">
					around 0.02 mSv
				</text>

				<text class="d-label" x="657" y="282" text-anchor="middle">
					Lumbar spine
				</text>
				<text class="d-sub" x="657" y="262" text-anchor="middle">
					around 0.7 mSv
				</text>

				<text class="d-label" x="753" y="222" text-anchor="middle">
					CT head
				</text>
				<text class="d-sub" x="753" y="202" text-anchor="middle">
					around 2 mSv
				</text>

				<text class="d-label" x="880" y="282" text-anchor="middle">
					CT abdomen
				</text>
				<text class="d-sub" x="880" y="262" text-anchor="middle">
					around 8 mSv
				</text>

				<line class="d-rule" x1="40" y1="430" x2="920" y2="430" />
				<text class="d-note" x="40" y="462">
					MRI and ultrasound use no ionising radiation. For X-ray and CT the duty is to justify the exposure
				</text>
				<text class="d-note" x="40" y="484">
					and then to optimise it, keeping the dose as low as reasonably practicable for the diagnostic purpose.
				</text>
			</g>
		)
	}
	{
		name === "local-only" && (
			<g>
				<text class="d-cap" x="40" y="46">
					Local only
				</text>
				<text class="d-title" x="40" y="80">
					Nothing leaves the device
				</text>
				<line class="d-rule" x1="40" y1="104" x2="920" y2="104" />

				<rect class="d-dash" x="60" y="140" width="560" height="330" />
				<text class="d-cap" x="80" y="172">
					Your device — browser session
				</text>

				<rect class="d-box" x="90" y="220" width="110" height="70" />
				<text class="d-label" x="145" y="252" text-anchor="middle">
					DICOM
				</text>
				<text class="d-sub" x="145" y="272" text-anchor="middle">
					file dropped
				</text>

				<line class="d-arrow" x1="204" y1="255" x2="228" y2="255" />
				<path class="d-head" d="M234 255 L226 251 L226 259 Z" />

				<rect class="d-box" x="240" y="220" width="110" height="70" />
