---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import PageIntro from '../components/PageIntro.astro';
import MedicalImageViewer from '../components/MedicalImageViewer.astro';
import Callout from '../components/Callout.astro';
import Figure from '../components/Figure.astro';
import Diagram from '../components/Diagram.astro';
import { SITE_TITLE } from '../consts';

const faqs = [
	{
		q: 'Are the scans used in case discussions real?',
		a: 'All images shown are either anonymised, licence-free illustrative material or fully anonymised source series with all identifiers removed. Nothing personally identifying is ever reproduced.',
	},
	{
		q: 'Is radiation exposure safe?',
		a: 'Every modern imaging examination is justified and optimised to keep dose as low as reasonably achievable (ALARA). The benefits of a correctly indicated scan almost always far outweigh the small radiation risk.',
	},
	{
		q: 'Do I need to do anything to prepare?',
		a: 'Preparation depends on the examination. Your referring clinician and the imaging department will give modality-specific instructions — for example, fasting before certain CT scans, or removing metal before MRI.',
	},
	{
		q: 'Which modality is best for my condition?',
		a: 'There is no single "best" modality — CT, MRI, ultrasound and X-ray each answer different questions. Your clinician will select the most appropriate test based on your symptoms and the clinical question.',
	},
];
---

<BaseLayout title={`Patient Advice | ${SITE_TITLE}`} description="Accessible, plain-language information about MRI, CT, ultrasound and X-ray, radiation safety, preparation guidelines and frequently asked questions.">
	<PageHero
		eyebrow="Radiology library · For patients"
		title="Patient Advice"
		description="Part of the radiology library, written for patients: clear information about the imaging examinations you may be asked to undergo — from how each modality works to preparation and safety."
	/>

	<PageIntro
		eyebrow="Radiology library · For patients"
		paragraphs={[
			'The patient-facing part of the radiology library. It explains, without jargon, what happens during X-ray, CT, MRI and ultrasound, why a particular test may be chosen, and what you can do to prepare.',
			'It is written for patients and carers, and for referrers who want something plain to hand to a patient. It is general information only and does not replace advice from your own clinician.',
		]}
		contents={[
			{ href: '#modalities-explained', label: 'Modalities explained' },
			{ href: '#radiation-safety', label: 'Radiation safety' },
			{ href: '#preparation', label: 'Preparation' },
			{ href: '#common-questions', label: 'Common questions' },
		]}
		reviewed="September 2026"
	/>

	<!-- Modalities -->
	<section id="modalities-explained" class="scroll-mt-24 bg-white py-16">
		<div class="container-page">
			<div class="doc">
				<span class="eyebrow">Understanding your scan</span>
				<h2 class="sec-h-lg">Imaging modalities explained</h2>
				<div class="mt-10 space-y-8">
					<MedicalImageViewer
						src="/images/open_mr_scanner.jpg"
						alt="Open MRI scanner"
						caption="MRI uses a strong magnetic field to produce detailed images of soft tissues, joints and the nervous system — with no ionising radiation."
						modality="MRI"
					/>
					<MedicalImageViewer
						src="/images/ct_scanner.jpg"
						alt="CT scanner"
						caption="CT (computed tomography) uses X-rays to build cross-sectional images quickly — ideal in trauma and for abdominal and chest imaging."
						modality="CT"
					/>
					<MedicalImageViewer
						src="/images/knee_xray_pen_pointing.jpg"
						alt="Knee X-ray"
						caption="Plain X-ray is the first-line test for bones, joints and the chest — fast, inexpensive and low-dose."
						modality="X-ray"
					/>
					<MedicalImageViewer
						src="/images/head_ct_images.jpg"
						alt="Head CT images"
						caption="Ultrasound (and specialist neuroradiology) exams are guided in real time — safe, radiation-free and well suited to many soft-tissue and vascular questions."
						modality="US / CT"
					/>
				</div>
			</div>
		</div>
	</section>

	<!-- Safety -->
	<section id="radiation-safety" class="scroll-mt-24 border-y border-slate-200 bg-paper py-16">
		<div class="container-page">
			<div class="doc">
				<span class="eyebrow">Radiation safety</span>
				<h2 class="sec-h-lg">Justification &amp; optimisation</h2>
				<div id="preparation" class="mt-8 scroll-mt-24 border-t border-slate-300 pt-6">
					<h3 class="font-serif text-lg font-bold text-slate-900">Preparation summary</h3>
					<dl class="mt-4 w-full border-collapse text-left">
						{[
							{ k: 'MRI', v: 'Remove all metal (jewellery, piercings, cards). Empty pockets. Inform staff of any implants or medical devices.' },
							{ k: 'CT with contrast', v: 'May require fasting and a kidney-function check; tell staff about allergies or diabetes.' },
							{ k: 'Ultrasound', v: "Some exams (e.g. bladder or pelvis) require a full bladder or fasting. Follow the department's instruction." },
							{ k: 'X-ray', v: 'Usually no preparation needed — just remove the relevant clothing or jewellery.' },
						].map((row) => (
							<div class="grid gap-1 border-b border-slate-200 py-3 sm:grid-cols-[10rem_1fr] sm:gap-4">
								<dt class="font-sans text-[0.7rem] font-semibold uppercase tracking-[0.12em] text-slate-500 sm:pt-1">{row.k}</dt>
								<dd class="font-serif text-sm leading-relaxed text-slate-700">{row.v}</dd>
							</div>
						))}
					</dl>
				</div>
				<div class="mt-8 space-y-4 border-t border-slate-200 pt-6 font-serif leading-relaxed text-slate-600">
					<p>Every examination that uses ionising radiation is justified by a clinician — meaning the potential benefit must outweigh the small risk. Imaging is then optimised so the lowest possible dose is used to answer the clinical question (the ALARA principle).</p>
					<p>MRI and ultrasound use <strong>no ionising radiation</strong> at all. For CT and X-ray, modern systems auto-adjust dose to patient size while preserving diagnostic quality.</p>
					<p>If you are pregnant or may be pregnant, always tell the imaging department so that the examination can be reconsidered or adjusted accordingly.</p>
				</div>
				<Figure
					label="Figure 01"
					caption="How much radiation each type of scan involves"
					subtitle="MRI and ultrasound use no ionising radiation at all. For X-ray and CT the dose is kept as low as reasonably practicable for the question being answered."
				>
					<Diagram name="dose-scale" />
				</Figure>
			</div>
		</div>
	</section>

	<!-- FAQs -->
	<section id="common-questions" class="scroll-mt-24 bg-white py-16">
		<div class="container-page">
			<div class="doc">
				<span class="eyebrow">Frequently asked questions</span>
				<h2 class="sec-h-lg">Common questions</h2>
				<div class="stack-divide-top">
					{faqs.map((f) => (
						<details class="group py-5">
							<summary class="flex cursor-pointer items-center justify-between gap-4 font-serif text-[0.975rem] font-bold text-slate-900">
								{f.q}
								<span class="font-sans text-lg font-normal text-slate-400 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
							</summary>
							<p class="mt-3 font-serif text-[0.95rem] leading-relaxed text-slate-600">{f.a}</p>
						</details>
					))}
				</div>

			<Callout tone="limit" title="When to ask your own clinician">
				<p>
					This page is general information, not advice about your individual case. If you are worried
					about a symptom, a result, or whether an examination is right for you, speak to the clinician
					who referred you or the department performing the examination. They have your history and can
					answer for your circumstances.
				</p>
			</Callout>
		</div>
	</section>
</BaseLayout>