---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import PageIntro from '../../components/PageIntro.astro';
import { getCollection } from 'astro:content';
import { SITE_TITLE, BLOG_CATEGORIES, PAGE_HERO_IMAGES } from '../../consts';
import { formatDateShort } from '../../lib/utils';

const allPosts = (await getCollection('recent-developments')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const categoryLabel = (id: string) => BLOG_CATEGORIES.find((c) => c.id === id)?.label ?? id;

export const prerender = true;
---

<BaseLayout title={`Recent Developments | ${SITE_TITLE}`} description="Recent developments across radiology and medicolegal law — anonymised case discussions on negligence, quantum, practice and procedure, MSK, gastrointestinal and peritoneal malignancy, and the reporting standards behind them.">
	<PageHero
		eyebrow="Recent developments"
		title="Recent Developments"
		description="Anonymised analysis of recent issues at the intersection of radiology and the law — from delayed diagnosis and causation to reporting standards, teleradiology and expert-report practice."
		heroImage={PAGE_HERO_IMAGES["/recent-developments"]}
	/>

	<PageIntro
		eyebrow="Commentary on recent cases"
		paragraphs={[
			'This is the part of the resource worth returning to: short, anonymised commentary on recent cases and developments that raise an interesting radiological or legal point.',
			'Each piece says what happened, what the imaging showed, what the court or tribunal was asked to decide, and what a radiologist should take from it. The selection is deliberately small — a few cases at a time, chosen because they change how a question should be answered.',
		]}
		contents={[
			{ href: '#latest-commentary', label: 'Latest commentary' },
			{ href: '#browse-by-subject', label: 'Browse by subject' },
		]}
		audience="Written for radiologists, solicitors, barristers and insurers. All material is anonymised in accordance with GMC guidance and CPR Part 35."
		reviewed="September 2026"
	/>

	<section class="band">
		<div class="container-page">
			<!-- Browse by subject -->
			<div id="browse-by-subject" class="doc scroll-mt-24">
				<div class="sec">
					<p class="meta-label">Filter</p>
					<h2 class="sec-title">
						Browse by subject
					</h2>
					<p id="blog-count" class="mt-3 text-muted-alt" aria-live="polite">
						Showing all {allPosts.length} pieces
					</p>
				</div>
				<div id="blog-filters" class="mt-6 flex flex-wrap gap-2">
					{BLOG_CATEGORIES.map((c) => (
						<button type="button" class="chip cursor-pointer transition-colors hover:border-slate-600" data-category={c.id}>
							{c.label}
						</button>
					))}
				</div>
			</div>

			<!-- Posts -->
			<div id="latest-commentary" class="doc mt-14 scroll-mt-24">
				<div class="sec">
					<p class="meta-label">Latest</p>
					<h2 class="sec-title">
						Latest commentary
					</h2>
					<p class="standfirst">
						Newest first. Each piece is a short analysis rather than a full case report, and all
						clinical detail is anonymised.
					</p>
				</div>
				<div id="blog-grid" class="entry-list-ruled mt-8">
				{allPosts.map((post, i) => (
					<article class="blog-card py-7" data-categories={post.data.category}>
						<div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
							<span class="sec-no">
								§ {String(i + 1).padStart(2, "0")}
							</span>
							<span class="text-muted-alt">{categoryLabel(post.data.category)}</span>
							<span class="text-muted-light">{formatDateShort(post.data.pubDate)}</span>
						</div>
						<h2 class="mt-2 font-serif text-lg font-bold leading-snug text-slate-900">
							<a href={`/recent-developments/${post.slug}`} class="hover:underline hover:decoration-slate-400 hover:underline-offset-4">{post.data.title}</a>
						</h2>
						<p class="para-sm">{post.data.description}</p>
					</article>
				))}
				</div>
			</div>
		</div>
	</section>
</BaseLayout>

<script>
	const filters = document.getElementById("blog-filters");
	const grid = document.getElementById("blog-grid");
	const count = document.getElementById("blog-count");
	const cards = Array.from(grid?.querySelectorAll(".blog-card") ?? []);

	function apply(cat: string) {
		filters?.querySelectorAll("[data-category]").forEach((node) => {
			const btn = node as HTMLElement;
			const active = btn.dataset.category === cat;
			btn.classList.toggle("bg-slate-800", active);
			btn.classList.toggle("text-white", active);
		});
		let shown = 0;
		cards.forEach((card) => {
			const match = cat === "all" || card.dataset.categories === cat;
			(card as HTMLElement).style.display = match ? "" : "none";
			if (match) shown++;
		});
		if (count) count.textContent = `Showing ${shown} of ${cards.length} pieces`;
	}

	filters?.addEventListener("click", (e) => {
		const btn = (e.target as HTMLElement).closest("[data-category]") as HTMLElement | null;
		if (!btn) return;
		apply(btn.dataset.category ?? "all");
	});

	apply("all");
</script>
