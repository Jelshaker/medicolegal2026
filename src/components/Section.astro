---
// Reusable content section wrapper with optional eyebrow + title.
// All new props are optional, so existing call sites render unchanged.
// `id` gives the section a stable anchor (called from PageIntro `contents`),
// `index` prints a section number, and `lead` states the point of the section
// in one sentence before the detail.
interface Props {
	id?: string;
	eyebrow?: string;
	/** Section number, e.g. "01". */
	index?: string;
	title?: string;
	lead?: string;
	span?: 1 | 2;
	children?: string;
}

const { id, eyebrow, index, title, lead = "" } = Astro.props as Props;
const headingId = id ? `${id}-heading` : undefined;
---

<section id={id} aria-labelledby={headingId} class="scroll-mt-24 space-y-8">
	<div class="border-t border-slate-200 pt-8 dark:border-navy-700">
		{(index || eyebrow) && (
			<div class="flex items-center gap-3">
				{index && <span class="text-xs font-bold tabular-nums text-teal-600 dark:text-teal-400">{index}</span>}
				{eyebrow && <span class="eyebrow">{eyebrow}</span>}
			</div>
		)}
		{title && (
			<h2 id={headingId} class="mt-2 text-2xl font-bold tracking-tight text-navy-900 dark:text-white sm:text-3xl">
				{title}
			</h2>
		)}
		{lead && <p class="mt-3 max-w-2xl text-lg leading-relaxed text-slate-600 dark:text-slate-300">{lead}</p>}
	</div>
	<slot />
</section>