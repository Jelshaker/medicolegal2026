---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Callout from "../components/Callout.astro";
import { getCollection } from "astro:content";
import {
  SITE_TITLE,
  SITE_DESCRIPTION,
  SITE_TAGLINE,
  BLOG_CATEGORIES,
  PAGE_HERO_IMAGES,
} from "../consts";

const radiologyFundamentalsTitle = "Radiology fundamentals";
const medicolegalFundamentalsTitle = "Medicolegal fundamentals";
const radiologyLegislationTitle = "Radiology Legislation";
const radiologyCaseLawTitle = "Radiology Case Law";
const importantNewCasesTitle = "Important New Cases";

const allPosts = (await getCollection("recent-developments")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const featured = allPosts.find((p) => p.data.featured) ?? allPosts[0];
const recent = allPosts.slice(0, 3);
const categoryLabel = (id: string) =>
  BLOG_CATEGORIES.find((c) => c.id === id)?.label ?? id;
---

<BaseLayout
  title={`${SITE_TITLE} — ${SITE_TAGLINE}`}
  description={SITE_DESCRIPTION}
>
  <!-- Masthead -->
  <PageHero
    eyebrow="Radiology · Law · Reference resource"
    title="A radiologist's guide to medicolegal law."
    description="A free reference resource for anyone dealing with radiology and the law: from how common radiological investigations are performed, interpreted, and reported, to the governing reporting standards, statutory duties, and legal consequences when things go wrong. Written with radiologists and healthcare professionals in mind."
    heroImage={PAGE_HERO_IMAGES["/"] as string}
  >
    <div
      class="mt-8 flex flex-wrap justify-center gap-x-8 gap-y-2 divider pt-5"
    >
      <a href="/radiology-resources" class="link-hero">Radiology reference</a>
      <a href="/medicolegal-fundamentals" class="link-hero"
        >Medicolegal law library</a
      >
      <a href="/dicom-viewer" class="link-hero">DICOM viewer</a>
    </div>
  </PageHero>

  <!-- Why this exists -->
  <section class="divider-below bg-white py-16">
    <div class="container-page doc">
      <div class="sec">
        <p class="meta-label">A brief explainer why this website exists</p>
        <h1 class="sec-title-lg">What is Radiology Law?</h1>
        <p class="para">
          "The recent tidal wave of AI slop has made it increasingly difficult
          to separate real case law from hallucinated nonsense. As a practising
          radiologist with a master's degree in healthcare ethics and law, I
          have a profound interest in ethics and legal issues in healthcare,
          especially with cases relevant to clinical radiology. In my free time,
          I like to read up on recent medicolegal news (a pastime I find
          interesting and intellectually stimulating if not a little nerdy) and
          occasionally I even discover important lessons I can apply to my
          clinical practice."
        </p>
        <p class="para">
          The main purpose of this website is therefore to serve as a <em
            >human reviewed</em
          > and <em>trustworthy</em>
          resource for myself and other radiologists, lawyers and patients to help
          serve as a guide through medicolegal case law, with a special emphasis on
          radiology.
        </p>
      </div>
    </div>
  </section>

  <!-- Breaking news — most recent recent-development -->
  <section class="divider-below bg-ink-strong py-14">
    <div class="container-page doc">
      <div>
        <p class="meta-label" style="color: #e2e8f0;">
          Most Recent Case Update
        </p>
        <h2
          class="mt-3 font-serif text-xl font-bold leading-snug text-white sm:text-2xl text-balance break-words"
          style="text-shadow: 0 2px 8px rgba(0 0 0 / 0.5);"
        >
          {allPosts[0].data.title}
        </h2>
        <p class="para mt-3 text-slate-200">
          {allPosts[0].data.description}
        </p>
        <p class="mt-2 text-slate-400">
          {
            (allPosts[0].data.pubDate as Date).toLocaleDateString("en-GB", {
              day: "numeric",
              month: "long",
              year: "numeric",
            })
          }
          · {categoryLabel(allPosts[0].data.category)}
        </p>
        <div class="mt-6 flex flex-wrap gap-x-8 gap-y-2">
          <a
            href={`/recent-developments/${allPosts[0].slug}`}
            class="btn btn-primary">Read the analysis</a
          >
          <a href="/recent-developments" class="btn btn-outline-white"
            >See more →</a
          >
        </div>
      </div>
    </div>
  </section>

  <!-- How this resource is laid out -->
  <section class="divider-below bg-white py-16">
    <div class="container-page doc">
      <div class="sec">
        <p class="meta-label">Website Structure</p>
        <h2 class="sec-title-lg">From Fundamentals to Recent Events</h2>
        <p class="para">
          I have organised this site in a way to try to ensure that everyone,
          from first time visitors to legal experts, are on a level playing
          field both <em>clinically</em> and <em>legally</em>. This site
          provides a clear, thorough understanding of clinical radiology as a
          specialty, the legislation and regulations governing it, foundational
          medicolegal case law, and important recent judgments.
        </p>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 mt-10">
        <article class="tile pad-box">
          <span class="sec-no">Section 01</span>
          <h3 class="mt-2 font-serif text-lg font-bold text-slate-900">
            {radiologyFundamentalsTitle}
          </h3>
          <p class="para-sm mt-2">
            This section covers common radiology studies, their typical uses and
            their limitations. Brief discussion on the dangers inherent to
            radiology investigations and ways that risks are mitigated and an
            overview of how images are handled, quality assurance and relevant
            legislation.
          </p>
          <a href="/radiology-resources" class="link-sm mt-4 inline-block"
            >Open {radiologyFundamentalsTitle}</a
          >
        </article>
        <article class="tile pad-box">
          <span class="sec-no">Section 02</span>
          <h3 class="mt-2 font-serif text-lg font-bold text-slate-900">
            {medicolegalFundamentalsTitle}
          </h3>
          <p class="para-sm mt-2">
            Foundational medicolegal principles such as Bolam and Bolitho and
            Montgomery consent. Important legislation and regulations that
            govern radiology practice, including IRR17 and IR(ME)R, the
            statutory duties, and the duty of candour.
          </p>
          <a href="/medicolegal-fundamentals" class="link-sm mt-4 inline-block"
            >Open {medicolegalFundamentalsTitle}</a
          >


        </article>
        <article class="tile pad-box">
          <span class="sec-no">Section 03</span>
          <h3 class="mt-2 font-serif text-lg font-bold text-slate-900">
            {radiologyCaseLawTitle}
          </h3>
          <p class="para-sm mt-2">
            This section focuses on important case law in radiology.
          </p>
          <a href="/radiology-legal-cases" class="link-sm mt-4 inline-block"
            >Open {radiologyCaseLawTitle}</a
          >
        </article>
        <article class="tile pad-box">
          <span class="sec-no">Section 04</span>
          <h3 class="mt-2 font-serif text-lg font-bold text-slate-900">
            {importantNewCasesTitle}
          </h3>
          <p class="para-sm mt-2">
            Regularly updated with new and important cases, this section
            contains the most recent case discussions and analysis.
          </p>
          <a href="/recent-developments" class="link-sm mt-4 inline-block"
            >Open {importantNewCasesTitle}</a
          >
        </article>
        <article class="tile pad-box">
          <span class="sec-no">Section 05</span>
          <h3 class="mt-2 font-serif text-lg font-bold text-slate-900">
            {radiologyLegislationTitle}
          </h3>
          <p class="para-sm mt-2">
            The statutory framework under radiological practice: who each duty binds, what it requires, what must be recorded, and what follows from a failure. Summary only — the primary text governs.
          </p>
          <a href="/radiology-legislation" class="link-sm mt-4 inline-block">Browse the legislation</a>
        </article>
      </div>
    </div>
  </section>

  <!-- Free DICOM viewer — advertise the page; viewer stays on its own page -->
  <section class="divider-below bg-paper py-16">
    <div class="container-page doc text-center">
      <div class="sec">
        <p class="meta-label">A Super Useful Free Tool</p>
        <h2 class="sec-title-lg">Free DICOM Image Viewer</h2>
        <p class="para mx-auto" style="max-width: 48rem;">
          This page contains a free browser-based DICOM viewer which can allow
          anyone with DICOM images to review them in complete privacy and
          without uploading them to any server - it is done all in the browser.
          Successfully tested with plain films (x-rays), CT and MRI scans. This
          viewer is a great tool for radiologists, legal professionals and
          patients to review anonymised DICOM images in a secure and private
          manner.
        </p>
        <a href="/dicom-viewer" class="btn btn-primary mt-8"
          >Open the DICOM viewer</a
        >
      </div>
    </div>
  </section>

  <!-- What this resource is — and what it is not -->
  <section class="divider-below bg-white py-14">
    <div class="container-page doc entry-list mt-0">
      <div class="pb-8">
        <div class="flex items-baseline gap-3">
          <span class="sec-no">§ 01</span>
          <span class="meta-label">Scope</span>
        </div>
        <h2 class="mt-2 font-serif text-xl font-bold text-slate-900">
          Small and Specific
        </h2>
        <p class="para">
          This is a deliberate resource. It holds a selective set of entries
          on radiology and medicolegal law, each one sourced to the statute,
          standard or decision behind it, rather than attempting to be a
          complete text.
        </p>
      </div>
      <div class="py-8">
        <div class="flex items-baseline gap-3">
          <span class="sec-no">§ 02</span>
          <span class="meta-label">Commentary</span>
        </div>
        <h2 class="mt-2 font-serif text-xl font-bold text-slate-900">
          Recent case commentary
        </h2>
        <p class="para">
          Its distinguishing feature is short, anonymised commentary on recent
          cases that raise an interesting radiological or legal point. Every
          piece says what the imaging showed, what the court was asked to
          decide, and what a radiologist should take from it.
        </p>
      </div>
      <div class="pt-2">
        <Callout tone="caution" title="What it is not">
          <p>
            It is not a substitute for the primary sources, not a comprehensive
            case database, and not legal or clinical advice. Where a matter
            needs a radiological opinion, instruction is handled through the
            practice behind the resource.
          </p>
        </Callout>
      </div>
    </div>
  </section>
</BaseLayout>
