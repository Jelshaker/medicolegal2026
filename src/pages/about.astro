---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import PageIntro from "../components/PageIntro.astro";
import Section from "../components/Section.astro";
import Figure from "../components/Figure.astro";
import { PRACTITIONER, MEMBERSHIPS, SITE_TITLE } from "../consts";

const scope = [
	{
		t: "Delayed diagnosis",
		d: "Whether a finding was demonstrable on the images as acquired, and whether any delay materially altered the treatment pathway or outcome.",
	},
	{
		t: "Staging & incidental findings",
		d: "Tumour staging errors, peritoneal disease, and pathology that was incidental to the clinical question actually asked of the reporter.",
	},
	{
		t: "Consent & interventional practice",
		d: "Whether material risks were explained and documented, and whether complications were disclosed promptly and candidly.",
	},
	{
		t: "Measurement & quantum",
		d: "Reproducibility of size, angle and index measurements where damages turn on a numerical threshold.",
	},
	{
		t: "Teleradiology & systemic risk",
		d: "The reporting chain as a whole — the individual reporter, the reporting provider, escalation protocols and contract safeguards.",
	},
	{
		t: "Protocol adequacy",
		d: "Whether the study performed was capable of answering the clinical question, and whose decision that protocol was.",
	},
];

const standards = [
	{ n: "Bolam v Friern Hospital Management Committee [1957] 1 WLR 582", d: "The standard of care — a responsible body of skilled professional opinion." },
	{ n: "Bolitho v City and Hackney HA [1997] UKHL 46", d: "A body of opinion must have a logical basis before it can defeat a claim." },
	{ n: "Montgomery v Lanarkshire Health Board [2015] UKSC 11", d: "Consent judged by the materiality of risk to a reasonable patient in that patient's position." },
	{ n: "CPR Part 35 and PD 35", d: "The overriding duty to the court, the required form of the report, and the limits of expert advocacy." },
	{ n: "Ikarian Reefer [1993] 2 Lloyd's Rep 68", d: "The classic statement of an expert's independent duties, including the duty to state the basis of opinion." },
	{ n: "GMC Good Medical Practice & Confidentiality guidance", d: "Professional obligations on record-keeping, candour and the handling of patient information." },
	{ n: "RCR Standards for interpretation and reporting (2025)", d: "The professional benchmark for report content, escalation, remote reporting and AI-assisted reporting." },
	{ n: "EMA / Expert Witness Institute Code of Practice", d: "Duties of competence, impartiality, confidentiality and the maintenance of a complaints procedure." },
];
---

<BaseLayout
	title={`About | ${SITE_TITLE}`}
	description="The curator of this radiology and medicolegal law resource: Dr Joseph El-Sheikha, Consultant Radiologist and medicolegal expert witness — how the reference material is maintained, and the scope of his independent CPR Part 35 opinions on delayed diagnosis, staging error, consent and teleradiology."
>
	<PageHero
		eyebrow="About this resource"
		title={PRACTITIONER.shortName}
		description="Consultant Radiologist, independent medicolegal expert witness, and the curator of this reference resource. The opinion I provide is written for the court rather than for the party instructing me."
	/>

	<PageIntro
		eyebrow="About this resource"
		paragraphs={[
			"The resource is curated by a single consultant radiologist in NHS practice with an independent medicolegal workload. That is deliberate: a small resource can be kept accurate and sourced, and does not accumulate the padding that larger collections do.",
			"The commentary is written from practice rather than from a textbook, and is checked against the primary sources cited throughout.",
		]}
		contents={[
			{ href: "#independence", label: "Independence" },
			{ href: "#scope", label: "Scope of practice" },
			{ href: "#standards", label: "Standards worked to" },
			{ href: "#memberships", label: "Memberships" },
			{ href: "#next-steps", label: "Next steps" },
		]}
		audience="Written for radiologists, trust legal teams, solicitors, barristers, insurers and expert witnesses."
		reviewed="September 2026"
	/>

	<section class="band">
		<div class="container-page">
			<div class="doc space-y-12">
				<Section
					id="independence"
					index="01"
					eyebrow="Independent expert evidence"
					title="Opinion written for the court, not for the party instructing me"
					lead="An expert's overriding duty is to the court. The method does not change with the side that has instructed me."
				>
					<p class="para">
						My practice is a radiological one with a legal method. The images answer technical questions —
						what was acquired, what was demonstrable, what a competent reporter would have seen at the
						time — and the law then asks separate questions about breach, causation and loss. Keeping those
						analyses apart is the discipline that makes an expert report useful, and it is the reason a
						report stands up in cross-examination.
					</p>
					<p class="para">
						I accept instructions from claimants and defendants alike. Under CPR 35.3 an expert's
						overriding duty is to the court, so the analysis is the same whichever side has instructed me:
						re-derive from the source DICOM, reconstruct the contemporaneous conditions, state clearly what
						is fact and what is opinion, and set out what would change my view. Where the radiological
						evidence does not support the case being advanced, the report says so.
					</p>
					<p class="para">
						I do not express opinions outside my competence. Questions of surgical technique, oncology
						management or life expectancy fall to surgeons and oncologists; my role is to define precisely
						what imaging did and did not show, and to identify where a radiological conclusion ends and
						another discipline's begins.
					</p>
					<div class="mx-auto mt-10 max-w-sm">
						<Figure
							src={PRACTITIONER.photo}
							alt={PRACTITIONER.shortName}
							label="Plate 01"
							caption={PRACTITIONER.shortName}
							subtitle="Consultant Radiologist and independent medicolegal expert witness."
							ratio="portrait"
							flush
						/>
					</div>
					<table class="mt-10 w-full border-collapse text-left">
						<thead>
							<tr>
								<th scope="col" class="border-b border-slate-400 bg-paper px-3 py-2 font-sans text-[0.7rem] font-semibold uppercase tracking-[0.14em] text-slate-500">At a glance</th>
								<th scope="col" class="border-b border-slate-400 bg-paper px-3 py-2 font-sans text-[0.7rem] font-semibold uppercase tracking-[0.14em] text-slate-500">Particulars</th>
							</tr>
						</thead>
						<tbody>
							<tr>
								<th scope="row">Qualifications</th>
								<td>{PRACTITIONER.qualifications}</td>
							</tr>
							<tr>
								<th scope="row">Sub-specialty</th>
								<td>{PRACTITIONER.subspecialty}</td>
							</tr>
							<tr>
								<th scope="row">Registration</th>
								<td>{PRACTITIONER.gmcNumber}</td>
							</tr>
							<tr>
								<th scope="row">Indemnity</th>
								<td>{PRACTITIONER.indemnity}</td>
							</tr>
						</tbody>
					</table>
				</Section>

				<Section
					id="scope"
					index="02"
					eyebrow="Scope of practice"
					title="Where radiological opinion decides the issue"
					lead="These are the questions in which a radiological opinion is usually decisive rather than peripheral."
				>
					<div class="entry-list-ruled">
						{scope.map((s) => (
							<div class="entry">
								<h3 class="entry-title">{s.t}</h3>
								<p class="para-sm">{s.d}</p>
							</div>
						))}
					</div>
				</Section>

				<Section
					id="standards"
					index="03"
					eyebrow="The framework"
					title="Standards and authorities I work to"
					lead="The professional standards and legal authorities against which an imaging opinion is prepared and tested."
				>
					<div class="entry-list-ruled">
						{standards.map((s, i) => (
							<div class="py-4">
								<div class="flex items-baseline gap-3">
									<span class="font-sans text-[0.7rem] font-semibold tabular-nums tracking-[0.1em] text-slate-400">{String(i + 1).padStart(2, "0")}</span>
									<p class="font-serif text-sm font-bold text-slate-900">{s.n}</p>
								</div>
								<p class="para-sm mt-1">{s.d}</p>
							</div>
						))}
					</div>
				</Section>

				<Section id="memberships" eyebrow="Professional bodies" title="Memberships">
					<ul class="list">
						{MEMBERSHIPS.map((m) => <li>{m}</li>)}
					</ul>
				</Section>

				<Section id="next-steps" eyebrow="Elsewhere in the resource" title="Next steps">
					<ul class="mt-6 space-y-2.5 divider pt-4">
						<li><a href="/cv" class="link-sm">Full curriculum vitae</a></li>
						<li><a href="/expert-witness" class="link-sm">Expert witness services</a></li>
						<li><a href="/radiology-resources" class="link-sm">Radiology reference</a></li>
						<li><a href="/medicolegal-fundamentals" class="link-sm">Medicolegal law library</a></li>
						<li><a href="/sitemap" class="link-sm">Site map</a></li>
						<li><a href="/contact" class="link-sm">Contact the secretariat</a></li>
					</ul>
				</Section>
			</div>
		</div>
	</section>
</BaseLayout>
