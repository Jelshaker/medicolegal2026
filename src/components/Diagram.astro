---
// Drawn schematics for the reference pages. Every graphic is monochrome line
// work on a white ground so it sits inside the document design rather than
// competing with it: hairline strokes, sans-serif labels, no colour, no radius.
//
// Each diagram is drawn on a 960 × 540 (16:9) canvas, which matches the
// default `ratio="video"` of Figure.astro.
interface Props {
  name:
    | "legal-questions"
    | "reporting-chain"
    | "duty-holders"
    | "case-timeline"
    | "incidental-regions"
    | "dose-scale"
    | "local-only"
    | "instruction-cycle"
    | "resource-map";
}

const { name } = Astro.props as Props;
const labels: Record<Props["name"], string> = {
  "legal-questions":
    "Diagram: the four questions that decide a radiological claim",
  "reporting-chain":
    "Diagram: the reporting chain from referrer to communication",
  "duty-holders": "Diagram: the four duty holders under IR(ME)R 2017",
  "case-timeline": "Diagram: timeline of the principal decisions and standards",
  "incidental-regions": "Diagram: regions in which incidental findings arise",
  "dose-scale": "Diagram: relative effective dose across imaging modalities",
  "local-only":
    "Diagram: a browser-only workflow in which no data leaves the device",
  "instruction-cycle": "Diagram: the stages of an expert instruction",
  "resource-map": "Diagram: how the pages of the resource are organised",
};
---

<svg
  class="diagram"
  viewBox="0 0 960 540"
  role="img"
  aria-label={labels[name]}
  preserveAspectRatio="xMidYMid meet"
>
  {
    name === "legal-questions" && (
      <g>
        <text class="d-cap" x="40" y="46">
          Legal Framework
        </text>
        <text class="d-title" x="40" y="80">
          Four foundational questions governing a radiological claim
        </text>
        <line class="d-rule" x1="40" y1="104" x2="920" y2="104" />

        <!-- Box 01: Standard of Care -->
        <a href="#bolam" aria-label="Standard of care — Bolam v Friern [1957] 1 WLR 582">
          <rect class="d-box" x="40" y="150" width="190" height="220" />
          <text class="d-num" x="58" y="184">
            01
          </text>
          <text class="d-label" x="58" y="216">
            Standard of Care
          </text>
          <text class="d-sub" x="58" y="246">
            Bolam v Friern
          </text>
          <text class="d-sub" x="58" y="268">
            [1957] 1 WLR 582
          </text>
          <text class="d-sub" x="58" y="294">
            Bolitho v City &amp; Hackney
          </text>
          <text class="d-sub" x="58" y="316">
            [1998] AC 232
          </text>
        </a>

        <line class="d-arrow" x1="232" y1="260" x2="264" y2="260" />
        <path class="d-head" d="M270 260 L262 256 L262 264 Z" />

        <!-- Box 02: Breach -->
        <a href="#muller" aria-label="Breach of duty — Muller v King's College Hospital [2017] EWHC 128 (QB)">
          <rect class="d-box" x="270" y="150" width="190" height="220" />
          <text class="d-num" x="288" y="184">
            02
          </text>
          <text class="d-label" x="288" y="216">
            Breach of Duty
          </text>
          <text class="d-sub" x="288" y="246">
            Muller v KCH
          </text>
          <text class="d-sub" x="288" y="268">
            [2017] EWHC 128 (QB)
          </text>
          <text class="d-sub" x="288" y="294">
            FB v Kurian [2017]
          </text>
        </a>

        <line class="d-arrow" x1="462" y1="260" x2="494" y2="260" />
        <path class="d-head" d="M500 260 L492 256 L492 264 Z" />

        <!-- Box 03: Causation -->
        <a href="#barnett" aria-label="Causation — Barnett v Chelsea [1969] 1 QB 428">
          <rect class="d-box" x="500" y="150" width="190" height="220" />
          <text class="d-num" x="518" y="184">
            03
          </text>
          <text class="d-label" x="518" y="216">
            Causation
          </text>
          <text class="d-sub" x="518" y="246">
            Barnett v Chelsea
          </text>
          <text class="d-sub" x="518" y="268">
            [1969] 1 QB 428
          </text>
          <text class="d-sub" x="518" y="294">
            Gregg v Scott [2005]
          </text>
          <text class="d-sub" x="518" y="316">
            [2005] UKHL 2
          </text>
        </a>

        <line class="d-arrow" x1="692" y1="260" x2="724" y2="260" />
        <path class="d-head" d="M730 260 L722 256 L722 264 Z" />

        <!-- Box 04: Consent -->
        <a href="#montgomery" aria-label="Consent — Montgomery v Lanarkshire [2015] UKSC 11">
          <rect class="d-box" x="730" y="150" width="190" height="220" />
          <text class="d-num" x="748" y="184">
            04
          </text>
          <text class="d-label" x="748" y="216">
            Consent
          </text>
          <text class="d-sub" x="748" y="246">
            Montgomery v
          </text>
          <text class="d-sub" x="748" y="268">
            Lanarkshire
          </text>
          <text class="d-sub" x="748" y="294">
            [2015] UKSC 11
          </text>
        </a>

        <line class="d-rule" x1="40" y1="420" x2="920" y2="420" />
        <text class="d-note" x="40" y="452">
          The sequence of events required to establish clinical negligence under English law.
        </text>
      </g>
    )
  }
  {
    name === "reporting-chain" && (
      <g>
        <text class="d-cap" x="40" y="46">
          The chain
        </text>
        <text class="d-title" x="40" y="80">
          A report is one link in a chain of duties
        </text>
        <line class="d-rule" x1="40" y1="104" x2="920" y2="104" />

        <rect class="d-box" x="40" y="180" width="144" height="112" />
        <text class="d-num" x="54" y="210">
          01
        </text>
        <text class="d-label" x="54" y="242">
          Referrer
        </text>
        <text class="d-sub" x="54" y="266">
          Clinical question
        </text>
        <text class="d-sub" x="54" y="284">
          Sufficient information
        </text>

        <line class="d-arrow" x1="188" y1="236" x2="212" y2="236" />
        <path class="d-head" d="M218 236 L210 232 L210 240 Z" />

        <rect class="d-box" x="224" y="180" width="144" height="112" />
        <text class="d-num" x="238" y="210">
          02
        </text>
        <text class="d-label" x="238" y="242">
          Acquisition
        </text>
        <text class="d-sub" x="238" y="266">
          Protocol and technique
        </text>
        <text class="d-sub" x="238" y="284">
          Justification recorded
        </text>

        <line class="d-arrow" x1="372" y1="236" x2="396" y2="236" />
        <path class="d-head" d="M402 236 L394 232 L394 240 Z" />

        <rect class="d-box" x="408" y="180" width="144" height="112" />
        <text class="d-num" x="422" y="210">
          03
        </text>
        <text class="d-label" x="422" y="242">
          Reporting
        </text>
        <text class="d-sub" x="422" y="266">
          Demonstrable findings
        </text>
        <text class="d-sub" x="422" y="284">
          Named author
        </text>

        <line class="d-arrow" x1="556" y1="236" x2="580" y2="236" />
        <path class="d-head" d="M586 236 L578 232 L578 240 Z" />

        <rect class="d-box" x="592" y="180" width="144" height="112" />
        <text class="d-num" x="606" y="210">
          04
        </text>
        <text class="d-label" x="606" y="242">
          Report
        </text>
        <text class="d-sub" x="606" y="266">
          Conclusion and limits
        </text>
        <text class="d-sub" x="606" y="284">
          Structured format
        </text>

        <line class="d-arrow" x1="740" y1="236" x2="764" y2="236" />
        <path class="d-head" d="M770 236 L762 232 L762 240 Z" />

        <rect class="d-box" x="776" y="180" width="144" height="112" />
        <text class="d-num" x="790" y="210">
          05
        </text>
        <text class="d-label" x="790" y="242">
          Communication
        </text>
        <text class="d-sub" x="790" y="266">
          Critical results
        </text>
        <text class="d-sub" x="790" y="284">
          Fail-safe escalation
        </text>

        <path class="d-arrow" d="M664 292 L664 340 L848 340 L848 292" />
        <line class="d-arrow" x1="756" y1="340" x2="756" y2="374" />
        <path class="d-head" d="M756 380 L752 372 L760 372 Z" />

        <rect class="d-box" x="576" y="384" width="344" height="96" />
        <text class="d-label" x="596" y="418">
          Communication is part of the standard
        </text>
        <text class="d-sub" x="596" y="444">
          The duty does not end with the report. Where a finding
        </text>
        <text class="d-sub" x="596" y="462">
          needs action, it must reach someone who will act on it.
        </text>

        <text class="d-note" x="40" y="418">
          A claim can attach at any link:
        </text>
        <text class="d-note" x="40" y="444">
          the protocol that could not answer
        </text>
        <text class="d-note" x="40" y="462">
          the question, the finding that was
        </text>
        <text class="d-note" x="40" y="480">
          demonstrable, or the result that
        </text>
        <text class="d-note" x="40" y="498">
          never reached the clinician.
        </text>
      </g>
    )
  }
  {
    name === "duty-holders" && (
      <g>
        <text class="d-cap" x="40" y="46">
          Duty holders
        </text>
        <text class="d-title" x="40" y="80">
          Four roles, one exposure
        </text>
        <line class="d-rule" x1="40" y1="104" x2="920" y2="104" />

        <rect class="d-box" x="60" y="150" width="380" height="160" />
        <text class="d-num" x="80" y="182">
          EMPLOYER
        </text>
        <text class="d-label" x="80" y="216">
          Provides the framework
        </text>
        <text class="d-sub" x="80" y="246">
          Written procedures, training and
        </text>
        <text class="d-sub" x="80" y="264">
          the incident reporting system.
        </text>

        <rect class="d-box" x="520" y="150" width="380" height="160" />
        <text class="d-num" x="540" y="182">
          REFERRER
        </text>
        <text class="d-label" x="540" y="216">
          Supplies the clinical question
        </text>
        <text class="d-sub" x="540" y="246">
          Sufficient clinical information, and
        </text>
        <text class="d-sub" x="540" y="264">
          entitlement to refer the patient.
        </text>

        <rect class="d-box" x="60" y="330" width="380" height="160" />
        <text class="d-num" x="80" y="362">
          PRACTITIONER
        </text>
        <text class="d-label" x="80" y="396">
          Justifies each exposure
        </text>
        <text class="d-sub" x="80" y="426">
          Takes clinical responsibility for the
        </text>
        <text class="d-sub" x="80" y="444">
          justification and its basis.
        </text>

        <rect class="d-box" x="520" y="330" width="380" height="160" />
        <text class="d-num" x="540" y="362">
          OPERATOR
        </text>
        <text class="d-label" x="540" y="396">
          Performs the practical aspects
        </text>
        <text class="d-sub" x="540" y="426">
          Must be entitled and trained for
        </text>
        <text class="d-sub" x="540" y="444">
          the task actually carried out.
        </text>

        <rect class="d-fill" x="450" y="288" width="60" height="64" />
        <text class="d-cap" x="480" y="306" text-anchor="middle">
          IR(ME)R
        </text>
        <text class="d-cap" x="480" y="324" text-anchor="middle">
          2017
        </text>
      </g>
    )
  }
  {
    name === "incidental-regions" && (
      <g>
        <text class="d-cap" x="40" y="46">
          Incidental findings
        </text>
        <text class="d-title" x="40" y="80">
          Pathology found outside the question that was asked
        </text>
        <line class="d-rule" x1="40" y1="104" x2="920" y2="104" />

        <ellipse class="d-outline" cx="330" cy="300" rx="180" ry="130" />
        <ellipse class="d-fill" cx="330" cy="300" rx="150" ry="104" />

        <rect class="d-box" x="312" y="382" width="36" height="26" />
        <ellipse class="d-box" cx="278" cy="346" rx="26" ry="18" />
        <ellipse class="d-box" cx="382" cy="346" rx="26" ry="18" />
        <ellipse class="d-box" cx="238" cy="252" rx="42" ry="30" />
        <circle class="d-box" cx="392" cy="250" r="17" />
        <circle class="d-box" cx="348" cy="286" r="13" />
        <circle class="d-box" cx="424" cy="300" r="11" />

        <line class="d-dash" x1="404" y1="346" x2="640" y2="196" />
        <line class="d-dash" x1="238" y1="252" x2="640" y2="286" />
        <line class="d-dash" x1="424" y1="300" x2="640" y2="376" />

        <text class="d-label" x="652" y="186">
          Renal
        </text>
        <text class="d-sub" x="652" y="208">
          A small renal mass seen on a study
        </text>
        <text class="d-sub" x="652" y="226">
          performed for a different indication.
        </text>

        <text class="d-label" x="652" y="276">
          Colonic
        </text>
        <text class="d-sub" x="652" y="298">
          Wall thickening without a dedicated
        </text>
        <text class="d-sub" x="652" y="316">
          colonic protocol or preparation.
        </text>

        <text class="d-label" x="652" y="366">
          Hepatic
        </text>
        <text class="d-sub" x="652" y="388">
          A deposit on a single-phase study
        </text>
        <text class="d-sub" x="652" y="406">
          not timed for the liver.
        </text>

        <line class="d-rule" x1="40" y1="448" x2="920" y2="448" />
        <text class="d-note" x="40" y="480">
          Around 37% of abdominal radiology claims cite incidental pathology.
          The question for the expert is
        </text>
        <text class="d-note" x="40" y="502">
          whether the finding fell within the responsibility created by the
          study that was actually performed.
        </text>
      </g>
    )
  }
  {
    name === "dose-scale" && (
      <g>
        <text class="d-cap" x="40" y="46">
          Dose
        </text>
        <text class="d-title" x="40" y="80">
          Effective dose on a normal scale
        </text>
        <line class="d-rule" x1="40" y1="104" x2="920" y2="104" />

        <line class="d-axis" x1="80" y1="340" x2="880" y2="340" />

        {/* X-axis ticks every 5 mSv */}
        <line class="d-axis" x1="80" y1="332" x2="80" y2="348" />
        <line class="d-axis" x1="280" y1="332" x2="280" y2="348" />
        <line class="d-axis" x1="480" y1="332" x2="480" y2="348" />
        <line class="d-axis" x1="680" y1="332" x2="680" y2="348" />
        <line class="d-axis" x1="880" y1="332" x2="880" y2="348" />

        <text class="d-sub" x="80" y="370" text-anchor="middle">
          0
        </text>
        <text class="d-sub" x="280" y="370" text-anchor="middle">
          5
        </text>
        <text class="d-sub" x="480" y="370" text-anchor="middle">
          10
        </text>
        <text class="d-sub" x="680" y="370" text-anchor="middle">
          15
        </text>
        <text class="d-sub" x="880" y="370" text-anchor="middle">
          20 mSv
        </text>

        {/* 40 px per mSv, x = 80 + dose × 40 */}

        {/* ---- Annual background dose: thin solid reference lines ---- */}

        {/* UK average — 2.7 mSv (x = 188) */}
        <line
          x1="188"
          y1="166"
          x2="188"
          y2="332"
          stroke="#94a3b8"
          stroke-width="1"
        />
        <line class="d-axis" x1="188" y1="332" x2="188" y2="348" />
        <text class="d-label" x="188" y="132" text-anchor="middle">
          UK average
        </text>
        <text class="d-sub" x="188" y="152" text-anchor="middle">
          2.7 mSv · annual
        </text>

        {/* Cornwall — 7.8 mSv (x = 392) */}
        <line
          x1="392"
          y1="166"
          x2="392"
          y2="332"
          stroke="#94a3b8"
          stroke-width="1"
        />
        <line class="d-axis" x1="392" y1="332" x2="392" y2="348" />
        <text class="d-label" x="392" y="132" text-anchor="middle">
          Cornwall
        </text>
        <text class="d-sub" x="392" y="152" text-anchor="middle">
          7.8 mSv · annual
        </text>

        {/* ---- Single medical procedure: thicker solid bars ---- */}

        {/* Chest radiograph — 0.02 mSv */}
        <line
          class="d-axis"
          x1="81"
          y1="340"
          x2="81"
          y2="308"
          stroke-width="3"
        />
        <text class="d-label" x="81" y="296" text-anchor="middle">
          Chest radiograph
        </text>
        <text class="d-sub" x="81" y="276" text-anchor="middle">
          0.02 mSv · per scan
        </text>

        {/* CT head — 2 mSv */}
        <line
          class="d-axis"
          x1="160"
          y1="340"
          x2="160"
          y2="250"
          stroke-width="3"
        />
        <text class="d-label" x="150" y="238" text-anchor="end">
          CT head
        </text>
        <text class="d-sub" x="150" y="218" text-anchor="end">
          2 mSv · per scan
        </text>

        {/* CT abdomen — 8 mSv */}
        <line
          class="d-axis"
          x1="400"
          y1="340"
          x2="400"
          y2="218"
          stroke-width="3"
        />
        <text class="d-label" x="422" y="206" text-anchor="start">
          CT abdomen
        </text>
        <text class="d-sub" x="422" y="186" text-anchor="start">
          8 mSv · per scan
        </text>

        {/* Occupational dose limit — 20 mSv */}
        <line
          class="d-axis"
          x1="880"
          y1="340"
          x2="880"
          y2="218"
          stroke-width="3"
        />
        <text class="d-label" x="860" y="206" text-anchor="end">
          Occupational limit
        </text>
        <text class="d-sub" x="860" y="186" text-anchor="end">
          20 mSv · annual
        </text>

        <line class="d-rule" x1="40" y1="430" x2="920" y2="430" />
        <text class="d-note" x="40" y="462">
          MRI and ultrasound use no ionising radiation. For X-ray and CT the
          exposure must be
        </text>
        <text class="d-note" x="40" y="484">
          justified and then optimised, keeping the dose as low as reasonably
          practicable.
        </text>
      </g>
    )
  }
  {
    name === "instruction-cycle" && (
      <g>
        <text class="d-cap" x="40" y="46">
          The instruction
        </text>
        <text class="d-title" x="40" y="80">
          From letter of instruction to the report
        </text>
        <line class="d-rule" x1="40" y1="104" x2="920" y2="104" />

        <rect class="d-box" x="40" y="180" width="148" height="120" />
        <text class="d-num" x="56" y="212">
          01
        </text>
        <text class="d-label" x="56" y="246">
          Instruction
        </text>
        <text class="d-sub" x="56" y="272">
          Letter of instruction and
        </text>
        <text class="d-sub" x="56" y="290">
          the questions to be answered.
        </text>

        <line class="d-arrow" x1="192" y1="240" x2="207" y2="240" />
        <path class="d-head" d="M213 240 L205 236 L205 244 Z" />

        <rect class="d-box" x="223" y="180" width="148" height="120" />
        <text class="d-num" x="239" y="212">
          02
        </text>
        <text class="d-label" x="239" y="246">
          Conflict check
        </text>
        <text class="d-sub" x="239" y="272">
          Competence, availability
        </text>
        <text class="d-sub" x="239" y="290">
          and independence confirmed.
        </text>

        <line class="d-arrow" x1="375" y1="240" x2="390" y2="240" />
        <path class="d-head" d="M396 240 L388 236 L388 244 Z" />

        <rect class="d-box" x="406" y="180" width="148" height="120" />
        <text class="d-num" x="422" y="212">
          03
        </text>
        <text class="d-label" x="422" y="246">
          Re-derivation
        </text>
        <text class="d-sub" x="422" y="272">
          Source DICOM reviewed on
        </text>
        <text class="d-sub" x="422" y="290">
          a diagnostic workstation.
        </text>

        <line class="d-arrow" x1="558" y1="240" x2="573" y2="240" />
        <path class="d-head" d="M579 240 L571 236 L571 244 Z" />

        <rect class="d-box" x="589" y="180" width="148" height="120" />
        <text class="d-num" x="605" y="212">
          04
        </text>
        <text class="d-label" x="605" y="246">
          Report
        </text>
        <text class="d-sub" x="605" y="272">
          CPR Part 35 form; fact and
        </text>
        <text class="d-sub" x="605" y="290">
          opinion kept separate.
        </text>

        <line class="d-arrow" x1="741" y1="240" x2="756" y2="240" />
        <path class="d-head" d="M762 240 L754 236 L754 244 Z" />

        <rect class="d-box" x="772" y="180" width="148" height="120" />
        <text class="d-num" x="788" y="212">
          05
        </text>
        <text class="d-label" x="788" y="246">
          Evidence
        </text>
        <text class="d-sub" x="788" y="272">
          Service on the parties and,
        </text>
        <text class="d-sub" x="788" y="290">
          if required, oral evidence.
        </text>

        <line class="d-rule" x1="40" y1="368" x2="920" y2="368" />
        <text class="d-note" x="40" y="400">
          The expert's overriding duty is to the court, not to the party
          instructing (CPR 35.3). The same method
        </text>
        <text class="d-note" x="40" y="422">
          is applied whether the instruction comes from a claimant or a
          defendant.
        </text>
        <text class="d-note" x="40" y="462">
