---
import { NAVIGATION_LINKS, PRACTITIONER, SITE_TITLE } from "../consts";

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
    href === "/" ? pathname === "/" : pathname.startsWith(href);
---

<header class="sticky top-0 z-50 border-b border-slate-300 bg-white px-4 md:px-8">
    <div class="container-page flex h-16 items-center justify-between gap-8 md:h-[4.75rem]">
        <a href="/" class="group shrink-0" aria-label={`${SITE_TITLE} — home`}>
            <span class="block font-serif text-[1.05rem] font-bold leading-tight text-slate-900">
                {PRACTITIONER.shortName}
            </span>
            <span class="meta-label mt-0.5 block !text-[0.62rem]">Radiology &amp; medicolegal law</span>
        </a>

        <!-- Desktop Navigation -->
        <nav class="hidden min-w-0 items-center gap-x-8 leading-tight lg:flex" aria-label="Primary">
            <div class="flex items-center gap-x-6">
                {
                    NAVIGATION_LINKS.map((link) => (
                        <a
                            href={link.href}
                            class:list={[
                                "relative py-1 font-sans text-[0.8rem] font-medium tracking-wide transition-colors duration-200",
                                "after:absolute after:bottom-0 after:left-0 after:h-[2px] after:w-full after:origin-left after:scale-x-0 after:bg-slate-900 after:transition-transform after:duration-300 hover:after:scale-x-100",
                                isActive(link.href)
                                    ? "text-slate-900 after:scale-x-100"
                                    : "text-slate-600 hover:text-slate-900",
                            ]}
                        >
                            {link.label}
                        </a>
                    ))
                }
            </div>

            <!-- Vertical Divider -->
            <div class="h-4 w-px bg-slate-200" aria-hidden="true"></div>

            <a href="/login" class="btn btn-ghost !px-4 !py-2 !text-xs shrink-0">Secure Login</a>
        </nav>

        <!-- Mobile Toggle & Actions -->
        <div class="flex items-center gap-3 lg:hidden">
            <a href="/login" class="btn btn-ghost hidden !px-4 !py-2 !text-xs sm:inline-flex lg:hidden">
                Secure Login
            </a>

            <button
                id="menu-toggle"
                type="button"
                class="flex h-10 w-10 items-center justify-center border border-slate-300 text-slate-700 hover:border-slate-900 hover:text-slate-900 lg:hidden"
                aria-label="Open menu"
                aria-expanded="false"
                aria-controls="mobile-menu"
            >
                <svg id="icon-burger" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M4 7h16M4 12h16M4 17h16" />
                </svg>
                <svg id="icon-close" class="hidden h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M6 6l12 12M18 6 6 18" />
                </svg>
            </button>
        </div>
    </div>

    <!-- Mobile Navigation Drawer -->
    <nav
        id="mobile-menu"
        class="hidden border-t border-slate-200 bg-white px-4 pb-4 pt-2 lg:hidden"
        aria-label="Mobile"
    >
        <ul class="flex flex-col">
            {
                NAVIGATION_LINKS.map((link) => (
                    <li class="border-b border-slate-100 last:border-b-0">
                        <a
                            href={link.href}
                            class:list={[
                                "block py-3 font-sans text-[0.9rem]",
                                isActive(link.href) ? "font-semibold text-slate-900" : "text-slate-600 hover:text-slate-900",
                            ]}
                        >
                            {link.label}
                        </a>
                    </li>
                ))
            }
            <li class="mt-3 border-t border-slate-200 pt-4">
                <a href="/login" class="btn btn-ghost w-full">Secure Client Login</a>
            </li>
        </ul>
    </nav>

<script>
    const menuToggle = document.getElementById("menu-toggle");
    const mobileMenu = document.getElementById("mobile-menu");
    const iconBurger = document.getElementById("icon-burger");
    const iconClose = document.getElementById("icon-close");

    menuToggle?.addEventListener("click", () => {
        const open = mobileMenu?.classList.toggle("hidden") !== true;
        menuToggle.setAttribute("aria-expanded", String(open));
        iconBurger?.classList.toggle("hidden", open);
        iconClose?.classList.toggle("hidden", !open);
    });

    if (mobileMenu) {
        mobileMenu.querySelectorAll("a").forEach((a) =>
            a.addEventListener("click", () => {
                mobileMenu.classList.add("hidden");
                iconBurger?.classList.remove("hidden");
                iconClose?.classList.add("hidden");
            }),
        );
    }
</script>
</header>