---
import { LOGIN_BUTTON_TEXT, NAVIGATION_LINKS, PRACTITIONER, SITE_BRAND_SUBTITLE, SITE_TITLE } from "../consts";

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
    href === "/" ? pathname === "/" : pathname.startsWith(href);

const navLinkClass = (href: string) =>
    isActive(href)
        ? "nav-link nav-link-active"
        : "nav-link nav-link-inactive";
---

<header class="site-header">
    <!-- The <header class="site-header"> is the sticky element: it must be the
         sticky one, because .sticky-bar fills it completely and a sticky child
         can never travel beyond its own parent (zero range → scrolls away).
         Everything sits inside a single container so padding, max-width and
         min-width apply uniformly - no overflow on narrow screens. -->
    <div class="sticky-bar">
        <div class="header-bar flex items-center">
            <div class="container-page flex items-center justify-center">
                <!-- Left: logo + brand name (hidden on very narrow screens) -->
                <a href="/" class="group flex shrink-0 items-center gap-3" aria-label={`${SITE_TITLE} - home`}>
                    <img
                        src="/logo.png"
                        alt={`${SITE_TITLE} logo`}
                        width="512"
                        height="512"
                        class="header-logo"
                        loading="eager"
                        decoding="async"
                    />
                    <span class="hidden sm:block">
                        <span class="brand-name">
                            {PRACTITIONER.shortName}
                        </span>
                        <span class="meta-label mt-0.5 block !text-[0.62rem]">{SITE_BRAND_SUBTITLE}</span>
                    </span>
                </a>

                <!-- Desktop nav — hidden on mobile, sits next to logo on desktop -->
                <nav class="header-nav header-nav-spaced" aria-label="Primary">
                    <div class="flex items-center gap-x-6">
                        {
                            NAVIGATION_LINKS.map((link) => (
                                <a
                                    href={link.href}
                                    class:list={[navLinkClass(link.href)]}
                                >
                                    {link.label}
                                </a>
                            ))
                        }
                    </div>
                </nav>

                <!-- Flexible spacer - pushes right group to the far right -->
                <div class="flex-1"></div>

                <!-- Right group: login (desktop only) + mobile toggle -->
                <div class="shrink-0 flex items-center gap-x-3">
                    <!-- Secure Login - desktop only -->
                    <a href="/login" class="btn btn-ghost shrink-0 header-login">{LOGIN_BUTTON_TEXT}</a>

                    <!-- Desktop divider -->
                    <div class="vrule header-divider" aria-hidden="true"></div>

                    <!-- Mobile menu toggle - visible on mobile, hidden on desktop -->
                    <button
                        id="menu-toggle"
                        type="button"
                        class="header-toggle"
                        aria-label="Open menu"
                        aria-expanded="false"
                        aria-controls="mobile-menu"
                    >
                        <svg id="icon-burger" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                            <path d="M4 7h16M4 12h16M4 17h16" />
                        </svg>
                        <svg id="icon-close" class="hidden h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                            <path d="M6 6l12 12M18 6 6 18" />
                        </svg>
                    </button>

                    <!-- Dark mode toggle -->
                    <button
                        id="theme-toggle"
                        type="button"
                        class="btn btn-ghost shrink-0 header-theme-toggle"
                        aria-label="Toggle dark mode"
                        aria-pressed="false"
                    >
                        <svg id="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="hidden">
                            <circle cx="12" cy="12" r="5" />
                            <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" />
                        </svg>
                        <svg id="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="block">
                            <circle cx="12" cy="12" r="5" />
                            <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" />
                        </svg>
                    </button>
                </div>
            </div>
        </div>

        <!-- Mobile Navigation Drawer - full-width panel below header bar -->
        <div
            id="mobile-menu"
            class="hidden menu-mobile mobile-menu-drawer"
            aria-label="Mobile"
        >
            <ul class="flex flex-col text-right">
                {
                    NAVIGATION_LINKS.map((link) => (
                        <li class="border-b border-slate-100 last:border-b-0">
                            <a
                                href={link.href}
                                class:list={[
                                    isActive(link.href) ? "nav-mobile-active" : "nav-mobile",
                                ]}
                            >
                                {link.label}
                            </a>
                        </li>
                    ))
                }
            </ul>
            <!-- Mobile login - outside the <ul> (invalid HTML to put <div> inside <ul>) -->
            <div class="border-t border-slate-100 p-3">
                <a href="/login" class="btn btn-ghost header-login-mobile flex w-full">{LOGIN_BUTTON_TEXT}</a>
            </div>
        </div>
    </div>
</header>

<script>
    // ── Mobile menu toggle ──────────────────────────────────────────────
    // All logic is isolated in this module to avoid global scope leaks.
    (() => {
        const MENU_ID      = "mobile-menu";
        const TOGGLE_ID    = "menu-toggle";
        const THEME_ID     = "theme-toggle";
        const SIDEBAR_SEL  = ".toc-sidebar";
        const STORAGE_KEY  = "medicolegal-theme";

        // Cached references (guaranteed to exist once the DOM is ready)
        let mobileMenu: HTMLElement | null = null;
        let toggle    : HTMLElement | null = null;
        let themeBtn  : HTMLElement | null = null;

        const getEls = () => {
            if (!mobileMenu) mobileMenu = document.getElementById(MENU_ID);
            if (!toggle)     toggle     = document.getElementById(TOGGLE_ID);
            if (!themeBtn)   themeBtn   = document.getElementById(THEME_ID);
            return mobileMenu && toggle && themeBtn;
        };

        // Populate refs immediately so theme/menu work even before any click.
        void getEls();

        // ── Theme handling ─────────────────────────────────────────────
        // Tailwind v4 is configured for class-based dark mode (tailwind.config.js),
        // so we toggle `class="dark"` on <html> to activate `dark:` utilities.
        const html = document.documentElement;
        const themeIconMoon = () => themeBtn?.querySelector<SVGSVGElement>('#icon-moon');
        const themeIconSun  = () => themeBtn?.querySelector<SVGSVGElement>('#icon-sun');

        function loadTheme() {
            const saved = localStorage.getItem(STORAGE_KEY);
            const isDark = saved ? saved === 'dark' : false;
            setTheme(isDark);
        }

        function setTheme(isDark: boolean) {
            if (!themeBtn) return;
            if (isDark) {
                html.classList.add('dark');
                localStorage.setItem(STORAGE_KEY, 'dark');
                themeBtn.setAttribute('aria-pressed', 'true');
                themeIconMoon()?.classList.remove('hidden');
                themeIconSun()?.classList.add('hidden');
            } else {
                html.classList.remove('dark');
                localStorage.setItem(STORAGE_KEY, 'light');
                themeBtn.setAttribute('aria-pressed', 'false');
                themeIconMoon()?.classList.add('hidden');
                themeIconSun()?.classList.remove('hidden');
            }
        }

        // ── Sidebar handling ───────────────────────────────────────────
        function closeSidebar() {
            const sidebar = document.querySelector(SIDEBAR_SEL);
            if (sidebar instanceof HTMLElement) {
                sidebar.classList.remove('is-ready');
                sidebar.setAttribute('hidden', 'true');
            }
        }

        function openMenu() {
            if (!mobileMenu || !toggle) return;
            mobileMenu.classList.remove("hidden");
            toggle!.setAttribute("aria-expanded", "true");
            const burger = toggle!.querySelector<SVGSVGElement>('#icon-burger');
            const close  = toggle!.querySelector<SVGSVGElement>('#icon-close');
            burger?.classList.add("hidden");
            close?.classList.remove("hidden");
        }

        function closeMenu() {
            if (!mobileMenu || !toggle) return;
            mobileMenu.classList.add("hidden");
            toggle!.setAttribute("aria-expanded", "false");
            const burger = toggle!.querySelector<SVGSVGElement>('#icon-burger');
            const close  = toggle!.querySelector<SVGSVGElement>('#icon-close');
            burger?.classList.remove("hidden");
            close?.classList.add("hidden");
        }

        // Toggle open/close when clicking the menu button.
        // Always close the TOC sidebar when the toggle is clicked,
        // whether we are opening or closing the mobile menu drawer.
        toggle?.addEventListener("click", (e) => {
            e.preventDefault();
            closeSidebar(); // close the TOC sidebar if it is open
            if (!mobileMenu) return;
            if (mobileMenu.classList.contains("hidden")) {
                openMenu();
            } else {
                closeMenu();
            }
        });

        // Close mobile menu when a nav link inside it is clicked.
        document.addEventListener("click", (e) => {
            if (!mobileMenu || !toggle) return;
            const link = (e.target as HTMLElement).closest(`#${MENU_ID} a`);
            if (link) {
                closeMenu();
            }
        });

        // Close mobile menu when clicking anywhere outside the menu area
        document.addEventListener("click", (e) => {
            if (!mobileMenu || !toggle) return;
            if (mobileMenu.classList.contains("hidden")) return;
            if (!mobileMenu.contains(e.target as Node) && !toggle.contains(e.target as Node)) {
                closeMenu();
            }
        });

        // Close menu on Escape key
        document.addEventListener("keydown", (e) => {
            if (!mobileMenu) return;
            if (e.key === "Escape" && !mobileMenu.classList.contains("hidden")) {
                closeMenu();
            }
        });

        // ── Theme toggle click ─────────────────────────────────────────
        document.addEventListener("click", (e) => {
            const target = (e.target as HTMLElement).closest(`#${THEME_ID}`);
            if (!target) return;
            e.preventDefault();
            const isCurrentlyDark = html.classList.contains('dark');
            setTheme(!isCurrentlyDark);
        });

        // Initialise theme on load
        loadTheme();
    })();
</script>
