---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import PageIntro from '../components/PageIntro.astro';
import Section from '../components/Section.astro';
import Callout from '../components/Callout.astro';
import { PAGE_HERO_IMAGES } from '../consts';

const faqs = [
    {
        q: 'Are my images uploaded?',
        a: 'The viewer is designed to process selected files locally in your browser. Before using identifiable clinical images, confirm that this remains true of the current implementation and that no analytics, error-reporting or other service receives file contents or DICOM metadata.',
    },
    {
        q: 'Is the viewer free?',
        a: 'Yes. No account or payment is required.',
    },
    {
        q: 'Can I use a phone or tablet?',
        a: 'The viewer may work on a recent mobile browser, although large studies and some DICOM formats are better handled on a desktop or laptop.',
    },
    {
        q: 'Why can I see only one image?',
        a: 'A CT or MRI examination usually contains many files and may include several series. If only one file was selected, the viewer may have received only one image.',
    },
    {
        q: 'Can I obtain a medical opinion from the viewer?',
        a: 'No. The viewer displays images but does not interpret them. Clinical or medicolegal review requires the complete examination, relevant prior imaging and clinical information.',
    },
] as const;
---

<BaseLayout
    title="How to Use the DICOM Viewer | Radiology & Medicolegal Law"
    description="A concise guide to opening and viewing DICOM images in the browser."
>
    <PageHero
        eyebrow="Free tools · Guide"
        title="How to Use the DICOM Viewer"
        description="Find your imaging files, open them in the viewer and use the basic display controls."
        heroImage={PAGE_HERO_IMAGES["/how-to-use-the-dicom-viewer"] || undefined}
    />

    <PageIntro
        eyebrow="Getting started"
        paragraphs={[
            'Hospital imaging is commonly supplied in DICOM format on a disc, portable drive or secure download. A CT or MRI examination will usually contain many image files rather than one ordinary photograph.',
            'This browser viewer is intended for basic review. It is not a diagnostic workstation and does not provide a medical opinion.'
        ]}
        contents={[
            { href: '#find-files', label: 'Find the files' },
            { href: '#open-study', label: 'Open the study' },
            { href: '#controls', label: 'Viewer controls' },
            { href: '#privacy', label: 'Privacy' },
            { href: '#troubleshooting', label: 'Troubleshooting' },
            { href: '#questions', label: 'Common questions' },
        ]}
        reviewed="October 2026"
    />

    <Section
        id="find-files"
        index="01"
        eyebrow="Step 1"
        title="Find the Imaging Files"
    >
        <p class="para">
            Open the disc, drive or downloaded folder using File Explorer on Windows
            or Finder on macOS. Look for folders containing files ending in
            <code>.dcm</code>, or files with no extension.
        </p>

        <div class="entry-list">
            <div class="entry">
                <h3 class="entry-title">Disc or portable drive</h3>
                <p class="para-sm">
                    The images may be in a folder named DICOM, IMAGES or STUDIES.
                    The supplied disc may also contain a separate viewing application,
                    which is not required for this browser viewer.
                </p>
            </div>

            <div class="entry">
                <h3 class="entry-title">Downloaded archive</h3>
                <p class="para-sm">
                    If the download is a ZIP archive and the viewer does not open ZIP
                    files directly, extract it before selecting the images. A PDF is
                    usually the written report, not the complete imaging examination.
                </p>
            </div>

            <div class="entry">
                <h3 class="entry-title">Complete examination</h3>
                <p class="para-sm">
                    CT and MRI examinations commonly contain many images and several
                    series. Keep the original folder structure where possible.
                </p>
            </div>
        </div>
    </Section>

    <Section
        id="open-study"
        index="02"
        eyebrow="Step 2"
        title="Open the Study"
    >
        <p class="para">
            Open the
            {' '}
            /free-dicom-viewer
                DICOM viewer
            </a>
            {' '}
            and choose the files or folder containing the examination.
        </p>

        <div class="entry-list">
            <div class="entry">
                <h3 class="entry-title">Choose files</h3>
                <p class="para-sm">
                    Select one or more DICOM files. For a CT or MRI examination,
                    select all relevant files rather than a single image.
                </p>
            </div>

            <div class="entry">
                <h3 class="entry-title">Choose a folder</h3>
                <p class="para-sm">
                    Where supported by the browser, selecting the complete folder is
                    usually the simplest way to open a full examination.
                </p>
            </div>

            <div class="entry">
                <h3 class="entry-title">Drag and drop</h3>
                <p class="para-sm">
                    On a desktop computer, files or folders may also be dragged onto
                    the viewer. Use the selection buttons on a phone or tablet.
                </p>
            </div>
        </div>

        <Callout tone="key" title="Open one study at a time">
            <p>
                If a folder contains several examinations or series, confirm that the
                viewer has grouped them correctly. Do not assume that every selected
                file belongs to the same examination.
            </p>
        </Callout>
    </Section>

    <Section
        id="controls"
        index="03"
        eyebrow="Step 3"
        title="Use the Viewer Controls"
    >
        <div class="entry-list">
            <div class="entry">
                <h3 class="entry-title">Move through images</h3>
                <p class="para-sm">
                    Use the slice control, arrow buttons, mouse wheel or touch gesture,
                    depending on the device and browser.
                </p>
            </div>

            <div class="entry">
                <h3 class="entry-title">Window and level</h3>
                <p class="para-sm">
                    Window width controls the displayed contrast. Window level controls
                    the centre of the displayed brightness range. Suitable settings vary
                    by modality, sequence and tissue.
                </p>
            </div>

            <div class="entry">
                <h3 class="entry-title">Zoom and pan</h3>
                <p class="para-sm">
                    Zoom enlarges the image. Pan moves around an enlarged image without
                    changing the underlying data.
                </p>
            </div>

            <div class="entry">
                <h3 class="entry-title">Invert</h3>
                <p class="para-sm">
                    Invert reverses the displayed black and white values. It does not
                    alter the source file.
                </p>
            </div>

            <div class="entry">
                <h3 class="entry-title">Reset</h3>
                <p class="para-sm">
                    Use Reset if the image becomes difficult to see after adjusting the
                    display.
                </p>
            </div>
        </div>

        <Callout tone="caution" title="Display only">
            <p>
                Display controls can make an abnormality more or less conspicuous.
                They do not determine whether an examination is normal and should not
                be used for self-diagnosis.
            </p>
        </Callout>
    </Section>

    <Section
        id="privacy"
        index="04"
        eyebrow="Privacy"
        title="Clinical Information in DICOM Files"
    >
        <p class="para">
            DICOM files may contain patient names, dates of birth, hospital identifiers,
            examination dates and other clinical information, even when those details
            are not displayed on the screen.
        </p>

        <p class="para-sm">
            The viewer is intended to process selected files locally in the browser.
            This should be confirmed by technical testing of the deployed viewer,
            including network activity, analytics, error reporting, browser storage
            and third-party scripts.
        </p>

        <Callout tone="limit" title="Use an appropriate device">
            <p>
                Open identifiable clinical images only on a secure device and only
                where you are authorised to access them. Closing the page does not
                necessarily remove the original files from the device, download folder,
                browser history or backups.
            </p>
        </Callout>
    </Section>

    <Section
        id="troubleshooting"
        index="05"
        eyebrow="Troubleshooting"
        title="If the Study Does Not Open"
    >
        <div class="entry-list">
            <div class="entry">
                <h3 class="entry-title">No images found</h3>
                <p class="para-sm">
                    Confirm that the selected folder contains DICOM images rather than
                    only a PDF report, screenshots or the disc's viewing program.
                </p>
            </div>

            <div class="entry">
                <h3 class="entry-title">Unsupported file</h3>
                <p class="para-sm">
                    Some compressed, encrypted, multi-frame or vendor-specific objects
                    may not be supported. Try the viewer supplied with the examination
                    or request a standard DICOM export.
                </p>
            </div>

            <div class="entry">
                <h3 class="entry-title">Only one image appears</h3>
                <p class="para-sm">
                    Check whether only one file was selected. A complete CT or MRI
                    examination usually contains many files.
                </p>
            </div>

            <div class="entry">
                <h3 class="entry-title">The image appears too dark or bright</h3>
                <p class="para-sm">
                    Use Reset, then adjust window and level gradually. There is no single
                    correct setting for every CT or MRI examination.
                </p>
            </div>

            <div class="entry">
                <h3 class="entry-title">Performance is poor</h3>
                <p class="para-sm">
                    Large studies may exceed the available memory of a phone, tablet or
                    older computer. Try a current desktop browser or the viewer supplied
                    by the imaging provider.
                </p>
            </div>
        </div>
    </Section>

    <Section
        id="questions"
        index="06"
        eyebrow="Reference"
        title="Common Questions"
    >
        <div class="entry-list">
            {
                faqs.map((item) => (
                    <div class="entry">
                        <h3 class="entry-title">{item.q}</h3>
                        <p class="para-sm">{item.a}</p>
                    </div>
                ))
            }
        </div>
    </Section>

    <section class="band-paper">
        <div class="container-page">
            <div class="doc text-center">
                <p class="meta-label">Ready to open the examination?</p>

                <div class="mt-5">
                    /free-dicom-viewer
                        Open the DICOM viewer
                    </a>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>