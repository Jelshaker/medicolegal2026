---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import PageIntro from '../../components/PageIntro.astro';
import { getCollection } from 'astro:content';
import { formatDateShort } from '../../lib/utils';
import { PAGE_HERO_IMAGES } from '../../consts';

export const prerender = true;

const categories = {
    all: {
        label: 'All',
        color: '#94a3b8',
    },
    musculoskeletal: {
        label: 'Musculoskeletal',
        color: '#7c9a6e',
    },
    gastrointestinal: {
        label: 'Gastrointestinal',
        color: '#b8935a',
    },
    'peritoneal-malignancy': {
        label: 'Peritoneal malignancy',
        color: '#a86b6b',
    },
    neuroradiology: {
        label: 'Neuroradiology',
        color: '#7a8da0',
    },
    interventional: {
        label: 'Interventional',
        color: '#a07a8d',
    },
    negligence: {
        label: 'Negligence',
        color: '#8d7a9a',
    },
    quantum: {
        label: 'Quantum and causation',
        color: '#7a9a8d',
    },
    practice: {
        label: 'Practice and procedure',
        color: '#9a8d7a',
    },
    regulation: {
        label: 'Regulation',
        color: '#8d9a7a',
    },
    'case-law': {
        label: 'Case law',
        color: '#9a7a8d',
    },
} as const;

type Category = keyof typeof categories;

function categoryLabel(category: string): string {
    return categories[category as Category]?.label ?? category;
}

function categoryColor(category: string): string {
    return categories[category as Category]?.color ?? '#94a3b8';
}

const allPosts = (await getCollection('recent-developments')).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const usedCategories = Object.entries(categories).filter(
    ([id]) =>
        id === 'all' ||
        allPosts.some((post) => post.data.category === id)
);
---

<BaseLayout
    title="Recent Developments | Radiology & Medicolegal Law"
    description="Concise commentary on recent developments in radiology, clinical negligence, case law, regulation and expert practice."
>
    <PageHero
        eyebrow="Commentary"
        title="Recent Developments"
        description="Concise analysis of recent developments in radiology and medicolegal practice."
        heroImage={PAGE_HERO_IMAGES['/recent-developments'] || undefined}
    />

    <PageIntro
        eyebrow="Recent developments"
        paragraphs={[
            'Short commentary on cases, professional standards and clinical issues with direct relevance to radiologists and legal practitioners.',
            'Each article identifies the radiological issue, the applicable legal or professional principle and its practical significance.'
        ]}
        contents={[
            { href: '#latest-commentary', label: 'Latest commentary' },
            { href: '#browse-by-subject', label: 'Browse by subject' },
        ]}
        audience="For radiologists, solicitors, barristers, insurers and expert witnesses."
        reviewed="October 2026"
    />

    <section class="band">
        <div class="container-page">
            <div
                id="browse-by-subject"
                class="doc scroll-mt-24"
            >
                <div class="sec">
                    <p class="meta-label">Filter</p>
                    <h2 class="sec-title">Browse by Subject</h2>

                    <p
                        id="blog-count"
                        class="mt-3 text-muted-alt"
                        aria-live="polite"
                    >
                        Showing all {allPosts.length} articles
                    </p>
                </div>

                <div
                    id="blog-filters"
                    class="mt-6 flex flex-wrap gap-2"
                    aria-label="Filter articles by subject"
                >
                    {usedCategories.map(([id, category]) => (
                        <button
                            type="button"
                            class="chip cursor-pointer transition-colors hover:border-slate-600"
                            data-category={id}
                            style={`--marker-color: ${category.color}`}
                            aria-pressed="false"
                        >
                            {category.label}
                        </button>
                    ))}
                </div>
            </div>

            <div
                id="latest-commentary"
                class="doc mt-14 scroll-mt-24"
            >
                <div class="sec">
                    <p class="meta-label">Latest</p>
                    <h2 class="sec-title">Latest Commentary</h2>

                    <p class="standfirst">
                        Newest first. Each article is a concise analysis rather than
                        a substitute for the judgment, guidance or primary source.
                    </p>
                </div>

                <div
                    id="blog-grid"
                    class="entry-list-ruled mt-8"
                >
                    <figure class="figure mt-0">
                        <div class="figure-frame">
                            <div class="relative aspect-[3/1] overflow-hidden">
                                <img
                                    src="/images/pexels-shvetsa-4226205.jpg"
                                    alt="Radiology image"
                                    class="h-full w-full object-cover"
                                />
                            </div>
                        </div>
                    </figure>
                    {allPosts.map((post) => (
                        <article
                            class="blog-card py-7"
                            data-category={post.data.category}
                            style={`--marker-color: ${categoryColor(post.data.category)}`}
                        >
                            <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
                                <div class="flex items-center gap-2">
                                    <span
                                        class="sec-marker"
                                        aria-hidden="true"
                                    ></span>

                                    <span class="text-muted-alt">
                                        {categoryLabel(post.data.category)}
                                    </span>
                                </div>

                                <time
                                    class="text-muted-light"
                                    datetime={post.data.pubDate.toISOString()}
                                >
                                    {formatDateShort(post.data.pubDate)}
                                </time>
                            </div>

                            <h3 class="mt-2 font-serif text-lg font-bold leading-snug text-slate-900">
                                <a href={`/recent-developments/${post.slug}`}>{post.data.title}</a>
                            </h3>

                            <p class="para-sm">
                                {post.data.description}
                            </p>

                            <p class="mt-3 text-sm">
                                <a href={`/recent-developments/${post.slug}`}>Read analysis →</a>
                            </p>
                        </article>
                    ))}
                </div>

                <p
                    id="blog-empty"
                    class="mt-8 hidden text-sm text-slate-500"
                >
                    No articles are currently available in this category.
                </p>
            </div>
        </div>
    </section>
</BaseLayout>

<script>
    const filters = document.getElementById('blog-filters');
    const grid = document.getElementById('blog-grid');
    const count = document.getElementById('blog-count');
    const emptyMessage = document.getElementById('blog-empty');

    const cards = Array.from(
        grid?.querySelectorAll<HTMLElement>('.blog-card') ?? []
    );

    function applyFilter(category: string): void {
        filters
            ?.querySelectorAll<HTMLButtonElement>('[data-category]')
            .forEach((button) => {
                const active = button.dataset.category === category;

                button.classList.toggle('is-active', active);
                button.setAttribute(
                    'aria-pressed',
                    active ? 'true' : 'false'
                );
            });

        let visible = 0;

        cards.forEach((card) => {
            const matches =
                category === 'all' ||
                card.dataset.category === category;

            card.hidden = !matches;

            if (matches) {
                visible += 1;
            }
        });

        if (count) {
            count.textContent =
                category === 'all'
                    ? `Showing all ${cards.length} articles`
                    : `Showing ${visible} of ${cards.length} articles`;
        }

        emptyMessage?.classList.toggle('hidden', visible > 0);
    }

    filters?.addEventListener('click', (event) => {
        const target = event.target as HTMLElement;

        const button = target.closest<HTMLButtonElement>(
            '[data-category]'
        );

        if (!button) return;

        applyFilter(button.dataset.category ?? 'all');
    });

    applyFilter('all');
</script>