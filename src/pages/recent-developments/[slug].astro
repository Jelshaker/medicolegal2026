---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MedicalImageViewer from '../../components/MedicalImageViewer.astro';
import PageHero from '../../components/PageHero.astro';
import Callout from '../../components/Callout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { formatDate, readingTime } from '../../lib/utils';
import { PAGE_HERO_IMAGES } from '../../consts';
import { isoDate } from '../../lib/seo';

export const prerender = true;

const categoryLabels = {
    musculoskeletal: 'Musculoskeletal',
    gastrointestinal: 'Gastrointestinal',
    'peritoneal-malignancy': 'Peritoneal malignancy',
    neuroradiology: 'Neuroradiology',
    interventional: 'Interventional',
    negligence: 'Negligence',
    quantum: 'Quantum and causation',
    practice: 'Practice and procedure',
    regulation: 'Regulation',
    'case-law': 'Case law',
} as const;

type Category = keyof typeof categoryLabels;

function categoryLabel(category: string): string {
    return categoryLabels[category as Category] ?? category;
}

export async function getStaticPaths() {
    const posts = await getCollection('recent-developments');

    return posts.map((post) => ({
        params: { slug: post.slug },
        props: { post },
    }));
}

interface Props {
    post: CollectionEntry<'recent-developments'>;
}

const { post } = Astro.props as Props;
const { Content } = await post.render();
const readMinutes = readingTime(post.body);
---

<BaseLayout
    title={`${post.data.title} | Radiology & Medicolegal Law`}
    description={post.data.description}
    article={{
        headline: post.data.title,
        datePublished: isoDate(post.data.pubDate),
        dateModified: post.data.updatedDate
            ? isoDate(post.data.updatedDate)
            : undefined,
        section: categoryLabel(post.data.category),
    }}
>
    <PageHero
        heroImage={PAGE_HERO_IMAGES['/recent-developments'] || undefined}
        eyebrow={categoryLabel(post.data.category)}
        title={post.data.title}
        description={post.data.description}
    >
        <nav class="mt-4" aria-label="Breadcrumb">
            <ol class="flex items-center justify-center gap-2 font-sans text-xs uppercase tracking-[0.14em] text-slate-400">
                <li>
                    <a
                        href="/recent-developments"
                        class="hover:text-slate-200 hover:underline"
                    >
                        Recent developments
                    </a>
                </li>

                <li aria-hidden="true">/</li>

                <li aria-current="page">
                    {categoryLabel(post.data.category)}
                </li>
            </ol>
        </nav>

        <div class="mt-4 flex flex-wrap items-baseline justify-center gap-x-5 gap-y-2 text-slate-300/80">
            <span>Published {formatDate(post.data.pubDate)}</span>

            {post.data.updatedDate && (
                <span>
                    Updated {formatDate(post.data.updatedDate)}
                </span>
            )}

            <span>{readMinutes} min read</span>
        </div>

        {post.data.tags?.length > 0 && (
            <p class="mt-3 font-sans text-xs uppercase tracking-[0.1em] text-slate-400">
                {post.data.tags.join(' · ')}
            </p>
        )}
    </PageHero>

    <article class="bg-white py-12">
        <div class="container-page">
            <div class="doc">
                {post.data.keyTakeaways?.length > 0 && (
                    <aside
                        class="divider-strong pt-4"
                        aria-labelledby="key-takeaways-heading"
                    >
                        <p
                            id="key-takeaways-heading"
                            class="meta-label mb-3"
                        >
                            Key points
                        </p>

                        <ol class="list mt-0">
                            {post.data.keyTakeaways.map((takeaway, index) => (
                                <li class="flex gap-3">
                                    <span
                                        class="shrink-0 font-sans text-[0.7rem] font-semibold tabular-nums tracking-[0.1em] text-slate-400"
                                        aria-hidden="true"
                                    >
                                        {index + 1}.
                                    </span>

                                    <span>{takeaway}</span>
                                </li>
                            ))}
                        </ol>
                    </aside>
                )}

                <div class="article-body mt-10">
                    <Content />
                </div>

                {post.data.figures?.length > 0 && (
                    <section
                        class="mt-12 space-y-8"
                        aria-label="Reference figures"
                    >
                        {post.data.figures.map((src, index) => (
                            <MedicalImageViewer
                                src={src}
                                alt={`Reference figure ${index + 1}`}
                                caption={`Reference figure ${index + 1}`}
                                modality="Medical imaging"
                            />
                        ))}
                    </section>
                )}

                <Callout tone="caution" title="Scope">
                    <p>
                        This article is an educational summary and not legal advice,
                        medical advice or an expert opinion on an individual case.
                        The judgment, legislation and professional guidance should be
                        checked before the material is relied upon.
                    </p>
                </Callout>

                <footer class="mt-12 divider pt-5">
                    <p class="font-serif text-sm italic leading-snug text-slate-600">
                        {post.data.author}, Consultant Radiologist
                    </p>

                    <div class="mt-6 flex flex-wrap gap-4">
                        <a
                            href="/recent-developments"
                            class="link-sm"
                        >
                            &larr; All recent developments
                        </a>

                        <a
                            href="/contact"
                            class="link-sm"
                        >
                            Contact
                        </a>
                    </div>
                </footer>
            </div>
        </div>
    </article>
</BaseLayout>