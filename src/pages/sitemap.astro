---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import PageIntro from "../components/PageIntro.astro";
import Callout from "../components/Callout.astro";
import { SITE_TITLE, SITEMAP } from "../consts";

export const prerender = true;

const pageCount = SITEMAP.reduce((n, group) => n + group.pages.length, 0);
const contents = SITEMAP.map((group) => ({ href: `#${group.id}`, label: group.title }));
---

<BaseLayout
	title={`Site map | ${SITE_TITLE}`}
	description="Every page in this small radiology and medicolegal law resource on one page — the clinical library, the legal library, recent case commentary, and how instruction works."
>
	<PageHero
		eyebrow="Site map"
		title="Everything in the resource"
		description={`${pageCount} pages across five groups: the two reference libraries, recent case commentary, and the practice behind them.`}
	/>

	<PageIntro
		eyebrow="Site map"
		paragraphs={[
			"This resource is deliberately small. Everything in it is listed on this page, grouped by library, with a one-line description of each entry, so you can see the whole thing at a glance rather than browsing for it.",
			"If you are looking for a particular case, statute or standard rather than a page, start with the legal library and the case commentary. If you are looking for how an investigation is performed and reported, start with the radiology library.",
		]}
		contents={contents}
		audience="Written for radiologists, referrers, solicitors, barristers, insurers and expert witnesses."
		reviewed="September 2026"
	/>

	<section class="bg-white py-16 dark:bg-navy-900">
		<div class="container-page space-y-12">
			{
				SITEMAP.map((group, i) => (
					<section id={group.id} class="scroll-mt-24 border-t border-slate-200 pt-8 dark:border-navy-700">
						<div class="flex items-center gap-3">
							<span class="text-xs font-bold tabular-nums text-teal-600 dark:text-teal-400">
								{String(i + 1).padStart(2, "0")}
							</span>
							<span class="eyebrow">{group.title}</span>
						</div>
						<h2 class="mt-2 text-2xl font-bold tracking-tight text-navy-900 dark:text-slate-100 sm:text-3xl">
							{group.title}
						</h2>
						<p class="mt-3 max-w-2xl text-lg leading-relaxed text-slate-600 dark:text-slate-300">
							{group.description}
						</p>
						<ul class="mt-6 grid gap-6 md:grid-cols-2">
							{group.pages.map((page) => (
								<li class="card flex flex-col p-6">
									<a
										href={page.href}
										class="text-base font-bold text-navy-900 hover:text-teal-600 dark:text-slate-100 dark:hover:text-teal-400"
									>
										{page.label}
									</a>
									<p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
										{page.description}
									</p>
								</li>
							))}
						</ul>
					</section>
				))
			}

			<Callout tone="limit" title="Access screen">
				<p>
					The secure login at <code class="rounded bg-slate-100 px-1.5 py-0.5 text-xs dark:bg-navy-800"
						>/login</code
					> is deliberately not listed above. It is an access screen for instructing parties and referrers,
					not part of the reference material.
				</p>
			</Callout>

			<div class="rounded-2xl bg-gradient-to-br from-navy-900 to-navy-800 p-8 text-center sm:p-10">
				<h2 class="text-2xl font-extrabold tracking-tight text-white">Looking for something specific?</h2>
				<p class="mx-auto mt-3 max-w-2xl text-slate-300">
					Case commentary is the quickest route into the material, and the two libraries explain the
					standards and authorities behind it. Enquiries about instruction go to the secretariat.
				</p>
				<div class="mt-6 flex flex-wrap justify-center gap-3">
					<a href="/recent-developments" class="btn btn-primary">Recent case commentary</a>
					<a href="/medicolegal-fundamentals" class="btn btn-outline-white">Medicolegal law library</a>
					<a href="/contact" class="btn btn-outline-white">Contact the secretariat</a>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>