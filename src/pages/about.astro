---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_TITLE } from "../consts";
---

<BaseLayout
  title={`About | ${SITE_TITLE}`}
  description="Brief background of the curator."
>
  <main class="mx-auto max-w-3xl px-4 py-12">
    <header class="mb-8">
      <p class="text-sm uppercase tracking-wide opacity-60 mb-2">
        About this resource
      </p>
      <h1 class="text-3xl font-bold mb-3">Joseph El-Sheikha</h1>
      <p class="text-lg leading-relaxed">
        Consultant Radiologist at Hampshire Hospitals NHS Foundation Trust (GMC
        7017101). I curate this medicolegal radiology reference — practical,
        sourced, and written from practice rather than from a textbook.
      </p>
    </header>
    <section class="mb-8">
      <h2 class="text-xl font-semibold mb-3">Qualifications</h2>
      <p class="leading-relaxed">
        FRCR (2019), MRCS (2011). LLM Healthcare Ethics and Law (Manchester,
        2017), MD (Hull York, 2017). BMedSci/MBChB (Manchester, 2008).
      </p>
    </section>
    <section class="mb-8">
      <h2 class="text-xl font-semibold mb-3">Professional memberships</h2>
      <ul class="list-disc pl-6 space-y-1 leading-relaxed">
        <li>General Medical Council (GMC 7017101)</li>
        <li>Fellow, Royal College of Radiologists (FRCR)</li>
        <li>
          Member, British Society of Gastrointestinal and Abdominal Radiology
          (BSGAR)
        </li>
      </ul>
    </section>
    <section class="mb-8">
      <h2 class="text-xl font-semibold mb-3">Employment</h2>
      <p class="leading-relaxed">
        Consultant Radiologist, HHFT (Sept 2023–present). Previously peritoneal
        malignancy radiology fellowship (Basingstoke), clinical radiology
        training (Oxford), and surgical/vascular research roles.
      </p>
    </section>
    <section class="mb-8">
      <h2 class="text-xl font-semibold mb-3">Selected publications</h2>
      <ul class="list-disc pl-6 space-y-1 leading-relaxed">
        <li>Appendix mucocoele misnomer — Clinical Radiology (in press)</li>
        <li>Rectal venous malformation embolisation — CVIR (2019)</li>
        <li>Long-term outcomes of EVLA vs surgery — BJS (2018)</li>
        <li>Systematic review of compression regimes — Phlebology (2016)</li>
      </ul>
    </section>
    <p class="text-sm opacity-70">Full CV available on request.</p>
  </main>
</BaseLayout>

