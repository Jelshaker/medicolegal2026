---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import PageIntro from "../components/PageIntro.astro";
import Section from "../components/Section.astro";
import Figure from "../components/Figure.astro";
import Diagram from "../components/Diagram.astro";
import { SITE_TITLE, PAGE_HERO_IMAGES } from "../consts";

// The clinical half of the resource. Each modality is described in terms of the
// question it answers, so the page reads as a reference rather than a service list.
const modalities = [
  {
    n: "Radiography (X-ray)",
    q: "Excellent for rapid triage and diagnosis",
    d: "The classic radiology examination, the plain radiograph, has historically been the mainstay of most radiology departments, but in recent years lower-dose CT scanners and increasingly detailed MRI have gradually begun to supplant this old, reliable workhorse. However, plain radiographs remain extremely useful and are readily available in almost every healthcare setting. For some examinations, a plain radiograph provides all the necessary information in a single image, allowing a faster and easier diagnosis that is no less accurate. In some situations, however, a plain radiograph is much less accurate than CT or MRI. Despite their relatively low radiation dose, plain radiographs will remain a vital part of any radiology department for many years to come.",
    img: "/images/normal-chest-radiograph-female-5.png",
    indications: [
      "Suspected fracture or dislocation",
      "Chest infection, consolidation or pleural effusion",
      "Bowel obstruction or free intraperitoneal gas",
      "Foreign-body localisation",
    ],
    limits: [
      "Superimposed structures can mask or mimic pathology",
      "Low soft-tissue contrast compared with CT or MRI",
      "Projection geometry can conceal a fracture line",
    ],
    safety:
      "Low-dose examination. Pregnancy status should be checked where the abdomen or pelvis is in the primary beam. Gonad shielding is rarely indicated under modern collimation.",
  },
  {
    n: "Computed tomography (CT)",
    q: "Excellent for most acute and cross-sectional questions",
    d: "Computed tomography is the modern workhorse of acute and cross-sectional imaging, with high spatial resolution, short acquisition times and near-universal availability in secondary care. Multi-detector scanners can image the whole chest and abdomen in seconds, which is why CT is first line for acute presentations, trauma, most suspected malignancies and vascular disease. Its main weakness is that it uses ionising radiation at doses higher than those of plain radiography, and it often requires iodinated contrast (an iodine-based agent injected to make structures easier to see), which carries risks of allergy and renal injury. Other technical issues, such as beam-hardening and metal artefact, can also obscure detail — an issue less prevalent with plain radiographs. Regardless, every exposure must be justified under IR(ME)R.",
    img: "/images/head_ct_images.jpg",
    indications: [
      "Acute head injury, stroke or intracranial haemorrhage",
      "Acute abdomen, trauma and suspected perforation",
      "Pulmonary embolism and aortic dissection",
      "Staging and follow-up of malignancy",
    ],
    limits: [
      "Ionising radiation dose — justification and optimisation apply",
      "Iodinated contrast risks (allergy, renal function, thyroid)",
      "Beam-hardening and metal artefact can obscure detail",
    ],
    safety:
      "Justification is mandatory under IR(ME)R. Contrast-enhanced studies require recent renal function and allergy history. Dose is monitored against diagnostic reference levels.",
  },
  {
    n: "Magnetic resonance imaging (MRI)",
    q: "Excellent for soft tissues",
    d: "MRI delivers high soft-tissue contrast without ionising radiation and is the modality of choice for soft-tissue, marrow, joint and neurological questions. Multiplanar acquisition and a range of contrast weightings make it central to musculoskeletal, neurological, hepatobiliary and pelvic imaging, and it will demonstrate pathology that CT resolves poorly or not at all. Its constraints are physical rather than dosimetric. The static field is permanently energised, so implant, device and foreign-body screening is mandatory before entry to the controlled area, and ferromagnetic projectile injury remains the principal safety hazard. Acquisition times are long, motion degrades the study, and a proportion of patients cannot tolerate the examination. Gadolinium (an intravenous contrast agent) requires a documented renal function assessment, and there are ongoing concerns about tissue deposition in the brain. MRI capacity and cost continue to limit access compared with CT. Its principal advantage is that it carries no ionising radiation and therefore no IR(ME)R justification requirement, but the request must still identify a clinical question that MRI answers better than a faster or lower-cost alternative.",
    img: "/images/pexels-cottonbro-5723878.jpg",
    indications: [
      "Joints and soft-tissue injury",
      "Brain, spinal cord and peripheral nerve lesions",
      "Liver, biliary and pelvic pathology",
      "Bone marrow and musculoskeletal infection or tumour",
    ],
    limits: [
      "Implant, device and foreign-body safety",
      "Long acquisition times, so motion degrades the study",
      "Gadolinium contrast",
    ],
    safety:
      "No ionising radiation, but the static magnetic field is always on. Implant and device status must be checked before entry to the controlled area. Gadolinium is avoided in significant renal impairment unless clinically essential.",
  },
  {
    n: "Ultrasound",
    q: "Excellent for superficial structures and blood flow",
    d: "Ultrasound provides real-time imaging without ionising radiation. It is a dynamic examination rather than a set of static images, so it can assess flow and superficial structures that projection and cross-sectional imaging demonstrate poorly. It is widely used in abdominal, obstetric, musculoskeletal and soft-tissue imaging, and it is the guidance method for many interventional procedures. Its principal weakness is operator dependence: image quality and interpretation vary with the practitioner, and the examination is the least reproducible of the modalities. Penetration is limited, and bowel gas obscures deeper structures. Ultrasound uses no ionising radiation, so no IR(ME)R justification requirement arises.",
    img: "/images/posterior-acoustic-shadowing-and-enhancement.jpeg",
    indications: [
      "Abdominal and pelvic pain, including gallstones and renal obstruction",
      "Obstetric assessment and foetal wellbeing",
      "Vascular stenosis, thrombosis and flow assessment",
      "Image guidance for biopsy, drainage and vascular access",
    ],
    limits: [
      "Operator-dependent and the least reproducible modality",
      "Limited penetration; bowel gas obscures deeper structures",
      "No whole-body overview compared with CT or MRI",
    ],
    safety:
      "No ionising radiation. Output parameters are kept as low as reasonably practicable. Endocavitary and interventional probes require appropriate decontamination between patients.",
  },
];

// Report content requirements — RCR Standards for interpretation and reporting
// of imaging investigations, third edition, October 2025.
const reportingStandards = [
  {
    n: "Report content",
    d: "A report must answer the clinical question asked, describe the findings, state the limitations of the study and give a clear conclusion. A structured format is expected where one has been agreed for that investigation. The conclusion should provide a radiological diagnosis or a reasoned differential, acknowledge limitations and make recommendations aligned with recognised guidelines.",
  },
  {
    n: "Named author and accountability",
    d: "Every report must be attributable to a named reporting author, including where reporting is remote or assisted by software. The author's name, position and profession should be identifiable. The content must not imply a level of scrutiny that has not in fact been applied.",
  },
  {
    n: "Remote and offsite reporting",
    d: "Remote reporting is acceptable only where the reporter has the images, the prior studies, the clinical information and the means to communicate an urgent finding. The same expectations of quality, turnaround and escalation apply as for onsite work. The RCR standards for teleradiology set out the governance, data-transfer and indemnity requirements.",
  },
  {
    n: "AI-assisted and speech-recognition output",
    d: "Where software generates or transcribes content, the named human author remains responsible for its accuracy. Every automated contribution must be reviewed and approved before the report is released. The use of AI does not transfer accountability to the software provider.",
  },
  {
    n: "Turnaround and communication of critical findings",
    d: "Providers must have procedures for turnaround times, communication of unexpected or time-critical findings, imaging classification for reporting priority, and acknowledgement of reports. A critical finding must be communicated directly and the communication documented, not left to the patient or referrer to discover.",
  },
  {
    n: "Addenda and corrections",
    d: "An addendum supplements the original report; it does not replace it. It must be attributable, dated and linked to the original study. Where a discrepancy or error is identified, the addendum should be non-judgemental and should trigger the local discrepancy and candour processes.",
  },
];

// Where a radiological standard becomes a legal question.
const lawLinks = [
  {
    n: "Disputed interpretation",
    d: 'How the courts separate a defensible difference of opinion from a breach, and how the "pure diagnosis" argument is met. The Bolam/Bolitho standard is applied to the reporting decision, not only to the clinical act.',
    href: "/medicolegal-radiology",
    cta: "Read the analysis",
  },
  {
    n: "Reporting standards and candour",
    d: "Standard of care, addenda and corrections, and the professional and statutory duties of candour where a report is found to be wrong. The statutory duty sits alongside the GMC professional duty.",
    href: "/medicolegal-fundamentals",
    cta: "Open the law library",
  },
  {
    n: "Statutory duties",
    d: "IR(ME)R justification and optimisation, IRR17 controls, the duty to communicate critical findings, and permitting for radioactive material. Breach can be a criminal offence as well as a regulatory matter.",
    href: "/radiology-legislation",
    cta: "Review the legislation",
  },
];

// Dose reference values for the comparison table beneath the diagram.
const doseComparisons = [
  {
    label: "UK average annual effective dose (all sources)",
    value: "2.6 mSv",
    note: "About half from radon; wide regional variation.",
  },
  {
    label: "Average annual dose in Cornwall",
    value: "7.8 mSv",
    note: "Elevated radon; the highest regional average in the UK.",
  },
  {
    label: "Public dose limit (man-made sources, excluding medical)",
    value: "1 mSv/year",
    note: "Statutory limit under the Basic Safety Standards.",
  },
  {
    label: "Chest radiograph (for comparison)",
    value: "≈0.02 mSv",
    note: "A single projection; dose varies with technique.",
  },
  {
    label: "Occupational dose limit (effective dose) i.e. radiation workers",
    value: "20 mSv/year",
    note: "Averaged over any calendar year; 100 mSv over five years under IRR17.",
  },
];
const qaStandards = [
  {
    n: "Peer review and discrepancy audit",
    d: "A documented sample of reports is re-read by another competent reporter; discrepancies are classified, discussed and the learning recorded. The RCR recommends regular discrepancy meetings and a blame-free learning culture. Done properly, the audit trail is also the evidence that the service was monitoring its own accuracy.",
  },
  {
    n: "Candour and correction",
    d: "Where a report is wrong or a study misread, the professional duty of candour runs in parallel with the incident process: acknowledge, explain, apologise, record and share the learning. An addendum supplements the original report; it does not replace it. The statutory duty of candour binds organisations and is triggered by moderate harm or above; the professional duty binds the individual clinician.",
  },
  {
    n: "Audit of unreported studies",
    d: "Unreported investigations should be audited at a defined interval, commonly annually. This is a service-level assurance activity, distinct from individual discrepancy review, and evidences that the reporting backlog is monitored and escalated rather than merely accumulating.",
  },
  {
    n: "Keep the record, not just the report",
    d: "Protocol detail, the clinical information supplied, viewing conditions, the route by which an urgent finding was communicated and any escalation attempt are often the decisive material years later. A contemporaneous note of an escalation attempt carries more weight than a later recollection.",
  },
];
---

<BaseLayout
  title={`Radiology Reference | ${SITE_TITLE}`}
  description="A working radiology reference: what each modality answers and where it is limited, the RCR standards for interpretation and reporting, radiation dose and safety duties, quality assurance, and how imaging should be stored, transferred and viewed."
>
  <PageHero
    eyebrow="Radiology library"
    title="Radiology Fundamentals"
    description="The clinical half of this resource: what each investigation can reasonably answer, the professional standards that govern reporting, the statutory duties attached to dose and data, and how images should be handled."
    heroImage={PAGE_HERO_IMAGES["/radiology-resources"] || undefined}
  />

  <PageIntro
    eyebrow="Radiology library"
    paragraphs={[
      "This section covers what each imaging modality can reasonably answer, the professional standards governing the interpretation and reporting of imaging, and the statutory requirements for dose, quality assurance and image handling.",
    ]}
    contents={[
      { href: "#modalities", label: "Modalities" },
      { href: "#dose-safety", label: "Dose and safety" },
      { href: "#reporting-standards", label: "Reporting standards" },
      { href: "#handling-images", label: "Handling images" },
      { href: "#legal-questions", label: "Legal questions" },
      { href: "#quality-assurance", label: "Quality assurance" },
      { href: "#primary-sources", label: "Primary sources" },
    ]}
    audience="Providing a clear, practical overview of day-to-day radiological principles for non-specialist readers, trainees, and experienced practitioners seeking a concise reference."
    reviewed="September 2026"
  />

  <!-- Modalities -->
  <section class="band">
    <div class="content-section">
      <Section
        id="modalities"
        index="01"
        eyebrow="Modalities"
        title="Common radiology examinations"
        lead="Each modality has its own strengths, weaknesses and clinical risks. The following sections describe what each modality can reasonably answer, where it is limited, and the practical safety considerations."
      >
        <div class="entry-list mt-0">
          {
            modalities.map((m) => (
              <div class="entry">
                <figure class="figure mt-0">
                  <div class="figure-frame">
                    <div class="relative aspect-[3/1] overflow-hidden">
                      <img
                        src={m.img}
                        alt=""
                        class="h-full w-full object-cover"
                      />
                    </div>
                  </div>
                </figure>
                <h3 class="entry-title">{m.n}</h3>
                <p class="mt-2 text-sm font-semibold text-slate-700">{m.q}</p>
                <p class="para-sm">{m.d}</p>

                <div class="mt-4 grid gap-4 sm:grid-cols-2">
                  <div>
                    <h4 class="text-xs font-bold uppercase tracking-wider text-slate-500">
                      Common indications
                    </h4>
                    <ul class="mt-2 space-y-1 text-sm text-slate-600">
                      {m.indications.map((i) => (
                        <li class="check-row">
                          <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-slate-500" />
                          <span>{i}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                  <div>
                    <h4 class="text-xs font-bold uppercase tracking-wider text-slate-500">
                      Limitations
                    </h4>
                    <ul class="mt-2 space-y-1 text-sm text-slate-600">
                      {m.limits.map((l) => (
                        <li class="check-row">
                          <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-slate-500" />
                          <span>{l}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>

                <div class="mt-4 rounded border border-slate-200 bg-slate-50 p-3">
                  <h4 class="text-xs font-bold uppercase tracking-wider text-slate-500">
                    Safety and practical notes
                  </h4>
                  <p class="mt-1 text-sm leading-relaxed text-slate-600">
                    {m.safety}
                  </p>
                </div>
              </div>
            ))
          }
        </div>
        <Figure
          src="/images/reporting_radiographer.jpg"
          alt="A radiographer reviewing a series of CT images on a monitor"
          label="Figure 01"
          caption="A radiographer checks a series of CT images on a monitor"
          subtitle="No modality is better than the others: each has its own clinical use, with its own strengths and limitations."
          ratio="wide"
        />
      </Section>

      <!-- Dose and safety -->
      <Section
        id="dose-safety"
        index="02"
        eyebrow="Dose & safety"
        title="Information on Dose, justification and statutory duties"
        lead="Ionising radiation is a powerful diagnostic tool, but it carries a risk of harm. The statutory duties of justification and optimisation apply to every exposure, and the law requires that the dose be kept as low as reasonably practicable for the diagnostic purpose."
      >
        <Figure
          label="Figure 02"
          caption="How the modalities compare on dose"
          subtitle="Linear scale 0–20 mSv. MRI and ultrasound involve no ionising radiation."
        >
          <Diagram name="dose-scale" />
        </Figure>

        {/* Reference table to accompany the diagram */}
        <div class="mt-6 grid gap-3 sm:grid-cols-2">
          {
            doseComparisons.map((d) => (
              <div class="rounded border border-slate-200 bg-white p-4">
                <p class="text-sm font-semibold text-slate-900">{d.label}</p>
                <p class="mt-1 text-xl font-bold text-slate-800">{d.value}</p>
                <p class="mt-1 text-xs text-slate-500">{d.note}</p>
              </div>
            ))
          }
        </div>
        <div class="entry-list mt-6">
          <div class="entry">
            <h3 class="entry-title">Justification and optimisation</h3>
            <ul class="list">
              <li>
                <strong>Justification:</strong> the benefit of the exposure to that
                patient must outweigh its harm. The referrer must provide sufficient
                clinical information to allow the radiologist to justify the examination
                and authorises the exposure.
              </li>
              <li>
                <strong>Optimisation:</strong> dose is kept as low as reasonably practicable
                (ALARP) for the diagnostic purpose. The 2024 amendments to IR(ME)R
                strengthened the duties to have regard to diagnostic reference levels
                and to audit practice.
              </li>
              <li>
                <strong>Diagnostic reference levels (DRLs):</strong> national values
                are set from wide-scale surveys, typically at the third quartile of
                the dose distribution for typical practice. Local DRLs should sit
                below the national value. Departments consistently above the DRL should
                review their practice and try to take corrective action.
              </li>
              <li>
                <strong>Protocol choice:</strong> whether the study performed was
                capable of answering the question asked. A technically adequate study
                that does not answer the clinical question is not optimised care.
              </li>
            </ul>
          </div>
          <div class="entry">
            <h3 class="entry-title">Duty holders under IR(ME)R</h3>
            <ul class="list">
              <li>
                <strong>Employer:</strong> owns the framework — written procedures,
                protocols, training, entitlement and compliance.
              </li>
              <li>
                <strong>Referrer:</strong> supplies sufficient and accurate clinical
                information to permit justification.
              </li>
              <li>
                <strong>Practitioner:</strong> justifies and authorises the individual
                exposure, weighing benefit against detriment.
              </li>
              <li>
                <strong>Operator:</strong> performs the practical aspects and secures
                optimisation in practice.
              </li>
            </ul>
            <p class="para-sm">
              The roles are distinct and may be held by different people for the
              same exposure. A claim can attach to any one of them
              independently.
            </p>
          </div>
          <div class="entry">
            <h3 class="entry-title">Recording and reporting</h3>
            <ul class="list">
              <li>
                Significant accidental or unintended exposures are reportable
                incidents and must be investigated, with the findings recorded.
              </li>
              <li>
                Occupational exposure is controlled through designated areas,
                monitoring and dose limits. Under IRR17 a controlled area is
                required where a person is likely to receive more than 6 mSv per
                year, and a supervised area above 1 mSv per year.
              </li>
              <li>
                Dose limits under IRR17 are 20 mSv per year (100 mSv over five
                years), 150 mSv for the lens of the eye and 500 mSv for the
                extremities.
              </li>
              <li>
                Equipment must be commissioned, tested and withdrawn from use
                when faulty.
              </li>
              <li>
                QA records and dose records are evidence. They are routinely
                sought years after the event, and their absence is itself a
                finding.
              </li>
            </ul>
          </div>
        </div>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/radiology-legislation" class="btn btn-ghost"
            >IR(ME)R and IRR17 in full</a
          >
          <a href="/patient-advice" class="btn btn-ghost"
            >Plain-language dose information for patients</a
          >
        </div>
      </Section>

      <!-- Reporting standards -->
      <Section
        id="reporting-standards"
        index="03"
        eyebrow="Standards"
        title="Interpretation and reporting: the professional benchmark"
        lead="The Royal College of Radiologists' Standards for interpretation and reporting of imaging investigations (third edition, October 2025) define what a defensible report looks like. They are the yardstick against which report practice is measured, including in disputed cases."
      >
        <div class="entry-list mt-0">
          {
            reportingStandards.map((s) => (
              <div class="entry">
                <h3 class="entry-title">{s.n}</h3>
                <p class="para-sm">{s.d}</p>
              </div>
            ))
          }
        </div>

        <div class="mt-6 rounded border border-slate-200 bg-slate-50 p-4">
          <p class="text-sm font-semibold text-slate-800">
            The standards apply to all who interpret and report imaging,
            regardless of professional background.
          </p>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">
            A doctor reporting within a narrower scope of practice is held to
            the same standard. Where imaged anatomy falls outside the
            interpreter's expertise, radiologist review must be agreed in
            advance. Reporting by sonographers and radiographers should occur
            within consultant-radiologist-led teams, with supervision and audit
            proportionate to the scope of practice.
          </p>
        </div>
      </Section>

      <!-- Handling and transferring images -->
      <Section
        id="handling-images"
        index="04"
        eyebrow="Handling images"
        title="Storage, transfer and viewing"
        lead="Most imaging disputes are ultimately about a file: what was acquired, what the header records, and who was able to see it. Handling practice is therefore part of the clinical record."
      >
        <div class="entry-list mt-0">
          <div class="entry">
            <h3 class="entry-title">What a study actually contains</h3>
            <p class="para-sm">
              A DICOM study is pixel data plus a header of tags: patient and
              study identifiers, acquisition parameters, exposure indices,
              window presets and slice geometry. The header makes a study
              searchable, transferable and anonymisable, and it is what allows a
              later review to distinguish a viewing choice from a missed
              finding. Removing identifiers from the visible image without
              stripping the header can leave the study identifiable.
            </p>
          </div>
          <div class="entry">
            <h3 class="entry-title">Transfer and anonymisation</h3>
            <p class="para-sm">
              Where a study leaves the treating relationship — for second
              opinion or medicolegal review — it should be anonymised at source,
              transferred by an encrypted route and logged. RCR confidentiality
              guidance distinguishes fully anonymised images (no name, date of
              birth, hospital or study identifier, and no hospital name) from
              pseudonymised data, which remains personal data because it can be
              re-linked. Transfer and anonymisation guidance is set out
              alongside the referral terms.
            </p>
            <!-- Referral form currently unavailable — link disabled while the referral function is deprecated -->
          </div>
          <div class="entry">
            <h3 class="entry-title">Second opinions and the record</h3>
            <p class="para-sm">
              The fact of a second opinion, the identity of the second reporter
              and the advice given should all be recorded. Where the second
              opinion differs, the original report is supplemented by an
              addendum. The addendum forms part of the record and should be
              traceable to the original study.
            </p>
          </div>
          <div class="entry">
            <h3 class="entry-title">Local-only viewing</h3>
            <p class="para-sm">
              Reviewing a study in a browser that never uploads it creates no
              further copy of personal data, satisfying data minimisation by
              design. It is a triage aid, not a calibrated diagnostic
              workstation, and cannot replace official interpretation. A local
              viewer should not be used to issue a formal report.
            </p>
            <a
              href="/free-dicom-viewer"
              class="mt-3 inline-flex items-center gap-2 text-sm font-semibold text-slate-700"
            >
              Open the local DICOM viewer
              <svg
                class="h-4 w-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"><path d="M5 12h14M12 5v14"></path></svg
              >
            </a>
          </div>
        </div>
      </Section>

      <!-- Where standards become legal questions -->
      <Section
        id="legal-questions"
        index="05"
        eyebrow="Radiology and the law"
        title="Where a reporting standard becomes a legal question"
        lead="The same standards are the yardstick in a claim. These links move from the professional requirement to the legal test applied to it."
      >
        <div class="grid gap-4 sm:grid-cols-3">
          {
            lawLinks.map((l) => (
              <a
                href={l.href}
                class="box group flex flex-col p-6 transition-all hover:border-slate-400"
              >
                <h3 class="entry-title">{l.n}</h3>
                <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-600">
                  {l.d}
                </p>
                <span class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-slate-700">
                  {l.cta}
                  <svg
                    class="h-4 w-4"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path d="M5 12h14M12 5v14" />
                  </svg>
                </span>
              </a>
            ))
          }
        </div>
      </Section>

      <!-- Quality assurance -->
      <Section
        id="quality-assurance"
        index="06"
        eyebrow="Assurance"
        title="Quality assurance and learning"
        lead="A reporting service is only as defensible as the system that checks it. Assurance is a matter of record, not of intention."
      >
        <div class="grid gap-4 sm:grid-cols-2">
          {
            qaStandards.map((q) => (
              <div class="entry">
                <h3 class="entry-title">{q.n}</h3>
                <p class="para-sm">{q.d}</p>
              </div>
            ))
          }
        </div>
      </Section>
    </div>
  </section>
  <!-- Primary sources -->
  <section class="band-white py-16">
    <div class="content-section">
      <Section
        id="primary-sources"
        index="07"
        eyebrow="Primary sources"
        title="The shelf behind this resource"
        lead="The site summarises and applies the following sources. Each is linked to the section where it is used, so a proposition can be traced back to the document that supports it."
      >
        <ul class="grid gap-4">
          {
            [
              {
                n: "RCR Standards for interpretation and reporting of imaging investigations (3rd ed., October 2025)",
                d: "The professional benchmark for report content, named authorship, remote reporting, AI-assisted output, turnaround and addenda.",
                href: "/medicolegal-fundamentals",
                tag: "Applied in Medicolegal Law",
              },
              {
                n: "RCR Standards for the provision of teleradiology within the United Kingdom (2nd ed.)",
