---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import MedicalImageViewer from '../components/MedicalImageViewer.astro';
import Figure from '../components/Figure.astro';
import Diagram from '../components/Diagram.astro';
import Callout from '../components/Callout.astro';
import { getCollection } from 'astro:content';
import { PRACTITIONER, SITE_TITLE, SITE_DESCRIPTION, SITE_TAGLINE, BLOG_CATEGORIES, RESOURCE_LIBRARIES, PAGE_HERO_IMAGES } from '../consts';

const allPosts = (await getCollection('recent-developments')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const featured = allPosts.find((p) => p.data.featured) ?? allPosts[0];
const recent = allPosts.slice(0, 3);
const categoryLabel = (id: string) => BLOG_CATEGORIES.find((c) => c.id === id)?.label ?? id;
const stats = [
	{ value: '1957', label: 'Bolam — the standard of care' },
	{ value: '~37%', label: 'Abdominal claims turning on incidental findings' },
	{ value: '2025', label: 'RCR interpretation and reporting standards' },
	{ value: '100%', label: 'DICOM viewing that never leaves your device' },
];
---

<BaseLayout title={`${SITE_TITLE} — ${SITE_TAGLINE}`} description={SITE_DESCRIPTION}>
	<!-- Masthead -->
	<PageHero
		eyebrow="Radiology · Law · Reference resource"
		title="A radiologist's guide to medicolegal law."
		description="Reference material for anyone who has to reason about radiology imaging and the law: how radiologyinvestigations are performed, interpreted and reported, the standards and statutory duties that govern them, and the decisions that show what happens when they fail. Written for radiologists, referrers, solicitors, barristers, insurers and expert witnesses."
		heroImage={PAGE_HERO_IMAGES["/"]}
	>
		<div class="mt-8 flex flex-wrap justify-center gap-x-8 gap-y-2 divider pt-5">
			<a href="/radiology-resources" class="link-sm">Radiology reference</a>
			<a href="/medicolegal-fundamentals" class="link-sm">Medicolegal law library</a>
			<a href="/dicom-viewer" class="link-sm">DICOM viewer</a>
		</div>
	</PageHero>

	<!-- What this resource is — and what it is not -->
	<section class="divider-below bg-paper py-14">
		<div class="container-page doc entry-list mt-0">
			<div class="pb-8">
				<div class="flex items-baseline gap-3">
					<span class="sec-no">§ 01</span>
					<span class="meta-label">Scope</span>
				</div>
				<h2 class="mt-2 font-serif text-xl font-bold text-slate-900">Small, and kept current</h2>
				<p class="para">
					This is a deliberately small resource. It holds a selective set of entries on radiology and
					medicolegal law, each one sourced to the statute, standard or decision behind it, rather than
					attempting to be a complete text.
				</p>
			</div>
			<div class="py-8">
				<div class="flex items-baseline gap-3">
					<span class="sec-no">§ 02</span>
					<span class="meta-label">Commentary</span>
				</div>
				<h2 class="mt-2 font-serif text-xl font-bold text-slate-900">Recent case commentary</h2>
				<p class="para">
					Its distinguishing feature is short, anonymised commentary on recent cases that raise an
					interesting radiological or legal point. Every piece says what the imaging showed, what the
					court was asked to decide, and what a radiologist should take from it.
				</p>
			</div>
			<div class="pt-2">
				<Callout tone="caution" title="What it is not">
					<p>
						It is not a substitute for the primary sources, not a comprehensive case database, and not
						legal or clinical advice. Where a matter needs a radiological opinion, instruction is handled
						through the practice behind the resource.
					</p>
				</Callout>
			</div>
		</div>
	</section>

	<!-- The two libraries -->
	<section class="divider-below bg-white py-16">
		<div class="container-page doc">
			<div class="sec">
				<p class="meta-label">Two reference libraries</p>
				<h2 class="sec-title-lg">Radiology, and the law that governs it</h2>
				<p class="para">
					The material is organised in two halves that read across to one another: what imaging can and
					cannot do, and how the law treats it when it goes wrong.
				</p>
			</div>
			<div class="entry-list-ruled mt-10">
				{
					RESOURCE_LIBRARIES.map((lib, i) => (
						<article class="py-8">
							<div class="flex items-baseline gap-3">
								<span class="sec-no">
									§ {String(i + 1).padStart(2, "0")}
								</span>
								<span class="meta-label">{lib.eyebrow}</span>
							</div>
							<h3 class="mt-2 font-serif text-xl font-bold text-slate-900">{lib.title}</h3>
							<p class="para">{lib.description}</p>
							<p class="mt-4 text-muted-alt">
								{lib.topics.join(" · ")}
							</p>
							<a href={lib.href} class="link-sm mt-4 inline-block">
								{lib.cta}
							</a>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<!-- Plates — a visual strip, with further space reserved for graphics -->
	<section class="divider-below bg-paper py-14">
		<div class="container-page doc">
			<div class="sec">
				<p class="meta-label">Plates</p>
				<h2 class="sec-title-lg">The material, in pictures</h2>
				<p class="para">
					Imaging, and the conditions in which an image is interpreted, are easier to follow with the
					hardware and the viewing environment in front of you. These plates run alongside the reference
					material; further figures are added to the libraries as the entries grow.
				</p>
			</div>

			<Figure
				src="/images/reporting_radiographer.jpg"
				alt="A radiographer reporting at a diagnostic display"
				label="Plate 01"
				caption="Reporting at a diagnostic display"
				subtitle="Interpretation, the professional reporting standards, and the conditions in which a finding is said to have been demonstrable."
				ratio="wide"
			/>

			<div class="grid gap-6 sm:grid-cols-2">
				<Figure
					src="/images/ct_scanner.jpg"
					alt="A CT scanner in a clinical imaging room"
					label="Plate 02"
					caption="Cross-sectional acquisition"
					subtitle="Protocol, technique and the justification recorded for the exposure."
					ratio="photo"
					flush
				/>
				<Figure
					src="/images/xr_spine_radiograph_2.jpg"
					alt="A projection radiograph of the spine"
					label="Plate 03"
					caption="Projection radiography"
					subtitle="Two dimensions, superimposed — and what that conceals."
					ratio="photo"
					flush
				/>
			</div>
		</div>
	</section>

	<!-- Legal framework -->
	<section class="divider-below bg-white py-16">
		<div class="container-page doc">
			<div class="sec">
				<p class="meta-label">Medicolegal law library</p>
				<h2 class="sec-title-lg">The framework, in four questions</h2>
				<p class="para">
					Every radiological claim resolves into a small number of legal questions. Each is examined in
					the law library, with the authorities and the professional standards that govern the answer.
				</p>
			</div>
			<Figure
				label="Figure 01"
				caption="The four questions a radiological claim resolves into"
				subtitle="Each is examined in the law library, with the authority and the professional standard behind the answer."
			>
				<Diagram name="legal-questions" />
			</Figure>
			<div class="entry-list-ruled mt-10">
				{[
					{ t: 'What standard of care applies?', d: 'Bolam, Bolitho and the line between a defensible difference of opinion and a breach.', href: '/medicolegal-fundamentals', tag: 'Bolam · Bolitho' },
					{ t: 'Was the finding demonstrable?', d: 'The "pure diagnosis" argument, incidentalomas, and what the images actually showed on the day.', href: '/medicolegal-radiology', tag: 'Breach & causation' },
					{ t: 'What did the patient know?', d: 'Consent, the materiality of risk, and the duty of candour where a complication occurs.', href: '/medicolegal-fundamentals', tag: 'Montgomery · Candour' },
					{ t: 'Who else is liable?', d: 'Remote reporting, provider-level duties, escalation failure and dual liability in teleradiology.', href: '/recent-developments', tag: 'Teleradiology' },
				].map((p, i) => (
					<article class="py-7">
						<div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
							<span class="sec-no">
								§ {String(i + 1).padStart(2, "0")}
							</span>
							<h3 class="font-serif text-lg font-bold text-slate-900">
								<a href={p.href} class="hover:underline hover:underline-offset-4 hover:decoration-slate-400">{p.t}</a>
							</h3>
						</div>
						<p class="para-sm">{p.d}</p>
						<p class="mt-2 text-muted-alt">{p.tag}</p>
					</article>
				))}
			</div>
			<div class="mt-8 flex flex-wrap gap-x-8 gap-y-2">
				<a href="/dicom-viewer" class="link-sm">Free local DICOM viewer</a>
				<a href="/patient-advice" class="link-sm">Patient advice</a>
				<a href="/about" class="link-sm">About the curator</a>
			</div>
		</div>
	</section>

	<!-- Key figures, set as a reference table -->
	<section class="divider-below bg-paper py-14">
		<div class="container-page doc">
			<p class="meta-label">Reference figures</p>
			<table class="table mt-4">
				<thead>
					<tr>
						<th scope="col" class="border-b border-slate-400 bg-white px-3 py-2 font-sans text-[0.7rem] font-semibold uppercase tracking-[0.14em] text-slate-500">Figure</th>
						<th scope="col" class="border-b border-slate-400 bg-white px-3 py-2 font-sans text-[0.7rem] font-semibold uppercase tracking-[0.14em] text-slate-500">Bears upon</th>
					</tr>
				</thead>
				<tbody>
					{stats.map((s) => (
						<tr>
							<td class="border-b border-slate-200 px-3 py-3 align-top font-serif text-[0.95rem] font-bold text-slate-900">{s.value}</td>
							<td>{s.label}</td>
						</tr>
					))}
				</tbody>
			</table>
		</div>
	</section>

	<!-- Featured case -->
	<section class="divider-below bg-white py-16">
		<div class="container-page doc">
			<div class="sec">
				<p class="meta-label">Featured case discussion</p>
				<h2 class="mt-3 font-serif text-2xl font-bold leading-snug text-slate-900">{featured.data.title}</h2>
				<p class="para">{featured.data.description}</p>
				<p class="mt-4 text-muted-alt">
					{featured.data.tags.slice(0, 3).join(" · ")}
				</p>
				<a href={`/recent-developments/${featured.slug}`} class="btn btn-ghost mt-6">Read the analysis</a>
			</div>
			<div class="mx-auto mt-10 max-w-2xl">
				{
					featured.data.figures?.[0]
						? (
							<MedicalImageViewer
								src={featured.data.figures[0]}
								alt="Anonymised case image"
								caption="Anonymised source series referenced in the featured case"
								modality="MRI / CT"
							/>
							)
						: (
							<MedicalImageViewer
								src="/images/placeholders/anonymised-mri-knee-sagittal.svg"
								alt="Anonymised imaging placeholder"
								caption="Anonymised reference image"
								modality="MRI"
							/>
							)
				}
			</div>
		</div>
	</section>

	<!-- Recent posts — flat text index -->
	<section class="divider-below bg-paper py-16">
		<div class="container-page doc">
			<div class="sec">
				<p class="meta-label">Recent developments</p>
				<h2 class="sec-title-lg">Latest case discussions</h2>
			</div>
			<div class="entry-list-ruled mt-8">
				{recent.map((post, i) => (
					<article class="py-7">
						<div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
							<span class="sec-no">
								§ {String(i + 1).padStart(2, "0")}
							</span>
							<span class="text-muted-alt">
								{categoryLabel(post.data.category)}
							</span>
						</div>
						<h3 class="mt-2 font-serif text-lg font-bold leading-snug text-slate-900">
							<a href={`/recent-developments/${post.slug}`} class="hover:underline hover:decoration-slate-400 hover:underline-offset-4">{post.data.title}</a>
						</h3>
						<p class="para-sm">{post.data.description}</p>
					</article>
				))}
			</div>
			<a href="/recent-developments" class="mt-8 inline-block font-sans text-[0.8rem] font-medium text-slate-700 underline decoration-slate-300 underline-offset-4 hover:text-slate-900 hover:decoration-slate-600">
				All discussions
			</a>
		</div>
	</section>

	<!-- Who maintains the resource -->
	<section class="bg-white py-16">
		<div class="container-page doc text-center">
			<div class="sec">
				<p class="meta-label">Who maintains this resource</p>
				<p class="standfirst mx-auto">
					The material is curated by {PRACTITIONER.name}, a consultant radiologist in NHS practice with an
					independent medicolegal workload, and is reviewed against the primary sources cited throughout.
					Where a matter needs a radiological opinion rather than background, terms of instruction and
					imaging transfer guidance are set out on the expert witness page.
				</p>
				<div class="mt-7 flex flex-wrap justify-center gap-x-8 gap-y-2">
					<a href="/expert-witness" class="link-sm">Expert witness services</a>
					<a href="/about" class="link-sm">About the curator</a>
					<a href="/sitemap" class="link-sm">Site map</a>
					<a href="/contact" class="link-sm">Contact the secretariat</a>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>
