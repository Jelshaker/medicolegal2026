---
// Reusable content section wrapper with optional eyebrow + title.
// All new props are optional, so existing call sites render unchanged.
// `id` gives the section a stable anchor (called from PageIntro `contents`),
// `index` prints an understated section number, and `lead` states the point
// of the section in one sentence before the detail. Content is held in a
// centered single column between hairline rules.
interface Props {
	id?: string;
	eyebrow?: string;
	/** Section number, e.g. "01". */
	index?: string;
	title?: string;
	lead?: string;
	span?: 1 | 2;
	children?: string;
}

const { id, eyebrow, index, title, lead = "" } = Astro.props as Props;
const headingId = id ? `${id}-heading` : undefined;
---

<section id={id} aria-labelledby={headingId} class="scroll-mt-24">
	<div class="doc">
		<div class="border-t border-slate-300 pt-8">
			{(index || eyebrow) && (
				<div class="flex items-baseline gap-3">
					{index && (
						<span class="font-sans text-[0.7rem] font-semibold tabular-nums tracking-[0.14em] text-slate-400">
							§ {index}
						</span>
					)}
					{eyebrow && <span class="eyebrow">{eyebrow}</span>}
				</div>
			)}
			{title && (
				<h2 id={headingId} class="mt-3 font-serif text-2xl font-bold leading-snug text-slate-900 sm:text-[1.75rem]">
					{title}
				</h2>
			)}
			{lead && <p class="mt-3 max-w-2xl font-serif text-[1.05rem] leading-relaxed text-slate-600">{lead}</p>}
		</div>
		<slot />
	</div>
</section>