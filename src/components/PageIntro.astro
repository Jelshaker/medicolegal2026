---
// Introduction block rendered directly beneath PageHero on content pages.
// Set as the opening of a document: standfirst, body paragraphs, and a flat
// table-of-contents index with section numbers.
interface Props {
	/** Short standfirst shown above the first paragraph. */
	eyebrow?: string;
	/** Two to three paragraphs of plain-English introduction. */
	paragraphs: string[];
	/** Optional "what you will find here" list, each with an in-page anchor. */
	contents?: { href: string; label: string }[];
	/** Optional audience line, e.g. "Written for radiologists, solicitors and insurers." */
	audience?: string;
	/** Optional human-readable review date. */
	reviewed?: string;
}

const {
	eyebrow = "About this page",
	paragraphs,
	contents = [],
	audience,
	reviewed,
} = Astro.props as Props;
---

<section class="divider-below bg-paper py-10">
	<div class="container-page">
		<div class="doc">
			{eyebrow && <p class="meta-label">{eyebrow}</p>}
			<div class="standfirst space-y-4 mt-4">
				{paragraphs.map((p) => <p>{p}</p>)}
			</div>
			{
				(audience || reviewed) && (
					<div class="mt-6 flex flex-wrap items-baseline gap-x-6 gap-y-1 divider pt-3 text-muted">
						{audience && <span>{audience}</span>}
						{reviewed && <span>Last reviewed {reviewed}</span>}
					</div>
				)
			}
			{
				contents.length > 0 && (
					<nav aria-label="On this page" class="mt-8 divider-strong pt-4 intro-nav">
						<h2 class="meta-label">Contents</h2>
						<ul class="mt-3 grid gap-x-8 gap-y-2 sm:grid-cols-2 intro-links">
							{contents.map((c, i) => (
								<li class="flex items-baseline gap-3 intro-link-row">
									<span class="shrink-0 sec-no">{String(i + 1).padStart(2, "0")}</span>
									<a
										href={c.href}
										class="intro-link"
									>
										{c.label}
									</a>
								</li>
							))}
						</ul>
					</nav>
				)
			}
		</div>
	</div>
</section>

<style>
	.intro-link {
		font-family: var(--font-serif);
		font-size: 0.925rem;
		color: #334155;
		text-decoration: underline;
		text-decoration-color: #cbd5e1;
		text-underline-offset: 4px;
		transition: color 0.15s ease, text-decoration-color 0.15s ease;
	}
	.intro-link:hover {
		color: #0f172a;
		text-decoration-color: #64748b;
	}
	.intro-link-row > * + * {
		margin-left: 0.75rem;
	}
</style>
