---
// Introduction block rendered directly beneath PageHero on content pages.
// Set as the opening of a document: standfirst, body paragraphs, and a flat
// table-of-contents index with section numbers.
interface Props {
	/** Short standfirst shown above the first paragraph. */
	eyebrow?: string;
	/** Two to three paragraphs of plain-English introduction. */
	paragraphs: string[];
	/** Optional "what you will find here" list, each with an in-page anchor. */
	contents?: { href: string; label: string }[];
	/** Optional audience line, e.g. "Written for radiologists, solicitors and insurers." */
	audience?: string;
	/** Optional human-readable review date. */
	reviewed?: string;
}

const {
	eyebrow = "About this page",
	paragraphs,
	contents = [],
	audience,
	reviewed,
} = Astro.props as Props;
---

<section class="border-b border-slate-200 bg-paper py-10">
	<div class="container-page">
		<div class="doc">
			{eyebrow && <p class="meta-label">{eyebrow}</p>}
			<div class="standfirst space-y-4 mt-4">
				{paragraphs.map((p) => <p>{p}</p>)}
			</div>
			{
				(audience || reviewed) && (
					<div class="mt-6 flex flex-wrap items-baseline gap-x-6 gap-y-1 border-t border-slate-200 pt-3 font-sans text-xs text-slate-500">
						{audience && <span>{audience}</span>}
						{reviewed && <span>Last reviewed {reviewed}</span>}
					</div>
				)
			}
			{
				contents.length > 0 && (
					<nav aria-label="On this page" class="mt-8 border-t border-slate-300 pt-4">
						<h2 class="meta-label">Contents</h2>
						<ul class="mt-3 grid gap-x-8 gap-y-2 sm:grid-cols-2">
							{contents.map((c, i) => (
								<li class="flex items-baseline gap-3">
									<span class="shrink-0 font-sans text-[0.7rem] font-semibold tabular-nums tracking-[0.08em] text-slate-400">
										§ {String(i + 1).padStart(2, "0")}
									</span>
									<a
										href={c.href}
										class="font-serif text-[0.925rem] text-slate-700 underline decoration-slate-300 underline-offset-4 hover:text-slate-900 hover:decoration-slate-600"
									>
										{c.label}
									</a>
								</li>
							))}
						</ul>
					</nav>
				)
			}
		</div>
	</div>
</section>
