---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import PageIntro from '../components/PageIntro.astro';
import Figure from '../components/Figure.astro';
import { SITE_TITLE, PRACTITIONER, PAGE_HERO_IMAGES } from '../consts';

const details = [
	{ label: 'Email', value: PRACTITIONER.email, href: `mailto:${PRACTITIONER.email}` },
	{ label: 'Phone', value: PRACTITIONER.phone, href: `tel:${PRACTITIONER.phone.replace(/[^0-9+]/g, '')}` },
	{ label: 'GMC', value: PRACTITIONER.gmcNumber },
	{ label: 'Address', value: PRACTITIONER.address },
];
---

<BaseLayout title={`Contact | ${SITE_TITLE}`} description="Clinic locations, secretarial contact details and a secure contact form for Dr Joseph El-Sheikha's medico-legal imaging practice.">
	<PageHero
		eyebrow="Get in touch"
		title="Contact"
		description="Reach the secretariat for referrals, enquiries about instruction, or general questions about the practice."
		heroImage={PAGE_HERO_IMAGES["/contact"]}
	/>

	<PageIntro
		eyebrow="Get in touch"
		paragraphs={[
			'Contact details for the secretariat, and a secure form for enquiries about the resource, instruction, or imaging transfer.',
			'The reference material on this site is free to use and needs no account. Enquiries about a specific matter, or about instructing an expert, go to the secretariat rather than through the library pages.',
		]}
		contents={[
			{ href: '#secretariat', label: 'Secretariat' },
			{ href: '#enquiry-form', label: 'Enquiry form' },
		]}
		reviewed="September 2026"
	/>

	<section class="band">
		<div class="container-page">
			<div class="doc space-y-14">
				<!-- Contact details -->
				<div id="secretariat" class="sec">
					<span class="meta-label">Secretariat</span>
					<h2 class="sec-title">Contact details</h2>
					<table class="table">
						<tbody>
							{details.map((d) => (
								<tr>
									<th scope="row">{d.label}</th>
									<td>
										{d.href ? <a href={d.href} class="underline decoration-slate-300 underline-offset-4 hover:text-slate-950 hover:decoration-slate-600">{d.value}</a> : d.value}
									</td>
								</tr>
							))}
						</tbody>
					</table>

					<div class="mt-8 grid gap-6 sm:grid-cols-2">
						<Figure
							src="/images/consult-room.jpg"
							alt="A consultation room used for medicolegal appointments"
							label="Plate 01"
							caption="Consultation and reporting rooms"
							subtitle="Appointments are held by arrangement; imaging is reviewed at the reporting workstation rather than in consultation."
							ratio="photo"
							flush
						/>
						<Figure
							label="Plate 02"
							caption="Location"
							subtitle="A map or plan of the consulting address sits here; the full address is given in the table above."
							ratio="photo"
							flush
						>
							<div class="plate-reserved">
								<div class="plate-reserved-inner">
									<p class="plate-reserved-label">Location map</p>
									<p class="plate-reserved-note">{PRACTITIONER.address}</p>
								</div>
							</div>
						</Figure>
					</div>
				</div>

				<!-- Contact form -->
				<div id="enquiry-form" class="sec">
					<span class="meta-label">Encrypted enquiry</span>
					<h2 class="sec-title">Send a message</h2>
					<form id="contact-form" class="mt-6 grid gap-5">
						<label class="form-label">
							Name *
							<input name="name" type="text" required class="input-field" placeholder="Full name" />
						</label>
						<label class="form-label">
							Email *
							<input name="email" type="email" required class="input-field" placeholder="you@example.com" />
						</label>
						<label class="form-label">
							Subject
							<select name="subject" class="input-field">
								<option>General enquiry</option>
								<!-- <option>Referral / instruction</option> -->
								<option>Imaging transfer</option>
								<option>Case progress</option>
							</select>
						</label>
						<label class="form-label">
							Message *
							<textarea name="message" rows="6" required class="input-field" placeholder="How can we help?"></textarea>
						</label>
						<div class="flex items-center gap-3">
							<button type="submit" class="btn btn-primary" data-submit>Send message</button>
							<span class="text-muted">Encrypted in transit and stored securely.</span>
						</div>
						<p class="text-muted leading-relaxed">
							Please keep your message anonymised — no patient names, dates of birth, NHS numbers or
							other identifying information. By sending, you agree to the
							<a href="/privacy-notice" class="link">privacy notice</a>
							and the
							<a href="/disclaimer" class="link">terms of use</a>.
						</p>
					</form>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>

<script>
	const form = document.getElementById("contact-form") as HTMLFormElement | null;
	if (form) {
		form.addEventListener("submit", async (e) => {
			e.preventDefault();
			const data = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
			const btn = form.querySelector("[data-submit]") as HTMLButtonElement | null;
			if (btn) { btn.disabled = true; btn.textContent = "Sending…"; }
			try {
				const res = await fetch("/api/contact", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify(data),
				});
				const json = await res.json();
				if (!res.ok) throw new Error(json.error || "Failed");
				form.reset();
				alert("Thank you — your message has been received.");
			} catch (err) {
				alert("There was a problem sending your message. Please email the secretariat directly.");
			} finally {
				if (btn) { btn.disabled = false; btn.textContent = "Send message"; }
			}
		});
	}
</script>