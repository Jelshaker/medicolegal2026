---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import PageIntro from '../components/PageIntro.astro';
import Callout from '../components/Callout.astro';
import { PRACTITIONER, SITE_TITLE, MEMBERSHIPS } from '../consts';

const career = [
	{ period: '2021 — Present', role: 'Consultant Radiologist', org: 'NHS Foundation Trust', detail: 'Reporting general radiology with sub-specialty sessions in MSK and gastrointestinal imaging; teaching and supervision of registrars.' },
	{ period: '2019 — 2021', role: 'Consultant Radiologist', org: 'Independent sector | The Harley Street Medico-Legal Imaging Unit', detail: 'Independent expert workload: CPR Part 35 compliant reporting for solicitors, barristers and insurers.' },
	{ period: '2017 — 2019', role: 'Sub-specialty Fellowship', org: 'MSK, GI & Interventional Radiology', detail: 'Advanced fellowship training including CT-guided and fluoroscopic interventional procedures.' },
	{ period: '2013 — 2017', role: 'Clinical Radiology Training (ST1–ST5)', org: 'Royal College of Radiologists (FRCR)', detail: 'Completed full radiology training programme; passed all FRCR examinations.' },
	{ period: '2009 — 2013', role: 'Core Surgical Training', org: 'Royal College of Surgeons of England (MRCS)', detail: 'Surgical foundation and core training, providing the basis for an interventional practice.' },
	{ period: '2003 — 2009', role: 'MBChB (Hons)', org: 'University of Leeds School of Medicine', detail: 'Graduated with honours; distinctions in anatomy and clinical skills.' },
];

const memberships = MEMBERSHIPS.slice(0, 5);
---

<BaseLayout title={`Curriculum Vitae | ${SITE_TITLE}`} description="Career timeline, qualifications, sub-specialty interests and memberships of Dr Joseph El-Sheikha FRCR — Consultant Radiologist and medicolegal expert witness.">
	<PageHero
		eyebrow="Professional record"
		title="Curriculum Vitae"
		description="A structured record of qualifications, appointments, sub-specialty interests and memberships."
	/>

	<PageIntro
		eyebrow="Professional record"
		paragraphs={[
			'A structured record of the qualifications, appointments and memberships behind the resource, provided so that the basis of the commentary can be checked.',
			'The resource is written from an NHS consultant practice with an independent medicolegal workload. This page sets out the training and subspecialty interests that sit behind it.',
		]}
		contents={[
			{ href: '#overview', label: 'Overview' },
			{ href: '#appointments', label: 'Appointments and qualifications' },
			{ href: '#memberships', label: 'Memberships' },
		]}
		reviewed="September 2026"
	/>

	<!-- Overview -->
	<section id="overview" class="scroll-mt-24 border-b border-slate-200 bg-white py-14">
		<div class="container-page">
			<div class="doc">
				<p class="meta-label">Registration & standing</p>
				<table class="mt-4 w-full border-collapse text-left">
					<tbody>
						<tr class="bg-white">
							<th scope="row" class="border-b border-slate-200 bg-paper px-3 py-3 align-top font-sans text-[0.7rem] font-semibold uppercase tracking-[0.12em] text-slate-500">GMC</th>
							<td class="border-b border-slate-200 px-3 py-3 align-top font-serif text-[0.95rem] text-slate-800">{PRACTITIONER.gmcNumber.replace("GMC ", "")} — full registration with a licence to practise</td>
						</tr>
						<tr class="bg-white">
							<th scope="row" class="border-b border-slate-200 bg-paper px-3 py-3 align-top font-sans text-[0.7rem] font-semibold uppercase tracking-[0.12em] text-slate-500">Sub-specialty</th>
							<td class="border-b border-slate-200 px-3 py-3 align-top font-serif text-[0.95rem] text-slate-800">MSK · GI · IR — {PRACTITIONER.subspecialty}</td>
						</tr>
						<tr class="bg-white">
							<th scope="row" class="border-b border-slate-200 bg-paper px-3 py-3 align-top font-sans text-[0.7rem] font-semibold uppercase tracking-[0.12em] text-slate-500">Indemnity</th>
							<td class="border-b border-slate-200 px-3 py-3 align-top font-serif text-[0.95rem] text-slate-800">{PRACTITIONER.indemnity}</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>
	</section>

	<!-- Timeline -->
	<section id="appointments" class="scroll-mt-24 border-b border-slate-200 bg-paper py-16">
		<div class="container-page">
			<div class="doc">
				<span class="eyebrow">Career &amp; training</span>
				<h2 class="mt-3 font-serif text-2xl font-bold text-slate-900 sm:text-3xl">Appointments &amp; qualifications</h2>
				<ol class="mt-8 divide-y divide-slate-200 border-t border-slate-200">
					{career.map((item) => (
						<li class="py-6">
							<p class="font-sans text-[0.7rem] font-semibold uppercase tracking-[0.14em] text-slate-400">{item.period}</p>
							<h3 class="mt-1 font-serif text-lg font-bold text-slate-900">{item.role}</h3>
							<p class="mt-0.5 font-sans text-sm text-slate-600">{item.org}</p>
							<p class="mt-2 font-serif text-[0.95rem] leading-relaxed text-slate-600">{item.detail}</p>
						</li>
					))}
				</ol>
			</div>
		</div>
	</section>

	<!-- Memberships -->
	<section id="memberships" class="scroll-mt-24 bg-white py-16">
		<div class="container-page">
			<div class="doc">
				<span class="eyebrow">Professional bodies</span>
				<h2 class="mt-3 font-serif text-2xl font-bold text-slate-900 sm:text-3xl">Memberships</h2>
				<ul class="mt-8 space-y-3 border-t border-slate-200 pt-4">
					{MEMBERSHIPS.map((m) => (
						<li class="font-serif text-[0.95rem] text-slate-700">{m}</li>
					))}
				</ul>
				<Callout tone="key" title="Publications & research">
					<p>
						Peer-reviewed and invited contributions on delayed-diagnosis radiology, measurement
						reproducibility and expert-report writing. A full publication list, appraisal portfolio
						and appraisal date are available on request.
					</p>
				</Callout>
			</div>
		</div>
	</section>
</BaseLayout>