---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { SITE_TITLE, FEES } from '../consts';
---

<BaseLayout title={`Referrals & Terms | ${SITE_TITLE}`} description="Secure referrals, terms of instruction, imaging transfer guidance (DICOM / PACS) and fee structure for instructing Dr Joseph El-Sheikha as a medico-legal radiology expert.">
	<PageHero
		eyebrow="Instructing the expert"
		title="Referrals & Terms"
		description="A secure referral form for GP and solicitor referrers, alongside terms of instruction, imaging transfer guidance and fees."
	/>

	<section class="bg-white py-16 dark:bg-navy-900">
		<div class="container-page grid gap-12 lg:grid-cols-5">
			<!-- Form -->
			<div class="lg:col-span-3">
				<span class="eyebrow block">Secure referral</span>
				<h2 class="mt-3 text-2xl font-bold tracking-tight text-navy-900 dark:text-slate-100">Submit a medico-legal referral</h2>
				<p class="mt-3 text-slate-600 dark:text-slate-300">Complete the form below and it will be stored securely for the secretariat to action. Fields marked * are required.</p>

				<form id="referral-form" class="mt-8 grid gap-5 sm:grid-cols-2">
					<label class="block text-sm font-medium text-navy-900 dark:text-slate-100">
						Referrer type *
						<select name="referrerType" required class="input-field mt-1.5">
							<option value="">Select…</option>
							<option>GP / General Practice</option>
							<option>Solicitor / Barrister</option>
							<option>Insurer</option>
							<option>Hospital / NHS Trust</option>
							<option>Patient / member of the public</option>
						</select>
					</label>
					<label class="block text-sm font-medium text-navy-900 dark:text-slate-100">
						Referrer name *
						<input name="referrerName" type="text" required class="input-field mt-1.5" placeholder="Full name" />
					</label>
					<label class="block text-sm font-medium text-navy-900 dark:text-slate-100">
						Firm / organisation
						<input name="organisation" type="text" class="input-field mt-1.5" placeholder="Firm or trust" />
					</label>
					<label class="block text-sm font-medium text-navy-900 dark:text-slate-100">
						Email *
						<input name="referrerEmail" type="email" required class="input-field mt-1.5" placeholder="you@firm.co.uk" />
					</label>
					<label class="block text-sm font-medium text-navy-900 dark:text-slate-100">
						Phone
						<input name="referrerPhone" type="tel" class="input-field mt-1.5" placeholder="Optional" />
					</label>
					<label class="block text-sm font-medium text-navy-900 dark:text-slate-100">
						Patient / case reference *
						<input name="patientRef" type="text" required class="input-field mt-1.5" placeholder="Reference or pseudonym" />
					</label>
					<label class="block text-sm font-medium text-navy-900 dark:text-slate-100 sm:col-span-2">
						Clinical / issue summary *
						<textarea name="summary" rows="4" required class="input-field mt-1.5" placeholder="Brief, anonymised summary of the issue and the imaging question"></textarea>
					</label>
					<label class="block text-sm font-medium text-navy-900 dark:text-slate-100 sm:col-span-2">
						Urgency
						<select name="urgency" class="input-field mt-1.5">
							<option value="standard">Standard ({FEES.standardTurnaround})</option>
							<option value="urgent">Urgent ({FEES.urgentTurnaround})</option>
						</select>
					</label>
					<div class="sm:col-span-2 flex items-center gap-3">
						<button type="submit" class="btn btn-primary" data-submit>Submit referral</button>
						<span class="text-xs text-slate-500 dark:text-slate-400">Stored securely; never including patient-identifying case details on this page.</span>
					</div>
				</form>
			</div>

			<!-- Sidebar -->
			<aside class="lg:col-span-2 space-y-6">
				<div class="card p-6">
					<h3 class="text-lg font-bold text-navy-900 dark:text-slate-100">Terms of engagement</h3>
					<ul class="mt-4 space-y-2.5 text-sm text-slate-600 dark:text-slate-300">
						<li>Reports prepared in accordance with <strong>CPR Part 35</strong> and the <strong>Expert Witness Institute / EMA</strong> Code of Practice.</li>
						<li>Re-derivation from source DICOM where required; reports are anonymised and reproducible.</li>
						<li>Conflicts of interest, indemnity and availability checked before acceptance.</li>
					</ul>
				</div>

				<div class="card p-6">
					<h3 class="text-lg font-bold text-navy-900 dark:text-slate-100">Imaging transfer (DICOM / PACS)</h3>
					<p class="mt-2 text-sm text-slate-600 dark:text-slate-300">Imaging is accepted via encrypted transfer or secure DICOM link. Please include the full study (not screenshots) and any prior comparative studies.</p>
					<a href="#terms" class="mt-3 inline-flex items-center gap-2 text-sm font-semibold text-teal-700 dark:text-teal-400">View transfer checklist
						<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5v14"/></svg>
					</a>
				</div>

				<div class="card p-6 border-teal-500/30">
					<h3 class="text-lg font-bold text-navy-900 dark:text-slate-100">Fees & turnaround</h3>
					<ul class="mt-4 space-y-2.5 text-sm text-slate-600 dark:text-slate-300">
						<li>Standard report: <strong class="text-navy-900 dark:text-slate-100">{FEES.standardFee}</strong></li>
						<li>Urgent supplement: <strong class="text-navy-900 dark:text-slate-100">{FEES.urgentSurcharge}</strong></li>
						<li>Standard turnaround: <strong class="text-navy-900 dark:text-slate-100">{FEES.standardTurnaround}</strong></li>
						<li>Urgent turnaround: <strong class="text-navy-900 dark:text-slate-100">{FEES.urgentTurnaround}</strong></li>
						<li>Attendance / conference fees quoted on request.</li>
					</ul>
				</div>
			</aside>
		</div>
	</section>
</BaseLayout>

<script>
	const form = document.getElementById("referral-form") as HTMLFormElement | null;
	if (form) {
		form.addEventListener("submit", async (e) => {
			e.preventDefault();
			const data = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
			const btn = form.querySelector("[data-submit]") as HTMLButtonElement | null;
			if (btn) { btn.disabled = true; btn.textContent = "Submitting…"; }
			try {
				const res = await fetch("/api/referrals", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify(data),
				});
				const json = await res.json();
				if (!res.ok) throw new Error(json.error || "Submission failed");
				form.reset();
				alert("Thank you. Your referral has been received (reference " + json.reference.slice(0, 8).toUpperCase() + ").");
			} catch (err) {
				alert("There was a problem submitting the referral. Please email the secretariat directly.");
			} finally {
				if (btn) { btn.disabled = false; btn.textContent = "Submit referral"; }
			}
		});
	}
</script>