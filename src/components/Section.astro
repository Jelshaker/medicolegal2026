---
// Reusable content section wrapper with optional eyebrow + title.
// All new props are optional, so existing call sites render unchanged.
// `id` gives the section a stable anchor (called from PageIntro `contents`),
// `index` prints an understated section number, and `lead` states the point
// of the section in one sentence before the detail. Content is held in a
// centered single column between hairline rules.
interface Props {
	id?: string;
	eyebrow?: string;
	/** Section number, e.g. "01". */
	index?: string;
	/** Short display title, e.g. the case name without its citation. */
	title?: string;
	/** Full neutral citation (or source line) set small beneath the title. */
	citation?: string;
	lead?: string;
	span?: 1 | 2;
	children?: string;
}

const { id, eyebrow, index, title, citation, lead = "" } = Astro.props as Props;
const headingId = id ? `${id}-heading` : undefined;
---

<section id={id} aria-labelledby={headingId} class="scroll-mt-24">
	<div class="doc overflow-hidden">
		<div class="sec">
			{(index || eyebrow) && (
				<div class="flex min-w-0 flex-wrap items-baseline gap-x-3 gap-y-1">
					{index && (
						<span class="sec-no">
							§ {index}
						</span>
					)}
					{eyebrow && <span class="meta-label">{eyebrow}</span>}
				</div>
			)}
			{title && (
				<h2 id={headingId} class="sec-title text-balance break-words">
					{title}
				</h2>
			)}
			{citation && (
				<p class="mt-1.5 font-sans text-[0.8rem] leading-relaxed tracking-wide text-muted-light break-words">
					{citation}
				</p>
			)}
			{lead && <p class="standfirst">{lead}</p>}
		</div>
		<slot />
	</div>
</section>