---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { SITE_TITLE, PAGE_HERO_IMAGES, SITEMAP } from "../consts";

export const prerender = true;
---

<BaseLayout
	title={`Site map | ${SITE_TITLE}`}
	description="A list of every page on this site."
>
	<PageHero
		eyebrow="Site map"
		title="Site map"
		heroImage={PAGE_HERO_IMAGES["/sitemap"] || undefined}
	/>

	<section class="band-white">
		<div class="container-page">
			<div class="doc space-y-10">
				{
					SITEMAP.map((group) => (
						<section id={group.id}>
							<h2 class="sec-title mt-0">
								{group.title}
							</h2>
							<ul class="mt-3 space-y-2">
								{group.pages.map((page) => (
									<li>
										<a
											href={page.href}
											class="text-base text-slate-900 hover:underline"
										>
											{page.label}
										</a>
									</li>
								))}
							</ul>
						</section>
					))
				}
			</div>
		</div>
	</section>
</BaseLayout>