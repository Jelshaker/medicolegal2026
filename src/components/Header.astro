---
import { LOGIN_BUTTON_TEXT, LOGIN_BUTTON_TEXT_MOBILE, NAVIGATION_LINKS, PRACTITIONER, SITE_BRAND_SUBTITLE, SITE_TITLE } from "../consts";

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
    href === "/" ? pathname === "/" : pathname.startsWith(href);

const navLinkClass = (href: string) =>
    isActive(href)
        ? "nav-link nav-link-active"
        : "nav-link nav-link-inactive";
---

<header class="sticky-bar">
    <div class="container-page row-lg row-justify-between header-bar">
        <a href="/" class="group flex shrink-0 items-center gap-3" aria-label={`${SITE_TITLE} — home`}>
            <img
                src="/logo.png"
                alt={`${SITE_TITLE} logo`}
                width="512"
                height="512"
                class="header-logo"
                loading="eager"
                decoding="async"
            />
            <span>
                <span class="brand-name">
                    {PRACTITIONER.shortName}
                </span>
                <span class="meta-label mt-0.5 block !text-[0.62rem]">{SITE_BRAND_SUBTITLE}</span>
            </span>
        </a>

        <!-- Desktop Navigation -->
        <nav class="header-nav hidden lg:flex" aria-label="Primary">
            <div class="flex items-center gap-x-6">
                {
                    NAVIGATION_LINKS.map((link) => (
                        <a
                            href={link.href}
                            class:list={[navLinkClass(link.href)]}
                        >
                            {link.label}
                        </a>
                    ))
                }
            </div>

            <!-- Vertical Divider -->
            <div class="vrule" aria-hidden="true"></div>

            <a href="/login" class="btn btn-ghost shrink-0 header-login">{LOGIN_BUTTON_TEXT}</a>
        </nav>

        <!-- Mobile Toggle & Actions -->
        <div class="flex items-center gap-3 lg:hidden">
            <a href="/login" class="btn btn-ghost header-login-mobile hidden sm:inline-flex lg:hidden">
                {LOGIN_BUTTON_TEXT}
            </a>

            <button
                id="menu-toggle"
                type="button"
                class="header-toggle"
                aria-label="Open menu"
                aria-expanded="false"
                aria-controls="mobile-menu"
            >
                <svg id="icon-burger" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M4 7h16M4 12h16M4 17h16" />
                </svg>
                <svg id="icon-close" class="hidden h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M6 6l12 12M18 6 6 18" />
                </svg>
            </button>
        </div>
    </div>

    <!-- Mobile Navigation Drawer -->
    <div
        id="mobile-menu"
        class="hidden menu-mobile mobile-menu-drawer"
        aria-label="Mobile"
    >
        <ul class="flex flex-col text-right">
            {
                NAVIGATION_LINKS.map((link) => (
                    <li class="border-b border-slate-100 last:border-b-0">
                        <a
                            href={link.href}
                            class:list={[
                                isActive(link.href) ? "nav-mobile-active" : "nav-mobile",
                            ]}
                        >
                            {link.label}
                        </a>
                    </li>
                ))
            }
            <li class="mt-3 divider pt-4">
                <a href="/login" class="btn btn-ghost w-full">{LOGIN_BUTTON_TEXT_MOBILE}</a>
            </li>
        </ul>
    </div>

<style>
    .header-bar {
        height: 4rem;
    }
    @media (min-width: 768px) {
        .header-bar {
            height: 4.75rem;
        }
    }
    header {
        /* Positioned by the .sticky-bar utility (position: sticky; top: 0; z-index: 50). */
    }
    .header-logo {
        height: 2.75rem;
        width: 2.75rem;
    }
    @media (min-width: 768px) {
        .header-logo {
            height: 3rem;
            width: 3rem;
        }
    }
    .header-nav {
        display: none;
        min-width: 0;
        align-items: center;
        gap: 2rem;
        line-height: 1.25;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
        &::-webkit-scrollbar {
            display: none;
        }
    }
    @media (min-width: 1024px) {
        .header-nav {
            display: flex;
        }
    }
    .header-toggle {
        display: flex;
        height: 2.5rem;
        width: 2.5rem;
        align-items: center;
        justify-content: center;
        border: 1px solid #cbd5e1;
        color: #334155;
        transition: border-color 0.15s ease, color 0.15s ease;
    }
    .header-toggle:hover {
        border-color: #0f172a;
        color: #0f172a;
    }
    .header-login,
    .header-login-mobile {
        font-size: 0.75rem;
        padding: 0.5rem 1rem !important;
    }
    /* Desktop nav: hidden below lg, shown at lg+ */
    @media (max-width: 1023px) {
        .header-nav {
            display: none !important;
        }
    }

    /* Narrow dropdown menu — positioned under the hamburger button on the right */
    .mobile-menu-drawer {
        position: absolute;
        top: 100%;
        right: 0;
        width: 12rem;
        z-index: 60;
    }
</style>
</header>

<script>
    function openMenu() {
        const mobileMenu = document.getElementById("mobile-menu");
        const iconBurger = document.getElementById("icon-burger");
        const iconClose = document.getElementById("icon-close");
        const toggle = document.getElementById("menu-toggle");
        if (!mobileMenu) return;
        mobileMenu.classList.remove("hidden");
        toggle?.setAttribute("aria-expanded", "true");
        iconBurger?.classList.add("hidden");
        iconClose?.classList.remove("hidden");
    }

    function closeMenu() {
        const mobileMenu = document.getElementById("mobile-menu");
        const iconBurger = document.getElementById("icon-burger");
        const iconClose = document.getElementById("icon-close");
        const toggle = document.getElementById("menu-toggle");
        if (!mobileMenu) return;
        mobileMenu.classList.add("hidden");
        toggle?.setAttribute("aria-expanded", "false");
        iconBurger?.classList.remove("hidden");
        iconClose?.classList.add("hidden");
    }

    function toggleMenu() {
        const mobileMenu = document.getElementById("mobile-menu");
        if (!mobileMenu) return;
        if (mobileMenu.classList.contains("hidden")) {
            openMenu();
        } else {
            closeMenu();
        }
    }

    // Toggle open/close when clicking the menu button (burger or X icon)
    document.addEventListener("click", (e) => {
        const toggle = e.target.closest("#menu-toggle");
        if (!toggle) return;
        e.preventDefault();
        toggleMenu();
    });

    // Close mobile menu when a nav link inside it is clicked.
    document.addEventListener("click", (e) => {
        const link = e.target.closest("#mobile-menu a");
        if (!link) return;
        closeMenu();
    });

    // Close mobile menu when clicking anywhere outside the menu area
    document.addEventListener("click", (e) => {
        const mobileMenu = document.getElementById("mobile-menu");
        const toggle = document.getElementById("menu-toggle");
        if (!mobileMenu || !toggle) return;
        if (mobileMenu.classList.contains("hidden")) return;
        if (!mobileMenu.contains(e.target) && !toggle.contains(e.target)) {
            closeMenu();
        }
    });
</script>
