---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { formatDate, readingTime } from "../lib/utils";

export interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	category: string;
	tags: string[];
	author: string;
	featured?: boolean;
	anonymised?: boolean;
	keyTakeaways?: string[];
	figures?: string[];
}

const { title, description, pubDate, updatedDate, category, tags, author, keyTakeaways, figures } =
	Astro.props as Props;

const readMin = readingTime(Astro.request.url?.toString() ?? "");
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />

		<article class="prose prose-lg prose-slate dark:prose-invert max-w-none">
			<!-- Article header -->
			<div class="bg-gradient-to-b from-slate-50 to-white py-10 sm:py-16 dark:from-navy-950 dark:to-navy-900/60">
				<div class="container-page">
					<div class="mx-auto max-w-3xl">
						<span class="eyebrow mb-3">{category.replace("-", " ").replace(/\b\w/g, c => c.toUpperCase())}</span>
						<h1 class="text-3xl font-extrabold leading-tight tracking-tight text-navy-900 dark:text-white sm:text-4xl lg:text-5xl">
							{title}
						</h1>
						<p class="mt-4 text-lg leading-relaxed text-slate-600 dark:text-slate-300 max-w-2xl">
							{description}
						</p>
						<div class="mt-5 flex flex-wrap items-center gap-3 text-sm text-slate-500 dark:text-slate-400">
							<span class="inline-flex items-center gap-2">
								<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
									<circle cx="12" cy="12" r="10"/>
									<path d="M12 6v6l4 2"/>
								</svg>
								Published {formatDate(pubDate)}
							</span>
							{updatedDate && (
								<span class="inline-flex items-center gap-2">
									<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
										<path d="M21 12a9 9 0 1 1-9-9c2.5 0 4.5 1 5 2h-5a3 3 0 0 0-3 3v0c0 .5 0 1-.5 1.5" opacity=".8"/>
										<path d="M21 12h-3a5 5 0 0 0 0 10h3"/>
									</svg>
									Updated {formatDate(updatedDate)}
								</span>
							)}
							<span class="inline-flex items-center gap-2">
								<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
									<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
									<path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
								</svg>
								{readMin} min read
							</span>
							{anonymised && (
								<span class="inline-flex items-center gap-2 rounded-full border border-navy-200 bg-navy-50 px-2.5 py-1 text-[0.7rem] font-semibold uppercase tracking-wider text-navy-700 dark:border-teal-500/40 dark:bg-navy-900 dark:text-teal-300">
									Anonymised
								</span>
							)}
						</div>
						<div class="mt-5 flex flex-wrap gap-2">
							{tags.map(tag => (
								<span class="chip">{tag}</span>
							))}
						</div>
						<div class="mt-6 flex items-center gap-3 rounded-xl border border-slate-200 bg-white p-3 shadow-sm dark:border-navy-700 dark:bg-navy-900/60">
							<div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-navy-800 to-navy-950 text-white text-sm font-bold">
								EV
							</div>
							<div class="text-sm leading-relaxed text-slate-600 dark:text-slate-300">
								<span class="font-semibold text-slate-800 dark:text-slate-100">Dr Eleanor Voss MBBS FRCR</span>
								<br />
								<span class="text-slate-500 dark:text-slate-400">Consultant Radiologist &amp; Medicolegal Expert Witness</span>
							</div>
						</div>
					</div>
				</div>
			</div>

				<!-- Key takeaways -->
				{keyTakeaways && (
					<aside class="border-l-4 border-teal-500 bg-teal-50 p-5 dark:border-teal-400 dark:bg-teal-950/30">
						<div class="flex items-center gap-3 text-teal-700 dark:text-teal-300">
							<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
								<path d="M12 9v4M12 17h.01"/>
								<circle cx="12" cy="12" r="10"/>
							</svg>
							<span class="text-sm font-semibold">Key Takeaways for the Court / Tribunal</span>
						</div>
						<ul class="mt-3 space-y-2 text-sm text-slate-700 dark:text-slate-300">
							{keyTakeaways.map(t => (
								<li class="flex gap-2">
									<span class="mt-0.5 h-4 w-4 shrink-0 flex items-center justify-center rounded-full bg-teal-200 text-[10px] font-bold text-teal-800 dark:bg-teal-800 dark:text-teal-200">•</span>
									<span>{t}</span>
								</li>
							))}
						</ul>
					</aside>
				)}
			</div>
		</article>

		<Footer />
	</body>
</html>

<style>
	.prose ol, .prose ul { margin: 1rem 0 1rem 1.5rem; }
	.prose li { margin: 0.5rem 0; }
	.prose p { margin: 0 0 1rem; }
	.prose h2 { margin: 1.5rem 0 0.5rem; }
	.prose h3 { margin: 1rem 0 0.5rem; }
	.prose blockquote { border-left: 3px solid var(--color-teal-500); margin: 1.5rem 0; padding-left: 1rem; }
	.prose strong { color: var(--color-navy-900); }
	.prose a { color: var(--color-teal-600); text-decoration: underline; }
	.dark .prose a { color: var(--color-teal-400); }
	.dark .prose strong { color: var(--color-slate-100); }
</style>