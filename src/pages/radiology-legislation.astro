---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import PageIntro from '../components/PageIntro.astro';
import Callout from '../components/Callout.astro';
import Figure from '../components/Figure.astro';
import Diagram from '../components/Diagram.astro';
import LegislationEntry from '../components/LegislationEntry.astro';
import { SITE_TITLE, PAGE_HERO_IMAGES } from '../consts';

const instruments = [
    {
        id: 'irmer',
        index: '01',
        eyebrow: 'Patient exposures',
        title: 'IR(ME)R 2017',
        lead:
            'IR(ME)R governs the justification, optimisation and clinical evaluation of individual medical exposures to ionising radiation in Great Britain.',
        fields: [
            {
                n: 'Duty holders',
                d: 'The employer, referrer, practitioner and operator, each exercising defined statutory functions.',
            },
            {
                n: 'Principal duties',
                d: 'Justification, authorisation, optimisation, clinical evaluation, quality assurance, clinical audit and appropriate training.',
            },
            {
                n: 'Records',
                d: 'Entitlement and training, referrals and authorisations, exposure information, clinical evaluations and investigations of accidental or unintended exposures.',
            },
            {
                n: 'Enforcement',
                d: 'Enforced as criminal law by the relevant national authority. In England, this is the Care Quality Commission.',
            },
        ],
        note:
            'Ionising Radiation (Medical Exposure) Regulations 2017, SI 2017/1322, as amended. Northern Ireland has separate regulations.',
    },
    {
        id: 'irr17',
        index: '02',
        eyebrow: 'Staff and workplace',
        title: 'IRR17',
        lead:
            'IRR17 protects staff and the public from risks arising from work with ionising radiation.',
        fields: [
            {
                n: 'Duty holders',
                d: 'The radiation employer and employees working with ionising radiation.',
            },
            {
                n: 'Principal duties',
                d: 'Prior risk assessment, restriction of exposure, engineering controls, designated areas, local rules, contingency planning, training and appropriate monitoring.',
            },
            {
                n: 'Records',
                d: 'Risk assessments, local rules, training, equipment examinations, area monitoring, dose assessments and health records where required.',
            },
            {
                n: 'Enforcement',
                d: 'Enforced principally by the Health and Safety Executive through statutory notices and criminal prosecution.',
            },
        ],
        note:
            'Ionising Radiations Regulations 2017, SI 2017/1075. The effective-dose limit for an adult employee is generally 20 mSv in a calendar year.',
    },
    {
        id: 'epr16',
        index: '03',
        eyebrow: 'Radioactive substances',
        title: 'EPR 2016',
        lead:
            'The Environmental Permitting Regulations control radioactive-material activities and radioactive waste in England and Wales.',
        fields: [
            {
                n: 'Duty holder',
                d: 'The operator holding the environmental permit, usually the NHS trust or other employing organisation.',
            },
            {
                n: 'Principal duties',
                d: 'Compliance with permit conditions governing radioactive materials, accumulation, disposal, monitoring and environmental protection.',
            },
            {
                n: 'Records',
                d: 'Source and waste inventories, monitoring results, accumulations, disposals, compliance records and regulatory returns.',
            },
            {
                n: 'Enforcement',
                d: 'The Environment Agency acts in England and Natural Resources Wales in Wales.',
            },
        ],
        note:
            'Environmental Permitting (England and Wales) Regulations 2016, SI 2016/1154. Different legislation applies in Scotland and Northern Ireland.',
    },
    {
        id: 'data-protection',
        index: '04',
        eyebrow: 'Patient information',
        title: 'UK GDPR and Data Protection Act 2018',
        lead:
            'Identifiable images, reports and associated clinical information are personal data and usually special-category health data.',
        fields: [
            {
                n: 'Duty holders',
                d: 'The controller determines the purpose and means of processing. External suppliers may act as processors or separate controllers.',
            },
            {
                n: 'Principal duties',
                d: 'Lawfulness, fairness, transparency, data minimisation, accuracy, security, accountability and controls over disclosure and transfer.',
            },
            {
                n: 'Records',
                d: 'Processing records, privacy information, retention schedules, supplier contracts, access controls, breach records and DPIAs where required.',
            },
            {
                n: 'Enforcement',
                d: 'The Information Commissioner may investigate, issue enforcement notices and impose administrative penalties.',
            },
        ],
        note:
            'Healthcare processing does not ordinarily rely on patient consent as its data-protection lawful basis. The appropriate Article 6 basis and Article 9 condition must be identified.',
    },
] as const;

const accentColors = [
    '#7c9a6e',
    '#b8935a',
    '#7a8da0',
    '#a07a8d',
] as const;
---

<BaseLayout
    title={`Radiology Legislation | ${SITE_TITLE}`}
    description="The principal legislation governing medical exposures, workplace radiation protection, radioactive substances and imaging data."
>
    <PageHero
        eyebrow="Radiology legislation"
        title="Radiology Legislation"
        description="The statutory framework governing patient exposure, workplace radiation protection, radioactive substances and imaging data."
        heroImage={PAGE_HERO_IMAGES["/radiology-legislation"] || undefined}
    />

    <PageIntro
        eyebrow="Statutory framework"
        paragraphs={[
            'Four principal legal regimes govern radiological practice: IR(ME)R for medical exposures; IRR17 for staff and public protection; environmental permitting for radioactive substances and waste; and data protection law for identifiable images and clinical information.',
            'Each entry identifies the principal duty holders, requirements, records and enforcement route. Professional standards and civil negligence are considered separately.'
        ]}
        contents={[
            { href: '#irmer', label: 'IR(ME)R 2017' },
            { href: '#irr17', label: 'IRR17' },
            { href: '#epr16', label: 'EPR 2016' },
            { href: '#data-protection', label: 'Data protection' },
            { href: '#communication', label: 'Critical findings' },
            { href: '#legal-effect', label: 'Legal effect' },
        ]}
        audience="Written for radiologists, radiographers, medical physicists, radiation protection professionals and expert witnesses."
        reviewed="October 2026"
    />

    <section class="band-paper">
        <div class="container-page">
            <div class="doc">
                <Figure
                    label="Figure 01"
                    caption="The four regulatory domains"
                    subtitle="Patient exposure, workplace protection, radioactive substances and patient information are governed by distinct legal regimes."
                >
                    <Diagram name="duty-holders" />
                </Figure>
            </div>
        </div>
    </section>

    <section class="section-dark">
        <div class="container-page">
            <div class="space-y-12">
                {
                    instruments.map((instrument, index) => (
                        <LegislationEntry
                            id={instrument.id}
                            index={instrument.index}
                            eyebrow={instrument.eyebrow}
                            title={instrument.title}
                            lead={instrument.lead}
                            fields={instrument.fields}
                            note={instrument.note}
                            accent={accentColors[index] ?? '#94a3b8'}
                        />
                    ))
                }
            </div>
        </div>
    </section>

    <section id="communication" class="band-paper">
        <div class="container-page">
            <div class="doc space-y-8">
                <div>
                    <p class="eyebrow">Professional duty</p>
                    <h2 class="heading-lg">Communication of Critical Findings</h2>

                    <p class="para">
                        Communication of urgent or unexpected findings is not a separate
                        statutory regime. It arises from the duty of care, professional
                        standards and local governance arrangements.
                    </p>
                </div>

                <div class="entry-list">
                    <div class="entry">
                        <h3 class="entry-title">Provider</h3>
                        <p class="para-sm">
                            The provider should maintain a documented system for communicating,
                            acknowledging and acting on urgent findings, including a fail-safe
                            process where acknowledgement is not received.
                        </p>
                    </div>

                    <div class="entry">
                        <h3 class="entry-title">Reporter</h3>
                        <p class="para-sm">
                            The reporter should use the agreed escalation route, communicate
                            with appropriate urgency and record the action taken.
                        </p>
                    </div>

                    <div class="entry">
                        <h3 class="entry-title">Clinical team</h3>
                        <p class="para-sm">
                            The responsible clinical team should review, act on and communicate
                            the result in accordance with local arrangements.
                        </p>
                    </div>
                </div>

                <p class="para-sm">
                    Professional source: Royal College of Radiologists,
                    <em>Alerts and notification of imaging reports: recommendations</em>,
                    October 2022.
                </p>

                <Callout tone="caution" title="Findings and exposures are distinct">
                    <p>
                        IR(ME)R regulation 8 concerns accidental or unintended radiation
                        exposures. It does not create the general duty to escalate a critical
                        diagnostic finding.
                    </p>
                </Callout>
            </div>
        </div>
    </section>

    <section id="legal-effect" class="band-white">
        <div class="container-page">
            <div class="panel-dark-lg">
                <h2 class="heading-hero-white">
                    Regulatory breach and civil liability
                </h2>

                <p class="centered-text-muted">
                    Regulatory enforcement and clinical negligence are distinct. A regulatory
                    contravention may occur without compensable injury. A civil claim requires
                    proof of duty, breach, causation and damage.
                </p>

                <div class="btn-group">
                    /medicolegal-fundamentals
                        Medicolegal fundamentals
                    </a>

                    /radiology-legal-cases
                        Case law
                    </a>

                    /radiology-fundamentals
                        Radiology fundamentals
                    </a>
                </div>
            </div>
        </div>
    </section>

    <section class="band-paper">
        <div class="container-page">
            <Callout tone="caution" title="Summary only">
                <p>
                    This page is an overview. The current legislation, permit conditions and
                    regulator guidance should be consulted where the precise wording or
                    application of a requirement matters.
                </p>
            </Callout>
        </div>
    </section>
</BaseLayout>