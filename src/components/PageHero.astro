---
// Reusable page masthead — full-width hero image with a soft gradient overlay,
// then the page eyebrow / title / description centred over it.
//
// Props
//   eyebrow     — uppercase label above the title (optional)
//   title       — page heading (required)
//   description — standfirst paragraph (optional)
//   heroImage   — URL path to a hero image (optional)
//   darkOverlay — strength of the dark gradient; default 0.65 (0–1)

interface Props {
	eyebrow?: string;
	title: string;
	description?: string;
	heroImage?: string;
	darkOverlay?: number;
}

const {
	eyebrow = "Radiology & medicolegal law",
	title,
	description = "",
	heroImage,
	darkOverlay = 0.65,
} = Astro.props as Props;

// When a hero image is present we apply a gradient on top; 0.65 means the
// dark layer is 65% opacity at its darkest (the text zone), fading to clear at
// the edges so the image bleeds naturally into the next section.
const gradient = heroImage
	? `linear-gradient(to bottom, rgba(2 6 23 / ${darkOverlay}) 0%, rgba(2 6 23 / ${darkOverlay * 0.4}) 40%, rgba(2 6 23 / ${darkOverlay * 0.15}) 70%, rgba(2 6 23 / 0) 100%)`
	: "transparent";
---

<section
	class:list={[
		"relative overflow-hidden border-b border-slate-300",
		heroImage ? "min-h-[36rem] sm:min-h-[42rem]" : "py-14 sm:py-16",
	]}
>
	<!-- Hero background image -->
	{heroImage && (
		<img
			src={heroImage}
			alt=""
			class="absolute inset-0 h-full w-full object-cover"
			loading="eager"
		/>
	)}

	<!-- Dark gradient overlay (only when there is an image) -->
	{heroImage && (
		<div
			class="absolute inset-0"
			style={`background: ${gradient};`}
			aria-hidden="true"
		/>
	)}

	<!-- Content — always centred in a single-column measure -->
	<div class="container-page relative z-10 py-16 sm:py-20">
		<div class="doc text-center mx-auto">
			{eyebrow && <p class="meta-label text-slate-300">{eyebrow}</p>}
			<h1 class="mt-5 font-serif text-4xl font-bold leading-tight text-white sm:text-5xl md:text-6xl text-balance break-words">
				{title}
			</h1>
			{description && <p class="standfirst mx-auto mt-4 text-slate-200/90">{description}</p>}
			<slot />
		</div>
	</div>
</section>
