---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import PageIntro from "../components/PageIntro.astro";
import Section from "../components/Section.astro";
import Callout from "../components/Callout.astro";
import { PRACTITIONER, SITE_TITLE } from "../consts";

export const prerender = true;
---

<BaseLayout
	title={`Privacy notice | ${SITE_TITLE}`}
	description="How this radiology and medicolegal law resource handles personal data: enquiry, referral and comment forms, optional analytics, lawful bases, retention, transfers, and your UK GDPR rights."
>
	<PageHero
		eyebrow="Your information"
		title="Privacy notice"
		description="Who holds your information when you use this site, what is collected, why it is needed, how long it is kept, and the rights you have over it."
	/>

	<PageIntro
		eyebrow="Your information"
		paragraphs={[
			"Reading the reference material needs no account and collects nothing about you. Personal data is only processed when you choose to send something — an enquiry, a referral, a comment — or when you accept the optional analytics cookie.",
			"This notice is written for the UK General Data Protection Regulation and the Data Protection Act 2018. It explains what is collected, the lawful basis for each use, how long it is kept, and the rights you have over it.",
		]}
		contents={[
			{ href: "#controller", label: "Who is responsible" },
			{ href: "#what-collected", label: "What is collected" },
			{ href: "#lawful-bases", label: "Why it is lawful" },
			{ href: "#how-used", label: "Uses and sharing" },
			{ href: "#retention", label: "Retention" },
			{ href: "#rights", label: "Your rights" },
		]}
		reviewed="September 2026"
	/>

	<section class="bg-white py-16">
		<div class="container-page">
			<div class="doc space-y-14">
				<Section
					id="controller"
					index="01"
					eyebrow="Data controller"
					title="Who is responsible for your information"
					lead="The person deciding how and why your information is processed is the curator of this resource."
				>
					<table class="mt-6 w-full border-collapse text-left">
						<tbody>
							<tr class="bg-white">
								<th scope="row" class="w-32 border-b border-slate-200 bg-paper px-3 py-3 align-top font-sans text-[0.7rem] font-semibold uppercase tracking-[0.12em] text-slate-500">Controller</th>
								<td class="border-b border-slate-200 px-3 py-3 align-top font-serif text-[0.95rem] text-slate-800">{PRACTITIONER.name}, {PRACTITIONER.title}</td>
							</tr>
							<tr class="bg-white">
								<th scope="row" class="w-32 border-b border-slate-200 bg-paper px-3 py-3 align-top font-sans text-[0.7rem] font-semibold uppercase tracking-[0.12em] text-slate-500">Contact</th>
								<td class="border-b border-slate-200 px-3 py-3 align-top font-serif text-[0.95rem] text-slate-800">
									<a href={`mailto:${PRACTITIONER.email}`} class="underline decoration-slate-300 underline-offset-4 hover:text-slate-950 hover:decoration-slate-600">{PRACTITIONER.email}</a>
									{` · ${PRACTITIONER.phone}`}
								</td>
							</tr>
							<tr class="bg-white">
								<th scope="row" class="w-32 border-b border-slate-200 bg-paper px-3 py-3 align-top font-sans text-[0.7rem] font-semibold uppercase tracking-[0.12em] text-slate-500">Address</th>
								<td class="border-b border-slate-200 px-3 py-3 align-top font-serif text-[0.95rem] text-slate-800">{PRACTITIONER.address}</td>
							</tr>
						</tbody>
					</table>
				</Section>

				<Section
					id="what-collected"
					index="02"
					eyebrow="Data collected"
					title="What is collected, and when"
					lead="Browsing is anonymous. Each interaction below collects only what that interaction needs."
				>
					<div class="mt-6 divide-y divide-slate-200 border-t border-slate-200">
						<div class="py-5">
							<h3 class="font-serif text-base font-bold text-slate-900">Reading the reference material</h3>
							<p class="mt-2 font-serif text-sm leading-relaxed text-slate-600">Nothing. No account, no sign-up, no contact details. The free DICOM viewer opens images inside your own browser — files never leave your device.</p>
						</div>
						<div class="py-5">
							<h3 class="font-serif text-base font-bold text-slate-900">Enquiry and referral forms</h3>
							<p class="mt-2 font-serif text-sm leading-relaxed text-slate-600">Name, email, and the message or case summary you write. Referrals add referrer type, organisation, phone and a case reference. Send an anonymised summary only — no patient names, dates of birth, NHS numbers or directly identifying information.</p>
						</div>
						<div class="py-5">
							<h3 class="font-serif text-base font-bold text-slate-900">Comments</h3>
							<p class="mt-2 font-serif text-sm leading-relaxed text-slate-600">The display name and comment text you post. Comments are public — do not include anything identifying a patient or a living individual involved in proceedings.</p>
						</div>
						<div class="py-5">
							<h3 class="font-serif text-base font-bold text-slate-900">Optional analytics</h3>
							<p class="mt-2 font-serif text-sm leading-relaxed text-slate-600">Only if you click “Accept analytics”: Google Analytics 4 records which pages are read, using cookies beginning _ga. Reject or ignore the banner and nothing is recorded. See the <a href="/cookie-policy" class="underline decoration-slate-300 underline-offset-4 hover:text-slate-900 hover:decoration-slate-600">cookie policy</a>.</p>
						</div>
						<div class="py-5">
							<h3 class="font-serif text-base font-bold text-slate-900">Technical logs</h3>
							<p class="mt-2 font-serif text-sm leading-relaxed text-slate-600">The hosting platform (Cloudflare) keeps short-lived security and delivery logs, including IP addresses, to keep the site available and defend against abuse.</p>
						</div>
					</div>
				</Section>

				<Section
					id="lawful-bases"
					index="03"
					eyebrow="Lawful bases"
					title="Why processing is lawful"
					lead="Every use of personal data needs a lawful basis under Article 6 of the UK GDPR."
				>
					<div class="mt-6 divide-y divide-slate-200 border-t border-slate-200">
						<div class="py-5">
							<h3 class="font-serif text-base font-bold text-slate-900">Consent — Article 6(1)(a)</h3>
							<p class="mt-2 font-serif text-sm leading-relaxed text-slate-600">The optional analytics cookie. Given by clicking “Accept analytics”, recorded with its date, withdrawable at any time via “Cookie settings” in the footer.</p>
						</div>
						<div class="py-5">
							<h3 class="font-serif text-base font-bold text-slate-900">Pre-contract steps — Article 6(1)(b)</h3>
							<p class="mt-2 font-serif text-sm leading-relaxed text-slate-600">Enquiries and referrals: handling your message to respond and, where applicable, to enter into terms of engagement.</p>
						</div>
						<div class="py-5">
							<h3 class="font-serif text-base font-bold text-slate-900">Legitimate interests — Article 6(1)(f)</h3>
							<p class="mt-2 font-serif text-sm leading-relaxed text-slate-600">A secure, available site: security logging, abuse prevention, remembering your cookie choice, comment moderation. Minimal data; anything further needs consent.</p>
						</div>
					</div>
					<Callout tone="limit" title="Health information">
						<p>
							Health information is special-category data under Article 9 of the UK GDPR. That is
							why the forms ask for an anonymised summary only. Anything patient-identifiable you
							send voluntarily about a prospective instruction is processed under Article 9(2)(f) —
							legal claims — under a doctor's duty of confidentiality.
						</p>
					</Callout>
				</Section>

				<Section
					id="how-used"
					index="04"
					eyebrow="Purposes and sharing"
					title="How information is used, and who sees it"
					lead="For the purpose you provided it for, and for nothing else."
				>
					<ul class="mt-6 space-y-2.5 border-t border-slate-200 pt-4 font-serif text-[0.95rem] leading-relaxed text-slate-600">
						<li>Responding to your enquiry or assessing a referral.</li>
						<li>Publishing comments you choose to post, under your name.</li>
						<li>Aggregate readership statistics, only with analytics consent.</li>
						<li>Security, availability and abuse prevention.</li>
					</ul>
					<p class="mt-4 font-serif text-[0.95rem] leading-relaxed text-slate-600">Processors: Cloudflare (hosting, form storage, security logs); Google Analytics 4 (consent only; US processing under Google's UK safeguards; IP anonymised); Clerk (login only). Nothing is sold or shared with advertisers. Comments are public by design; everything else is visible only to the secretariat.</p>
				</Section>

				<Section
					id="retention"
					index="05"
					eyebrow="Retention"
					title="How long information is kept"
					lead="No longer than necessary for the purpose collected."
				>
					<ul class="mt-6 space-y-2.5 border-t border-slate-200 pt-4 font-serif text-[0.95rem] leading-relaxed text-slate-600">
						<li><strong>Enquiries</strong> — while live, then deleted or anonymised within 12 months unless they lead to an instruction.</li>
						<li><strong>Instructions</strong> — medicolegal file duties (ordinarily 6+ years after conclusion).</li>
						<li><strong>Comments</strong> — until you ask for removal, or moderation requires it.</li>
						<li><strong>Analytics</strong> — 14-month retention; your choice lives on your device until cleared.</li>
					</ul>
				</Section>

				<Section
					id="rights"
					index="06"
					eyebrow="Your rights"
					title="The rights you have over your information"
					lead="Email the secretariat to exercise any of these. You will be answered within one month."
				>
					<ul class="mt-6 space-y-2.5 border-t border-slate-200 pt-4 font-serif text-[0.95rem] leading-relaxed text-slate-600">
						<li><strong>Access</strong> — a copy of data held about you.</li>
						<li><strong>Rectification</strong> — correction of anything inaccurate.</li>
						<li><strong>Erasure</strong> — deletion where no good reason to keep it, including a published comment.</li>
						<li><strong>Restriction and objection</strong> — freeze or objection on grounds of your situation.</li>
						<li><strong>Portability</strong> — your data in a usable format, where based on consent or contract.</li>
						<li><strong>Withdrawal</strong> — analytics consent at any time via “Cookie settings” in the footer.</li>
					</ul>
					<p class="mt-4 font-serif text-[0.95rem] leading-relaxed text-slate-600">Identity may be checked first. If unhappy, contact <a href={`mailto:${PRACTITIONER.email}`} class="underline decoration-slate-300 underline-offset-4 hover:text-slate-900 hover:decoration-slate-600">{PRACTITIONER.email}</a>; you may also complain to the ICO at <a href="https://ico.org.uk" class="underline decoration-slate-300 underline-offset-4 hover:text-slate-900 hover:decoration-slate-600">ico.org.uk</a> (0303 123 1113). This notice is reviewed when the site changes.</p>
				</Section>
			</div>
		</div>
	</section>
</BaseLayout>

