---
// Reusable page masthead, set like the title block of a printed brief:
// white ground, centered single column, hairline rule beneath.
interface Props {
	eyebrow?: string;
	title: string;
	description?: string;
}

const { eyebrow = "Radiology & medicolegal law", title, description = "" } = Astro.props as Props;
---

<section class="divider-below bg-white">
	<div class="container-page py-14 sm:py-16">
		<div class="doc text-center">
			{eyebrow && <p class="meta-label">{eyebrow}</p>}
			<h1 class="mt-4 font-serif text-3xl font-bold leading-tight text-slate-900 sm:text-4xl text-balance break-words">
				{title}
			</h1>
			{description && <p class="standfirst mx-auto">{description}</p>}
			<slot />
		</div>
	</div>
</section>