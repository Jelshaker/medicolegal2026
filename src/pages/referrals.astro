---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import PageIntro from '../components/PageIntro.astro';
import { SITE_TITLE } from '../consts';
---

<!--
  ⚠️ DEPRECATED — Legal Referral Function
  =========================================
  This page was the secure GP/Consultant referral form and terms-of-engagement page.
  It is currently disabled (the original content has been commented out and will be
  re-enabled when the feature is needed again).

  To re-enable in the future:
    1. Restore the original page content below (between the <!- - - -> markers).
    2. Re-enable src/pages/api/referrals.ts (the POST endpoint).
    3. Re-add the "/referrals" entry to NAVIGATION_LINKS in src/consts.ts.
    4. Re-add the footer link and sitemap entry for /referrals.
-->

<BaseLayout title={`Referrals & Terms | ${SITE_TITLE}`} description="Secure referrals, terms of instruction and imaging transfer guidance (DICOM / PACS) for instructing Dr Joseph El-Sheikha as a medico-legal radiology expert.">
	<!-- Referral form content was here — removed while the function is deprecated. -->
	<!-- See the git history for the original implementation. -->

	<section class="band">
		<div class="container-page">
			<div class="doc space-y-14">
				<div class="sec">
					<span class="meta-label">Under maintenance</span>
					<h2 class="sec-title">Referrals temporarily unavailable</h2>
					<p class="para">
						The referral form is currently being updated. Please contact the secretariat
						directly via <a href="/contact" class="link">the contact page</a> for any
						enquiries about instructing Dr El-Sheikha as an expert radiology witness.
					</p>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>