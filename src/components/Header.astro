---
import { LOGIN_BUTTON_TEXT, LOGIN_BUTTON_TEXT_MOBILE, NAVIGATION_LINKS, PRACTITIONER, SITE_BRAND_SUBTITLE, SITE_TITLE } from "../consts";

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
    href === "/" ? pathname === "/" : pathname.startsWith(href);

const navLinkClass = (href: string) =>
    isActive(href)
        ? "nav-link nav-link-active"
        : "nav-link nav-link-inactive";
---

<header class="sticky-bar">
    <div class="container-page row-lg header-bar">
        <a href="/" class="group flex shrink-0 items-center gap-3" aria-label={`${SITE_TITLE} — home`}>
            <img
                src="/logo.png"
                alt={`${SITE_TITLE} logo`}
                width="512"
                height="512"
                class="header-logo"
                loading="eager"
                decoding="async"
            />
            <span>
                <span class="brand-name">
                    {PRACTITIONER.shortName}
                </span>
                <span class="meta-label mt-0.5 block !text-[0.62rem]">{SITE_BRAND_SUBTITLE}</span>
            </span>
        </a>

        <!-- Desktop Navigation -->
        <nav class="hide-lg header-nav" aria-label="Primary">
            <div class="flex items-center gap-x-6">
                {
                    NAVIGATION_LINKS.map((link) => (
                        <a
                            href={link.href}
                            class:list={[navLinkClass(link.href)]}
                        >
                            {link.label}
                        </a>
                    ))
                }
            </div>

            <!-- Vertical Divider -->
            <div class="vrule" aria-hidden="true"></div>

            <a href="/login" class="btn btn-ghost shrink-0 header-login">{LOGIN_BUTTON_TEXT}</a>
        </nav>

        <!-- Mobile Toggle & Actions -->
        <div class="flex items-center gap-3 lg:hidden">
            <a href="/login" class="btn btn-ghost hidden header-login-mobile sm:inline-flex lg:hidden">
                {LOGIN_BUTTON_TEXT}
            </a>

            <button
                id="menu-toggle"
                type="button"
                class="header-toggle"
                aria-label="Open menu"
                aria-expanded="false"
                aria-controls="mobile-menu"
            >
                <svg id="icon-burger" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M4 7h16M4 12h16M4 17h16" />
                </svg>
                <svg id="icon-close" class="hidden h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M6 6l12 12M18 6 6 18" />
                </svg>
            </button>
        </div>
    </div>

    <!-- Mobile Navigation Drawer -->
    <nav
        id="mobile-menu"
        class="hidden menu-mobile lg:hidden"
        aria-label="Mobile"
    >
        <ul class="flex flex-col">
            {
                NAVIGATION_LINKS.map((link) => (
                    <li class="border-b border-slate-100 last:border-b-0">
                        <a
                            href={link.href}
                            class:list={[
                                isActive(link.href) ? "nav-mobile-active" : "nav-mobile",
                            ]}
                        >
                            {link.label}
                        </a>
                    </li>
                ))
            }
            <li class="mt-3 divider pt-4">
                <a href="/login" class="btn btn-ghost w-full">{LOGIN_BUTTON_TEXT_MOBILE}</a>
            </li>
        </ul>
    </nav>

<style>
    .header-bar {
        height: 4rem;
    }
    @media (min-width: 768px) {
        .header-bar {
            height: 4.75rem;
        }
    }
    .header-logo {
        height: 2.75rem;
        width: 2.75rem;
    }
    @media (min-width: 768px) {
        .header-logo {
            height: 3rem;
            width: 3rem;
        }
    }
    .header-nav {
        display: none;
        min-width: 0;
        align-items: center;
        gap: 2rem;
        line-height: 1.25;
    }
    @media (min-width: 1024px) {
        .header-nav {
            display: flex;
        }
    }
    .header-toggle {
        display: flex;
        height: 2.5rem;
        width: 2.5rem;
        align-items: center;
        justify-content: center;
        border: 1px solid #cbd5e1;
        color: #334155;
        transition: border-color 0.15s ease, color 0.15s ease;
    }
    .header-toggle:hover {
        border-color: #0f172a;
        color: #0f172a;
    }
    .header-login {
        font-size: 0.75rem;
        padding: 0.5rem 1rem !important;
    }
    .header-login-mobile {
        font-size: 0.75rem;
        padding: 0.5rem 1rem !important;
    }
</style>
</header>

<script>
    const menuToggle = document.getElementById("menu-toggle");
    const mobileMenu = document.getElementById("mobile-menu");
    const iconBurger = document.getElementById("icon-burger");
    const iconClose = document.getElementById("icon-close");

    menuToggle?.addEventListener("click", () => {
        const open = mobileMenu?.classList.toggle("hidden") !== true;
        menuToggle.setAttribute("aria-expanded", String(open));
        iconBurger?.classList.toggle("hidden", open);
        iconClose?.classList.toggle("hidden", !open);
    });

    if (mobileMenu) {
        mobileMenu.querySelectorAll("a").forEach((a) =>
            a.addEventListener("click", () => {
                mobileMenu.classList.add("hidden");
                iconBurger?.classList.remove("hidden");
                iconClose?.classList.add("hidden");
            }),
        );
    }
</script>
