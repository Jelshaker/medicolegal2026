# ------------------------------------------------------------------
# Medicolegal 2026 - Environment Variables Template
# Copy to `.env` for local `astro dev` / `astro build`, and set the
# SAME variables in your Cloudflare Pages project settings.
# ------------------------------------------------------------------

# Google Analytics 4 measurement ID (sitewide analytics)
PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Clerk authentication (https://dashboard.clerk.com -> API Keys)
# `pk_test_` keys are development keys; use `pk_live_` in production.
PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY
CLERK_SECRET_KEY=sk_test_YOUR_SECRET_KEY

# Optional: CourtListener API token.
# Only required if you enable the `courtlistener` search provider.
# Create an account at https://www.courtlistener.com and request an API token.
COURTLISTENER_TOKEN=

# Optional: secure DICOM upload portal URL shown on the /information page.
# Point this at your encrypted transfer endpoint (e.g. a Medica/OneDrive link is NOT
# acceptable; use an E2E-encrypted portal or a managed DICOM router).
PUBLIC_DICOM_UPLOAD_URL=