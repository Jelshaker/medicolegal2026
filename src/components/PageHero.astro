---
// Reusable page hero used on content pages (CV, Referrals, Patient Advice, etc.).
interface Props {
	eyebrow?: string;
	title: string;
	description?: string;
}

const { eyebrow = "Medico-legal imaging", title, description = "" } = Astro.props as Props;
---

<section class="bg-gradient-to-b from-navy-900 to-navy-800 text-white">
	<div class="container-page py-14 sm:py-20">
		<div class="max-w-3xl">
			{eyebrow && <span class="eyebrow mb-4 text-teal-400">{eyebrow}</span>}
			<h1 class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl lg:text-5xl">
				{title}
			</h1>
			{description && <p class="mt-4 text-lg leading-relaxed text-slate-300 max-w-2xl">{description}</p>}
			<slot />
		</div>
	</div>
</section>