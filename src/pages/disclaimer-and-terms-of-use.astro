---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import PageIntro from "../components/PageIntro.astro";
import Section from "../components/Section.astro";
import Callout from "../components/Callout.astro";

export const prerender = true;
---

<BaseLayout
  title="Disclaimer and terms of use | Radiology &amp; Medicolegal Law"
  description="This resource provides general information on radiology and the law. It does not constitute legal or medical advice."
>
  <PageHero
    eyebrow="Legal notice"
    title="Disclaimer and terms of use"
    description="General information only: not legal or medical advice, and the terms of use for this resource."
  />

  <PageIntro
    eyebrow="Terms of use"
    paragraphs={[
      "This site is a free, personal reference resource. It is maintained by one practising radiologist with an interest in healthcare law.",
      "Everything on this website is general information. It is not advice and does not create a professional relationship."
    ]}
    contents={[
      { href: "#no-advice", label: "Not advice" },
      { href: "#no-endorsement", label: "External links" },
      { href: "#liability", label: "Liability" },
      { href: "#governing-law", label: "Governing law" }
    ]}
    reviewed="October 2026"
  />

  <section class="band">
    <div class="container-page">
      <div class="doc space-y-14">

        <Section
          id="no-advice"
          index="01"
          eyebrow="Not advice"
          title="Not legal advice, not medical advice"
        >
          <ul class="list">
            <li><strong>Not legal advice.</strong> Case summaries and commentary explain legal decisions in general terms. They do not advise on your prospects, procedure or strategy. Instructed matters require independent legal advice.</li>
            <li><strong>Not medical advice.</strong> The radiology content is general information only. Decisions about investigation or treatment belong with the clinician responsible for your care.</li>
            <li><strong>Not an expert opinion.</strong> A formal opinion under CPR Part 35 is a separate exercise. Nothing on this website is one.</li>
          </ul>
        </Section>

        <Section
          id="no-endorsement"
          index="02"
          eyebrow="External links"
          title="Links to other websites"
          lead="Provided for convenience only."
        >
          <p class="para">
            This site links to external websites for convenience. The operator accepts no responsibility for their content and linking does not imply endorsement.
          </p>
        </Section>

        <Section
          id="liability"
          index="03"
          eyebrow="Liability"
          title="Limits of liability"
          lead="Used at your own risk."
        >
          <ul class="list">
            <li>This resource is provided "as is" without warranties of any kind.</li>
            <li>To the extent permitted by law, liability for reliance on the information is excluded. Law, guidance and sources change, and the operator makes no guarantees about completeness or currency.</li>
            <li>Nothing excludes liability for death or personal injury caused by negligence, for fraud, or for any liability that cannot lawfully be limited under the law of England and Wales.</li>
            <li>Nothing here affects your statutory consumer rights.</li>
          </ul>
        </Section>

        <Section
          id="governing-law"
          index="04"
          eyebrow="Legal notice"
          title="Governing law and jurisdiction"
        >
          <p class="para">
            These terms are governed by the law of England and Wales. Disputes are subject to the exclusive jurisdiction of its courts.
          </p>

          <p class="para-sm">
            Questions about these terms: see the <a href="/privacy-notice" class="link">privacy notice</a>.
          </p>
        </Section>

      </div>
    </div>
  </section>
</BaseLayout>
