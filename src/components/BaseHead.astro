---
import "../styles/global.css";
import {
	DEFAULT_SOCIAL_IMAGE,
	PRACTITIONER,
	SITE_DESCRIPTION,
	SITE_TITLE,
	SITE_URL,
} from "../consts";
import type { ArticleMeta } from "../lib/seo";
import { CONSENT_DEFAULTS } from "../lib/consent";

interface Props {
	title?: string;
	description?: string;
	/** Overrides the canonical URL. Defaults to this page's path on `site`. */
	canonical?: string | URL;
	/** Social preview image: absolute URL or a root-relative path. */
	image?: string;
	/** Keeps a page out of the index (`/login` is the only such page). */
	noindex?: boolean;
	/** Adds `article:` meta tags and a `BlogPosting` JSON-LD node. */
	article?: ArticleMeta;
}

const {
	title = SITE_TITLE,
	description = SITE_DESCRIPTION,
	canonical: canonicalOverride,
	image = DEFAULT_SOCIAL_IMAGE,
	noindex = false,
	article,
} = Astro.props as Props;

// `Astro.site` is set from `site` in astro.config.mjs (which reads
// PUBLIC_SITE_URL); SITE_URL is that same value and only covers the case where
// Astro cannot resolve a site at build time.
const site = Astro.site ?? new URL(`${SITE_URL}/`);

// Canonical URLs must match the URLs in the XML sitemap or every page advertises
// a second address for the same content. Cloudflare serves directory-style pages
// at `/about/` and redirects e.g. `/sitemap` → `/sitemap/`, and @astrojs/sitemap
// lists pages with a trailing slash, so canonicals carry one too. Paths that end
// in a file extension (assets, endpoints) are left alone.
const { pathname } = Astro.url;
const canonicalPath =
	pathname.endsWith("/") || /\.[a-z0-9]+$/i.test(pathname) ? pathname : `${pathname}/`;

const canonical = new URL(canonicalOverride ?? canonicalPath, site);
const socialImage = new URL(image, site);
const siteUrl = new URL("/", site).toString();

// Google Analytics 4 behind Google Consent Mode v2 (UK GDPR / PECR).
// `PUBLIC_` variables are inlined at build time, so one build-time value
// reaches prerendered pages (`/recent-developments/*`, `/sitemap`) and
// server-rendered pages alike — see `.env.example`. The documented placeholder
// is rejected so a copy-paste can never ship hits to a measurement ID that
// does not exist.
//
// Consent behaviour (see src/components/CookieConsent.astro and
// src/lib/consent.ts): every page emits the default-denied Consent Mode state
// BEFORE gtag.js loads, so no analytics cookie or identifier can be set until
// the visitor clicks "Accept analytics". Accepting fires a `consent update`
// that grants `analytics_storage`; rejecting (or ignoring the banner) leaves
// the defaults in place and GA4 stays inert, sending no hits.
const rawGaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID?.trim();
const gaId =
	rawGaId && rawGaId !== "G-XXXXXXXXXX" && /^G-[A-Z0-9]{4,}$/i.test(rawGaId)
		? rawGaId
		: undefined;

// Search Console ownership token. Omitted entirely when unset, rather than the
// literal "XXXXX" placeholder that used to be emitted on every page.
const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION?.trim();

// gtag bootstrap. Built here rather than inside the tag because the contents of
// an `is:inline` script are emitted verbatim by Astro — an interpolation written
// inside the script would ship the literal text `${gaId}` to the browser, which
// would silently configure the wrong property ID. `set:html` in the markup
// injects this already-interpolated string instead.
//
// `consent default` (always emitted) vs `config` (only when a real ID exists).
// Order matters: the `consent default` must execute BEFORE gtag.js loads —
// Google's own requirement — so it is a separate inline script placed first.
// The `config` call stays after the external tag. With `analytics_storage:
// denied`, that config cannot set cookies or send identifiers; it only takes
// effect once CookieConsent.astro fires a `consent update` after accept.
//
// The defaults script is unconditional (not gated on `gaId`): the dataLayer/
// gtag stub and the denied defaults must exist on every page so that a stored
// "accept" can safely call `gtag('consent','update',…)` and so that nothing can
// load a Google tag ahead of the defaults later.
const gaConsentDefaults = `window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('consent', 'default', ${JSON.stringify(CONSENT_DEFAULTS)});`;
const gaConfig = `gtag('js', new Date());
gtag('config', '${gaId}', { anonymize_ip: true });`;
const jsonLd = {
	"@context": "https://schema.org",
	"@graph": [
		{
			// The site itself is the resource; the practice sits behind it.
			"@type": "WebSite",
			name: SITE_TITLE,
			description: SITE_DESCRIPTION,
			url: siteUrl,
			inLanguage: "en-GB",
			about: [
				{ "@type": "Thing", name: "Radiology" },
				{ "@type": "Thing", name: "Medical imaging" },
				{ "@type": "Thing", name: "Medicolegal law" },
				{ "@type": "Thing", name: "Expert evidence" },
			],
			author: { "@type": "Person", name: PRACTITIONER.name },
		},
		{
			"@type": "MedicalBusiness",
			name: `${SITE_TITLE} — practice`,
			description:
				"Independent radiological opinions for solicitors, barristers and insurers, provided by the curator of this resource.",
			url: siteUrl,
			sameAs: [siteUrl],
			address: {
				"@type": "PostalAddress",
				streetAddress: PRACTITIONER.address,
				addressLocality: "London",
				addressCountry: "GB",
			},
			telephone: PRACTITIONER.phone,
			email: PRACTITIONER.email,
			medicalSpecialty: "Radiology",
		},
		{
			"@type": "Person",
			name: PRACTITIONER.name,
			jobTitle: "Consultant Radiologist",
			worksFor: { "@type": "MedicalBusiness", name: `${SITE_TITLE} — practice` },
			url: siteUrl,
		},
		// Commentary posts also carry BlogPosting data (E-E-A-T signals for a
		// professional resource: named author, dates, subject area).
		...(article
			? [
					{
						"@type": "BlogPosting",
						headline: article.headline,
						description,
						datePublished: article.datePublished,
						...(article.dateModified ? { dateModified: article.dateModified } : {}),
						...(article.section ? { articleSection: article.section } : {}),
						inLanguage: "en-GB",
						url: canonical.href,
						mainEntityOfPage: { "@type": "WebPage", "@id": canonical.href },
						image: socialImage.href,
						author: { "@type": "Person", name: PRACTITIONER.name },
						publisher: { "@type": "Person", name: PRACTITIONER.name },
					},
				]
			: []),
	],
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content="Astro" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="canonical" href={canonical.href} />
<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

{/* Crawling. Every page is indexable except the `/login` access screen, which
     `src/pages/robots.txt.ts` disallows and which carries a `noindex` meta tag. */}
{
	noindex ? (
		<meta name="robots" content="noindex, nofollow" />
	) : (
		<meta
			name="robots"
			content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
		/>
	)
}

{/* Google Search Console verification token (PUBLIC_GOOGLE_SITE_VERIFICATION). */}
{
	googleSiteVerification && (
		<meta name="google-site-verification" content={googleSiteVerification} />
	)
}

<meta property="og:type" content={article ? "article" : "website"} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content="en_GB" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical.href} />
<meta property="og:image" content={socialImage.href} />
<meta property="og:image:alt" content={title} />
{image === DEFAULT_SOCIAL_IMAGE && <meta property="og:image:width" content="1200" />}
{image === DEFAULT_SOCIAL_IMAGE && <meta property="og:image:height" content="630" />}
{article && <meta property="article:published_time" content={article.datePublished} />}
{article?.dateModified && <meta property="article:modified_time" content={article.dateModified} />}
{article?.section && <meta property="article:section" content={article.section} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage.href} />

{/* Structured data: WebSite + MedicalBusiness + Person (+ BlogPosting). */}
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>

<!-- Inter (metadata sans) + Merriweather (document serif, Georgia fallback) -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
	href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Merriweather:ital,wght@0,400;0,700;1,400;1,700&display=swap"
	rel="stylesheet"
/>


{/* Google Consent Mode v2 defaults — emitted on EVERY page, whether or not a
     GA4 ID is configured. This defines the dataLayer/gtag stub and records
     default-denied consent before anything else can push to the dataLayer, per
     Google's spec. When PUBLIC_GA_MEASUREMENT_ID holds a real ID the gtag.js
     tag and config below load behind these defaults, so GA4 is inert until
     CookieConsent.astro records an accept. The CSP in
     src/lib/security-headers.ts and public/_headers permits the GA4 hosts;
     extend both if you add another tag. */}
<script is:inline set:html={gaConsentDefaults}></script>
{gaId && <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>}
{gaId && <script is:inline set:html={gaConfig}></script>}