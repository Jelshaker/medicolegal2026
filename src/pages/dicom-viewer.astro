---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Callout from "../components/Callout.astro";
import Section from "../components/Section.astro";
import LocalDicomViewer from "../components/LocalDicomViewer.astro";
import { SITE_TITLE, PAGE_HERO_IMAGES } from "../consts";
---

<BaseLayout
	title={`Free DICOM Viewer — Open Your Scan in Your Browser | ${SITE_TITLE}`}
	description="Open your CT, MRI, X-ray or ultrasound images free in your browser. This DICOM viewer runs entirely on your device — nothing is uploaded, stored or shared."
>
	<PageHero
		eyebrow="Free tool · No sign-up, no upload"
		title="Free DICOM Viewer"
		description="If you have DICOM image files and do not have a PACS viewer to view them, you are welcome to use this browser-based DICOM viewer for free. The files are kept locally and nothing is uploaded, stored or shared. As a radiologist I would only use this viewer for a superfical imaging review and any formal diagnosis can only be made by a qualified radiologist using a calibrated clinical display with PACS based reporting."
		heroImage={PAGE_HERO_IMAGES["/dicom-viewer"]}
	>
		<p class="mt-4 font-sans text-xs uppercase tracking-[0.14em] text-slate-400">
			Works with CT · MRI · X-ray · Ultrasound · PET
		</p>
	</PageHero>

	<!-- The viewer itself -->
	<section id="open-a-study" class="scroll-mt-24 bg-white py-14">
		<div class="container-page">
			<div class="mx-auto max-w-5xl">
				<LocalDicomViewer />

				<Callout tone="limit" title="Important — not a diagnosis">
					<p>
						This viewer is for looking at your own images and understanding them, not for
						reaching a conclusion about what they show. Only a radiologist reading the full
						study on a calibrated clinical display can provide that. If anything worries you,
						take it back to the doctor who referred you for the scan — they have your history
						and can answer for your circumstances.
					</p>
				</Callout>

				<p class="mt-8 text-center font-serif text-[0.95rem] text-slate-500">
					New here? The <a href="/dicom-viewer-guide" class="link font-semibold text-slate-800">step-by-step guide</a> walks you through finding your files on a disc or download and using every tool.
				</p>
			</div>
		</div>
	</section>

	<!-- Why it's safe -->
	<Section id="privacy" index="01" title="Your images never leave your device">
		<p class="standfirst">
			The viewer runs entirely inside your browser. There is no upload step, no account, and
			no copy made anywhere — which is also why there is nothing to sign up for.
		</p>
		<div class="mt-8 grid gap-5 sm:grid-cols-2">
			<div class="box p-6">
				<h3 class="entry-title-sm">Nothing is uploaded</h3>
				<p class="para-sm">
					The files are opened by code running on your own device. At no point do your images
					travel over the internet to this site or to anyone else.
				</p>
			</div>
			<div class="box p-6">
				<h3 class="entry-title-sm">Nothing is kept</h3>
				<p class="para-sm">
					Close the tab or press Clear and everything is gone — no server copy, no storage,
					no record of what you looked at.
				</p>
			</div>
			<div class="box p-6">
				<h3 class="entry-title-sm">No account or details needed</h3>
				<p class="para-sm">
					There is no sign-up, no email address and no payment. The viewer is free, and it
					stays that way.
				</p>
			</div>
			<div class="box p-6">
				<h3 class="entry-title-sm">Names are not shown</h3>
				<p class="para-sm">
					The details panel deliberately shows only technical information — scan type, date,
					image size — and never patient names or identifiers.
				</p>
			</div>
		</div>
	</Section>

	<!-- What it opens -->
	<Section id="compatibility" index="02" title="What you can open">
		<p class="standfirst">
			Any imaging given to you in the DICOM format — the standard format in which hospitals
			supply scans on disc and through patient portals.
		</p>
		<div class="mt-8 grid gap-x-10 gap-y-6 sm:grid-cols-2">
			<div>
				<h3 class="entry-title-sm">Works with</h3>
				<ul class="list mt-3">
					<li>CT, MRI, X-ray, ultrasound and PET scans</li>
					<li>Files ending in <code>.dcm</code> — and files with no extension at all, as hospital discs often supply</li>
					<li>Single images or a whole folder of slices, which are sorted into order for you</li>
					<li>Windows, Mac and Linux, in any modern browser</li>
				</ul>
			</div>
			<div>
				<h3 class="entry-title-sm">Doesn't work with</h3>
				<ul class="list mt-3">
					<li>Zip archives — unzip the folder first, then drop the folder in</li>
					<li>Photographs, PDFs or JPGs from a portal — those are not DICOM files</li>
					<li>A small number of scans stored in heavily compressed formats</li>
				</ul>
			</div>
		</div>
	</Section>

	<!-- Tools summary -->
	<Section id="tools" index="03" title="The tools on screen">
		<p class="standfirst">
			The same basic controls a radiologist uses to look at a scan, minus the diagnostic
			measurement tools.
		</p>
		<div class="entry-list mt-8">
			<div class="entry">
				<h3 class="entry-title-sm">Scroll through the scan</h3>
				<p class="para-sm">
					Use the slice slider, the arrow buttons, or your mouse wheel over the image to move
					through a stack of slices — like flicking through the pages of the scan.
				</p>
			</div>
			<div class="entry">
				<h3 class="entry-title-sm">Brightness and contrast</h3>
				<p class="para-sm">
					The Width and Level sliders adjust how the image is displayed. Scans contain far more
					shades of grey than a screen can show at once, so this is how you bring different
					tissues into view.
				</p>
			</div>
			<div class="entry">
				<h3 class="entry-title-sm">Zoom and pan</h3>
				<p class="para-sm">
					Zoom with the slider or Ctrl/Cmd + mouse wheel, then drag the image to look around.
				</p>
			</div>
			<div class="entry">
				<h3 class="entry-title-sm">Invert and reset</h3>
				<p class="para-sm">
					Invert Colours reverses black and white, which can make some structures easier to see.
					Reset all returns the image to its natural display.
				</p>
			</div>
		</div>

		<Callout tone="key" title="Next step">
			<p>
				Not sure where your images are, or which file to pick? The
				<a href="/dicom-viewer-guide" class="link font-semibold text-slate-800">guide to using the viewer</a>
				takes you through it step by step, with a disc and a portal download as worked examples.
			</p>
		</Callout>
	</Section>

	<div class="band-paper">
		<div class="container-page">
			<div class="doc text-center">
				<a href="/dicom-viewer-guide" class="btn btn-primary">How to use the viewer</a>
				<a href="/patient-advice" class="btn btn-ghost ml-3">Patient advice library</a>
			</div>
		</div>
	</div>
</BaseLayout>
