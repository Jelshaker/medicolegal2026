---
// Interactive medical image card with an embedded Lightbox modal.
// Supports high-res zoom (wheel / pinch + pan), captioning, modality badges,
// case reference numbers and detailed radiological descriptions.
interface Props {
	src: string;
	alt: string;
	caption: string;
	subtitle?: string;
	modality?: string;
	caseReference?: string;
	radiologicalCaption?: string;
}

const { src, alt, caption, subtitle = "", modality = "CT / MRI", caseReference, radiologicalCaption = "" } = Astro.props as Props;
const uid = "v" + Math.random().toString(36).slice(2, 10);
---

<div
	class="box relative overflow-hidden"
	data-viewer
	data-uid={uid}
>
	<button
		type="button"
		class="viewer-open relative block h-64 w-full cursor-zoom-in overflow-hidden bg-slate-950 text-left outline-none"
		aria-haspopup="dialog"
		aria-label={`Open image viewer: ${caption}`}
	>
		<img
			src={src}
			alt={alt}
			loading="lazy"
			class="h-full w-full object-cover"
		/>
		<span
			class="absolute top-3 left-3 border border-slate-300 bg-white/95 px-2 py-0.5 font-sans text-[0.65rem] font-semibold uppercase tracking-[0.12em] text-slate-700"
		>
			{modality}
		</span>
		{caseReference && (
			<span class="absolute top-3 right-3 border border-slate-300 bg-white/95 px-2 py-0.5 font-mono text-[0.65rem] tabular-nums text-slate-600">
				REF: {caseReference}
			</span>
		)}
	</button>
	<div class="border-t border-slate-200 bg-paper p-4">
		<div class="flex items-start justify-between gap-3">
			<div class="min-w-0 flex-1">
				<p class="font-serif text-sm leading-snug text-slate-800">{caption}</p>
				{subtitle && <p class="mt-0.5 font-sans text-xs text-slate-500">{subtitle}</p>}
				{radiologicalCaption && <p class="mt-1 font-serif text-xs italic text-slate-500">{radiologicalCaption}</p>}
			</div>
			{caseReference && (
				<span class="shrink-0 font-mono text-[0.65rem] tabular-nums text-slate-400">
					{caseReference}
				</span>
			)}
		</div>
	</div>
</div>

<!-- Lightbox modal -->
<div class="lightbox" id={`lb-${uid}`} role="dialog" aria-modal="true" aria-label={caption} hidden tabindex="-1">
	<div class="lightbox-backdrop" data-close></div>
	<div class="lightbox-panel">
		<!-- Header bar with case ref + modality -->
		<div class="lightbox-header flex items-center justify-between border-b border-slate-800 px-4 py-2">
			<div class="flex items-center gap-3">
				<span class="bg-slate-800 px-2.5 py-1 text-[0.65rem] font-semibold uppercase tracking-wider text-slate-400">
					{modality}
				</span>
				{caseReference && (
					<span class="text-[0.65rem] font-mono text-slate-400">REF: {caseReference}</span>
				)}
			</div>
			<div class="flex items-center gap-2">
				<span class="text-[0.65rem] text-slate-500">Zoom</span>
				<span class="text-xs tabular-nums text-slate-300" data-zoom-label>100%</span>
			</div>
		</div>

		<!-- Image stage -->
		<div class="lightbox-stage">
			<img src={src} alt={alt} class="lightbox-img" data-lightbox-img draggable="false" />
		</div>

		<!-- Caption area -->
		<div class="lightbox-cap border-t border-slate-800 px-4 py-3">
			<p class="text-sm font-medium text-slate-100">{caption}</p>
			{radiologicalCaption && (
				<p class="mt-1 text-xs leading-relaxed text-slate-400">{radiologicalCaption}</p>
			)}
			{subtitle && <p class="mt-0.5 text-xs text-slate-500">{subtitle}</p>}
		</div>

		<!-- Tool bar -->
		<div class="lightbox-tools">
			<button type="button" class="lightbox-btn" data-zoom-out aria-label="Zoom out">
				<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14"/></svg>
			</button>
			<button type="button" class="lightbox-btn" data-zoom-in aria-label="Zoom in">
				<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
			</button>
			<button type="button" class="lightbox-btn" data-reset aria-label="Reset view">
				<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg>
			</button>
			<button type="button" class="lightbox-btn" data-close aria-label="Close viewer">
				<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
			</button>
		</div>
	</div>
</div>

<script define:vars={{ baseUid: uid }}>
	const root = document.querySelector(`[data-viewer][data-uid="${baseUid}"]`) as HTMLElement | null;
	if (!root) throw new Error(`Missing viewer root for ${baseUid}`);
	const openBtn = root.querySelector(".viewer-open") as HTMLButtonElement;
	const lightbox = document.getElementById(`lb-${baseUid}`) as HTMLElement;
	const img = lightbox.querySelector("[data-lightbox-img]") as HTMLImageElement;
	const zoomLabel = lightbox.querySelector("[data-zoom-label]") as HTMLElement;
	let scale = 1;
	let tx = 0;
	let ty = 0;
	let dragging = false;
	let startX = 0;
	let startY = 0;
	const MIN = 0.5;
	const MAX = 8;

	function apply() {
		img.style.transform = `translate(${tx}px, ${ty}px) scale(${scale})`;
		if (zoomLabel) zoomLabel.textContent = `${Math.round(scale * 100)}%`;
	}
	function open() {
		lightbox.hidden = false;
		document.body.style.overflow = "hidden";
		lightbox.focus();
		reset();
	}
	function close() {
		lightbox.hidden = true;
		document.body.style.overflow = "";
	}
	function reset() {
		scale = 1;
		tx = 0;
		ty = 0;
		apply();
	}
	function zoom(delta) {
		scale = Math.min(MAX, Math.max(MIN, scale + delta));
		apply();
	}

	openBtn.addEventListener("click", open);
	lightbox.querySelectorAll("[data-close]").forEach((el) =>
		el.addEventListener("click", (e) => {
			e.stopPropagation();
			close();
		}),
	);
	lightbox.addEventListener("click", (e) => {
		if (e.target === lightbox) close();
	});
	lightbox.addEventListener("keydown", (e) => {
		if (e.key === "Escape") close();
	});

	(lightbox.querySelector("[data-zoom-in]") as HTMLButtonElement).addEventListener("click", () => zoom(0.25));
	(lightbox.querySelector("[data-zoom-out]") as HTMLButtonElement).addEventListener("click", () => zoom(-0.25));
	(lightbox.querySelector("[data-reset]") as HTMLButtonElement).addEventListener("click", reset);

	img.addEventListener("wheel", (e) => {
		e.preventDefault();
		zoom(e.deltaY < 0 ? 0.15 : -0.15);
	}, { passive: false });

	img.addEventListener("pointerdown", (e) => {
		dragging = true;
		startX = e.clientX - tx;
		startY = e.clientY - ty;
		img.style.cursor = "grabbing";
		img.setPointerCapture(e.pointerId);
	});
	img.addEventListener("pointermove", (e) => {
		if (!dragging) return;
		tx = e.clientX - startX;
		ty = e.clientY - startY;
		apply();
	});
	img.addEventListener("pointerup", () => {
		dragging = false;
		img.style.cursor = "";
	});
</script>
