---
const title = "On this page";
---
<aside data-toc-sidebar class="toc-sidebar" aria-label="Page navigation">
  <nav aria-label={title} class="toc-card">
    <svg class="toc-chevron" data-toc-overflow-top viewBox="0 0 20 20" fill="none" aria-hidden="true">
      <path d="M5 12l5-5 5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <p class="meta-label" aria-hidden="true">{title}</p>
    <ul class="toc-list" data-toc-list></ul>
    <a href="#top" class="toc-top" data-toc-top hidden>Back to top</a>
    <svg class="toc-chevron" data-toc-overflow-bottom viewBox="0 0 20 20" fill="none" aria-hidden="true">
      <path d="M5 8l5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </nav>
</aside>
<script>
  const tocSidebar = document.querySelector("[data-toc-sidebar]");
  if (tocSidebar) {
    const list = tocSidebar.querySelector("[data-toc-list]");
    const top = tocSidebar.querySelector("[data-toc-top]");
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const seen = new Set();
    const found = [];
    document.querySelectorAll("main section[id]").forEach((sec) => {
      const id = (sec.getAttribute("id") || "").trim();
      if (!id || seen.has(id)) return;
      seen.add(id);
      const h = sec.querySelector("h1, h2, h3");
      const raw = ((h ? h.textContent : id) || id).trim().slice(0, 60);
      if (!raw) return;
      found.push({ id, label: raw.replace(/\s+/g, " ") });
    });
    found.forEach((entry) => {
      const li = document.createElement("li");
      const a = document.createElement("a");
      a.href = "#" + entry.id;
      a.className = "toc-link";
      a.setAttribute("data-toc-link", "");
      a.textContent = entry.label;
      li.appendChild(a);
      if (list) list.appendChild(li);
    });
    const links = list ? Array.from(list.querySelectorAll("[data-toc-link]")) : [];
    if (links.length < 2) {
      tocSidebar.remove();
    } else {
      tocSidebar.classList.add("is-ready");
      if (top) top.hidden = false;
      // Dock the rail just under the hero image while the hero is on
      // screen, then let it ride up and clamp under the sticky header as
      // the page scrolls. rAF-throttled so it tracks smoothly; disabled
      // below the wide breakpoint where the rail is display:none anyway.
      const hero = document.querySelector("[data-page-hero]");
      const mq = window.matchMedia("(min-width: 80rem)");
      const dockToc = () => {
        if (!mq.matches) {
          tocSidebar.style.top = "";
          return;
        }
        const header = document.querySelector("header");
        const headerH = header ? header.getBoundingClientRect().height : 76;
        const heroBottom = hero ? hero.getBoundingClientRect().bottom : -Infinity;
        // While the hero is visible, sit ~1rem below its bottom edge;
        // once it scrolls past, park just under the sticky header.
        const top = Math.max(heroBottom + 16, headerH + 16);
        tocSidebar.style.top = `${Math.round(top)}px`;
      };
      let dockQueued = false;
      const queueDock = () => {
        if (dockQueued) return;
        dockQueued = true;
        requestAnimationFrame(() => {
          dockQueued = false;
          dockToc();
        });
      };
      dockToc();
      window.addEventListener("scroll", queueDock, { passive: true });
      window.addEventListener("resize", queueDock);
      if (mq.addEventListener) mq.addEventListener("change", dockToc);
    }
    links.forEach((a) => {
      a.addEventListener("click", (e) => {
        const href = a.getAttribute("href") || "";
        if (href.charAt(0) !== "#") return;
        const el = document.getElementById(href.slice(1));
        if (!el) return;
        e.preventDefault();
        el.scrollIntoView({ behavior: reduce ? "auto" : "smooth", block: "start" });
      });
    });

    const setActive = (id) => {
      links.forEach((a) => {
        const on = a.getAttribute("href") === "#" + id;
        a.classList.toggle("is-active", on);
        if (on) a.setAttribute("aria-current", "true");
        else a.removeAttribute("aria-current");
      });
    };
    const targets = links.map((a) => document.getElementById((a.getAttribute("href") || "").slice(1))).filter(Boolean);
    if ("IntersectionObserver" in window) {
      const obs = new IntersectionObserver((entries) => {
        entries.forEach((en) => { if (en.isIntersecting) setActive(en.target.id); });
      }, { rootMargin: "-20% 0px -65% 0px" });
      targets.forEach((t) => obs.observe(t));
    }
    if (top) top.addEventListener("click", (e) => {
      e.preventDefault();
      window.scrollTo({ top: 0, behavior: reduce ? "auto" : "smooth" });
    });

    // Scroll overflow chevrons — show when content exceeds viewport height
    const card = tocSidebar.querySelector("[data-toc-list]").parentElement;
    const overflowTop = tocSidebar.querySelector("[data-toc-overflow-top]");
    const overflowBottom = tocSidebar.querySelector("[data-toc-overflow-bottom]");
    const hasScroll = card.scrollHeight > card.clientHeight;
    if (hasScroll) {
      const updateChevrons = () => {
        const atTop = card.scrollTop === 0;
        const atBottom = card.scrollTop + card.clientHeight >= card.scrollHeight - 1;
        overflowTop.classList.toggle("is-visible", !atTop);
        overflowBottom.classList.toggle("is-visible", !atBottom);
      };
      card.addEventListener("scroll", updateChevrons, { passive: true });
      updateChevrons();
      if (overflowTop) overflowTop.addEventListener("click", () => {
        card.scrollTo({ top: 0, behavior: reduce ? "auto" : "smooth" });
      });
      if (overflowBottom) overflowBottom.addEventListener("click", () => {
        card.scrollTo({ top: card.scrollHeight, behavior: reduce ? "auto" : "smooth" });
      });
    }
  }
</script>