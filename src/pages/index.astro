---
import BaseLayout from '../layouts/BaseLayout.astro';
import MedicalImageViewer from '../components/MedicalImageViewer.astro';
import { getCollection } from 'astro:content';
import { PRACTITIONER, SITE_TITLE, SITE_DESCRIPTION, BLOG_CATEGORIES } from '../consts';

const allPosts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const featured = allPosts.find((p) => p.data.featured) ?? allPosts[0];
const recent = allPosts.slice(0, 3);
const categoryLabel = (id: string) => BLOG_CATEGORIES.find((c) => c.id === id)?.label ?? id;
const stats = [
	{ value: '1957', label: 'Bolam — the standard of care' },
	{ value: '~37%', label: 'Abdominal claims turning on incidental findings' },
	{ value: '8.7–12.7%', label: 'Offsite reporting error rate (Howlett et al.)' },
	{ value: '2025', label: 'RCR reporting standards edition' },
];
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<!-- Hero -->
	<section class="relative overflow-hidden bg-navy-950 text-white">
		<div class="container-page grid items-center gap-12 py-20 lg:grid-cols-2 lg:gap-16 lg:py-28">
			<div>
				<span class="eyebrow mb-4 text-teal-400">Radiology · Law · The standard of care</span>
				<h1 class="text-4xl font-extrabold leading-tight tracking-tight text-white sm:text-5xl">
					How English law judges a radiological opinion.
				</h1>
				<p class="mt-5 max-w-xl text-lg leading-relaxed text-slate-300">
					A working reference on the legal architecture of diagnostic imaging — the Bolam and
					Montgomery standards, breach and causation, incidental findings, consent, and the systemic
					risks of teleradiology. Anonymised case discussion and primary-source analysis for
					solicitors, barristers, insurers and radiologists.
				</p>
				<div class="mt-7 flex flex-wrap gap-3">
					<a href="/legal-fundamentals" class="btn btn-primary">
						<svg class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h13M12 5v13"/></svg>
						Legal fundamentals
					</a>
					<a href="/legal-blog" class="btn btn-ghost">Case discussions</a>
					<a href="/recent-developments" class="btn btn-ghost">Recent developments</a>
				</div>
				<div class="mt-9 grid grid-cols-2 gap-x-6 gap-y-5 sm:grid-cols-4">
					{stats.map((s) => (
						<div>
							<div class="text-2xl font-extrabold text-teal-400">{s.value}</div>
							<div class="mt-1 text-xs text-slate-400">{s.label}</div>
						</div>
					))}
				</div>
			</div>
			<div class="relative">
				<div class="overflow-hidden rounded-2xl border border-navy-700 shadow-2xl">
					<img src={PRACTITIONER.photo} alt="Dr Joseph El-Sheikha" class="aspect-[4/5] w-full object-cover" loading="lazy" />
				</div>
				<div class="absolute -bottom-5 -left-6 hidden rounded-2xl border border-teal-500/40 bg-navy-900 p-4 shadow-xl lg:block">
					<div class="flex items-center gap-3">
						<div class="flex h-11 w-11 items-center justify-center rounded-full bg-teal-600 text-sm font-bold text-white">FRCR</div>
						<div class="text-xs leading-snug text-slate-200">
							<span class="block font-semibold text-slate-100">Royal College of Radiologists</span>
							<span>Fellow · Specialist register</span>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Legal framework -->
	<section class="bg-white py-16 dark:bg-navy-900">
		<div class="container-page">
			<div class="max-w-2xl">
				<span class="eyebrow block">Legal fundamentals</span>
				<h2 class="mt-3 text-3xl font-bold tracking-tight text-navy-900 dark:text-slate-100">The framework, in four questions</h2>
				<p class="mt-4 leading-relaxed text-slate-600 dark:text-slate-300">
					Every radiological claim resolves into a small number of legal questions. Each is examined in
					detail, with the authorities and the professional standards that govern the answer.
				</p>
			</div>
			<div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
				{[
					{ t: 'What standard of care applies?', d: 'Bolam, Bolitho and the line between a defensible difference of opinion and a breach.', href: '/legal-fundamentals', tag: 'Bolam · Bolitho' },
					{ t: 'Was the finding demonstrable?', d: 'The "pure diagnosis" argument, incidentalomas, and what the images actually showed on the day.', href: '/medicolegal-radiology', tag: 'Breach & causation' },
					{ t: 'What did the patient know?', d: 'Consent, the materiality of risk, and the duty of candour where a complication occurs.', href: '/legal-fundamentals', tag: 'Montgomery · Candour' },
					{ t: 'Who else is liable?', d: 'Remote reporting, provider-level duties, escalation failure and dual liability in teleradiology.', href: '/recent-developments', tag: 'Teleradiology' },
				].map((p) => (
					<a href={p.href} class="group flex flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-soft transition-all hover:border-teal-500/40 hover:shadow-lift dark:border-navy-700 dark:bg-navy-900">
						<span class="chip mb-3 self-start">{p.tag}</span>
						<h3 class="font-bold leading-snug text-navy-900 dark:text-slate-100">{p.t}</h3>
						<p class="mt-2 flex-1 text-sm leading-snug text-slate-600 dark:text-slate-300">{p.d}</p>
						<span class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-teal-700 dark:text-teal-400">
							Read the analysis
							<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5v14"/></svg>
						</span>
					</a>
				))}
			</div>
			<div class="mt-8 flex flex-wrap gap-3">
				<a href="/image-review" class="btn btn-ghost">Free online image review</a>
				<a href="/about" class="btn btn-ghost">About the practice</a>
				<a href="/patient-advice" class="btn btn-ghost">Patient advice</a>
			</div>
		</div>
	</section>

	<!-- Featured case -->
	<section class="bg-slate-50 py-16 dark:bg-navy-950">
		<div class="container-page grid items-center gap-12 lg:grid-cols-2">
			<div>
				<span class="eyebrow block text-teal-600 dark:text-teal-400">Featured case discussion</span>
				<h2 class="mt-3 text-3xl font-bold tracking-tight text-navy-900 dark:text-slate-100">{featured.data.title}</h2>
				<p class="mt-4 leading-relaxed text-slate-600 dark:text-slate-300">{featured.data.description}</p>
				<div class="mt-6 flex flex-wrap gap-2">
					{featured.data.tags.slice(0, 3).map((t) => <span class="chip">{t}</span>)}
				</div>
				<a href={`/legal-blog/${featured.slug}`} class="btn btn-primary mt-7">Read the analysis</a>
			</div>
			<div class="lg:ml-auto">
				{
					featured.data.figures?.[0]
						? (
							<MedicalImageViewer
								src={featured.data.figures[0]}
								alt="Anonymised case image"
								caption="Anonymised source series referenced in the featured case"
								modality="MRI / CT"
							/>
						)
						: (
							<MedicalImageViewer
								src="/images/placeholders/anonymised-mri-knee-sagittal.svg"
								alt="Anonymised imaging placeholder"
								caption="Anonymised reference image"
								modality="MRI"
							/>
						)
				}
			</div>
		</div>
	</section>

	<!-- Recent posts -->
	<section class="bg-white py-16 dark:bg-navy-900">
		<div class="container-page">
			<div class="flex items-end justify-between gap-4">
				<div>
					<span class="eyebrow block">Legal radiology</span>
					<h2 class="mt-3 text-3xl font-bold tracking-tight text-navy-900 dark:text-slate-100">Latest case discussions</h2>
				</div>
				<a href="/legal-blog" class="btn btn-ghost">All discussions</a>
			</div>
			<div class="mt-10 grid gap-6 md:grid-cols-3">
				{recent.map((post) => (
					<a href={`/legal-blog/${post.slug}`} class="group flex flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-soft transition-all hover:shadow-lift dark:border-navy-700 dark:bg-navy-900">
						<div class="px-5 pt-5">
							<span class="chip">{categoryLabel(post.data.category)}</span>
						</div>
						<div class="p-5">
							<h3 class="font-bold leading-snug text-navy-900 dark:text-slate-100">{post.data.title}</h3>
							<p class="mt-2 line-clamp-3 text-sm leading-snug text-slate-600 dark:text-slate-300">{post.data.description}</p>
						</div>
					</a>
				))}
			</div>
		</div>
	</section>

	<!-- Instructing -->
	<section class="bg-gradient-to-br from-navy-900 to-navy-800 py-14 text-center dark:bg-navy-950">
		<div class="container-page max-w-3xl">
			<h2 class="text-3xl font-extrabold tracking-tight text-white">Instructing an expert</h2>
			<p class="mt-3 text-lg text-slate-300">
				Where the legal analysis needs a radiological opinion, terms of instruction, imaging transfer
				guidance and the fee structure are set out on the expert witness page.
			</p>
			<div class="mt-6 flex flex-wrap justify-center gap-3">
				<a href="/expert-witness" class="btn btn-primary">Expert witness services</a>
				<a href="/contact" class="btn btn-white">Contact the secretariat</a>
			</div>
		</div>
	</section>
</BaseLayout>