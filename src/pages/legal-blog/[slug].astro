---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MedicalImageViewer from '../../components/MedicalImageViewer.astro';
import { getCollection } from 'astro:content';
import { SITE_TITLE, BLOG_CATEGORIES } from '../../consts';
import { formatDate, readingTime } from '../../lib/utils';

export const prerender = true;

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.slug },
		props: { post },
	}));
}

const { post } = Astro.props as { post: Awaited<ReturnType<typeof getCollection<'blog'>>>[number] };
const { Content } = await post.render();
const readMin = readingTime(post.body);
const categoryLabel = (id: string) => BLOG_CATEGORIES.find((c) => c.id === id)?.label ?? id;
---

<BaseLayout title={`${post.data.title} | ${SITE_TITLE}`} description={post.data.description}>
	<!-- Article header -->
	<section class="bg-gradient-to-b from-navy-900 to-navy-800 py-14 text-white sm:py-18">
		<div class="container-page">
			<div class="mx-auto max-w-3xl">
				<nav class="text-sm text-slate-400" aria-label="Breadcrumb">
					<ol class="flex items-center gap-2">
						<li><a href="/legal-blog" class="hover:text-teal-400">Legal Radiology</a></li>
						<li aria-hidden="true">/</li>
						<li class="text-slate-300">{categoryLabel(post.data.category)}</li>
					</ol>
				</nav>
				<span class="eyebrow mb-4 mt-5 block text-teal-400">{categoryLabel(post.data.category)}</span>
				<h1 class="text-3xl font-extrabold leading-tight tracking-tight text-white sm:text-4xl lg:text-5xl">{post.data.title}</h1>
				<p class="mt-4 text-lg leading-relaxed text-slate-300">{post.data.description}</p>
				<div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-3 text-sm text-slate-400">
					<span>Published {formatDate(post.data.pubDate)}</span>
					<span>{readMin} min read</span>
					{post.data.anonymised && (
						<span class="rounded-full border border-teal-500/40 bg-teal-500/10 px-2.5 py-1 text-xs font-semibold uppercase tracking-wider text-teal-300">Anonymised</span>
					)}
				</div>
				<div class="mt-5 flex flex-wrap gap-2">
					{post.data.tags.map((t) => <span class="chip !bg-white/10 !text-slate-200">{t}</span>)}
				</div>
			</div>
		</div>
	</section>

	<!-- Body -->
	<article class="bg-white py-12 dark:bg-navy-900">
		<div class="container-page">
			<div class="mx-auto max-w-3xl">
				{post.data.keyTakeaways && (
					<aside class="rounded-r-2xl border-l-4 border-teal-500 bg-teal-50 p-5 dark:border-teal-400 dark:bg-teal-950/30">
						<div class="flex items-center gap-3 text-teal-700 dark:text-teal-300">
							<span class="text-sm font-semibold">Key Takeaways for the Court / Tribunal</span>
						</div>
						<ul class="mt-3 space-y-2 text-sm text-slate-700 dark:text-slate-300">
							{post.data.keyTakeaways.map((t) => (
								<li class="flex gap-2"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-teal-500"></span><span>{t}</span></li>
							))}
						</ul>
					</aside>
				)}

				<div class="prose article-body mt-10 max-w-none">
					<Content />
				</div>

				{post.data.figures && post.data.figures.length > 0 && (
					<div class="mt-10 grid gap-6 sm:grid-cols-2">
						{post.data.figures.map((src, i) => (
							<MedicalImageViewer
								src={src}
								alt={`Anonymised figure ${i + 1}`}
								caption={`Anonymised reference figure ${i + 1} for this analysis`}
								modality="MRI / CT / X-ray"
							/>
						))}
					</div>
				)}

				<!-- Author -->
				<div class="mt-12 flex items-center gap-4 rounded-2xl border border-slate-200 bg-slate-50 p-5 dark:border-navy-700 dark:bg-navy-950">
					<div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-navy-800 to-navy-950 text-sm font-bold text-white">JE</div>
					<div class="text-sm">
						<div class="font-semibold text-navy-900 dark:text-slate-100">Dr Joseph El-Sheikha FRCR</div>
						<div class="text-slate-500 dark:text-slate-400">Consultant Radiologist & Medicolegal Expert Witness</div>
					</div>
				</div>
			</div>
		</div>
	</article>

	<!-- Comments -->
	<section class="bg-slate-50 py-14 dark:bg-navy-950">
		<div class="container-page">
			<div class="mx-auto max-w-3xl">
				<span class="eyebrow block">Comments</span>
				<h2 class="mt-3 text-2xl font-bold tracking-tight text-navy-900 dark:text-slate-100">Join the discussion</h2>
				<form id="comment-form" class="mt-6 grid gap-4 rounded-2xl border border-slate-200 bg-white p-5 dark:border-navy-700 dark:bg-navy-900">
					<label class="block text-sm font-medium text-navy-900 dark:text-slate-100">
						Name *
						<input name="author" type="text" required class="input-field mt-1.5" placeholder="Your name" />
					</label>
					<label class="block text-sm font-medium text-navy-900 dark:text-slate-100">
						Comment *
						<textarea name="text" rows="3" required class="input-field mt-1.5" placeholder="Your comment (moderated)"></textarea>
					</label>
					<div class="flex items-center gap-3">
						<button type="submit" class="btn btn-primary" data-submit>Post comment</button>
						<span class="text-xs text-slate-500 dark:text-slate-400">Comments are stored via Cloudflare KV and moderated.</span>
					</div>
				</form>
				<div id="comment-list" class="mt-8 space-y-4" data-postid={post.slug}>
					<!-- populated client-side -->
				</div>
			</div>
		</div>
	</section>
</BaseLayout>

<script define:vars={{ postId: post.slug }}>
	const list = document.getElementById("comment-list") as HTMLElement | null;
	const form = document.getElementById("comment-form") as HTMLFormElement | null;

	function escapeHtml(s: string) {
		return s.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c] as string));
	}

	async function load() {
		if (!list) return;
		const res = await fetch(`/api/comments?postId=${encodeURIComponent(postId)}`);
		if (!res.ok) return;
		const comments = await res.json();
		list.innerHTML = comments.length
			? comments.map((c) => `
				<div class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-navy-700 dark:bg-navy-900">
					<div class="flex items-center justify-between text-sm">
						<span class="font-semibold text-navy-900 dark:text-slate-100">${escapeHtml(c.author)}</span>
						<span class="text-xs text-slate-500">${new Date(c.date).toLocaleDateString("en-GB")}</span>
					</div>
					<p class="mt-2 text-slate-600 dark:text-slate-300">${escapeHtml(c.text)}</p>
				</div>`).join("")
			: `<p class="text-sm text-slate-500 dark:text-slate-400">No comments yet. Be the first to join the discussion.</p>`;
	}

	form?.addEventListener("submit", async (e) => {
		e.preventDefault();
		const data = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
		const btn = form.querySelector("[data-submit]") as HTMLButtonElement | null;
		if (btn) { btn.disabled = true; btn.textContent = "Posting…"; }
		try {
			const res = await fetch("/api/comments", {
				method: "POST",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify({ postId, author: data.author, text: data.text }),
			});
			const json = await res.json();
			if (!res.ok) throw new Error(json.error || "Failed");
			form.reset();
			await load();
		} catch (err) {
			alert("There was a problem posting your comment.");
		} finally {
			if (btn) { btn.disabled = false; btn.textContent = "Post comment"; }
		}
	});

	load();
</script>