---
// Structured entry for a single statutory instrument.
// Each law is rendered as a distinct panel with a left accent bar,
// the four core fields in a two-by-two grid, and an authority note.
interface Props {
	id: string;
	index: string;
	eyebrow: string;
	title: string;
	lead: string;
	fields: { n: string; d: string }[];
	note: string;
	accent?: string;
}

const { id, index, eyebrow, title, lead, fields, note, accent = "#94a3b8" } = Astro.props as Props;
---

<section id={id} class="law-entry" style={`--accent: ${accent}; --accent-light: ${accent}20`}>
	<!-- Accent bar on the left edge -->
	<div class="law-accent" aria-hidden="true"></div>

	<div class="law-body">
		<!-- Eyebrow + Title header -->
		<div class="law-head">
			<div class="flex items-baseline gap-x-3 gap-y-1 flex-wrap">
				<span class="sec-no">§ {index}</span>
				<span class="meta-label">{eyebrow}</span>
			</div>
			<h2 class="law-title">{title}</h2>
			<p class="law-lead">{lead}</p>
		</div>

		<!-- Divider -->
		<div class="law-rule" aria-hidden="true"></div>

		<!-- Four fields in a 2×2 grid -->
		<div class="law-fields">
			{fields.map((f, i) => (
				<div class="law-field">
					<div class="law-field-head">
						<!-- Icon placeholder (emoji — matches the four standard fields) -->
						<span class="law-field-icon">{['👤','📋','📄','⚠️'][i]}</span>
						<span class="law-field-label">{f.n}</span>
					</div>
					<p class="law-field-text">{f.d}</p>
				</div>
			))}
		</div>

		<!-- Authority note -->
		<aside class="law-callout">
			<span class="meta-label">Authority</span>
			<p class="law-callout-text">{note}</p>
		</aside>
	</div>
</section>

<style>
	/* --- Entry shell --- */
	.law-entry {
		position: relative;
		border: 1px solid #e2e8f0;
		background: #fff;
		margin-bottom: 2.5rem;
	}

	/* Gradient halo on the section background behind the card */
	.law-entry::before {
		content: '';
		position: absolute;
		inset: -1.5rem;
		background: radial-gradient(ellipse 60% 80% at 50% 0%, var(--accent-light, #94a3b820), transparent 70%);
		z-index: -1;
		pointer-events: none;
	}

	/* Left accent bar — the visual anchor for each law */
	.law-accent {
		position: absolute;
		top: 0;
		bottom: 0;
		left: 0;
		width: 3px;
		background: var(--accent, #94a3b8);
	}

	.law-body {
		padding: 2rem 2rem 1.5rem 2rem;
	}
	@media (min-width: 768px) {
		.law-body {
			padding: 2.25rem 2.5rem 1.75rem 2.25rem;
		}
	}

	/* --- Header --- */
	.law-head {
		margin-bottom: 1.25rem;
	}

	.law-title {
		margin-top: 0.375rem;
		font-family: var(--font-serif);
		font-size: 1.5rem;
		font-weight: 700;
		line-height: 1.25;
		color: var(--color-ink-strong);
	}
	@media (min-width: 640px) {
		.law-title {
			font-size: 1.75rem;
		}
	}

	.law-lead {
		margin-top: 0.75rem;
		max-width: 48rem;
		font-family: var(--font-serif);
		font-size: 1.05rem;
		line-height: 1.625;
		color: #475569;
	}

	/* --- Divider rule --- */
	.law-rule {
		border: none;
		border-top: 1px solid #cbd5e1;
		margin: 1.25rem 0;
	}

	/* --- Four-field grid --- */
	.law-fields {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0;
		margin-bottom: 1.5rem;
	}
	@media (min-width: 768px) {
		.law-fields {
			grid-template-columns: 1fr 1fr;
			gap: 1.5rem;
		}
	}

	.law-field {
		padding: 1.125rem 0;
	}
	/* Add a horizontal divider between fields on mobile, but not the last one */
	.law-field:not(:last-child) {
		border-bottom: 1px solid #f1f5f9;
	}
	/* On desktop, the grid gaps replace borders, so only horizontal dividers */
	@media (min-width: 768px) {
		.law-field {
			padding: 0;
		}
		.law-field:nth-child(odd) {
			border-right: 1px solid #f1f5f9;
			padding-right: 1.25rem;
		}
		.law-field:nth-child(2) {
			border-bottom: 1px solid #f1f5f9;
		}
		.law-field:nth-child(3) {
			border-bottom: 1px solid #f1f5f9;
		}
		/* last column gets no right border */
	}

	.law-field-head {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.law-field-icon {
		font-size: 0.9rem;
		line-height: 1;
		opacity: 0.7;
	}

	.law-field-label {
		font-family: var(--font-sans);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.02em;
		color: var(--color-ink-strong);
		text-transform: none;
	}

	.law-field-text {
		margin-top: 0.5rem;
		font-family: var(--font-serif);
		font-size: 0.9rem;
		line-height: 1.625;
		color: #475569;
	}

	/* --- Authority callout --- */
	.law-callout {
		margin-top: 0.5rem;
		padding-top: 0.75rem;
		border-top: 1px solid #e2e8f0;
	}
	.law-callout .meta-label {
		display: block;
		margin-bottom: 0.375rem;
	}
	.law-callout-text {
		font-family: var(--font-serif);
		font-size: 0.85rem;
		line-height: 1.625;
		color: #64748b;
		font-style: italic;
	}
</style>
