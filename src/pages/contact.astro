---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import PageIntro from '../components/PageIntro.astro';
import Callout from '../components/Callout.astro';
import { PAGE_HERO_IMAGES } from '../consts';

const contactEmail = 'enquiries@medicolegal.org';
const gmcNumber = '7017101';
---

<BaseLayout
    title="Contact | Radiology & Medicolegal Law"
    description="Contact details and general enquiries for the radiology and medicolegal practice."
>
    <PageHero
        eyebrow="Contact"
        title="Contact"
        description="General enquiries and preliminary enquiries about expert instruction."
        heroImage={PAGE_HERO_IMAGES["/contact"] || undefined}
    />

    <PageIntro
        eyebrow="Enquiries"
        paragraphs={[
            'Please use the contact details or form below for general enquiries and preliminary enquiries about expert instruction.',
            'Do not send patient-identifiable information, medical records or diagnostic images through this form. A secure transfer method will be provided if an instruction is accepted.'
        ]}
        contents={[
            { href: '#contact-details', label: 'Contact details' },
            { href: '#enquiry-form', label: 'Send an enquiry' },
        ]}
        reviewed="October 2026"
    />

    <section class="band">
        <div class="container-page">
            <div class="doc space-y-14">

                <section id="contact-details" class="sec">
                    <span class="meta-label">Secretariat</span>
                    <h2 class="sec-title">Contact Details</h2>

                    <table class="table">
                        <tbody>
                            <tr>
                                <th scope="row">Email</th>
                                <td>
                                    {`mailto:${contactEmail}`}
                                        {contactEmail}
                                    </a>
                                </td>
                            </tr>

                            <tr>
                                <th scope="row">GMC</th>
                                <td>{gmcNumber}</td>
                            </tr>

                            <tr>
                                <th scope="row">Location</th>
                                <td>Basingstoke, Hampshire</td>
                            </tr>
                        </tbody>
                    </table>

                    <p class="para-sm mt-6">
                        Telephone and postal details are provided where required following
                        initial contact.
                    </p>
                </section>

                <section id="enquiry-form" class="sec">
                    <span class="meta-label">General enquiry</span>
                    <h2 class="sec-title">Send a Message</h2>

                    <form id="contact-form" class="mt-6 grid gap-5">
                        <label class="form-label">
                            Name
                            <input
                                name="name"
                                type="text"
                                required
                                autocomplete="name"
                                maxlength="120"
                                class="input-field"
                            />
                        </label>

                        <label class="form-label">
                            Email address
                            <input
                                name="email"
                                type="email"
                                required
                                autocomplete="email"
                                inputmode="email"
                                maxlength="254"
                                class="input-field"
                            />
                        </label>

                        <label class="form-label">
                            Subject
                            <select name="subject" class="input-field">
                                <option value="general">General enquiry</option>
                                <option value="expert-instruction">
                                    Expert-witness enquiry
                                </option>
                                <option value="existing-matter">
                                    Existing instruction
                                </option>
                                <option value="website">
                                    Website query
                                </option>
                            </select>
                        </label>

                        <label class="form-label">
                            Message
                            <textarea
                                name="message"
                                rows="6"
                                required
                                maxlength="4000"
                                class="input-field"
                                placeholder="Please provide a brief anonymised summary."
                            ></textarea>
                        </label>

                        <input
                            type="hidden"
                            name="csrfToken"
                            id="contact-csrf"
                        />

                        <div
                            class="absolute -left-[9999px]"
                            aria-hidden="true"
                        >
                            <label for="contact-website">
                                Leave this field empty
                            </label>

                            <input
                                id="contact-website"
                                name="_honey"
                                type="text"
                                tabindex="-1"
                                autocomplete="off"
                            />
                        </div>

                        <Callout tone="limit" title="Do not include patient information">
                            <p>
                                Do not enter patient names, dates of birth, NHS or hospital
                                numbers, addresses, medical records or other identifiable
                                clinical information. Do not send DICOM images or attachments
                                by ordinary email.
                            </p>
                        </Callout>

                        <p
                            id="contact-status"
                            class="hidden text-sm"
                            role="status"
                            aria-live="polite"
                        ></p>

                        <div class="flex-gap-sm">
                            <button
                                type="submit"
                                class="btn btn-primary"
                                data-submit
                                disabled
                            >
                                Preparing form…
                            </button>

                            <span class="text-muted">
                                Your information is handled in accordance with the
                                {' '}
                                /privacy-notice
                                    privacy notice
                                </a>.
                            </span>
                        </div>
                    </form>
                </section>

            </div>
        </div>
    </section>
</BaseLayout>

<script>
    import { toast } from '../lib/toast';

    interface ContactResponse {
        csrfToken?: string;
        reference?: string;
        error?: string;
    }

    const form = document.getElementById(
        'contact-form'
    ) as HTMLFormElement | null;

    const csrfInput = document.getElementById(
        'contact-csrf'
    ) as HTMLInputElement | null;

    const submitButton = form?.querySelector(
        '[data-submit]'
    ) as HTMLButtonElement | null;

    const status = document.getElementById('contact-status');

    function setStatus(
        message: string,
        kind: 'neutral' | 'error' | 'success' = 'neutral'
    ): void {
        if (!status) return;

        status.textContent = message;
        status.classList.remove(
            'hidden',
            'text-slate-600',
            'text-red-700',
            'text-green-700'
        );

        if (kind === 'error') {
            status.classList.add('text-red-700');
        } else if (kind === 'success') {
            status.classList.add('text-green-700');
        } else {
            status.classList.add('text-slate-600');
        }
    }

    function clearStatus(): void {
        if (!status) return;

        status.textContent = '';
        status.classList.add('hidden');
    }

    async function readResponse(
        response: Response
    ): Promise<ContactResponse> {
        try {
            return await response.json() as ContactResponse;
        } catch {
            return {};
        }
    }

    async function prepareForm(): Promise<void> {
        if (!form || !csrfInput || !submitButton) return;

        submitButton.disabled = true;
        submitButton.textContent = 'Preparing form…';

        try {
            const response = await fetch('/api/contact', {
                method: 'GET',
                credentials: 'same-origin',
                headers: {
                    Accept: 'application/json',
                },
            });

            const result = await readResponse(response);

            if (!response.ok || !result.csrfToken) {
                throw new Error();
            }

            csrfInput.value = result.csrfToken;
            submitButton.disabled = false;
            submitButton.textContent = 'Send message';
        } catch {
            setStatus(
                'The enquiry form is temporarily unavailable. Please use the email address above.',
                'error'
            );

            submitButton.disabled = true;
            submitButton.textContent = 'Form unavailable';
        }
    }

    form?.addEventListener('submit', async (event) => {
        event.preventDefault();

        if (!form || !csrfInput || !submitButton) return;

        clearStatus();

        if (!csrfInput.value) {
            setStatus(
                'The secure form session has expired. Please reload the page.',
                'error'
            );
            return;
        }

        if (!form.reportValidity()) return;

        const payload = Object.fromEntries(
            new FormData(form).entries()
        );

        submitButton.disabled = true;
        submitButton.textContent = 'Sending…';
        form.setAttribute('aria-busy', 'true');

        try {
            const response = await fetch('/api/contact', {
                method: 'POST',
                credentials: 'same-origin',
                headers: {
                    Accept: 'application/json',
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(payload),
            });

            const result = await readResponse(response);

            if (!response.ok) {
                if (result.csrfToken) {
                    csrfInput.value = result.csrfToken;
                }

                const message =
                    result.error === 'RATE_LIMITED'
                        ? 'Too many messages have been submitted. Please try again later.'
                        : 'The message could not be sent. Please check the form and try again.';

                throw new Error(message);
            }

            form.reset();

            if (result.csrfToken) {
                csrfInput.value = result.csrfToken;
            } else {
                await prepareForm();
            }

            const confirmation = result.reference
                ? `Your message has been received. Reference: ${result.reference}.`
                : 'Your message has been received.';

            setStatus(confirmation, 'success');
            toast(confirmation, 'success', 4000);
        } catch (error: unknown) {
            const message =
                error instanceof Error
                    ? error.message
                    : 'The message could not be sent. Please use the email address above.';

            setStatus(message, 'error');
            toast(message, 'error', 5000);
        } finally {
            form.removeAttribute('aria-busy');

            if (csrfInput.value) {
                submitButton.disabled = false;
                submitButton.textContent = 'Send message';
            }
        }
    });

    void prepareForm();
</script>