---
import BaseLayout from '../layouts/BaseLayout.astro';
import { LOGIN_PAGE_TITLE } from '../consts';
---

<BaseLayout
    title={`${LOGIN_PAGE_TITLE} | Radiology & Medicolegal Law`}
    description="Secure access for authorised professional users."
    noindex
>
    <section class="bg-paper py-20">
        <div class="container-page max-w-md">
            <div class="border border-slate-300 bg-white p-8">
                <header>
                    <p class="font-sans text-xs uppercase tracking-[0.12em] text-slate-500">
                        Authorised access
                    </p>

                    <h1 class="mt-2 font-serif text-xl font-bold text-slate-900">
                        {LOGIN_PAGE_TITLE}
                    </h1>
                </header>

                <p class="para-sm mt-5">
                    Secure access for invited professional users. Please sign in using
                    your registered credentials.
                </p>

                <form id="login-form" class="mt-6 grid gap-4">
                    <label class="form-label">
                        Email address
                        <input
                            name="email"
                            type="email"
                            required
                            autocomplete="username"
                            inputmode="email"
                            class="input-field"
                            placeholder="name@example.com"
                        />
                    </label>

                    <label class="form-label">
                        Password
                        <input
                            name="password"
                            type="password"
                            required
                            autocomplete="current-password"
                            class="input-field"
                        />
                    </label>

                    <input
                        type="hidden"
                        name="csrfToken"
                        id="csrf-token"
                    />

                    <div
                        class="absolute -left-[9999px]"
                        aria-hidden="true"
                    >
                        <label for="website">Leave this field empty</label>
                        <input
                            id="website"
                            name="_honey"
                            type="text"
                            tabindex="-1"
                            autocomplete="off"
                        />
                    </div>

                    <p
                        id="login-status"
                        class="hidden text-sm"
                        role="status"
                        aria-live="polite"
                    ></p>

                    <button
                        type="submit"
                        class="btn btn-primary w-full"
                        data-submit
                        disabled
                    >
                        Preparing secure sign-in…
                    </button>
                </form>

                <p class="mt-5 text-xs leading-relaxed text-slate-500">
                    Access is restricted to authorised users. If you cannot access your
                    account, please contact the administrator through your usual
                    professional channel.
                </p>
            </div>
        </div>
    </section>
</BaseLayout>

<script>
    import { toast } from '../lib/toast';

    interface LoginResponse {
        csrfToken?: string;
        redirectTo?: string;
        error?: string;
    }

    const form = document.getElementById('login-form') as HTMLFormElement | null;
    const csrfInput = document.getElementById('csrf-token') as HTMLInputElement | null;
    const submitButton = form?.querySelector(
        '[data-submit]'
    ) as HTMLButtonElement | null;
    const status = document.getElementById('login-status');

    function setStatus(
        message: string,
        kind: 'neutral' | 'error' = 'neutral'
    ): void {
        if (!status) return;

        status.textContent = message;
        status.classList.remove(
            'hidden',
            'text-slate-600',
            'text-red-700'
        );

        status.classList.add(
            kind === 'error' ? 'text-red-700' : 'text-slate-600'
        );
    }

    function clearStatus(): void {
        if (!status) return;

        status.textContent = '';
        status.classList.add('hidden');
    }

    async function readResponse(response: Response): Promise<LoginResponse> {
        try {
            return await response.json() as LoginResponse;
        } catch {
            return {};
        }
    }

    async function prepareLogin(): Promise<void> {
        if (!form || !csrfInput || !submitButton) return;

        submitButton.disabled = true;
        submitButton.textContent = 'Preparing secure sign-in…';

        try {
            const response = await fetch('/api/login', {
                method: 'GET',
                credentials: 'same-origin',
                headers: {
                    Accept: 'application/json',
                },
            });

            const result = await readResponse(response);

            if (!response.ok || !result.csrfToken) {
                throw new Error('Secure sign-in is temporarily unavailable.');
            }

            csrfInput.value = result.csrfToken;
            submitButton.disabled = false;
            submitButton.textContent = 'Sign in';
        } catch {
            setStatus(
                'Secure sign-in is temporarily unavailable. Please try again later.',
                'error'
            );

            submitButton.disabled = true;
            submitButton.textContent = 'Sign-in unavailable';
        }
    }

    form?.addEventListener('submit', async (event) => {
        event.preventDefault();

        if (!form || !csrfInput || !submitButton) return;

        clearStatus();

        if (!csrfInput.value) {
            setStatus(
                'The secure session has expired. Please reload the page.',
                'error'
            );
            return;
        }

        const formData = new FormData(form);
        const payload = Object.fromEntries(formData.entries());

        submitButton.disabled = true;
        submitButton.textContent = 'Signing in…';
        form.setAttribute('aria-busy', 'true');

        try {
            const response = await fetch('/api/login', {
                method: 'POST',
                credentials: 'same-origin',
                headers: {
                    Accept: 'application/json',
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(payload),
            });

            const result = await readResponse(response);

            if (!response.ok) {
                if (result.csrfToken) {
                    csrfInput.value = result.csrfToken;
                }

                throw new Error(
                    result.error === 'RATE_LIMITED'
                        ? 'Too many attempts. Please wait before trying again.'
                        : 'The email address or password was not recognised.'
                );
            }

            toast('Signed in successfully.', 'success', 2000);

            const destination =
                result.redirectTo &&
                result.redirectTo.startsWith('/') &&
                !result.redirectTo.startsWith('//')
                    ? result.redirectTo
                    : '/portal';

            window.location.assign(destination);
        } catch (error: unknown) {
            const message =
                error instanceof Error
                    ? error.message
                    : 'Sign-in could not be completed. Please try again.';

            setStatus(message, 'error');
            toast(message, 'error', 5000);

            submitButton.disabled = false;
            submitButton.textContent = 'Sign in';
        } finally {
            form.removeAttribute('aria-busy');
        }
    });

    void prepareLogin();
</script>